\ pick  ( xN .. x0 n -- xN .. x0 xN )  copy the n-th data-stack item down.
\ 0 pick = dup, 1 pick = over.  Pure lw/slli/add/sw, no jalr, so verifier-clean.
:M pick
83220100 ,   \ lw   t0,0(sp)    t0 = n
93922200 ,   \ slli t0,t0,2     t0 = n*4
B3822200 ,   \ add  t0,t0,sp    t0 = sp + n*4
83A24200 ,   \ lw   t0,4(t0)    t0 = the n-th item (sp + n*4 + 4)
23205100 ,   \ sw   t0,0(sp)    overwrite n with it
;


