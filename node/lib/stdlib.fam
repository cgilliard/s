:I \
63FC2401 ,
83C20400 ,
93841400 ,
1303A000 ,
63846200 ,
6FF0DFFE ,
;

\ ============================================================
\ fam standard library  (single file — catted in front of the
\ user program as one EOT-terminated UART stream).
\ ------------------------------------------------------------

\ nxchar  ( C: -- ch )   read next source byte AND advance s1.
\         compile-time fragment; clobbers t0, pushes to cstack.
:M nxchar
63F82401 ,   \ bgeu s1, s2, nx_eof
83C20400 ,   \ lbu  t0, 0(s1)
93841400 ,   \ addi s1, s1, 1
6F008000 ,   \ jal  x0, nx_push
93024000 ,   \ addi t0, x0, 0x04        ( nx_eof: EOT sentinel )
1302C2FF ,   \ addi tp, tp, -4          ( nx_push )
23205200 ,   \ sw   t0, 0(tp)
;

\ pxchar  ( C: -- ch )   peek next source byte; does NOT advance s1.
\         compile-time fragment; clobbers t0, pushes to cstack.
:M pxchar
63F62401 ,   \ bgeu s1, s2, px_eof
83C20400 ,   \ lbu  t0, 0(s1)
6F008000 ,   \ jal  x0, px_push
93024000 ,   \ addi t0, x0, 0x04        ( px_eof: EOT sentinel )
1302C2FF ,   \ addi tp, tp, -4          ( px_push )
23205200 ,   \ sw   t0, 0(tp)
;

\ skipch  ( C: -- )      advance s1 one byte (discard), bounded by s2.
\         compile-time fragment; no cstack effect.
:M skipch
63F42401 ,   \ bgeu s1, s2, sk_end
93841400 ,   \ addi s1, s1, 1
;


\ bye   ( -- )   RUNTIME: clean program shutdown (process exit 0).
\        a `:` word — called, not inlined (no perf need; saves binary).
: bye
B7021000 ,   \ lui  t0, 0x100           ( SiFive finisher 0x100000 )
37530000 ,   \ lui  t1, 0x5
13035355 ,   \ addi t1, t1, 0x555       ( 0x5555 = PASS -> exit 0 )
23A06200 ,   \ sw   t1, 0(t0)
6F000000 ,   \ jal  x0, .               ( spin until QEMU exits )
;

\ abort  ( C: -- )   COMPILE-TIME: abort — print '?' + LF to the UART,
\         then exit code 1. compile-time fragment (for :I scanners).
:M abort
B7020010 ,   \ lui  t0, 0x10000         ( UART base 0x10000000 )
03C35200 ,   \ lbu  t1, 5(t0)           ( ca1: LSR )
13730302 ,   \ andi t1, t1, 0x20        ( THR-empty bit )
E30C03FE ,   \ beqz t1, ca1
1303F003 ,   \ addi t1, x0, 0x3F        ( '?' )
23806200 ,   \ sb   t1, 0(t0)
03C35200 ,   \ lbu  t1, 5(t0)           ( ca2 )
13730302 ,   \ andi t1, t1, 0x20
E30C03FE ,   \ beqz t1, ca2
1303A000 ,   \ addi t1, x0, 0x0A        ( LF )
23806200 ,   \ sb   t1, 0(t0)
B7021000 ,   \ lui  t0, 0x100           ( SiFive finisher 0x100000 )
37330100 ,   \ lui  t1, 0x13
13033333 ,   \ addi t1, t1, 0x333       ( 0x00013333 = FAIL -> exit 1 )
23A06200 ,   \ sw   t1, 0(t0)
6F000000 ,   \ jal  x0, ca3             ( spin until QEMU exits )
;


\ (   block comment — consume source to the MATCHING ')'. NESTS, and
\     spans newlines. Unterminated (EOF first) -> abort. :I, compile time.
\     Nesting depth kept in t2 (nxchar preserves it).
:I (
93031000 ,   \ addi t2, x0, 1           ( depth = 1: inside the opening '(' )
nxchar       \ ploop: push next char (0x04 at EOF), advance s1
83220200 ,   \ lw   t0, 0(tp)           ( peek pushed char )
13024200 ,   \ addi tp, tp, 4           ( pop )
13034000 ,   \ addi t1, x0, 0x04        ( EOT )
63846202 ,   \ beq  t0, t1, abort       ( EOF -> unterminated )
13038002 ,   \ addi t1, x0, 0x28        ( '(' )
63966200 ,   \ bne  t0, t1, pclose
93831300 ,   \ addi t2, t2, 1           ( '(' -> depth++ )
6FF09FFC ,   \ jal  x0, ploop
13039002 ,   \ addi t1, x0, 0x29        ( pclose: ')' )
E39062FC ,   \ bne  t0, t1, ploop
9383F3FF ,   \ addi t2, t2, -1          ( ')' -> depth-- )
E39C03FA ,   \ bnez t2, ploop           ( still nested -> keep scanning )
6F004004 ,   \ jal  x0, done            ( depth 0 -> matched close )
abort        \ unterminated: print '?' and halt the compiler
;


\ init  ( -- )   RUNTIME: set up the return-id (RID) stack used by
\        every `:`-word call, the bump allocator, and the data stack.
\          gp  = gp rounded up to 4 KiB: the data starts on a page boundary,
\                               so a program's PMP boundary between its code
\                               and its data (src/exec.fam) falls on one too
\                               (QEMU stops caching a page a PMP boundary
\                               cuts through: every access to it is slow)
\          s10 = gp             RID-stack floor / overflow bound
\          s11 = gp + 0x1000    RID-stack top (1024 entries, grows DOWN)
\          gp  = gp + 0x1000    heap base — first free byte ABOVE the
\                               RID stack (bump-allocate upward from here)
\          sp  = 0x87FF0000     data-stack top (grows DOWN toward the heap:
\                               everything from the heap base to the top of
\                               the machine's 128 MiB is shared between the two)
\          s8  = 0x88000000     loop-control stack top (the last 64 KiB of RAM)
\        The RAM size is the virt machine's default (QEMU -m 128M, tools/q32
\        and scripts/build.sh); another machine means another constant here.
\        A program exec'd by the kernel (src/exec.fam) runs in a region of its
\        own and is started with a5 = 'EXEC' (0x43455845), a6 = the region's
\        base, a7 = its size: then the loop stack ends at the region's top and
\        the data stack 16 KiB below it, with the heap growing up from the
\        image as before.  (tabernacle hands the node a0..a4; a5 is never that
\        value by accident.)
\        runtime fragment; must run before any `:`-word call.
:M init
B7120000 ,   \ lui  t0, 0x1             ( gp = (gp + 0xFFF) & ~0xFFF: the next page )
9382F2FF ,   \ addi t0, t0, -1
B3815100 ,   \ add  gp, gp, t0
B7F2FFFF ,   \ lui  t0, 0xFFFFF
B3F15100 ,   \ and  gp, gp, t0
138D0100 ,   \ addi s10, gp, 0          ( s10 = gp = RID floor / region base )
B7120000 ,   \ lui  t0, 0x1             ( t0 = 0x1000 )
B38D5100 ,   \ add  s11, gp, t0         ( s11 = gp + 0x1000 = RID top )
\        Variable region: 16 KiB (4096 cells) at [s10+0x1000, s10+0x5000), i.e.
\        right after the RID stack. VARBASE = s10 + 0x1000. The `variable` word
\        hands out fixed cells here, so they live in DATA (not code).
B7520000 ,   \ lui  t0, 0x5             ( t0 = 0x5000 = 0x1000 RID + 0x4000 vars )
B3815100 ,   \ add  gp,  gp, t0         ( gp += 0x5000 = heap base, above RID+vars )
B7624543 ,   \ lui  t0, 0x43456         ( t0 = 'EXEC' ...
93825284 ,   \ addi t0, t0, -1979       ( ... = 0x43455845 )
639A5700 ,   \ bne  a5, t0, +20         ( not exec'd: the standalone layout below )
330C1801 ,   \ add  s8, a6, a7          ( s8 = region top = loop-control stack top )
B7420000 ,   \ lui  t0, 0x4             ( t0 = 0x4000 = 16 KiB of loop stack )
33015C40 ,   \ sub  sp, s8, t0          ( sp = region top - 16 KiB = data-stack top )
6F00C000 ,   \ j    +12                 ( done )
3701FF87 ,   \ lui  sp, 0x87FF0         ( sp = 0x87FF0000 = data-stack top: RAM top - 64 KiB )
370C0088 ,   \ lui  s8, 0x88000         ( s8 = 0x88000000 = loop-control stack top = RAM top )
;


\ ------------------------------------------------------------
\ Layer 5 — runtime literals and I/O.
\ ------------------------------------------------------------

\ lit   ( C: n -- )   COMPILE-TIME: pop n from the cstack and EMIT code
\        that pushes n onto the runtime data stack. The counterpart to
\        `,` (which emits a literal WORD); `lit` emits a runtime PUSH.
\        Emits  lui t1,%hi ; addi t1,t1,%lo ; addi sp,sp,-4 ; sw t1,0(sp)
\        — lui+addi covers the full 32-bit range (the +0x800 rounds %hi
\        so a set bit 11 in %lo doesn't corrupt it). :I word.
:I lit
63628205 ,   \ bltu tp, s8, work        ( cstack has an item -> work; else abort )
abort        \ cstack underflow (16-instr fragment)
83220200 ,   \ work: lw t0, 0(tp)       ( t0 = n )
13024200 ,   \ addi tp, tp, 4           ( pop cstack )
930F1000 ,   \ addi t6, x0, 1
939FBF00 ,   \ slli t6, t6, 11          ( t6 = 0x800 )
3383F201 ,   \ add  t1, t0, t6          ( n + 0x800 )
1353C300 ,   \ srli t1, t1, 12          ( t1 = %hi )
9313C300 ,   \ slli t2, t1, 12
B3837240 ,   \ sub  t2, t0, t2          ( t2 = %lo, signed )
130E1000 ,   \ addi t3, x0, 1
131ECE00 ,   \ slli t3, t3, 12
130EFEFF ,   \ addi t3, t3, -1          ( t3 = 0xFFF )
B3F3C301 ,   \ and  t2, t2, t3          ( mask %lo to 12 bits )
931EC300 ,   \ slli t4, t1, 12          ( lui imm field )
130F7033 ,   \ addi t5, x0, 0x337       ( lui t1 opcode template )
B3EEEE01 ,   \ or   t4, t4, t5
23A0D101 ,   \ sw   t4, 0(gp)           ( emit: lui t1, %hi )
93814100 ,   \ addi gp, gp, 4
939E4301 ,   \ slli t4, t2, 20          ( addi imm field )
370F0300 ,   \ lui  t5, 0x30
130F3F31 ,   \ addi t5, t5, 0x313       ( addi t1,t1 opcode template )
B3EEEE01 ,   \ or   t4, t4, t5
23A0D101 ,   \ sw   t4, 0(gp)           ( emit: addi t1, t1, %lo )
93814100 ,   \ addi gp, gp, 4
B70EC1FF ,   \ lui  t4, 0xFFC10
938E3E11 ,   \ addi t4, t4, 0x113       ( = 0xFFC10113 )
23A0D101 ,   \ sw   t4, 0(gp)           ( emit: addi sp, sp, -4 )
93814100 ,   \ addi gp, gp, 4
B72E6100 ,   \ lui  t4, 0x612
938E3E02 ,   \ addi t4, t4, 0x23        ( = 0x00612023 )
23A0D101 ,   \ sw   t4, 0(gp)           ( emit: sw t1, 0(sp) )
93814100 ,   \ addi gp, gp, 4
;

\ putc  ( c -- )   RUNTIME: pop a byte off the data stack, write to UART.
\        a `:` word (called, not inlined).
: putc
B7020010 ,   \ lui  t0, 0x10000         ( UART base )
03C35200 ,   \ lbu  t1, 5(t0)           ( LSR )
13730302 ,   \ andi t1, t1, 0x20        ( THR-empty bit )
E30C03FE ,   \ beqz t1, -8              ( wait until ready )
03230100 ,   \ lw   t1, 0(sp)           ( pop the byte )
13014100 ,   \ addi sp, sp, 4
23806200 ,   \ sb   t1, 0(t0)           ( write to UART )
;

\ puts  ( addr -- )   RUNTIME: write a null-terminated string to the UART.
\        a `:` word; pairs with the "..." string literal.
: puts
83220100 ,   \ lw   t0, 0(sp)           ( addr )
13014100 ,   \ addi sp, sp, 4
37030010 ,   \ lui  t1, 0x10000         ( UART base )
83C30200 ,   \ ploop: lbu t2, 0(t0)
638E0300 ,   \ beqz t2, pend            ( null -> done )
034E5300 ,   \ lbu  t3, 5(t1)           ( wait THR-empty )
137E0E02 ,   \ andi t3, t3, 0x20
E30C0EFE ,   \ beqz t3, -8
23007300 ,   \ sb   t2, 0(t1)           ( write byte )
93821200 ,   \ addi t0, t0, 1
6FF05FFE ,   \ jal  x0, ploop
;

\ Minimal stack/arith primitives (the arithmetic layer proper comes later).
\ dup ( a -- a a )
:M dup
83220100 ,   \ lw t0,0(sp)
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;
\ drop ( a -- )
:M drop
13014100 ,   \ addi sp,sp,4
;
\ 1- ( a -- a-1 )
:M 1-
83220100 ,   \ lw t0,0(sp)
9382F2FF ,   \ addi t0,t0,-1
23205100 ,   \ sw t0,0(sp)
;
\ 0= ( a -- flag )   flag = 1 if a==0 else 0
:M 0=
83220100 ,   \ lw t0,0(sp)
93B21200 ,   \ seqz t0,t0
B3025040 ,   \ neg t0,t0
23205100 ,   \ sw t0,0(sp)
;

\ ============================================================
\ Control flow — if / else / then.  Built from emit/patch :M
\ fragments. Every conditional jump is a fixed `bne t0,x0,+8`
\ trampoline over a `jal`, so the only backpatched offset is a
\ J-type jump (+-1MiB, range-checked) — never a B-type branch
\ whose range (~2KB) could silently truncate on a long body.
\ ============================================================

\ ,test  ( C: -- )  emit: pop flag; `bne t0,x0,+8` (skip the jal if true).
:M ,test
B7220100 ,   \ lui t0,0x12
93823228 ,   \ addi t0,t0,643
23A05100 ,   \ sw t0,0(gp)
93814100 ,   \ addi gp,gp,4
B7024100 ,   \ lui t0,0x410
93823211 ,   \ addi t0,t0,275
23A05100 ,   \ sw t0,0(gp)
93814100 ,   \ addi gp,gp,4
B7920200 ,   \ lui t0,0x29
93823246 ,   \ addi t0,t0,1123
23A05100 ,   \ sw t0,0(gp)
93814100 ,   \ addi gp,gp,4
;

\ ,j0    ( C: -- )  emit a `jal x0, 0` placeholder (forward jump).
:M ,j0
9302F006 ,   \ li t0,111
23A05100 ,   \ sw t0,0(gp)
93814100 ,   \ addi gp,gp,4
;

\ here   ( C: -- addr )  push the current output cursor (gp) to the cstack.
:M here
1302C2FF ,   \ addi tp,tp,-4
23203200 ,   \ sw gp,0(tp)
;

\ jpat!  ( C: addr -- )  backpatch the jal at addr to jump to here (gp).
\        Aborts on cstack underflow or a >1MiB offset (no silent truncation).
:M jpat!
637A8207 ,   \ bgeu tp,s8,bad
03230200 ,   \ lw t1,0(tp)
13024200 ,   \ addi tp,tp,4
B3826140 ,   \ sub t0,gp,t1
93D34241 ,   \ srai t2,t0,0x14
63860300 ,   \ beqz t2,20 <.L1^B1>
130EF0FF ,   \ li t3,-1
639CC305 ,   \ bne t2,t3,bad
93030000 ,   \ li t2,0
13DE4201 ,   \ srli t3,t0,0x14
137E1E00 ,   \ andi t3,t3,1
131EFE01 ,   \ slli t3,t3,0x1f
B3E3C301 ,   \ or t2,t2,t3
13DE1200 ,   \ srli t3,t0,0x1
137EFE3F ,   \ andi t3,t3,1023
131E5E01 ,   \ slli t3,t3,0x15
B3E3C301 ,   \ or t2,t2,t3
13DEB200 ,   \ srli t3,t0,0xb
137E1E00 ,   \ andi t3,t3,1
131E4E01 ,   \ slli t3,t3,0x14
B3E3C301 ,   \ or t2,t2,t3
13DEC200 ,   \ srli t3,t0,0xc
137EFE0F ,   \ zext.b t3,t3
131ECE00 ,   \ slli t3,t3,0xc
B3E3C301 ,   \ or t2,t2,t3
032E0300 ,   \ lw t3,0(t1)
B3E3C301 ,   \ or t2,t2,t3
23207300 ,   \ sw t2,0(t1)
6F004004 ,   \ j done
abort        \ underflow / out-of-range -> compile error
;

\ cswap  ( C: a b -- b a )  swap the top two cstack items (>=2 guard).
:M cswap
93024200 ,   \ addi t0,tp,4
63FC8201 ,   \ bgeu t0,s8,bad
83220200 ,   \ lw t0,0(tp)
03234200 ,   \ lw t1,4(tp)
23206200 ,   \ sw t1,0(tp)
23225200 ,   \ sw t0,4(tp)
6F004004 ,   \ j done
abort        \ fewer than 2 items -> compile error
;

\ flag if <true> then          /          flag if <true> else <false> then
:I if    ,test here ,j0 ;
:I then  jpat! ;
:I else  here ,j0 cswap jpat! ;

\ ============================================================
\ Loops — begin/until and begin/while/repeat. Same trampoline
\ rule: the conditional is a fixed `bne +8`; the loop-back/exit
\ is a range-checked `jal` (never a B-type branch).
\ ============================================================

\ ,jto  ( C: target -- )  emit `jal x0, target` (backward; +-1MiB checked).
:M ,jto
63788207 ,   \ bgeu tp,s8,bad
03230200 ,   \ lw t1,0(tp)
13024200 ,   \ addi tp,tp,4
B3023340 ,   \ sub t0,t1,gp
93D34241 ,   \ srai t2,t0,0x14
63860300 ,   \ beqz t2,20 <.L1^B1>
130EF0FF ,   \ li t3,-1
639AC305 ,   \ bne t2,t3,bad
9303F006 ,   \ li t2,111
13DE4201 ,   \ srli t3,t0,0x14
137E1E00 ,   \ andi t3,t3,1
131EFE01 ,   \ slli t3,t3,0x1f
B3E3C301 ,   \ or t2,t2,t3
13DE1200 ,   \ srli t3,t0,0x1
137EFE3F ,   \ andi t3,t3,1023
131E5E01 ,   \ slli t3,t3,0x15
B3E3C301 ,   \ or t2,t2,t3
13DEB200 ,   \ srli t3,t0,0xb
137E1E00 ,   \ andi t3,t3,1
131E4E01 ,   \ slli t3,t3,0x14
B3E3C301 ,   \ or t2,t2,t3
13DEC200 ,   \ srli t3,t0,0xc
137EFE0F ,   \ zext.b t3,t3
131ECE00 ,   \ slli t3,t3,0xc
B3E3C301 ,   \ or t2,t2,t3
23A07100 ,   \ sw t2,0(gp)
93814100 ,   \ addi gp,gp,4
6F004004 ,   \ j done
abort        \ underflow / out-of-range -> compile error
;

\ begin ... until            loop back to begin while flag is false (exit on true)
\ begin ... while ... repeat  exit the loop when flag is false
:I begin   here ;
:I until   ,test ,jto ;
:I while   ,test here ,j0 ;
:I repeat  cswap ,jto jpat! ;

\ ???   ( a0 = token start, a1 = token length )   COMPILE-TIME literal hook.
\        Recognizes and pushes to the cstack (for lit/`,`):
\          'x'      char (length 3)         '\x'  escape: \n \r \t \\ \' \" \0
\          ' '      char literals may hold a space (token split is rejoined via s2)
\          1234u    unsigned decimal        -1234  signed negative decimal
\        STRING "..." self-emits: bytes (escapes processed) inline + address push.
\        Overflow / malformed / unrecognized -> abort. :I word.
:I ???
