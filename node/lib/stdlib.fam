\ getc  ( -- ch )   RUNTIME: read one byte from the UART (blocks). :M (inlined
\        so it never pushes a return-id — safe inside loops that pin s11).
:M getc
B7020010 ,   \ lui  t0, 0x10000         ( UART base )
03C35200 ,   \ lbu  t1, 5(t0)           ( LSR )
13731300 ,   \ andi t1, t1, 1           ( RX data-ready bit )
E30C03FE ,   \ beqz t1, -8              ( wait for a byte )
03C30200 ,   \ lbu  t1, 0(t0)           ( read the byte )
1301C1FF ,   \ addi sp, sp, -4
23206100 ,   \ sw   t1, 0(sp)           ( push it )
;

\ alloc ( n -- ptr )   RUNTIME: bump-allocate n bytes (rounded up to a multiple
\        of 4) from the heap (gp); returns the old gp. BOUNDS-CHECKED: if the
\        allocation would meet the data stack (need > sp - gp) it returns 0
\        (null) and leaves gp unchanged. A negative/huge n aligns to a huge
\        unsigned size and so also returns 0. No free.
:M alloc
83220100 ,   \ lw   t0, 0(sp)           ( t0 = n )
93823200 ,   \ addi t0, t0, 3
93F2C2FF ,   \ andi t0, t0, -4          ( t0 = round n up to a multiple of 4 )
33033140 ,   \ sub  t1, sp, gp          ( t1 = available bytes = sp - gp )
63685300 ,   \ bltu t1, t0, +16         ( need > available -> exhausted )
23203100 ,   \ sw   gp, 0(sp)           ( ptr = old gp )
B3815100 ,   \ add  gp, gp, t0          ( gp += t0 )
6F008000 ,   \ jal  x0, +8              ( skip the null path )
23200100 ,   \ sw   x0, 0(sp)           ( exhausted: return 0 )
;

