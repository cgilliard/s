\ variable  ( -- addr )   COMPILE-TIME: hand out the next fixed 4-byte cell in
\        the DATA-side variable region (VARBASE = s10+0x1000), and EMIT code that
\        pushes its address at runtime ( push s10 + 0x1000 + 4*slot ). The cell
\        lives in DATA, not code, so `!`/`@` never touch the code image.
\        Slots are counted in this :I word's own (compile-time) cell below, so the
\        counter never appears in the output. >4096 variables -> compile error.
\        Use:  : counter variable ;   then  N lit counter !   /   counter @
:I variable
97020000 ,   \ auipc t0, 0              ( t0 = PC of this instruction )
9382020F ,   \ addi  t0, t0, 240        ( t0 = &slot-counter, the cell below )
03AE0200 ,   \ lw    t3, 0(t0)          ( t3 = k = next free slot )
B71E0000 ,   \ lui   t4, 0x1            ( t4 = 4096 = region capacity, in cells )
6362DE05 ,   \ bltu  t3, t4, +68        ( k < 4096 -> ok; else fall into abort )
abort        \ too many variables -> compile error (16-instr fragment)
930E1E00 ,   \ addi  t4, t3, 1          ( ok: )
23A0D201 ,   \ sw    t4, 0(t0)          ( slot-counter = k + 1 )
93122E00 ,   \ slli  t0, t3, 2          ( t0 = 4k )
371F0000 ,   \ lui   t5, 0x1            ( t5 = 0x1000 = VARBASE offset from s10 )
B382E201 ,   \ add   t0, t0, t5         ( t0 = C = 0x1000 + 4k )
930F1000 ,   \ addi  t6, x0, 1
939FBF00 ,   \ slli  t6, t6, 11         ( t6 = 0x800 )
3383F201 ,   \ add   t1, t0, t6         ( C + 0x800 )
1353C300 ,   \ srli  t1, t1, 12         ( t1 = %hi )
9313C300 ,   \ slli  t2, t1, 12
B3837240 ,   \ sub   t2, t0, t2         ( t2 = %lo, signed )
130E1000 ,   \ addi  t3, x0, 1
131ECE00 ,   \ slli  t3, t3, 12
130EFEFF ,   \ addi  t3, t3, -1         ( t3 = 0xFFF )
B3F3C301 ,   \ and   t2, t2, t3         ( mask %lo to 12 bits )
931EC300 ,   \ slli  t4, t1, 12         ( emit: lui t1, %hi )
130F7033 ,   \ addi  t5, x0, 0x337
B3EEEE01 ,   \ or    t4, t4, t5
23A0D101 ,   \ sw    t4, 0(gp)
93814100 ,   \ addi  gp, gp, 4
939E4301 ,   \ slli  t4, t2, 20         ( emit: addi t1, t1, %lo )
370F0300 ,   \ lui   t5, 0x30
130F3F31 ,   \ addi  t5, t5, 0x313
B3EEEE01 ,   \ or    t4, t4, t5
23A0D101 ,   \ sw    t4, 0(gp)
93814100 ,   \ addi  gp, gp, 4
B70E6D00 ,   \ lui   t4, 0x6D0          ( emit: add t1, s10, t1  = 0x006D0333 )
938E3E33 ,   \ addi  t4, t4, 0x333
23A0D101 ,   \ sw    t4, 0(gp)
93814100 ,   \ addi  gp, gp, 4
B70EC1FF ,   \ lui   t4, 0xFFC10        ( emit: addi sp, sp, -4 )
938E3E11 ,   \ addi  t4, t4, 0x113
23A0D101 ,   \ sw    t4, 0(gp)
93814100 ,   \ addi  gp, gp, 4
B72E6100 ,   \ lui   t4, 0x612          ( emit: sw t1, 0(sp) )
938E3E02 ,   \ addi  t4, t4, 0x23
23A0D101 ,   \ sw    t4, 0(gp)
93814100 ,   \ addi  gp, gp, 4
6F008000 ,   \ jal   x0, +8             ( jump over the counter cell )
00000000 ,   \ slot-counter ( compile-time only; never emitted to the output )
;

