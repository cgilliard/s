83220100 ,   \ lw t0,0(sp)
03234100 ,   \ lw t1,4(sp)
B3025300 ,   \ add t0,t1,t0
13014100 ,   \ addi sp,sp,4
23205100 ,   \ sw t0,0(sp)
;
