\ ============================================================
\ lib/bench.fam — `--bench` bench-harness header.
\ Prepended by `./tools/fam --bench` AFTER the stdlib, BEFORE the user
\ source(s).  Runs ONLY the Bench { name { code } ... } blocks — top-level
\ main is skipped and Test { ... } blocks are consumed (as lib/build.fam
\ does) — and prints one timing line per named body:
\   bench <name> ... <ticks> tk[, <n> ns/op]     (or: ... [skipped])
\ Each body runs ONCE and is timed with the CLINT mtime (10 MHz, 100 ns/tick):
\ put the iteration loop INSIDE the body and end it with `N lit bops` to get
\ the ns/op figure (ns/op stays exact for bodies up to ~7 min).  Setup /
\ teardown: `bgo` restarts the clock (call it after setup), `bstop` freezes
\ the elapsed time (call it before teardown) — code outside the bgo..bstop
\ window runs unmeasured.  Both are optional; default = whole body.  asrt_eq /
\ assert work as in --test (sanity checks; first failure halts).  The
\ compile-time plumbing (Bench/{/}/_tend/_skip) is byte-for-byte lib/test.fam
\ machinery — regenerate this file from test.fam if that ever changes.
\ ============================================================

\ bname ( -- addr ) current bench's name.  bcount ( -- addr ) counter.
: bname  variable ;
: bcount variable ;
: bstart variable ;   \ mtime (ticks) at the first bench (drives the summary)
: b0     variable ;   \ mtime (ticks) when the current body started
: bopn   variable ;   \ ops in the current body (0 = no ns/op line)
: bskf   variable ;   \ nonzero = body declared itself skipped (via bskip)
: btf    variable ;   \ nonzero = bt was frozen by bstop (teardown not timed)
: bt     variable ;   \ scratch: elapsed ticks of the finished body

\ _now ( -- ticks )  RUNTIME: read the machine timer low word (CLINT mtime @
\        0x0200BFF8). QEMU virt ticks at 10 MHz (100 ns/tick).
: _now
	B7C20002 ,   \ lui  t0, 0x0200C
	03A382FF ,   \ lw   t1, -8(t0)         ( mtime low @ 0x0200BFF8 )
	1301C1FF ,   \ addi sp, sp, -4
	23206100 ,   \ sw   t1, 0(sp)
;

\ _elapsed ( -- )  RUNTIME: print (now - bstart) as "S.CCs" (10 MHz timebase).
: _elapsed
	_now bstart @ -                    \ delta ticks
	dup 989680 lit / u.               \ whole seconds
	2E lit putc                       \ '.'
	989680 lit % 186A0 lit /          \ centiseconds (0..99)
	dup 0A lit u< if 30 lit putc then \ leading zero
	u.
	73 lit putc                       \ 's'
;

\ ANSI colour helpers:  _red = ESC[31m   _yel = ESC[33m   _rst = ESC[0m
: _red 1B lit putc 5B lit putc 33 lit putc 31 lit putc 6D lit putc ;
: _yel 1B lit putc 5B lit putc 33 lit putc 33 lit putc 6D lit putc ;
: _rst 1B lit putc 5B lit putc 30 lit putc 6D lit putc ;

\ _bprev ( -- )  report the just-finished bench: name, then either a yellow
\ [skipped] (body called bskip) or total ticks and — when the body declared
\ its op count via bops — an exact ns/op figure computed as
\ (t/n)*100 + (t%n)*100/n (no 32-bit overflow for any body under ~7 min).
\ bt is measured now-b0 unless bstop already froze it.
: _bprev
	btf @ 0= if _now b0 @ - bt ! then
	"bench " puts bname @ puts " ... " puts
	bskf @ if
		_yel "[skipped]" puts _rst
	else
		bt @ u. " tk" puts
		bopn @ 0 lit > if
			", " puts
			bt @ bopn @ / 64 lit *              \ (t/n)*100
			bt @ bopn @ % 64 lit * bopn @ / +   \ + (t%n)*100/n
			u. " ns/op" puts
		then
	then
	0A lit putc
;

\ bops ( n -- )  declare how many operations the current body performed.
: bops bopn ! ;

\ bskip ( -- )  declare the current body skipped (e.g. required device absent):
\ its report line shows a yellow [skipped] instead of a meaningless time.
: bskip 1 lit bskf ! ;

\ bgo ( -- )  restart the clock: call after setup so it isn't measured.
: bgo _now b0 ! ;

\ bstop ( -- )  freeze the elapsed time: call before teardown so it isn't
\ measured.  bgo..bstop bound the measured window; both default to the body.
: bstop _now b0 @ - bt ! 1 lit btf ! ;

\ _fail  ( -- )  RUNTIME: report the current bench FAILED and exit 1.
: _fail
	"bench " puts bname @ puts " ... " puts _red "FAILED" puts _rst 0A lit putc
	0A lit putc
	"bench result: " puts _red "FAILED" puts _rst 0A lit putc
	B7021000 ,   \ lui  t0, 0x100           ( SiFive finisher )
	37330100 ,   \ lui  t1, 0x13
	13033333 ,   \ addi t1, t1, 0x333       ( 0x00013333 = FAIL -> exit 1 )
	23A06200 ,   \ sw   t1, 0(t0)
	6F000000 ,   \ jal  x0, .               ( spin )
;

\ asrt_eq ( actual expected -- )  fail unless equal.
: asrt_eq <> if _fail then ;

\ assert  ( flag -- )  fail unless flag is non-zero.
: assert 0= if _fail then ;

\ _tdone ( -- )  RUNTIME: report the last bench, then the summary.  Reached by
\        a call after `_tend`, and must NOT return.
: _tdone
	bcount @ if _bprev then
	0A lit putc
	"bench result: " puts
	bcount @ u.
	" benches; finished in " puts
	_elapsed
	0A lit putc
	bye
;

