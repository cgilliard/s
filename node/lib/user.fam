\ ============================================================
\ lib/user.fam — the stdlib's part for a program the OS runs (docs/OS.md),
\ in place of lib/mach.fam (`tools/fam --user`): the program runs in user
\ mode, where the devices and the machine's registers are out of reach, so
\ its I/O and its exit are system calls, and its stacks are in the memory
\ the kernel gives it.
\
\ System calls: the number in a7, the arguments in a0-a2, `ecall`, the
\ result in a0 (negative: an error).  1 exit(code), 2 spawn, 3 wait,
\ 4 thread, 5 thread_exit, 6 join, 7 yield, 8 sleep, 9 lock, 10 unlock,
\ 11 await, 12 wake (below), 16 read(fd, buf, n), 17 write(fd, buf, n).
\
\ At the start the kernel gives the program, in a0 and a1, the first byte of
\ its memory and the byte past it (page-aligned).  The layout there, as
\ lib/mach.fam's over RAM: return ids (4 KiB), variables (16 KiB), the heap
\ upward from there, the data stack down from 4 KiB below the end, the loop
\ frames' stack in that last 4 KiB.
\ ============================================================

\ sys ( a0 a1 a2 number -- result )  any system call of up to three
\ arguments.
: sys
83280100 ,   \ lw a7,0(sp)
03264100 ,   \ lw a2,4(sp)
83258100 ,   \ lw a1,8(sp)
0325C100 ,   \ lw a0,12(sp)
1301C100 ,   \ addi sp,sp,12
73000000 ,   \ ecall
2320A100 ,   \ sw a0,0(sp)
;

\ bye ( -- )  the program ends: exit(0).
: bye
13050000 ,   \ addi a0,zero,0
93081000 ,   \ addi a7,zero,1
73000000 ,   \ ecall
6F000000 ,   \ jal zero,.
;

\ putc ( c -- )  write(1, the byte, 1); the byte is the stack's top word's
\ first (little-endian).
: putc
93050100 ,   \ addi a1,sp,0
13051000 ,   \ addi a0,zero,1
13061000 ,   \ addi a2,zero,1
93081001 ,   \ addi a7,zero,17
73000000 ,   \ ecall
13014100 ,   \ addi sp,sp,4
;

\ puts ( addr -- )  a NUL-terminated string, in one write.
: puts
83250100 ,   \ lw a1,0(sp)
13014100 ,   \ addi sp,sp,4
93820500 ,   \ addi t0,a1,0
03C30200 ,   \ lbu t1,0(t0)               length:
63060300 ,   \ beq t1,zero,done
93821200 ,   \ addi t0,t0,1
6FF05FFF ,   \ jal zero,length
3386B240 ,   \ sub a2,t0,a1               done:
13051000 ,   \ addi a0,zero,1
93081001 ,   \ addi a7,zero,17
73000000 ,   \ ecall
;

\ u. ( u -- )  an unsigned decimal.
: u.  dup A lit u< if 30 lit + putc else dup A lit / u. A lit % 30 lit + putc then ;

\ . ( n -- )  a signed decimal.
: .  dup 0< if 2D lit putc 0 lit swap - then u. ;

\ u.x ( u -- )  8 hex digits.
: u.x  8 lit 0 lit do dup 1C lit rshift dup A lit u< if 30 lit + else 37 lit + then putc 4 lit lshift loop drop ;

\ getc ( -- ch )  read(0, a byte, 1): the byte, or -1 if none came.
:M getc
1301C1FF ,   \ addi sp,sp,-4
23200100 ,   \ sw zero,0(sp)
93050100 ,   \ addi a1,sp,0
13050000 ,   \ addi a0,zero,0
13061000 ,   \ addi a2,zero,1
93080001 ,   \ addi a7,zero,16
73000000 ,   \ ecall
93021000 ,   \ addi t0,zero,1
63065500 ,   \ beq a0,t0,got
9302F0FF ,   \ addi t0,zero,-1
23205100 ,   \ sw t0,0(sp)
;                            \ got:

\ ── Processes and threads (docs/OS.md, section 5) ──

: exit    0 lit 0 lit 1 lit sys drop ;       \ ( code -- )  this process ends
: spawn   0 lit 0 lit 2 lit sys ;            \ ( name -- pid )  a child running that program
: wait    0 lit 3 lit sys ;                  \ ( pid status-addr -- pid )  a child's end (pid -1: any)
: thread  4 lit sys ;                        \ ( entry stack-top arg -- tid )  16 KiB below stack-top its own
: texit   0 lit 0 lit 5 lit sys drop ;       \ ( value -- )  this thread ends
: join    0 lit 0 lit 6 lit sys ;            \ ( tid -- value )
: yield   0 lit 0 lit 0 lit 7 lit sys drop ;
: sleep   0 lit 0 lit 8 lit sys drop ;       \ ( ns -- )
: lock    0 lit 0 lit 9 lit sys drop ;       \ ( addr -- )  a mutex: the word at addr, 0 free
: unlock  0 lit 0 lit A lit sys drop ;       \ ( addr -- )
: await   B lit sys ;                        \ ( addr expected ns -- r )  0; -11 not expected; -110 time ran out
: wake    0 lit C lit sys ;                  \ ( addr n -- woken )

\ tcode[ ... ]tcode ( -- entry )  a thread's code, compiled where it is but
\ jumped over; its address left for `thread`.  It runs on its own stacks
\ (the variables and the heap are shared), and ends with texit(0) if it
\ does not end itself.
:I [skip  here ,j0 ;
:I skip]  jpat! ;
:M tcode[
97020000 ,   \ auipc t0,0x0
93824201 ,   \ addi t0,t0,20              ( the code past the jump )
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
[skip ;
:M ]tcode  0 lit texit skip] ;

\ The start: the stacks and the heap in the memory given (a0, a1).
130D0500 ,   \ addi s10,a0,0              ( return ids from the start )
B7120000 ,   \ lui t0,0x1
B30D5500 ,   \ add s11,a0,t0              ( growing down from 4 KiB on )
B7520000 ,   \ lui t0,0x5
B3015500 ,   \ add gp,a0,t0               ( the heap, past the variables )
138C0500 ,   \ addi s8,a1,0               ( loop frames, down from the end )
B7120000 ,   \ lui t0,0x1
33815540 ,   \ sub sp,a1,t0               ( the data stack, down from 4 KiB below it )
