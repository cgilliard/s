\ ────────────────────────────────────────────────────────────────
\ lib/asm.fam — RV32I mini-assembler primitives
\
\ Layer 1 below the high-level stdlib words. Lets fam programs
\ emit individual RV32I instructions inline using natural
\ assembler-like syntax. Originally machine-generated (the
\ generator is gone); maintained by hand now.
\
\ Calling convention (cstack source order, bottom-to-top):
\   I-type:  imm rs1 rd  OP    (addi, andi, slli, srli, lw, lbu)
\   R-type:  rs2 rs1 rd  OP    (add, sub, _or) — `A B C sub` =
\                              `sub C, B, A` so C = B - A
\   S-type:  imm rs2 rs1 OP    (sw, sb)
\   U-type:  imm rd      OP    (lui)
\
\ Register-name :I words push the register's number to cstack:
\   zr=0  sp=2  gp=3  t0=5  t1=6  t2=7  s5..s11=21..27
\   t3..t6=28..31  a0..a3=10..13  s6=22
\ ────────────────────────────────────────────────────────────────

\ ── Register names (push number to cstack at compile time) ──
:I zr    \ pushes 0 (0x0)
1302C2FF ,   \ addi tp,tp,-4
93020000 ,   \ li t0,0
23205200 ,   \ sw t0,0(tp)
;

:I sp    \ pushes 2 (0x2)
1302C2FF ,   \ addi tp,tp,-4
93022000 ,   \ li t0,2
23205200 ,   \ sw t0,0(tp)
;

:I gp    \ pushes 3 (0x3)
1302C2FF ,   \ addi tp,tp,-4
93023000 ,   \ li t0,3
23205200 ,   \ sw t0,0(tp)
;

:I t0    \ pushes 5 (0x5)
