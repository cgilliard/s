#!/usr/bin/env bash
# serial_pump PORT IN OUT [LOG] — pump for QEMU's TCP serial chardev, in pure bash.
#
# Connects to 127.0.0.1:PORT (retrying while QEMU starts up), streams file IN
# into the socket (IN = "-" means no input), and writes everything received
# to file OUT (OUT = "-": to stdout, as inherited, never reopened) until QEMU
# closes the connection (guest exit).  LOG is the chardev's logfile, QEMU's
# own copy of the output: whatever of it never came over the socket is
# written after.  Used where
# file-backed serial isn't available: QEMU's win32 build rejects
# `-chardev file,input-path=...`, and its win32 stdio chardev loses bytes on
# piped stdin.  The socket chardev behaves identically on every platform, so
# this path is also testable on Linux via FAM_SERIAL=socket.
#
# Deliberately bash, not sh: /dev/tcp redirections are a bash feature, and
# bash's non-POSIX mode lets a failed `exec 3<>` return instead of killing
# the shell, which is what makes the connect-retry loop possible.  No other
# dependencies — the build chain stays shell + qemu only.

port=$1; in=$2; out=$3; log=$4

# Retried for 60 s, by the clock: on Windows a refused connect itself takes
# a second or two, and QEMU can be slow to start on a loaded runner.
start=$SECONDS
until { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null; do
	if [ $((SECONDS - start)) -ge 60 ]; then
		echo "serial_pump: cannot connect to qemu on port $port" >&2
		exit 1
	fi
	sleep 0.1
done

# Read errors are treated as EOF: on Windows, qemu's exit closes the socket
# with RST (WinError 10054), not FIN, and a reset discards what had arrived
# but was not yet read: the guest's last bytes, written just before it
# exits.  QEMU writes each byte to LOG before the guest goes on, so by the
# close LOG holds all of it, and the socket's bytes are a prefix of it: the
# rest of LOG, past what came, is what was lost.  Output still streams as
# it comes; only the end can come late.  Correctness is enforced
# downstream too: qemu's exit code carries the guest verdict, and every
# consumer checks its output (fam0 cmp, the 13000000 magic).
[ "$in" != "-" ] && cat "$in" >&3 2>/dev/null &
if [ -z "$log" ]; then
	if [ "$out" = "-" ]; then cat <&3 2>/dev/null || :; else cat <&3 > "$out" 2>/dev/null || :; fi
	exit 0
fi
if [ "$out" = "-" ]; then
	got="$log.got"
	{ cat <&3 2>/dev/null || :; } | tee "$got"
else
	got=$out
	cat <&3 > "$out" 2>/dev/null || :
fi
n=$(wc -c < "$got" | tr -d ' ')
if [ "$out" = "-" ]; then
	tail -c +$((n + 1)) "$log" 2>/dev/null
	rm -f "$got"
else
	tail -c +$((n + 1)) "$log" >> "$out" 2>/dev/null
fi
:
