\ storebench.fam — the store's benchmark (docs/OS.md, step 2): how fast
\ the store's core (src/store.fam) puts, gets, overwrites, deletes and
\ scans, and what a commit costs, on a bare machine with virtio-blk.  Run
\ by scripts/storebench.sh.  Keys are 32 bytes, values 64; every value got
\ is checked, so a wrong store cannot pass for a fast one.

:M BN 186A0 lit ;            \ 100,000 entries

: kbuf  variable ;  : vbuf variable ;  : gb variable ;
: t0    variable ;
: bcnt  variable ;  : bsize variable ;
: T variable ;  : nw0 variable ;  : nc0 variable ;

\ bswap ( x -- y )  bytes reversed: a counter, big-endian, sorts as keys.
: bswap
dup 18 lit rshift
over 8 lit rshift FF00 lit and or
over 8 lit lshift FF0000 lit and or
swap 18 lit lshift or ;

\ mix ( x -- y )  two rounds of xorshift: keys scattered over the tree.
: mix
9E3779B9 lit xor
dup D lit lshift xor dup 11 lit rshift xor dup 5 lit lshift xor
dup D lit lshift xor dup 11 lit rshift xor dup 5 lit lshift xor ;

: krand  8 lit 0 lit do dup 3 lit lshift i or mix kbuf @ i 2 lit lshift + ! loop drop ;  \ ( i -- )
: kseq   kbuf @ 20 lit mzero bswap kbuf @ ! ;                                          \ ( i -- )
: mkval  10 lit 0 lit do dup i xor vbuf @ i 2 lit lshift + ! loop drop ;               \ ( i -- )

\ The transaction's key and value from kbuf and vbuf.
: kx  kbuf @ XKEY xa 20 lit mcpy  20 lit XKLEN x! ;
: vx  vbuf @ XVAL xa 40 lit mcpy  40 lit XVLEN x! ;
: put  kx vx tput 0= if "a put failed" panic then tunpin ;
: get  kx gb @ 40 lit tget tunpin ;                  \ ( -- n | -1 )

\ check ( i -- )  key i (random) holds value i.
: check
dup krand get
40 lit <> if "a key put is missing" panic then
gb @ @ <> if "a value got is not the one put" panic then ;

\ Transactions: a writer always open; op1 commits every bsize operations.
: wbeg  T @ 2 lit tbegin 0= if "no transaction" panic then ;
: wend  tcommit if "a commit failed" panic then ;
: batch  dup bsize ! bcnt ! ;
: op1    bcnt @ 1 lit - dup bcnt ! 0= if wend wbeg bsize @ bcnt ! then ;
: fresh  tcreate topen dup T ! 0= if "no tree" panic then ;   \ a new, empty tree

: tstart  mtime@ t0 !  T @ TNW t@ nw0 !  T @ TNC t@ nc0 ! ;

\ entries ( -- n )  walked with next, in a reader.
: entries
T @ 1 lit tbegin drop
0 lit XKLEN x!  0 lit
begin gb @ tnext dup 0< 0= while dup XKLEN x!  gb @ XKEY xa rot bcpy  1 lit +  tunpin repeat
drop tcommit drop ;
: count  T @ TCNT t@ ;

\ report ( ops name -- )
: report
mtime@ t0 @ - 2710 lit /
swap "BENCH " puts puts ": " puts
over u. " ops in " puts dup u. " ms, " puts
?dup if over 3E8 lit * swap / u. " ops/s" puts else ">1000000 ops/s" puts then drop
"; " puts T @ TNW t@ nw0 @ - u. " pages written in " puts T @ TNC t@ nc0 @ - u. " commits" puts 0A lit putc ;

: main
40 lit alloc kbuf !  40 lit alloc vbuf !  400 lit alloc gb !
"storebench: " puts BN u. " entries, 32-byte keys, 64-byte values, "
puts NSLOT 8 lit rshift u. " MiB cache" puts
bflush @ if ", flushed" else ", no flush (the device offers none)" then puts 0A lit putc

\ Keys in order, into an empty tree.
fresh 2710 lit batch tstart wbeg
BN 0 lit do i kseq i mkval put op1 loop wend
BN "seq_put (10000 a commit)" report

\ Keys scattered, into an empty tree: the tree the rest works on.
fresh 2710 lit batch tstart wbeg
BN 0 lit do i krand i mkval put op1 loop wend
BN "rand_put (10000 a commit)" report
count BN <> if "the tree holds the wrong number of entries" panic then

tstart T @ 1 lit tbegin drop
BN 0 lit do i check loop
tcommit drop BN "get, cached" report

cdrop tstart T @ 1 lit tbegin drop
2710 lit 0 lit do i 7 lit * check loop
tcommit drop 2710 lit "get, from disk" report

64 lit batch tstart wbeg
2710 lit 0 lit do i 9 lit * dup krand BN + mkval put op1 loop wend
2710 lit "overwrite (100 a commit)" report
T @ 1 lit tbegin drop
2710 lit 0 lit do i 9 lit * dup krand get drop gb @ @ swap BN + <> if "an overwrite was lost" panic then loop
tcommit drop

64 lit batch tstart wbeg
2710 lit 0 lit do i 9 lit * 1 lit + krand kx tdel 0= if "a key to delete was missing" panic then tunpin op1 loop wend
2710 lit "delete (100 a commit)" report

tstart
entries
dup BN 2710 lit - <> if "a scan counted the wrong number of entries" panic then
"scan" report

1 lit batch tstart wbeg
3E8 lit 0 lit do i BN + dup krand mkval put op1 loop wend
3E8 lit "put (1 a commit)" report

64 lit batch tstart wbeg
2710 lit 0 lit do i BN + 3E8 lit + dup krand mkval put op1 loop wend
2710 lit "put (100 a commit)" report

\ Everything put is still there.
T @ 1 lit tbegin drop
2710 lit 0 lit do i 9 lit * 2 lit + check loop
tcommit drop
count BN 2710 lit - 3E8 lit + 2710 lit + <> if "entries miscounted at the end" panic then
entries count <> if "the final scan disagrees" panic then
"storebench: all checks passed" puts 0A lit putc
0 lit halt ;

trapinit area@ mhartid@ harea harr !
gp@ 10000 lit + FFF lit + FFFFF000 lit and 87F00000 lit pginit
1 lit stmount
main
