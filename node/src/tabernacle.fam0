# The other harts all leave 0x80000000 (where they started, and where the
# image will be written) on their way to wait at 0x87FF1F00, each marking
# its mailbox as it goes; under QEMU, with more harts than the host has
# cores, one may take a while to be run at all, and one that runs only
# after the image is written there runs a half-written image and is lost.
# So wait for all of them: as many as the device tree QEMU puts at
# 0x87E00000 has cpu@ nodes (the kernel's fdtharts), up to 960 (harts past
# the mailboxes make no mark), for 60 s at most against a hang.  With no
# device tree, until 100 ms pass with no new mark (a slow host can make
# that too short; QEMU always gives one).
# settle:
#         jal     t6, fdt_harts           # a4 = the harts, 0 if no tree
EF 0F 40 09	# jal t6,1254 <fdt_harts>
#         li      t0, 960
93 02 00 3C	# li t0,960
#         bleu    a4, t0, 5f
63 F4 E2 00	# bgeu t0,a4,11d0 <.L5^B2>
#         mv      a4, t0
13 87 02 00	# mv a4,t0
# 5:      addi    a4, a4, -1              # marks to wait for (hart 0 makes none)
13 07 F7 FF	# addi a4,a4,-1
#         li      t5, MTIME
37 CF 00 02	# lui t5,0x200c
13 0F 8F FF	# addi t5,t5,-8 # 200bff8 <MTIME>
#         lw      a5, 0(t5)               # when the wait began
83 27 0F 00	# lw a5,0(t5)
#         lw      t6, 0(t5)               # since the last new mark
83 2F 0F 00	# lw t6,0(t5)
#         li      a2, 0                   # marks seen
13 06 00 00	# li a2,0
# 1:      li      t0, 0x87FF1000
B7 12 FF 87	# lui t0,0x87ff1
#         li      t1, 0x87FF1F00
37 23 FF 87	# lui t1,0x87ff2
13 03 03 F0	# addi t1,t1,-256 # 87ff1f00 <STACK+0xd1f00>
#         li      a3, 0
93 06 00 00	# li a3,0
# 2:      lw      t2, 0(t0)
83 A3 02 00	# lw t2,0(t0) # 87ff1000 <STACK+0xd1000>
#         addi    t2, t2, -1
93 83 F3 FF	# addi t2,t2,-1
#         bnez    t2, 3f
63 94 03 00	# bnez t2,1208 <.L3^B10>
#         addi    a3, a3, 1
93 86 16 00	# addi a3,a3,1
# 3:      addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
#         bltu    t0, t1, 2b
E3 E6 62 FE	# bltu t0,t1,11f8 <.L2^B14>
#         bltz    a4, 6f                  # no tree: the quiet rule
63 40 07 02	# bltz a4,1230 <.L6^B1>
#         bgeu    a3, a4, 7f              # every hart marked
63 FC E6 00	# bgeu a3,a4,122c <.L7^B1>
#         lw      t4, 0(t5)
83 2E 0F 00	# lw t4,0(t5)
#         sub     t4, t4, a5
B3 8E FE 40	# sub t4,t4,a5
#         li      t3, TICK * 60
37 4E C3 23	# lui t3,0x23c34
13 0E 0E 60	# addi t3,t3,1536 # 23c34600 <VIRTIO+0x13c33600>
#         bltu    t4, t3, 1b
E3 E0 CE FD	# bltu t4,t3,11e8 <.L1^B22>
# 7:      ret
67 80 00 00	# ret
# 6:      beq     a3, a2, 4f
63 86 C6 00	# beq a3,a2,123c <.L4^B3>
#         mv      a2, a3
13 86 06 00	# mv a2,a3
#         lw      t6, 0(t5)
83 2F 0F 00	# lw t6,0(t5)
# 4:      lw      t4, 0(t5)
83 2E 0F 00	# lw t4,0(t5)
#         sub     t4, t4, t6
