13 00 00 00	# nop  (q32 magic; prepended like scripts/build.sh)

# tabernacle -- the fam node's boot program (docs/TABERNACLE.md).
#
# Runs the node image from the virtio-blk disk if the disk holds it, else
# fetches it from the network, one peer at a time; either way only an image
# of the patched-in size and Gimli-Hash is run.  The image is placed at
# 0x80000000, where q32 would load it, so tabernacle first moves itself to
# RELOC (its code is position-independent) and runs from there.
#
# Converted to src/tabernacle.fam0 by tools/s2fam0_fam.py, which prepends
# the q32 magic (a nop): this file's first instruction runs at 0x80000004.
#
# Registers kept throughout:
#   s0 = VARS   s1 = virtio-net base (0: none)   s2 = time discovery began
#   s3 = now (read once a pass of the main loop)  s4 = the patched config
# Functions take a0-a2, return a0, and may clobber t0-t6 and a0-a5; one that
# uses s5-s11 saves them.  Calls are jal ra / ret; sp is a small stack.
# ---------------------------------------------------------------------------

# .option norelax
# .altmacro

# .macro LOAD_ADDRESS reg, label
# _base\@:
#         .equ _offset\@, (\label - _base\@)
#         auipc   \reg, %hi(_offset\@)
#         addi    \reg, \reg, %lo(_offset\@)
# .endm

# .macro PUSH r0, r1=zero, r2=zero, r3=zero
#         addi    sp, sp, -16
#         sw      \r0, 0(sp)
#         sw      \r1, 4(sp)
#         sw      \r2, 8(sp)
#         sw      \r3, 12(sp)
# .endm

# .macro POP r0, r1=zero, r2=zero, r3=zero
#         lw      \r0, 0(sp)
#         .ifnc \r1, zero
#         lw      \r1, 4(sp)
#         .endif
#         .ifnc \r2, zero
#         lw      \r2, 8(sp)
#         .endif
#         .ifnc \r3, zero
#         lw      \r3, 12(sp)
#         .endif
#         addi    sp, sp, 16
# .endm

# --- memory -----------------------------------------------------------------
# .equ IMAGE,     0x80000000      # the node image, where q32 would load it
# .equ RELOC,     0x87F00000      # tabernacle, moved
# .equ RXQ,       0x87F10000      # virtqueues: two pages each (legacy layout)
# .equ TXQ,       0x87F12000
# .equ BLKQ,      0x87F14000
# .equ RXBUF,     0x87F16000      # QN receive buffers of 2 KiB
# .equ TXBUF,     0x87F1A000      # one transmit buffer
# .equ BLKHDR,    0x87F1A800      # a disk request's header; its status at +16
# .equ PEERS,     0x87F1B000      # MAXPEERS entries of 32 bytes
# .equ VARS,      0x87F1C000
# .equ STACK,     0x87F20000
# .equ SEEDS,     0x87FFF000      # from scripts/node.sh: count u8, then
                                # 4 address bytes and a port (u16 LE) each

# --- devices (QEMU virt) ----------------------------------------------------
# .equ UART,      0x10000000
# .equ FINISHER,  0x00100000
# .equ MTIME,     0x0200BFF8      # 10 MHz
# .equ VIRTIO,    0x10001000      # 8 virtio-mmio slots, 0x1000 apart
# .equ QN,        8               # entries per virtqueue

# --- network ----------------------------------------------------------------
# .equ MYIP,      0x0F02000A      # 10.0.2.15, QEMU user networking's guest
# .equ GWIP,      0x0202000A      # 10.0.2.2, its gateway
# .equ PORT,      3737
# .equ MAGIC,     0x31424154      # "TAB1"
# .equ T_PING, 1
# .equ T_PONG, 2
# .equ T_GET_PEERS, 3
# .equ T_PEERS, 4
# .equ T_GET_IMAGES, 64
# .equ T_IMAGES, 65
# .equ T_GET_IMAGE, 66
# .equ T_IMAGE_CHUNK, 67
# .equ PAYLOAD,   TXBUF + 52      # virtio header 10, Ethernet 14, IP 20, UDP 8
# .equ MAXPEERS,  64
# .equ BATCH,     32              # chunks asked for at once
# .equ TICK,      10000000        # 1 s: retries, and a download's patience
# .equ WAIT,      100000000       # 10 s before the seeds are asked for the image

# --- VARS -------------------------------------------------------------------
# .equ V_MAC, 0           # ours (6)
# .equ V_GW, 8            # the gateway's (6)
# .equ V_GWOK, 16         # nonzero once known
# .equ V_RXSEEN, 20       # used receive entries handled
# .equ V_RXAV, 24         # receive buffers handed to the device
# .equ V_TXAV, 28         # frames sent
# .equ V_ARPT, 32         # when ARP last asked for the gateway
# .equ V_NPEERS, 36
# .equ V_CUR, 40          # the peer downloading from (0: none)
# .equ V_BASE, 44         # first chunk of the batch
# .equ V_MASK, 48         # chunks of the batch arrived
# .equ V_N, 52            # chunks in the batch
# .equ V_LAST, 56         # when the batch last moved
# .equ V_STRIKES, 60      # times it did not, in a row
# .equ V_NCHUNKS, 64
# .equ V_BLK, 68          # virtio-blk base (0: none)
# .equ V_BLKAV, 72        # disk requests made
# .equ V_RAND, 76         # rand_peer's state, stirred by each frame's arrival time
# .equ V_HS, 80           # the hash state (48)
# .equ V_SIZE, 128

# --- a peer -----------------------------------------------------------------
# .equ P_IP, 0            # 4 address bytes, as get32le reads them
# .equ P_PORT, 4          # u16
# .equ P_SEED, 6          # 1 for a seed
# .equ P_STATE, 7         # 0 pinging, 1 asking, 2 has our image, 3 done, 4 dropped
# .equ P_TOKEN, 8         # what its Pong gave us (8)
# .equ P_LAST, 16         # when last asked
# .equ P_TRIES, 20

# ===========================================================================
# Harts other than 0 wait, before anything else (docs/OS.md, section 3; the
# same sequence, word for word, as lib/stdlib.fam's): each copies the wait
# loop to 0x87FF1F00, marks its mailbox word (0x87FF1000 + 4*hartid) present,
# and sleeps there until the OS writes it a record to go to.  Hart 0 boots.
# _start:
#         csrr    t0, mhartid
F3 22 40 F1	# csrr t0,mhartid
#         beqz    t0, park_go
63 86 02 08	# beqz t0,90 <_base0>
# park_here:
#         auipc   t1, 0
17 03 00 00	# auipc t1,0x0
#         addi    t1, t1, 96              # park_code (the assembler takes no
13 03 03 06	# addi t1,t1,96 # 68 <park_code>
#         li      t2, 0x87FF1F00          #   forward difference here)
B7 23 FF 87	# lui t2,0x87ff2
93 83 03 F0	# addi t2,t2,-256 # 87ff1f00 <STACK+0xd1f00>
#         li      t3, 10                  # its words
13 0E A0 00	# li t3,10
# 1:      lw      t4, 0(t1)
83 2E 03 00	# lw t4,0(t1)
#         sw      t4, 0(t2)
23 A0 D3 01	# sw t4,0(t2)
#         addi    t1, t1, 4
13 03 43 00	# addi t1,t1,4
#         addi    t2, t2, 4
93 83 43 00	# addi t2,t2,4
#         addi    t3, t3, -1
13 0E FE FF	# addi t3,t3,-1
#         bnez    t3, 1b
E3 16 0E FE	# bnez t3,1c <.L1^B1>
#         li      t2, 0x87FF1F00
B7 23 FF 87	# lui t2,0x87ff2
93 83 03 F0	# addi t2,t2,-256 # 87ff1f00 <STACK+0xd1f00>
#         li      t1, 960
13 03 00 3C	# li t1,960
#         bgeu    t0, t1, park_many
63 F0 62 02	# bgeu t0,t1,60 <park_many>
#         slli    t0, t0, 2               # its mailbox word
93 92 22 00	# slli t0,t0,0x2
#         li      t1, 0x87FF1000
37 13 FF 87	# lui t1,0x87ff1
#         add     t0, t0, t1
B3 82 62 00	# add t0,t0,t1
#         li      t1, 1                   # present
13 03 10 00	# li t1,1
#         sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
#         fence
0F 00 F0 0F	# fence
#         jr      t2
67 80 03 00	# jr t2
# park_many:
#         addi    t2, t2, 32              # a hart id past the mailboxes: sleep
93 83 03 02	# addi t2,t2,32
#         jr      t2
67 80 03 00	# jr t2
# park_code:                              # (copied to 0x87FF1F00)
#         li      t1, 8                   # software interrupts wake wfi
13 03 80 00	# li t1,8
#         csrs    mie, t1
73 20 43 30	# csrs mie,t1
# 2:      wfi
73 00 50 10	# wfi
#         lw      a0, 0(t0)
03 A5 02 00	# lw a0,0(t0)
#         li      t1, 1
13 03 10 00	# li t1,1
#         bgeu    t1, a0, 2b              # 0 or 1: not released yet
E3 7A A3 FE	# bgeu t1,a0,70 <.L2^B1>
#         lw      t1, 0(a0)               # the record's first word: where to go
03 23 05 00	# lw t1,0(a0)
#         jr      t1
67 00 03 00	# jr t1 # 87ff1000 <STACK+0xd1000>
# park_dead:
#         wfi
73 00 50 10	# wfi
#         j       park_dead
6F F0 DF FF	# j 88 <park_dead>
# park_go:
# Move to RELOC and go on there.
#         LOAD_ADDRESS t0, _start
97 02 00 00	# auipc t0,0x0
93 82 02 F7	# addi t0,t0,-144 # 0 <_start>
#         addi    t0, t0, -4              # where we were loaded (the magic)
93 82 C2 FF	# addi t0,t0,-4
#         LOAD_ADDRESS t4, main
97 0E 00 00	# auipc t4,0x0
93 8E 4E 03	# addi t4,t4,52 # d0 <main>
#         sub     t4, t4, t0
B3 8E 5E 40	# sub t4,t4,t0
#         li      t2, RELOC
B7 03 F0 87	# lui t2,0x87f00
#         add     t4, t4, t2              # main, moved
B3 8E 7E 00	# add t4,t4,t2
#         LOAD_ADDRESS t1, _end
17 13 00 00	# auipc t1,0x1
13 03 03 7B	# addi t1,t1,1968 # 1860 <_end>
# 1:      lw      t3, 0(t0)
03 AE 02 00	# lw t3,0(t0)
#         sw      t3, 0(t2)
23 A0 C3 01	# sw t3,0(t2) # 87f00000 <RELOC>
#         addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
#         addi    t2, t2, 4
93 83 43 00	# addi t2,t2,4
#         bltu    t0, t1, 1b
E3 E8 62 FE	# bltu t0,t1,b8 <.L1^B2>
#         jr      t4
67 80 0E 00	# jr t4

# main:
#         li      sp, STACK
37 01 F2 87	# lui sp,0x87f20
#         li      s0, VARS
37 C4 F1 87	# lui s0,0x87f1c
#         li      s1, 0
93 04 00 00	# li s1,0
#         mv      a0, s0
13 05 04 00	# mv a0,s0
#         li      a1, V_SIZE
93 05 00 08	# li a1,128
#         jal     zero_bytes
EF 10 40 4B	# jal 1598 <zero_bytes>
#         jal     settle
EF 10 80 0D	# jal 11c0 <settle>
#         LOAD_ADDRESS s4, cfg_version
17 1A 00 00	# auipc s4,0x1
13 0A CA 74	# addi s4,s4,1868 # 1838 <cfg_version>
#         lw      t0, 4(s4)
83 22 4A 00	# lw t0,4(s4)
#         LOAD_ADDRESS a0, msg_unpatched
17 15 00 00	# auipc a0,0x1
13 05 C5 71	# addi a0,a0,1820 # 1814 <msg_unpatched>
#         beqz    t0, fail                # size 0: never patched
63 84 02 16	# beqz t0,268 <fail>
#         addi    t0, t0, 1023
93 82 F2 3F	# addi t0,t0,1023
#         srli    t0, t0, 10
93 D2 A2 00	# srli t0,t0,0xa
#         sw      t0, V_NCHUNKS(s0)
23 20 54 04	# sw t0,64(s0) # 87f1c040 <VARS+0x40>

# --- the disk ----------------------------------------------------------------
#         li      a0, 2                   # virtio-blk
13 05 20 00	# li a0,2
#         jal     find_dev
EF 00 10 61	# jal f24 <find_dev>
#         sw      a0, V_BLK(s0)
23 22 A4 04	# sw a0,68(s0)
#         beqz    a0, net
63 00 05 04	# beqz a0,15c <net>
#         jal     dev_init
EF 00 10 64	# jal f60 <dev_init>
#         lw      a0, V_BLK(s0)
03 25 44 04	# lw a0,68(s0)
#         li      a1, 0
93 05 00 00	# li a1,0
#         li      a2, BLKQ
37 46 F1 87	# lui a2,0x87f14
#         jal     queue_init
EF 00 10 66	# jal f90 <queue_init>
#         lw      a0, V_BLK(s0)
03 25 44 04	# lw a0,68(s0)
#         jal     dev_ok
EF 00 D0 64	# jal f84 <dev_ok>
#         jal     disk_read
EF 00 90 74	# jal 1084 <disk_read>
#         bnez    a0, net
63 1E 05 00	# bnez a0,15c <net>
#         jal     check_image
EF 10 C0 20	# jal 1350 <check_image>
#         beqz    a0, net
63 0A 05 00	# beqz a0,15c <net>
#         LOAD_ADDRESS a0, msg_disk
17 15 00 00	# auipc a0,0x1
13 05 85 5F	# addi a0,a0,1528 # 1744 <msg_disk>
#         jal     puts
EF 10 00 4F	# jal 1644 <puts>
#         j       run
6F 00 C0 07	# j 1d4 <run>

# --- the network -------------------------------------------------------------
# net:
#         li      a0, 1                   # virtio-net
13 05 10 00	# li a0,1
#         jal     find_dev
EF 00 50 5C	# jal f24 <find_dev>
#         mv      s1, a0
93 04 05 00	# mv s1,a0
#         LOAD_ADDRESS a0, msg_nonet
17 15 00 00	# auipc a0,0x1
13 05 C5 68	# addi a0,a0,1676 # 17f4 <msg_nonet>
#         beqz    s1, fail
63 8C 04 0E	# beqz s1,268 <fail>
#         jal     net_init
EF 00 D0 63	# jal fb0 <net_init>
#         jal     now
EF 10 80 1C	# jal 1340 <now>
#         mv      s2, a0
13 09 05 00	# mv s2,a0
#         mv      s3, a0
93 09 05 00	# mv s3,a0
#         sw      a0, V_RAND(s0)          # QEMU's start-up jitter: the seeds' order
23 26 A4 04	# sw a0,76(s0)
#         li      a0, SEEDS
37 F5 FF 87	# lui a0,0x87fff
#         li      a1, 1
93 05 10 00	# li a1,1
#         jal     add_peers
EF 00 50 0D	# jal a64 <add_peers>
#         jal     arp_request
EF 00 10 43	# jal dc4 <arp_request>
# loop:
#         jal     poll_rx
EF 00 C0 42	# jal 5c4 <poll_rx>
#         jal     now
EF 10 40 1A	# jal 1340 <now>
#         mv      s3, a0
93 09 05 00	# mv s3,a0
#         lw      t0, V_GWOK(s0)
83 22 04 01	# lw t0,16(s0)
#         bnez    t0, 1f
63 90 02 02	# bnez t0,1c8 <.L1^B3>
#         lw      t1, V_ARPT(s0)          # no gateway yet: ask again each second
03 23 04 02	# lw t1,32(s0)
#         sub     t1, s3, t1
33 83 69 40	# sub t1,s3,t1
#         li      t2, TICK
B7 93 98 00	# lui t2,0x989
93 83 03 68	# addi t2,t2,1664 # 989680 <TICK>
#         bltu    t1, t2, loop
E3 6E 73 FC	# bltu t1,t2,198 <loop>
#         jal     arp_request
EF 00 50 40	# jal dc4 <arp_request>
#         j       loop
6F F0 5F FD	# j 198 <loop>
# 1:      jal     discover
EF 00 80 0B	# jal 280 <discover>
#         jal     download
EF 00 00 16	# jal 32c <download>
#         j       loop
6F F0 9F FC	# j 198 <loop>

# Hand over: devices reset (so nothing more is written to memory), the
# registers as QEMU's reset leaves them but t0, and on to the image.
# run:
#         beqz    s1, 1f
63 84 04 00	# beqz s1,1dc <.L1^B4>
#         sw      zero, 0x70(s1)
23 A8 04 06	# sw zero,112(s1)
# 1:      lw      t0, V_BLK(s0)
83 22 44 04	# lw t0,68(s0)
#         beqz    t0, 2f
63 84 02 00	# beqz t0,1e8 <.L2^B2>
#         sw      zero, 0x70(t0)
23 A8 02 06	# sw zero,112(t0)
# 2:      li      ra, 0
93 00 00 00	# li ra,0
#         li      sp, 0
13 01 00 00	# li sp,0
#         li      gp, 0
93 01 00 00	# li gp,0
#         li      tp, 0
13 02 00 00	# li tp,0
#         li      t1, 0
13 03 00 00	# li t1,0
#         li      t2, 0
93 03 00 00	# li t2,0
#         li      s0, 0
13 04 00 00	# li s0,0
#         li      s1, 0
93 04 00 00	# li s1,0
#         li      a0, 0
13 05 00 00	# li a0,0
#         li      a1, 0
93 05 00 00	# li a1,0
#         li      a2, 0
13 06 00 00	# li a2,0
#         li      a3, 0
93 06 00 00	# li a3,0
#         li      a4, 0
13 07 00 00	# li a4,0
#         li      a5, 0
93 07 00 00	# li a5,0
#         li      a6, 0
13 08 00 00	# li a6,0
#         li      a7, 0
93 08 00 00	# li a7,0
#         li      s2, 0
13 09 00 00	# li s2,0
#         li      s3, 0
93 09 00 00	# li s3,0
#         li      s4, 0
13 0A 00 00	# li s4,0
#         li      s5, 0
93 0A 00 00	# li s5,0
#         li      s6, 0
13 0B 00 00	# li s6,0
#         li      s7, 0
93 0B 00 00	# li s7,0
#         li      s8, 0
13 0C 00 00	# li s8,0
#         li      s9, 0
93 0C 00 00	# li s9,0
#         li      s10, 0
13 0D 00 00	# li s10,0
#         li      s11, 0
93 0D 00 00	# li s11,0
#         li      t3, 0
13 0E 00 00	# li t3,0
#         li      t4, 0
93 0E 00 00	# li t4,0
#         li      t5, 0
13 0F 00 00	# li t5,0
#         li      t6, 0
93 0F 00 00	# li t6,0
#         li      t0, IMAGE
B7 02 00 80	# lui t0,0x80000
#         jr      t0
67 80 02 00	# jr t0 # 80000000 <IMAGE>

# a0 = message: print it and exit 1.
# fail:
#         jal     puts
EF 10 C0 3D	# jal 1644 <puts>
#         li      t0, FINISHER
B7 02 10 00	# lui t0,0x100
#         li      t1, 0x13333             # exit 1
37 33 01 00	# lui t1,0x13
13 03 33 33	# addi t1,t1,819 # 13333 <_end+0x11ad3>
#         sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <FINISHER>
#         j       .
6F 00 00 00	# j 27c <fail+0x14>

# ===========================================================================
# Discovery: each peer still being asked is asked again each second, three
# times at most: a Ping until its Pong gives us its token, then GetPeers and
# GetImages until its Images says whether it has our image.  In table order,
# which add_peers keeps shuffled: the first to answer gets the download, so
# no peer is always asked first.
# discover:
#         PUSH    ra, s5, s6
13 01 01 FF	# addi sp,sp,-16 # 87f1fff0 <VARS+0x3ff0>
23 20 11 00	# sw ra,0(sp)
23 22 51 01	# sw s5,4(sp)
23 24 61 01	# sw s6,8(sp)
23 26 01 00	# sw zero,12(sp)
#         li      s5, PEERS
B7 BA F1 87	# lui s5,0x87f1b
#         lw      s6, V_NPEERS(s0)
03 2B 44 02	# lw s6,36(s0)
#         slli    s6, s6, 5
13 1B 5B 00	# slli s6,s6,0x5
#         add     s6, s6, s5
33 0B 5B 01	# add s6,s6,s5
# 1:      bgeu    s5, s6, 9f
63 FA 6A 07	# bgeu s5,s6,318 <.L9^B1>
#         lbu     t0, P_STATE(s5)
83 C2 7A 00	# lbu t0,7(s5) # 87f1b007 <PEERS+0x7>
#         li      t1, 2
13 03 20 00	# li t1,2
#         bgeu    t0, t1, 8f              # asked enough
63 F0 62 06	# bgeu t0,t1,310 <.L8^B1>
#         lw      t1, P_LAST(s5)
03 A3 0A 01	# lw t1,16(s5)
#         sub     t1, s3, t1
33 83 69 40	# sub t1,s3,t1
#         li      t2, TICK
B7 93 98 00	# lui t2,0x989
93 83 03 68	# addi t2,t2,1664 # 989680 <TICK>
#         bltu    t1, t2, 8f
63 66 73 04	# bltu t1,t2,310 <.L8^B1>
#         lw      t1, P_TRIES(s5)
03 A3 4A 01	# lw t1,20(s5)
#         li      t2, 3
93 03 30 00	# li t2,3
#         bltu    t1, t2, 2f
63 68 73 00	# bltu t1,t2,2e0 <.L2^B3>
#         li      t1, 3                   # no answer: done with it
13 03 30 00	# li t1,3
#         sb      t1, P_STATE(s5)
A3 83 6A 00	# sb t1,7(s5)
#         j       8f
6F 00 40 03	# j 310 <.L8^B1>
# 2:      addi    t1, t1, 1
13 03 13 00	# addi t1,t1,1
#         sw      t1, P_TRIES(s5)
23 AA 6A 00	# sw t1,20(s5)
#         sw      s3, P_LAST(s5)
23 A8 3A 01	# sw s3,16(s5)
#         mv      a0, s5
13 85 0A 00	# mv a0,s5
#         bnez    t0, 3f
63 96 02 00	# bnez t0,2fc <.L3^B1>
#         jal     send_ping
