63 1A C3 01	# bne t1,t3,12cc <.L2^B15>
#         lbu     t1, 3(t0)
03 C3 32 00	# lbu t1,3(t0)
#         li      t3, 0x40
13 0E 00 04	# li t3,64
#         bne     t1, t3, 2f
63 14 C3 01	# bne t1,t3,12cc <.L2^B15>
#         addi    a4, a4, 1
13 07 17 00	# addi a4,a4,1
# 2:      lbu     t1, 0(t0)               # past the name and its NUL, to 4
03 C3 02 00	# lbu t1,0(t0)
#         addi    t0, t0, 1
93 82 12 00	# addi t0,t0,1
#         bnez    t1, 2b
