# ===========================================================================
# a0 = count byte, then 6-byte entries (4 address bytes, a u16 LE port), as
# in a Peers message; a1 = 1 if they are seeds.  Adds those not yet known,
# each swapped with an entry picked at random (an inside-out Fisher-Yates
# shuffle), so the table is always in random order and peers are asked, and
# taken, in no fixed order.
# add_peers:
#         PUSH    ra, s5, s6, s7
13 01 01 FF	# addi sp,sp,-16
23 20 11 00	# sw ra,0(sp)
23 22 51 01	# sw s5,4(sp)
23 24 61 01	# sw s6,8(sp)
23 26 71 01	# sw s7,12(sp)
#         lbu     s6, 0(a0)
03 4B 05 00	# lbu s6,0(a0)
#         addi    s5, a0, 1
93 0A 15 00	# addi s5,a0,1
#         mv      s7, a1
93 8B 05 00	# mv s7,a1
# 1:      beqz    s6, 9f
63 0E 0B 0C	# beqz s6,b60 <.L9^B9>
#         addi    s6, s6, -1
13 0B FB FF	# addi s6,s6,-1
#         mv      a0, s5
13 85 0A 00	# mv a0,s5
#         jal     get32le
EF 00 90 34	# jal 15d8 <get32le>
#         mv      t5, a0
13 0F 05 00	# mv t5,a0
#         addi    a0, s5, 4
13 85 4A 00	# addi a0,s5,4
#         jal     get16le
EF 00 90 32	# jal 15c4 <get16le>
#         mv      a1, a0
93 05 05 00	# mv a1,a0
#         addi    s5, s5, 6
93 8A 6A 00	# addi s5,s5,6
#         mv      a0, t5
13 05 0F 00	# mv a0,t5
#         beqz    a0, 1b
E3 0C 05 FC	# beqz a0,a84 <.L1^B15>
#         beqz    a1, 1b
E3 8A 05 FC	# beqz a1,a84 <.L1^B15>
#         PUSH    a0, a1
13 01 01 FF	# addi sp,sp,-16
23 20 A1 00	# sw a0,0(sp)
23 22 B1 00	# sw a1,4(sp)
23 24 01 00	# sw zero,8(sp)
23 26 01 00	# sw zero,12(sp)
#         jal     find_peer
EF 00 00 0B	# jal b78 <find_peer>
#         POP     t5, t6
03 2F 01 00	# lw t5,0(sp)
83 2F 41 00	# lw t6,4(sp)
13 01 01 01	# addi sp,sp,16
#         bnez    a0, 1b                  # known
E3 16 05 FA	# bnez a0,a84 <.L1^B15>
#         lw      t0, V_NPEERS(s0)
83 22 44 02	# lw t0,36(s0)
#         li      t1, MAXPEERS
13 03 00 04	# li t1,64
#         bgeu    t0, t1, 9f              # no room
63 FE 62 06	# bgeu t0,t1,b60 <.L9^B9>
#         addi    t1, t0, 1
13 83 12 00	# addi t1,t0,1 # 80000001 <IMAGE+0x1>
#         sw      t1, V_NPEERS(s0)
23 22 64 02	# sw t1,36(s0)
#         slli    t0, t0, 5
93 92 52 00	# slli t0,t0,0x5
#         li      t1, PEERS
