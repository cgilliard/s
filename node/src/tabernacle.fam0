# 4:      addi    t0, t0, 4               # anything else: one token
93 82 42 00	# addi t0,t0,4
#         j       1b
6F F0 1F F7	# j 127c <.L1^B23>
# 9:      jr      t6
67 80 0F 00	# jr t6

# fdt_be (returns through t2): t4 = the big-endian word at t3.  t1 used.
# fdt_be:
#         lbu     t4, 0(t3)
83 4E 0E 00	# lbu t4,0(t3)
#         slli    t4, t4, 8
93 9E 8E 00	# slli t4,t4,0x8
#         lbu     t1, 1(t3)
03 43 1E 00	# lbu t1,1(t3)
#         or      t4, t4, t1
B3 EE 6E 00	# or t4,t4,t1
#         slli    t4, t4, 8
93 9E 8E 00	# slli t4,t4,0x8
#         lbu     t1, 2(t3)
03 43 2E 00	# lbu t1,2(t3)
#         or      t4, t4, t1
B3 EE 6E 00	# or t4,t4,t1
#         slli    t4, t4, 8
93 9E 8E 00	# slli t4,t4,0x8
#         lbu     t1, 3(t3)
03 43 3E 00	# lbu t1,3(t3)
#         or      t4, t4, t1
B3 EE 6E 00	# or t4,t4,t1
#         jr      t2
67 80 03 00	# jr t2

# a0 = time (MTIME's low word).
# now:
#         li      t0, MTIME
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME>
#         lw      a0, 0(t0)
03 A5 02 00	# lw a0,0(t0)
#         ret
67 80 00 00	# ret

# ===========================================================================
# The Gimli-Hash of the image (as src/gen_hash.fam computes it): a0 = 1 if it
# is the patched one.
# check_image:
#         PUSH    ra, s5, s6, s7
13 01 01 FF	# addi sp,sp,-16
23 20 11 00	# sw ra,0(sp)
23 22 51 01	# sw s5,4(sp)
23 24 61 01	# sw s6,8(sp)
23 26 71 01	# sw s7,12(sp)
#         addi    s7, s0, V_HS
93 0B 04 05	# addi s7,s0,80
#         mv      a0, s7
13 85 0B 00	# mv a0,s7
#         li      a1, 48
93 05 00 03	# li a1,48
#         jal     zero_bytes
EF 00 80 22	# jal 1598 <zero_bytes>
#         li      s5, IMAGE
B7 0A 00 80	# lui s5,0x80000
#         lw      s6, 4(s4)
03 2B 4A 00	# lw s6,4(s4)
# 1:      li      t0, 16                  # whole blocks
93 02 00 01	# li t0,16
#         bltu    s6, t0, 2f
63 60 5B 04	# bltu s6,t0,13c0 <.L2^B16>
#         li      t0, 0
93 02 00 00	# li t0,0
# 3:      add     t1, s5, t0
33 83 5A 00	# add t1,s5,t0
#         lw      t1, 0(t1)
03 23 03 00	# lw t1,0(t1)
#         add     t2, s7, t0
B3 83 5B 00	# add t2,s7,t0
#         lw      t3, 0(t2)
03 AE 03 00	# lw t3,0(t2)
#         xor     t3, t3, t1
33 4E 6E 00	# xor t3,t3,t1
#         sw      t3, 0(t2)
23 A0 C3 01	# sw t3,0(t2)
#         addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
#         li      t1, 16
13 03 00 01	# li t1,16
#         bltu    t0, t1, 3b
E3 E0 62 FE	# bltu t0,t1,1388 <.L3^B12>
#         mv      a0, s7
13 85 0B 00	# mv a0,s7
#         jal     gimli
EF 00 00 0E	# jal 1490 <gimli>
#         addi    s5, s5, 16
93 8A 0A 01	# addi s5,s5,16 # 80000010 <IMAGE+0x10>
#         addi    s6, s6, -16
13 0B 0B FF	# addi s6,s6,-16
#         j       1b
6F F0 1F FC	# j 137c <.L1^B24>
# 2:      li      t0, 0                   # the rest, and the padding
93 02 00 00	# li t0,0
# 4:      bgeu    t0, s6, 5f
63 F2 62 03	# bgeu t0,s6,13e8 <.L5^B3>
#         add     t1, s5, t0
33 83 5A 00	# add t1,s5,t0
#         lbu     t1, 0(t1)
03 43 03 00	# lbu t1,0(t1)
#         add     t2, s7, t0
B3 83 5B 00	# add t2,s7,t0
#         lbu     t3, 0(t2)
03 CE 03 00	# lbu t3,0(t2)
#         xor     t3, t3, t1
33 4E 6E 00	# xor t3,t3,t1
#         sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#         addi    t0, t0, 1
93 82 12 00	# addi t0,t0,1
#         j       4b
6F F0 1F FE	# j 13c4 <.L4^B5>
# 5:      add     t2, s7, s6
B3 83 6B 01	# add t2,s7,s6
#         lbu     t3, 0(t2)
03 CE 03 00	# lbu t3,0(t2)
#         xori    t3, t3, 1
13 4E 1E 00	# xori t3,t3,1
#         sb      t3, 0(t2)
23 80 C3 01	# sb t3,0(t2)
#         lbu     t3, 15(s7)
03 CE FB 00	# lbu t3,15(s7)
#         xori    t3, t3, 0x80
13 4E 0E 08	# xori t3,t3,128
#         sb      t3, 15(s7)
A3 87 CB 01	# sb t3,15(s7)
#         lbu     t3, 47(s7)
03 CE FB 02	# lbu t3,47(s7)
#         xori    t3, t3, 1
13 4E 1E 00	# xori t3,t3,1
#         sb      t3, 47(s7)
A3 87 CB 03	# sb t3,47(s7)
#         li      s6, 0                   # differences
13 0B 00 00	# li s6,0
#         addi    s5, s4, 8               # the patched hash
93 0A 8A 00	# addi s5,s4,8
#         jal     6f
EF 00 40 02	# jal 143c <.L6^B2>
#         jal     6f
EF 00 00 02	# jal 143c <.L6^B2>
#         seqz    a0, s6
13 35 1B 00	# seqz a0,s6
#         POP     ra, s5, s6, s7
83 20 01 00	# lw ra,0(sp)
83 2A 41 00	# lw s5,4(sp)
03 2B 81 00	# lw s6,8(sp)
83 2B C1 00	# lw s7,12(sp)
13 01 01 01	# addi sp,sp,16
#         ret
67 80 00 00	# ret
# 6:      PUSH    ra                      # squeeze 16 bytes, compare them
13 01 01 FF	# addi sp,sp,-16
23 20 11 00	# sw ra,0(sp)
23 22 01 00	# sw zero,4(sp)
23 24 01 00	# sw zero,8(sp)
23 26 01 00	# sw zero,12(sp)
#         mv      a0, s7
13 85 0B 00	# mv a0,s7
#         jal     gimli
EF 00 C0 03	# jal 1490 <gimli>
#         li      t0, 0
93 02 00 00	# li t0,0
# 7:      add     t1, s7, t0
33 83 5B 00	# add t1,s7,t0
#         lw      t1, 0(t1)
03 23 03 00	# lw t1,0(t1)
#         add     t2, s5, t0
B3 83 5A 00	# add t2,s5,t0
#         lw      t2, 0(t2)
83 A3 03 00	# lw t2,0(t2)
#         xor     t1, t1, t2
33 43 73 00	# xor t1,t1,t2
#         or      s6, s6, t1
33 6B 6B 00	# or s6,s6,t1
#         addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
#         li      t1, 16
13 03 00 01	# li t1,16
#         bltu    t0, t1, 7b
E3 E0 62 FE	# bltu t0,t1,145c <.L7^B2>
#         addi    s5, s5, 16
93 8A 0A 01	# addi s5,s5,16
#         POP     ra
83 20 01 00	# lw ra,0(sp)
13 01 01 01	# addi sp,sp,16
#         ret
67 80 00 00	# ret

# a0 = the 12-word state: the Gimli permutation.
# gimli:
#         li      a1, 24
93 05 80 01	# li a1,24
# 1:      mv      a2, a0
13 06 05 00	# mv a2,a0
#         addi    a3, a0, 16
93 06 05 01	# addi a3,a0,16 # 87f1a010 <TXBUF+0x10>
# 2:      lw      t0, 0(a2)               # x = s[c] <<< 24
83 22 06 00	# lw t0,0(a2) # 87f12000 <TXQ>
#         slli    t3, t0, 24
13 9E 82 01	# slli t3,t0,0x18
#         srli    t0, t0, 8
93 D2 82 00	# srli t0,t0,0x8
#         or      t0, t0, t3
B3 E2 C2 01	# or t0,t0,t3
#         lw      t1, 16(a2)              # y = s[4 + c] <<< 9
03 23 06 01	# lw t1,16(a2)
#         slli    t3, t1, 9
13 1E 93 00	# slli t3,t1,0x9
#         srli    t1, t1, 23
13 53 73 01	# srli t1,t1,0x17
#         or      t1, t1, t3
33 63 C3 01	# or t1,t1,t3
#         lw      t2, 32(a2)              # z = s[8 + c]
83 23 06 02	# lw t2,32(a2)
#         slli    t3, t2, 1               # x ^ (z << 1) ^ ((y & z) << 2)
13 9E 13 00	# slli t3,t2,0x1
#         and     t4, t1, t2
B3 7E 73 00	# and t4,t1,t2
#         slli    t4, t4, 2
93 9E 2E 00	# slli t4,t4,0x2
#         xor     t3, t3, t4
33 4E DE 01	# xor t3,t3,t4
#         xor     t3, t3, t0
33 4E 5E 00	# xor t3,t3,t0
#         sw      t3, 32(a2)
23 20 C6 03	# sw t3,32(a2)
#         or      t4, t0, t2              # y ^ x ^ ((x | z) << 1)
B3 EE 72 00	# or t4,t0,t2
#         slli    t4, t4, 1
93 9E 1E 00	# slli t4,t4,0x1
#         xor     t4, t4, t1
B3 CE 6E 00	# xor t4,t4,t1
#         xor     t4, t4, t0
B3 CE 5E 00	# xor t4,t4,t0
#         sw      t4, 16(a2)
23 28 D6 01	# sw t4,16(a2)
#         and     t4, t0, t1              # z ^ y ^ ((x & y) << 3)
B3 FE 62 00	# and t4,t0,t1
#         slli    t4, t4, 3
93 9E 3E 00	# slli t4,t4,0x3
#         xor     t4, t4, t2
B3 CE 7E 00	# xor t4,t4,t2
#         xor     t4, t4, t1
B3 CE 6E 00	# xor t4,t4,t1
#         sw      t4, 0(a2)
23 20 D6 01	# sw t4,0(a2)
#         addi    a2, a2, 4
13 06 46 00	# addi a2,a2,4
#         bltu    a2, a3, 2b
E3 6C D6 F8	# bltu a2,a3,149c <.L2^B17>
#         andi    t0, a1, 3
93 F2 35 00	# andi t0,a1,3
#         bnez    t0, 3f
63 9C 02 02	# bnez t0,1544 <.L3^B13>
#         lw      t1, 0(a0)               # small swap, and the round constant
03 23 05 00	# lw t1,0(a0)
#         lw      t2, 4(a0)
83 23 45 00	# lw t2,4(a0)
#         li      t3, 0x9E377900
37 8E 37 9E	# lui t3,0x9e378
13 0E 0E 90	# addi t3,t3,-1792 # 9e377900 <SEEDS+0x16378900>
#         or      t3, t3, a1
33 6E BE 00	# or t3,t3,a1
#         xor     t2, t2, t3
B3 C3 C3 01	# xor t2,t2,t3
#         sw      t2, 0(a0)
23 20 75 00	# sw t2,0(a0)
#         sw      t1, 4(a0)
23 22 65 00	# sw t1,4(a0)
#         lw      t1, 8(a0)
03 23 85 00	# lw t1,8(a0)
#         lw      t2, 12(a0)
83 23 C5 00	# lw t2,12(a0)
#         sw      t2, 8(a0)
23 24 75 00	# sw t2,8(a0)
#         sw      t1, 12(a0)
23 26 65 00	# sw t1,12(a0)
#         j       4f
6F 00 C0 02	# j 156c <.L4^B6>
# 3:      li      t1, 2
13 03 20 00	# li t1,2
#         bne     t0, t1, 4f
63 92 62 02	# bne t0,t1,156c <.L4^B6>
#         lw      t1, 0(a0)               # big swap
03 23 05 00	# lw t1,0(a0)
#         lw      t2, 8(a0)
83 23 85 00	# lw t2,8(a0)
#         sw      t2, 0(a0)
23 20 75 00	# sw t2,0(a0)
#         sw      t1, 8(a0)
23 24 65 00	# sw t1,8(a0)
#         lw      t1, 4(a0)
03 23 45 00	# lw t1,4(a0)
#         lw      t2, 12(a0)
83 23 C5 00	# lw t2,12(a0)
#         sw      t2, 4(a0)
23 22 75 00	# sw t2,4(a0)
#         sw      t1, 12(a0)
23 26 65 00	# sw t1,12(a0)
# 4:      addi    a1, a1, -1
93 85 F5 FF	# addi a1,a1,-1
#         bnez    a1, 1b
E3 92 05 F2	# bnez a1,1494 <.L1^B25>
#         ret
67 80 00 00	# ret

# ===========================================================================
# Bytes.  These clobber only t0-t1 (and a0).

# a0 = destination, a1 = source, a2 = count.
# copy:
#         beqz    a2, 9f
63 0E 06 00	# beqz a2,1594 <.L9^B14>
#         lbu     t0, 0(a1)
83 C2 05 00	# lbu t0,0(a1)
#         sb      t0, 0(a0)
23 00 55 00	# sb t0,0(a0)
#         addi    a0, a0, 1
13 05 15 00	# addi a0,a0,1
#         addi    a1, a1, 1
93 85 15 00	# addi a1,a1,1
#         addi    a2, a2, -1
13 06 F6 FF	# addi a2,a2,-1
#         j       copy
6F F0 9F FE	# j 1578 <copy>
# 9:      ret
67 80 00 00	# ret

# a0 = address, a1 = count.
# zero_bytes:
#         beqz    a1, 9f
63 8A 05 00	# beqz a1,15ac <.L9^B15>
#         sb      zero, 0(a0)
23 00 05 00	# sb zero,0(a0)
#         addi    a0, a0, 1
13 05 15 00	# addi a0,a0,1
#         addi    a1, a1, -1
93 85 F5 FF	# addi a1,a1,-1
#         j       zero_bytes
6F F0 1F FF	# j 1598 <zero_bytes>
# 9:      ret
67 80 00 00	# ret

# get16be:
#         lbu     t0, 0(a0)
83 42 05 00	# lbu t0,0(a0)
#         lbu     t1, 1(a0)
03 43 15 00	# lbu t1,1(a0)
#         slli    t0, t0, 8
93 92 82 00	# slli t0,t0,0x8
#         or      a0, t0, t1
33 E5 62 00	# or a0,t0,t1
#         ret
67 80 00 00	# ret

# get16le:
#         lbu     t0, 0(a0)
83 42 05 00	# lbu t0,0(a0)
#         lbu     t1, 1(a0)
03 43 15 00	# lbu t1,1(a0)
#         slli    t1, t1, 8
13 13 83 00	# slli t1,t1,0x8
#         or      a0, t0, t1
33 E5 62 00	# or a0,t0,t1
#         ret
67 80 00 00	# ret

# get32le:
#         lbu     t0, 3(a0)
83 42 35 00	# lbu t0,3(a0)
#         lbu     t1, 2(a0)
03 43 25 00	# lbu t1,2(a0)
#         slli    t0, t0, 8
93 92 82 00	# slli t0,t0,0x8
#         or      t0, t0, t1
B3 E2 62 00	# or t0,t0,t1
#         lbu     t1, 1(a0)
03 43 15 00	# lbu t1,1(a0)
#         slli    t0, t0, 8
93 92 82 00	# slli t0,t0,0x8
#         or      t0, t0, t1
B3 E2 62 00	# or t0,t0,t1
#         lbu     t1, 0(a0)
03 43 05 00	# lbu t1,0(a0)
#         slli    t0, t0, 8
93 92 82 00	# slli t0,t0,0x8
#         or      a0, t0, t1
33 E5 62 00	# or a0,t0,t1
#         ret
67 80 00 00	# ret

# a0 = address, a1 = value.
# put16be:
#         srli    t0, a1, 8
93 D2 85 00	# srli t0,a1,0x8
#         sb      t0, 0(a0)
23 00 55 00	# sb t0,0(a0)
#         sb      a1, 1(a0)
A3 00 B5 00	# sb a1,1(a0)
#         ret
67 80 00 00	# ret

# put16le:
#         sb      a1, 0(a0)
23 00 B5 00	# sb a1,0(a0)
#         srli    t0, a1, 8
93 D2 85 00	# srli t0,a1,0x8
#         sb      t0, 1(a0)
A3 00 55 00	# sb t0,1(a0)
#         ret
67 80 00 00	# ret

# put32le:
#         sb      a1, 0(a0)
23 00 B5 00	# sb a1,0(a0)
#         srli    t0, a1, 8
93 D2 85 00	# srli t0,a1,0x8
#         sb      t0, 1(a0)
A3 00 55 00	# sb t0,1(a0)
#         srli    t0, a1, 16
93 D2 05 01	# srli t0,a1,0x10
#         sb      t0, 2(a0)
23 01 55 00	# sb t0,2(a0)
#         srli    t0, a1, 24
93 D2 85 01	# srli t0,a1,0x18
#         sb      t0, 3(a0)
A3 01 55 00	# sb t0,3(a0)
#         ret
67 80 00 00	# ret

# ===========================================================================
# The serial port.

# a0 = a NUL-terminated string.
# puts:
#         li      t0, UART
B7 02 00 10	# lui t0,0x10000
# 1:      lbu     t1, 0(a0)
03 43 05 00	# lbu t1,0(a0)
#         beqz    t1, 9f
63 08 03 00	# beqz t1,165c <.L9^B16>
#         sb      t1, 0(t0)
23 80 62 00	# sb t1,0(t0) # 10000000 <UART>
#         addi    a0, a0, 1
13 05 15 00	# addi a0,a0,1
#         j       1b
6F F0 1F FF	# j 1648 <.L1^B26>
# 9:      ret
67 80 00 00	# ret

# a0 = a number below 100,000, in decimal.
# put_dec:
#         li      t0, UART
B7 02 00 10	# lui t0,0x10000
#         LOAD_ADDRESS t1, tens
17 03 00 00	# auipc t1,0x0
13 03 03 0C	# addi t1,t1,192 # 1724 <tens>
#         li      t4, 0                   # a digit printed yet
93 0E 00 00	# li t4,0
# 1:      lw      t2, 0(t1)
83 23 03 00	# lw t2,0(t1)
#         beqz    t2, 9f
63 8C 03 02	# beqz t2,16ac <.L9^B17>
#         li      t3, 0
13 0E 00 00	# li t3,0
# 2:      bltu    a0, t2, 3f
63 68 75 00	# bltu a0,t2,168c <.L3^B14>
#         sub     a0, a0, t2
33 05 75 40	# sub a0,a0,t2
#         addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
#         j       2b
6F F0 5F FF	# j 167c <.L2^B18>
# 3:      or      t4, t4, t3
B3 EE CE 01	# or t4,t4,t3
#         li      t5, 1
13 0F 10 00	# li t5,1
#         beq     t2, t5, 4f              # the last digit, even 0
63 84 E3 01	# beq t2,t5,169c <.L4^B7>
#         beqz    t4, 5f
63 86 0E 00	# beqz t4,16a4 <.L5^B4>
# 4:      addi    t3, t3, '0'
13 0E 0E 03	# addi t3,t3,48
#         sb      t3, 0(t0)
23 80 C2 01	# sb t3,0(t0) # 10000000 <UART>
# 5:      addi    t1, t1, 4
13 03 43 00	# addi t1,t1,4
#         j       1b
6F F0 9F FC	# j 1670 <.L1^B27>
# 9:      ret
67 80 00 00	# ret

# a0 = peer: "a.b.c.d:port" and a newline.
# put_peer:
#         PUSH    ra, s5, s6
13 01 01 FF	# addi sp,sp,-16
23 20 11 00	# sw ra,0(sp)
23 22 51 01	# sw s5,4(sp)
23 24 61 01	# sw s6,8(sp)
23 26 01 00	# sw zero,12(sp)
#         mv      s5, a0
93 0A 05 00	# mv s5,a0
#         li      s6, 0
13 0B 00 00	# li s6,0
# 1:      add     t0, s5, s6
B3 82 6A 01	# add t0,s5,s6
#         lbu     a0, P_IP(t0)
03 C5 02 00	# lbu a0,0(t0)
#         jal     put_dec
EF F0 DF F8	# jal 1660 <put_dec>
#         li      t0, UART
B7 02 00 10	# lui t0,0x10000
#         li      t1, '.'
13 03 E0 02	# li t1,46
#         li      t2, 3
93 03 30 00	# li t2,3
#         bne     s6, t2, 2f
63 14 7B 00	# bne s6,t2,16ec <.L2^B19>
#         li      t1, ':'
13 03 A0 03	# li t1,58
# 2:      sb      t1, 0(t0)
23 80 62 00	# sb t1,0(t0) # 10000000 <UART>
#         addi    s6, s6, 1
13 0B 1B 00	# addi s6,s6,1
#         li      t2, 4
93 03 40 00	# li t2,4
#         bltu    s6, t2, 1b
E3 6A 7B FC	# bltu s6,t2,16cc <.L1^B28>
#         lhu     a0, P_PORT(s5)
