13 0E 0E 24	# addi t3,t3,576 # f4240 <_end+0xf29e0>
#         bltu    t4, t3, 1b
E3 EE CE F9	# bltu t4,t3,11e8 <.L1^B22>
#         ret
67 80 00 00	# ret

# fdt_harts (returns through t6): a4 = the cpu@ nodes of the device tree
# at 0x87E00000 (big-endian tokens: 1 begin node, its name NUL-ended and
# padded to 4; 3 a property, its length, name offset and value padded to 4;
# 9 the end), or 0 when there is no tree there.  t0..t4 used.
# fdt_harts:
#         li      a4, 0
13 07 00 00	# li a4,0
#         li      t0, 0x87E00000
B7 02 E0 87	# lui t0,0x87e00
#         mv      t3, t0
13 8E 02 00	# mv t3,t0
#         jal     t2, fdt_be
EF 03 40 0B	# jal t2,1314 <fdt_be>
#         li      t1, 0xD00DFEED
37 03 0E D0	# lui t1,0xd00e0
13 03 D3 EE	# addi t1,t1,-275 # d00dfeed <SEEDS+0x480e0eed>
#         bne     t4, t1, 9f
63 92 6E 0A	# bne t4,t1,1310 <.L9^B13>
#         addi    t3, t0, 8
13 8E 82 00	# addi t3,t0,8 # 87e00008 <IMAGE+0x7e00008>
#         jal     t2, fdt_be              # off_dt_struct
EF 03 00 0A	# jal t2,1314 <fdt_be>
#         add     t0, t0, t4
B3 82 D2 01	# add t0,t0,t4
# 1:      mv      t3, t0
13 8E 02 00	# mv t3,t0
#         jal     t2, fdt_be
EF 03 40 09	# jal t2,1314 <fdt_be>
#         li      t1, 9
13 03 90 00	# li t1,9
#         beq     t4, t1, 9f
63 84 6E 08	# beq t4,t1,1310 <.L9^B13>
#         li      t1, 1
13 03 10 00	# li t1,1
#         bne     t4, t1, 3f
63 9A 6E 04	# bne t4,t1,12e4 <.L3^B11>
#         addi    t0, t0, 4               # a node: is its name cpu@...?
93 82 42 00	# addi t0,t0,4
#         lbu     t1, 0(t0)
03 C3 02 00	# lbu t1,0(t0)
#         li      t3, 0x63
13 0E 30 06	# li t3,99
#         bne     t1, t3, 2f
63 16 C3 03	# bne t1,t3,12cc <.L2^B15>
#         lbu     t1, 1(t0)
03 C3 12 00	# lbu t1,1(t0)
#         li      t3, 0x70
