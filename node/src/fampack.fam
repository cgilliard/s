\ ── fampack prelude: inline I/O so NO :-word calls happen (our RID stack
\    lives in s10/s11, which fampack uses as state; a : call would clobber it).
:M _putc
B7020010 ,   \ lui  t0, 0x10000
03C35200 ,   \ lbu  t1, 5(t0)
13730302 ,   \ andi t1, t1, 0x20
E30C03FE ,   \ beqz t1, -8
03230100 ,   \ lw   t1, 0(sp)
13014100 ,   \ addi sp, sp, 4
23806200 ,   \ sb   t1, 0(t0)
;
:M _bye
B7021000 ,   \ lui  t0, 0x100
37530000 ,   \ lui  t1, 0x5
13035355 ,   \ addi t1, t1, 0x555
23A06200 ,   \ sw   t1, 0(t0)
6F000000 ,   \ jal  x0, .
;

\ ──────────────────────────────────────────────────────────────────────────────
\ src/fampack.fam — LZ77 self-extracting packer (RV32I, pure fam).
\
\ Brute-force match finder: O(N²), 4 KB sliding window, 3..18 byte matches.
\
\ Wire protocol:
\ stdin: [4 bytes LE: N] [N bytes data]
\ stdout: [16 B header (NOP magic + jal + PAYLOAD + UNCOMP)]
\ [200 B fixed stub body]
\ The stub copies the payload to 0x84800000, unpacks it to 0x80001000 (a page
\ boundary, so what is packed runs page-aligned: tabernacle's end marker, and
\ with it the node it loads there, lands on a page) and jumps to it.
\ [LZ77 payload]
\
\ LZ77 stream:
\ Repeating: 1 flag byte (MSB-first; 1=literal, 0=match) + 8 chunks.
\ Literal: 1 byte raw. Match: 2 bytes (offset-1, length-3).
\
\ Register map:
\ s5 = state base (alloc'd 32 B):
\ [0]=output_pos [4]=chunk_pos [8]=flag_bits [12]=flag_count
\ [16..31]=chunk_buf (max 8 chunks × 1-2 B = 16 B)
\ s7 = N
\ s8 = input_base
\ s9 = output_base (alloc'd N + ceil(N/8) + slack bytes)
\ s11 = i (input position)
\ ──────────────────────────────────────────────────────────────────────────────


\ ── Helpers ──

:M rd4
\ ( -- u32 ) read 4 bytes LE from stdin
getc
getc 8 lit lshift or
getc 10 lit lshift or
getc 18 lit lshift or
;

:M wr4
\ ( v -- ) write 4 bytes LE to stdout
dup FF lit and _putc
8 lit rshift dup FF lit and _putc
8 lit rshift dup FF lit and _putc
8 lit rshift FF lit and _putc
;

\ tos↔sX (raw hex; no nested :M)
:M tos>s5 832A0100 , 13014100 , ;
:M tos>s7 832B0100 , 13014100 , ;
:M tos>s8 032C0100 , 13014100 , ;
:M tos>s6 032B0100 , 13014100 , ;
:M tos>s11 832D0100 , 13014100 , ;
:M s5>tos 1301C1FF , 23205101 , ;
:M s7>tos 1301C1FF , 23207101 , ;
:M s8>tos 1301C1FF , 23208101 , ;
:M s6>tos 1301C1FF , 23206101 , ;
:M s11>tos 1301C1FF , 2320B101 , ;


\ ── Phase 2: read length, alloc input buf, fill it ──
rd4 tos>s7 \ s7 = N
s7>tos alloc tos>s8 \ s8 = input_base
0 zr 1B addi \ s11 = 0 (i)
begin
s7 s11 t4 sub
1301C1FF ,
0 t4 sp sw
while
getc
0 sp 6 lw \ t1 = byte
4 sp sp addi
s11 s8 5 add \ t0 = s8 + i
0 6 5 sb \ sb t1, 0(t0)
1 1B 1B addi
repeat


\ ── Phase 3: brute-force LZ77 encoder ──

\ Alloc output buffer = N + N/8 + 32 (safe upper bound; literal expansion).
s7>tos s7>tos 3 lit rshift + 20 lit + alloc tos>s6

\ Alloc state (32 B): output_pos, chunk_pos, flag_bits, flag_count, chunk_buf[16].
20 lit alloc tos>s5

\ Init state to 0.
0 zr 5 addi \ t0 = 0
0 5 15 sw \ s5[0] = output_pos = 0
4 5 15 sw \ s5[4] = chunk_pos = 0
8 5 15 sw \ s5[8] = flag_bits = 0
C 5 15 sw \ s5[12] = flag_count = 0

\ Main loop. Per-iteration registers (no `:` calls inside, so t-regs survive):
\ s5 state base, s7 N, s8 input_base, s9 output_base, s11 i
\ s10 max_len (for inner match-length loop)
\ t3 j (search position)
\ t4 ln (working match length)
\ t5 best_off
\ t6 best_len
0 zr 1B addi \ s11 = 0
begin
s7 s11 t4 sub
1301C1FF ,
0 t4 sp sw
while
\ best_len = 0, best_off = 0.
0 zr 1F addi \ t6 = 0
0 zr 1E addi \ t5 = 0

\ max_len = min(18, N - s11) → s10
s11 s7 6 sub \ t1 = N - s11
FED 6 5 addi \ t0 = t1 - 19 (FED = -19 in 12-bit)
1301C1FF ,
0 5 sp sw
0< if
\ t1 < 19 → keep t1
else
12 zr 6 addi \ t1 = 18
then
0 6 14 addi \ s10 = t1

\ win_start = max(0, s11 - 0x1000) → t3
1 5 lui \ t0 = 1000
5 1B 1C sub \ t3 = s11 - 1000
1301C1FF ,
0 1C sp sw
0< if
0 zr 1C addi \ t3 = 0
then

\ for j = win_start; j < s11; j++:
begin
s11 1C 1D sub \ t4 = j - s11
1301C1FF ,
0 1D sp sw
while
\ ln = match_length(input + j, input + s11, max_len)
0 zr 1D addi \ t4 = 0
begin
\ continue if ln < max_len AND input[j+ln] == input[s11+ln]
1D 14 5 sub \ t0 = max_len - ln
1301C1FF ,
0 5 sp sw
0= if
\ ln >= max_len: stop
0 zr 6 addi
1301C1FF ,
0 6 sp sw
else
1D 1C 5 add \ t0 = j + ln
s8 5 5 add \ t0 += input_base
0 5 6 lbu \ t1 = input[j + ln]
1D 1B 5 add \ t0 = s11 + ln
s8 5 5 add \ t0 += input_base
0 5 7 lbu \ t2 = input[s11 + ln]
7 6 5 sub \ t0 = t1 - t2
1301C1FF ,
0 5 sp sw
0= if
1 zr 6 addi \ flag = 1 (continue)
else
0 zr 6 addi \ flag = 0 (mismatch)
then
1301C1FF ,
0 6 sp sw
then
while
1 1D 1D addi \ ln++
repeat

\ if ln > best_len: best_len = ln; best_off = s11 - j
\ ln > best_len ↔ best_len - ln < 0
1D 1F 5 sub \ t0 = best_len - ln (rs2=t4, rs1=t6, rd=t0)
1301C1FF ,
0 5 sp sw
0< if
0 1D 1F addi \ t6 = ln
1C 1B 1E sub \ t5 = s11 - j
then

1 1C 1C addi \ j++
repeat

\ ── decide: emit_literal or emit_match ──
FFD 1F 5 addi \ t0 = best_len - 3
1301C1FF ,
0 5 sp sw
0< if
\ best_len < 3 → emit_literal
\ flag_bits = (flag_bits << 1) | 1
8 15 6 lw
1 6 6 slli
1 zr 5 addi
5 6 6 _or
8 6 15 sw
\ flag_count++
C 15 6 lw
1 6 6 addi
C 6 15 sw
\ Load input[s11] → t4
s11 s8 5 add
0 5 1D lbu
\ chunk_buf[chunk_pos++] = byte
4 15 6 lw
10 15 7 addi
6 7 7 add
0 1D 7 sb
1 6 6 addi
4 6 15 sw
\ s11++
1 1B 1B addi
else
\ best_len >= 3 → emit_match
\ Save best_len for s11 update (t6 will be clobbered).
0 1F 1C addi \ t3 = best_len
\ flag_bits <<= 1 (no |1)
8 15 6 lw
1 6 6 slli
8 6 15 sw
\ flag_count++
C 15 6 lw
1 6 6 addi
C 6 15 sw
\ off_enc = best_off - 1
FFF 1E 1E addi \ t5 -= 1
\ ln_enc = best_len - 3 in t4
FFD 1C 1D addi
\ byte0 = off_enc & FF → t0
FF 1E 5 andi
\ byte1 = ((off_enc >> 8) & 0x0F) | (ln_enc << 4) → t1
8 1E 6 srli
F 6 6 andi
4 1D 1D slli
1D 6 6 _or
\ chunk_buf[chunk_pos] = byte0; chunk_buf[chunk_pos+1] = byte1
4 15 7 lw \ t2 = chunk_pos
10 15 1F addi \ t6 = chunk_buf base
7 1F 1F add \ t6 += chunk_pos
0 5 1F sb \ sb byte0, 0(t6)
1 6 1F sb \ sb byte1, 1(t6)
2 7 7 addi \ chunk_pos += 2
4 7 15 sw
\ s11 += best_len
1C 1B 1B add
then

\ ── flush if flag_count == 8 ──
C 15 6 lw \ t1 = flag_count
8 zr 5 addi \ t0 = 8
5 6 6 sub \ t1 -= 8
1301C1FF ,
0 6 sp sw
0= if
\ output[output_pos++] = flag_bits
0 15 6 lw \ t1 = output_pos
6 s6 7 add \ t2 = output_base + output_pos
8 15 5 lw \ t0 = flag_bits
0 5 7 sb
1 6 6 addi
0 6 15 sw

\ Copy chunk_buf[0..chunk_pos-1] to output.
4 15 1C lw \ t3 = chunk_pos
0 zr 1D addi \ t4 = k = 0
begin
1D 1C 1E sub \ t5 = chunk_pos - k
1301C1FF ,
0 1E sp sw
while
10 15 5 addi \ t0 = chunk_buf base
1D 5 5 add \ t0 += k
0 5 6 lbu \ t1 = chunk_buf[k]
0 15 5 lw \ t0 = output_pos
5 s6 7 add \ t2 = output_base + output_pos
0 6 7 sb
0 15 5 lw
1 5 5 addi
0 5 15 sw
1 1D 1D addi \ k++
repeat

\ Reset state: chunk_pos=0, flag_bits=0, flag_count=0
0 zr 5 addi
4 5 15 sw
8 5 15 sw
C 5 15 sw
then
repeat

\ ── Final flush: pad flag_bits with zeros if flag_count > 0, then flush. ──
C 15 6 lw \ t1 = flag_count
1301C1FF ,
0 6 sp sw
0= if
\ flag_count == 0, nothing to flush.
else
\ pad flag_bits left by (8 - flag_count)
C 15 6 lw \ t1 = flag_count
8 zr 5 addi \ t0 = 8
5 6 6 sub \ t1 = flag_count - 8 = -(8-flag_count)
\ Hmm we want shift amount = 8 - flag_count. Let me do it differently.
\ Compute shift = 8 - flag_count.
\ Use addi: shift = -t1 (where t1 was flag_count - 8). t1 is negative; -t1 positive.
\ Actually t1 = flag_count - 8. shift = 8 - flag_count = -t1.
\ neg via sub: t1 = 0 - t1.
6 zr 6 sub \ t1 = -t1 = (8 - flag_count)
\ flag_bits <<= shift
8 15 5 lw \ t0 = flag_bits
\ slli with VARIABLE shift → use sll (R-type variable shift).
\ sll = funct3=1, funct7=0, opcode=0x33. RV32I has sll (variable shift left).
\ Encoding: rd=t0(5), rs1=t0(5), rs2=t1(6) → 0x006292B3.
\ Let me compute: opcode 33 | rd 5 << 7 | funct3 1 << 12 | rs1 5 << 15 | rs2 6 << 20 | funct7 0 << 25
\ = 33 | 280 | 1000 | 28000 | 600000
\ = 0x6292B3.
B3926200 , \ sll t0, t0, t1
\ output[output_pos++] = t0
0 15 6 lw \ t1 = output_pos
6 s6 7 add \ t2 = output_base + output_pos
0 5 7 sb \ sb t0, 0(t2)
1 6 6 addi
0 6 15 sw \ output_pos++

\ Copy chunk_buf[0..chunk_pos-1] to output.
4 15 1C lw \ t3 = chunk_pos
0 zr 1D addi \ t4 = 0
begin
1D 1C t5 sub
1301C1FF ,
0 1E sp sw
while
10 15 5 addi
1D 5 5 add
0 5 6 lbu
0 15 5 lw
5 s6 7 add
0 6 7 sb
0 15 5 lw
1 5 5 addi
0 5 15 sw
1 1D 1D addi
repeat
then


\ ── Phase 4: emit stub ──
\ 16-byte header.
13 lit _putc 0 lit _putc 0 lit _putc 0 lit _putc \ NOP magic 13
6F lit _putc 0 lit _putc C0 lit _putc 0 lit _putc \ jal zero, +12 = C0006F
0 15 6 lw \ t1 = output_pos = PAYLOAD_SIZE
\ Push t1 to sp, wr4.
1301C1FF , 0 6 sp sw
wr4
\ uncomp_size = N (s7)
s7>tos wr4

\ 200-byte fixed body — 50 instructions, each as 4 LE bytes: the payload
\ starts at 16 + 200 = 216, the unpacked image at 0x80001000, the last two
\ words jump there.
800002B7 lit wr4 82A303 lit wr4 D828393 lit wr4 84800E37 lit wr4
638EB3 lit wr4 1D38C63 lit wr4 3C503 lit wr4 AE0023 lit wr4
138393 lit wr4 1E0E13 lit wr4 FEDFF06F lit wr4 C2A303 lit wr4
848003B7 lit wr4 80001E37 lit wr4 6E0EB3 lit wr4 F13 lit wr4
F93 lit wr4 7DE0E63 lit wr4 F9863 lit wr4 3CF03 lit wr4
138393 lit wr4 800F93 lit wr4 80F7513 lit wr4 1F1F13 lit wr4
FFFF8F93 lit wr4 50C63 lit wr4 3C503 lit wr4 AE0023 lit wr4
138393 lit wr4 1E0E13 lit wr4 FCDFF06F lit wr4 3C583 lit wr4
13C603 lit wr4 238393 lit wr4 F67693 lit wr4 869693 lit wr4
D5E5B3 lit wr4 158593 lit wr4 465693 lit wr4 368693 lit wr4
40BE0733 lit wr4 FA0680E3 lit wr4 74783 lit wr4 FE0023 lit wr4
170713 lit wr4 1E0E13 lit wr4 FFF68693 lit wr4 FE9FF06F lit wr4
800012B7 lit wr4 28067 lit wr4


\ ── Phase 5: emit payload bytes ──
0 zr 1B addi \ s11 = 0
0 15 14 lw \ s10 = output_pos
begin
s11 14 t4 sub \ t4 = s10 - s11
1301C1FF ,
0 t4 sp sw
while
s11 s6 5 add \ t0 = output_base + s11
0 5 a0 lbu
_emit
1 1B 1B addi
repeat

_bye
