\ store.fam — the store (docs/OS.md, section 6; step 8): B+ trees of 4 KiB
\ pages kept copy-on-write on the disk, after LMDB.  Between src/kernel.fam
\ (whose words it uses) and src/ksys.fam (whose calls use it).
\
\ The disk: its first 64 MiB are tabernacle's (the image); the store's page
\ p is at 64 MiB + 4 KiB p.  Pages 0 and 1 are the pool's meta pages, 2 and
\ 3 the file system's tree's; every other tree has a pair of its own.
\
\ Any number of trees, each with its own writer (a kernel mutex held from
\ begin to commit or abort), its readers (each a snapshot: the tree as a
\ commit left it), its meta pages (written alternately: a commit's is
\ never the one the last left) and its free pages.  A transaction writes
\ no page in place: a page it changes is copied to a new one (once; the
\ copy is its own, and changed where it is), the old one freed.  A commit
\ writes its pages, flushes, writes the meta page, flushes.
\
\ Free space: a page a commit frees goes in its tree's free list, reused
\ by a later transaction of that tree once no reader of it can see it.
\ The list is kept on the disk as pages listing pages, the meta pointing
\ at the last, each at the one before; a commit writes again only those
\ from its first entry changed (pages are taken from the list's end), and
\ the tree reads it all back when opened.  New pages come from the pool,
\ 1 MiB at a time to a tree (its chunk, whose bounds its meta page keeps),
\ the pool's mark (the first page never given) written and flushed before
\ a chunk is used.  A crash leaks nothing: what the transaction it cut
\ short had taken is free again by the last commit's meta page.  (What an
\ abort gave back is lost if no commit follows before the tree is closed;
\ a sweep can take such pages back one day.)
\
\ A page: its type (1 leaf, 2 branch, 16 bits), its count of cells, where
\ its cells begin (they fill it down from its end), the bytes they take,
\ a branch's first child (32 bits at 8); then its cells' offsets, 16 bits
\ each, in key order.  A leaf's cell: key length, value length (16 bits
\ each), the key, the value.  A branch's: key length, 0, the child holding
\ keys from that key on (32 bits), the key.  Cells take a multiple of 4
\ bytes.  Keys are 1 to 255 bytes, values up to 1 KiB, so a page holds at
\ least 3 cells.  Pages a delete empties are freed (a branch with no child
\ left, too; a root with one child gives way to it); others are not
\ merged.
\
\ Concurrency: one spin lock (stlk, held briefly, never across a sleep)
\ for the cache, the pool and the trees' records; kernel mutexes (which
\ sleep) for the device, a tree's writer, the pool's meta, opening trees.
\ A call that waits for the disk sleeps (ksleep) while its hart runs other
\ threads.  A transaction is worked by one call at a time; its words find
\ it in the calling context (tx, at 352 of the trap area).

:M SBASE 4000 lit ;          \ the store's first page on the disk
:M CHUNK 100 lit ;           \ pages given a tree at a time: 1 MiB
:M FLMAX 4000 lit ;          \ free pages a tree keeps in memory
:M DLMAX 2000 lit ;          \ pages a transaction may make or free
: nslot variable ;           \ the cache's pages (stmount: nsize)
: NSLOT  nslot @ ;
:M TMAX 10 lit ;             \ trees open at once
:M RMAX 8 lit ;              \ readers of a tree at once

\ ── Bytes (raw words) ──

\ bcpy ( src dst n -- )  n bytes, any alignment; the two may overlap.
: bcpy
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
63E06202 ,   \ bltu t0,t1,back
63800304 ,   \ beq t2,zero,done
03CE0200 ,   \ lbu t3,0(t0)
2300C301 ,   \ sb t3,0(t1)
93821200 ,   \ addi t0,t0,1
13031300 ,   \ addi t1,t1,1
9383F3FF ,   \ addi t2,t2,-1
6FF09FFE ,   \ jal zero,fwd
B3827200 ,   \ add t0,t0,t2
33037300 ,   \ add t1,t1,t2
638E0300 ,   \ beq t2,zero,done
9382F2FF ,   \ addi t0,t0,-1
1303F3FF ,   \ addi t1,t1,-1
03CE0200 ,   \ lbu t3,0(t0)
2300C301 ,   \ sb t3,0(t1)
9383F3FF ,   \ addi t2,t2,-1
6FF09FFE ,   \ jal zero,bk
;                            \ done:

\ bcmp ( a an b bn -- c )  two byte strings in order: -1, 0 or 1 (a
\ shorter one that begins the other comes first).
: bcmp
032E0100 ,   \ lw t3,0(sp)
83234100 ,   \ lw t2,4(sp)
03238100 ,   \ lw t1,8(sp)
8322C100 ,   \ lw t0,12(sp)
1301C100 ,   \ addi sp,sp,12
B30E0300 ,   \ add t4,t1,zero
6364C301 ,   \ bltu t1,t3,lp
B30E0E00 ,   \ add t4,t3,zero
638A0E02 ,   \ beq t4,zero,lens
03CF0200 ,   \ lbu t5,0(t0)
83CF0300 ,   \ lbu t6,0(t2)
631AFF01 ,   \ bne t5,t6,diff
93821200 ,   \ addi t0,t0,1
93831300 ,   \ addi t2,t2,1
938EFEFF ,   \ addi t4,t4,-1
6FF05FFE ,   \ jal zero,lp
6366FF01 ,   \ bltu t5,t6,less
13051000 ,   \ addi a0,zero,1
6F000002 ,   \ jal zero,out
1305F0FF ,   \ addi a0,zero,-1
6F008001 ,   \ jal zero,out
6308C301 ,   \ beq t1,t3,eq
E36AC3FF ,   \ bltu t1,t3,less
13051000 ,   \ addi a0,zero,1
6F008000 ,   \ jal zero,out
13050000 ,   \ addi a0,zero,0
2320A100 ,   \ sw a0,0(sp)
;

\ ── virtio-blk (legacy MMIO, one queue, one request at a time) ──

:M QN 40 lit ;               \ 64 descriptors: a header, up to 32 pages, a status

: bk     variable ;          \ the device's registers
: bq     variable ;          \ its queue: two pages
: bav    variable ;          \ requests made
: bhdr   variable ;          \ a request's header (16 bytes), its status at +16
: bflush variable ;          \ the device takes flushes
: brn    variable ;
: brl    variable ;
: brd1   variable ;          \ a one-buffer list
: bdev   variable ;          \ the device's mutex
: birq   variable ;          \ its interrupt (0: requests are polled)
: bcap   variable ;          \ its size, in 4 KiB pages

\ blkfind ( -- base | 0 )  the virtio-mmio slot holding a disk.
: blkfind
0 lit 10001000 lit
begin dup 10009000 lit u< while
	over 0= if
		dup @ 74726976 lit = if dup 8 lit + @ 2 lit = if nip dup then then
	then
	1000 lit +
repeat
drop ;

\ dsc! ( addr len word i -- )  descriptor i; word = flags | next << 16.
: dsc!
4 lit lshift bq @ +
tuck C lit + !
tuck 8 lit + !
0 lit over 4 lit + !
! ;

: blkinit
blkfind dup 0= if "no virtio-blk device" panic then bk !
0 lit bk @ 70 lit + !        \ reset
1 lit bk @ 70 lit + !        \ acknowledged
3 lit bk @ 70 lit + !        \ a driver
0 lit bk @ 14 lit + !
bk @ 10 lit + @ 200 lit and dup bflush !   \ VIRTIO_BLK_F_FLUSH, if offered
bk @ 20 lit + !
1000 lit bk @ 28 lit + !     \ 4 KiB pages
0 lit bk @ 30 lit + !
bk @ 34 lit + @ QN u< if "virtio-blk queue too small" panic then
QN bk @ 38 lit + !
1000 lit bk @ 3C lit + !
3 lit pgalloc dup 0= if "no memory for the disk's queue" panic then dup bq ! 3000 lit mzero
bq @ C lit rshift bk @ 40 lit + !
20 lit alloc bhdr !  4 lit alloc brd1 !
0 lit bav !  0 lit bdev !  0 lit birq !
bk @ 100 lit + @ 3 lit rshift  bk @ 104 lit + @ 1D lit lshift or bcap !   \ 512-byte sectors, in pages
7 lit bk @ 70 lit + ! ;      \ running

\ bwait  until the device has done the request made: asleep in a call
\ (woken by its interrupt), else polling.
: bdone?  bq @ 1002 lit + h@ bav @ FFFF lit and = ;
: bwait
kthr? birq @ and if
	begin klk @ lock bdone? if klk @ unlock 1 lit else bq @ kwaiton 0 lit then until
else
	begin bdone? until
then ;

\ kblkirq  the device's interrupt: acknowledged, its waiters woken.
: kblkirq  bk @ 60 lit + @ bk @ 64 lit + !  klk @ lock bq @ fwake klk @ unlock ;

\ breq ( type sector list n -- )  one request, waited for, bdev held: type
\ 0 reads n pages into the buffers listed, 1 writes them, 4 flushes (n 0).
: breq
brn ! brl !
bhdr @ 8 lit + !
dup bhdr @ !
0 lit bhdr @ 4 lit + !
0 lit bhdr @ C lit + !
FF lit bhdr @ 10 lit + c!
bhdr @ 10 lit 10001 lit 0 lit dsc!
brn @ if
	brn @ 0 lit do
		i 2 lit lshift brl @ + @ 1000 lit
		2 lit pick 0= if 3 lit else 1 lit then
		i 2 lit + 10 lit lshift or
		i 1 lit + dsc!
	loop
then
drop
bhdr @ 10 lit + 1 lit 2 lit brn @ 1 lit + dsc!
bav @ QN 1 lit - and 1 lit lshift bq @ 404 lit + + 0 lit swap h!
fence
bav @ 1 lit + dup bav ! bq @ 402 lit + h!
fence
0 lit bk @ 50 lit + !
bwait
fence
bhdr @ 10 lit + c@ if "virtio-blk request failed" panic then ;

\ blkreq ( type p list n -- )  a request of n pages from the store's page
\ p; blk1 ( type p buf -- ) of one; bflsh  a flush.
: psec   SBASE + 3 lit lshift ;                            \ ( p -- sector )
: blkreq  bdev kmlock rot psec -rot breq bdev kmunlock ;
: blk1    bdev kmlock brd1 @ ! psec brd1 @ 1 lit breq bdev kmunlock ;
: bflsh   bflush @ if bdev kmlock 4 lit 0 lit 0 lit 0 lit breq bdev kmunlock then ;

\ ── The calling context: the transaction worked on ──
\
\ A transaction is a page: its fields below, then its scratch (locals,
\ the path down, its key, value and cells).  tx is found at 352 of the
\ trap area (a thread's block, or a hart's own).

:M tx                               \ ( -- txn )  (inline, as the three below)
1301C1FF ,   \ addi sp,sp,-4
F3220034 ,   \ csrrs t0,mscratch,zero
83A20216 ,   \ lw t0,0x160(t0)
23205100 ,   \ sw t0,0(sp)
;
: tx!   area@ 160 lit + ! ;          \ ( txn -- )
:M x@                                \ ( off -- v )
03230100 ,   \ lw t1,0(sp)
F3220034 ,   \ csrrs t0,mscratch,zero
83A20216 ,   \ lw t0,0x160(t0)
B3826200 ,   \ add t0,t0,t1
83A20200 ,   \ lw t0,0(t0)
23205100 ,   \ sw t0,0(sp)
;
:M x!                                \ ( v off -- )
03230100 ,   \ lw t1,0(sp)
83234100 ,   \ lw t2,4(sp)
13018100 ,   \ addi sp,sp,8
F3220034 ,   \ csrrs t0,mscratch,zero
83A20216 ,   \ lw t0,0x160(t0)
B3826200 ,   \ add t0,t0,t1
23A07200 ,   \ sw t2,0(t0)
;
:M xa                                \ ( off -- addr )
03230100 ,   \ lw t1,0(sp)
F3220034 ,   \ csrrs t0,mscratch,zero
83A20216 ,   \ lw t0,0x160(t0)
B3826200 ,   \ add t0,t0,t1
23205100 ,   \ sw t0,0(sp)
;

:M XTREE   0 lit ;  :M XKIND   4 lit ;  :M XTXID   8 lit ;  :M XROOT   C lit ;
:M XCNT   10 lit ;  :M XRSLOT 14 lit ;  :M XNDIRTY 18 lit ; :M XNFREED 1C lit ;
:M XNPIN  20 lit ;  :M XDEPTH 24 lit ;  :M XBMAP  28 lit ;  :M XDIRTY 2C lit ;
:M XFREED 30 lit ;  :M XTMP   34 lit ;  :M XTMP2  38 lit ;  :M XKLEN  3C lit ;
:M XVLEN  40 lit ;  :M XSKLEN 44 lit ;  :M XERR   48 lit ;  :M XCHG   4C lit ;
:M S0 50 lit ;  :M S1 54 lit ;  :M S2 58 lit ;  :M S3 5C lit ;     \ the searches' locals
:M L0 60 lit ;  :M L1 64 lit ;  :M L2 68 lit ;  :M L3 6C lit ;     \ the ops'
:M L4 70 lit ;  :M L5 74 lit ;  :M L6 78 lit ;  :M L7 7C lit ;     \ a page's cells'
:M XPINS 80 lit ;            \ the cache slots this call pinned (32)
:M XPPG 100 lit ;            \ the path down: pages (16),
:M XPIX 140 lit ;            \ the child taken at each,
:M XPBUF 180 lit ;           \ and their buffers
:M Q0 1C0 lit ;  :M Q1 1C4 lit ;  :M Q2 1C8 lit ;  :M Q3 1CC lit ;  \ a split's
:M Q4 1D0 lit ;  :M Q5 1D4 lit ;  :M Q6 1D8 lit ;  :M Q7 1DC lit ;
:M R0 1E0 lit ;  :M R1 1E4 lit ;  :M R2 1E8 lit ;  :M R3 1EC lit ;  \ the level above's
:M P0 1F0 lit ;  :M P1 1F4 lit ;  :M P2 1F8 lit ;  :M P3 1FC lit ;  \ palloc's
:M XKEY 200 lit ;            \ the key (256 bytes)
:M XSKEY 300 lit ;           \ a separator going up (256)
:M XVAL 400 lit ;            \ the value (1 KiB)
:M XCELL 800 lit ;           \ a leaf's cell being put (to 0xE00)
:M XCELL2 E00 lit ;          \ a branch's (to 0xF00)
:M XWL F00 lit ;             \ a write's buffers (32)

: pp!   2 lit lshift XPPG + x! ;     \ ( p d -- )
: pp@   2 lit lshift XPPG + x@ ;     \ ( d -- p )
: pix!  2 lit lshift XPIX + x! ;
: pix@  2 lit lshift XPIX + x@ ;
: pb!   2 lit lshift XPBUF + x! ;
: pb@   2 lit lshift XPBUF + x@ ;

\ ── Locks, and waking ──

\ spga ( n -- addr | 0 ), spgf ( addr n -- )  pages from the kernel's
\ allocator, which klk guards (the store's calls run without it).
: spga  klk @ lock pgalloc klk @ unlock ;
: spgf  klk @ lock pgfree klk @ unlock ;

: stlk   variable ;          \ the store's spin lock
: stl    stlk @ lock ;
: stu    stlk @ unlock ;
\ stwake ( token -- )  those asleep on token woken (none outside the OS).
: stwake  kready @ if klk @ lock fwake klk @ unlock else drop then ;

\ ── The page cache ──

: cbase  variable ;          \ the slots' buffers
: cpg    variable ;          \ each slot's page
: cfl    variable ;          \ its flags: 1 used, 2 dirty, 4 recently used, 8 being read
: cpn    variable ;          \ its pins: calls using it now
: pslot  variable ;          \ each page's slot + 1 (0: not cached)
: chand  variable ;          \ the clock's hand
: npg    variable ;          \ the store's pages

: sbuf   C lit lshift cbase @ + ;              \ ( s -- buf )
: bslot  cbase @ - C lit rshift ;              \ ( buf -- s )
: cfl@   2 lit lshift cfl @ + @ ;              \ ( s -- flags )
: cfl!   2 lit lshift cfl @ + ! ;              \ ( flags s -- )
: cpg@   2 lit lshift cpg @ + @ ;
: cpg!   2 lit lshift cpg @ + ! ;              \ ( p s -- )
: cpn+   2 lit lshift cpn @ + dup @ 1 lit + swap ! ;   \ ( s -- )
: cpn-   2 lit lshift cpn @ + dup @ 1 lit - swap ! ;
: cpn@   2 lit lshift cpn @ + @ ;
: ps@    2 lit lshift pslot @ + @ ;            \ ( p -- s+1 | 0 )
: ps!    2 lit lshift pslot @ + ! ;            \ ( v p -- )

\ cevict ( -- s )  a slot to use, under stlk: a free one, or the clock's
\ (passing over one recently used once, and always one dirty, pinned or
\ being read).
: cevict
FFFFFFFF lit
NSLOT 1 lit lshift 0 lit do
	dup 0< if
		chand @ dup 1 lit + NSLOT 1 lit - and chand !
		dup cfl@ dup 1 lit and 0= if drop nip else
		dup A lit and 2 lit pick cpn@ or if 2drop else
		dup 4 lit and if 4 lit invert and swap cfl! else
			drop dup cpg@ 0 lit swap ps!  nip
		then then then
	then
loop
dup 0< if "store: the cache is full of pages in use" panic then ;

\ xpin ( s -- )  noted as pinned by this call; tunpin lets go of them all.
: xpin   XNPIN x@ dup 20 lit = if "store: too many pages pinned" panic then
         dup 1 lit + XNPIN x!  2 lit lshift XPINS + x! ;
: tunpin
stl XNPIN x@ ?dup if 0 lit do i 2 lit lshift XPINS + x@ cpn- loop then stu
0 lit XNPIN x! ;

\ pget ( p -- buf )  page p, pinned, read if it is not cached (the call
\ sleeping for it; one reading it meanwhile waits for that read).
: pget
begin
	stl
	dup ps@ ?dup if
		1 lit -  dup cfl@ 8 lit and if
			stu  klk @ lock dup cfl@ 8 lit and if sbuf kwaiton else drop klk @ unlock then  0 lit
		else
			dup cpn+  dup cfl@ 4 lit or over cfl!  stu  dup xpin  sbuf nip 1 lit
		then
	else
		cevict
		2dup cpg!  dup 1 lit + 2 lit pick ps!  9 lit over cfl!  dup cpn+  stu
		dup xpin  over over sbuf 0 lit -rot blk1
		stl dup cfl@ 8 lit invert and over cfl! stu
		sbuf dup stwake  nip 1 lit
	then
until ;

\ pslot! ( p -- buf )  page p's slot for this transaction to fill (a page
\ it made): pinned, dirty, its old contents (if cached) no matter.
: pslot!
stl
dup ps@ ?dup if 1 lit - nip else cevict 2dup cpg! dup 1 lit + rot ps! then
7 lit over cfl!  dup cpn+  stu
dup xpin sbuf ;

\ cdrop  every clean page no call is using forgotten (a cold cache, for
\ measuring reads).
: cdrop
stl NSLOT 0 lit do
	i cfl@ dup 1 lit and swap A lit and 0= and i cpn@ 0= and if i cpg@ 0 lit swap ps!  0 lit i cfl! then
loop stu ;

\ ── The pool ──

: hwm    variable ;          \ the first page never given out
: pseq   variable ;          \ the pool's meta's sequence
: pmlk   variable ;          \ the pool's meta's mutex
: pmbuf  variable ;          \ a page for metas
: stleak variable ;          \ free pages forgotten (a free list full)

\ cksum ( buf n -- x )  of n words: each rotated in.
: cksum  0 lit swap 0 lit do over i 2 lit lshift + @ swap dup 5 lit lshift swap 1B lit rshift or xor loop nip ;

\ pmeta ( -- )  the pool's meta written (pmlk held): its magic, sequence,
\ mark, size, checksum, at page 0 or 1 by the sequence.
: pmeta
pmbuf @ 1000 lit mzero
504C5453 lit pmbuf @ !  pseq @ pmbuf @ 4 lit + !  hwm @ pmbuf @ 8 lit + !  npg @ pmbuf @ C lit + !
pmbuf @ 4 lit cksum pmbuf @ 10 lit + !
1 lit pseq @ 1 lit and pmbuf @ blk1  bflsh ;

\ The trees open: 128 bytes each.
:M TM 0 lit ;  :M TREF 4 lit ;  :M TTX 8 lit ;  :M TROOT C lit ;  :M TCNT 10 lit ;
:M TWLK 14 lit ;  :M TFL 18 lit ;  :M TFN 1C lit ;  :M TCH 20 lit ;  :M TCE 24 lit ;
:M TFP 28 lit ;  :M TFPN 2C lit ;  :M TRD 30 lit ;  :M TNC 50 lit ;  :M TNW 54 lit ;
:M TFLO 58 lit ;              \ the first entry of the free list changed since the last commit
: trees  variable ;          \ the table
: stopen variable ;          \ the mutex for opening and closing
: gtr    variable ;          \ a record whose chunk new trees' meta pages come from
: fst    variable ;          \ the file system's tree

: trn  7 lit lshift trees @ + ;                 \ ( i -- T )
:M t@   + @ ;                                   \ ( T off -- v )
:M t!   + ! ;                                   \ ( v T off -- )

\ chunkn ( T n -- ok ), chunk ( T -- ok )  n new pages of the pool for T
\ (a chunk), the mark moved on and written before they are used.  0 when
\ the disk is full.
: chunkn
pmlk kmlock
stl hwm @ dup 2 lit pick + dup npg @ u> if
	2drop stu pmlk kmunlock 2drop 0 lit
else
	hwm !  pseq @ 1 lit + pseq !  stu
	pmeta pmlk kmunlock
	stl rot 2dup TCH t!  -rot + swap TCE t! stu 1 lit
then ;
: chunk  CHUNK chunkn ;

\ minr ( T -- txid+1 )  its oldest reader's snapshot, plus 1 (none: all).
: minr  FFFFFFFF lit RMAX 0 lit do over TRD + i 2 lit lshift + @ ?dup if 2dup u< if drop else nip then then loop nip ;

\ flpush ( p tag T -- )  a free page for T (stlk held); tag: the commit that
\ freed it (0: none can see it).
: flpush
dup TFN t@ FLMAX = if drop 2drop stleak @ 1 lit + stleak ! else
	dup TFN t@ over TFLO t@ u< if dup TFN t@ over TFLO t! then
	dup TFN t@ 3 lit lshift over TFL t@ +  rot over 4 lit + !  rot swap !
	dup TFN t@ 1 lit + swap TFN t!
then ;

\ palloc ( -- p | 0 )  a page for this transaction: from its tree's free
\ list (the last one no reader can see: taken from the end, the list's
\ front stays as the last commit wrote it), else its chunk, else a new
\ chunk.
: palloc
XTREE x@ P0 x!  0 lit P1 x!
stl
P0 x@ minr P2 x!
P0 x@ TFN t@ begin dup if P0 x@ TFL t@ over 1 lit - 3 lit lshift + 4 lit + @ P2 x@ u< 0= else 0 lit then while 1 lit - repeat
?dup if
	1 lit -
	P0 x@ TFL t@ over 3 lit lshift + @ P1 x!
	dup P0 x@ TFLO t@ u< if dup P0 x@ TFLO t! then
	P0 x@ TFN t@ 1 lit - dup P0 x@ TFN t!  3 lit lshift P0 x@ TFL t@ +  swap 3 lit lshift P0 x@ TFL t@ +  8 lit mcpy
then
P1 x@ 0= if P0 x@ TCH t@ P0 x@ TCE t@ u< if P0 x@ TCH t@ dup P1 x! 1 lit + P0 x@ TCH t! then then
stu
P1 x@ 0= if P0 x@ chunk if stl P0 x@ TCH t@ dup P1 x! 1 lit + P0 x@ TCH t! stu then then
P1 x@ ;

\ ── Trees: opened, closed, made ──
\
\ A tree's meta page: its magic, the commit's number, the root (0: empty),
\ the entries, the free list's last page and its count, its chunk (the
\ next page, the page past), a checksum of those eight words.  A crash
\ leaves the chunk as the commit had it: what a lost transaction took
\ from it is free again.

: mvalid  dup @ 52545453 lit = if dup 8 lit cksum swap 20 lit + @ = else drop 0 lit then ;   \ ( buf -- ok )

: tmp2 variable ;            \ two pages for reading metas and lists (under stopen)

\ tload ( m -- T | 0 )  a tree read in: its newer whole meta page, and its
\ free list.  0 if neither meta page is whole, or no room.
: tload
0 lit TMAX 0 lit do dup 0= if i trn dup TREF t@ if drop else nip then then loop
dup 0= if nip else
	over tmp2 @ 0 lit -rot blk1
	over 1 lit + tmp2 @ 1000 lit + 0 lit -rot blk1
	tmp2 @ mvalid tmp2 @ 1000 lit + mvalid
	2dup and if drop drop tmp2 @ 4 lit + @ tmp2 @ 1004 lit + @ u< if tmp2 @ 1000 lit + else tmp2 @ then else
	if drop tmp2 @ 1000 lit + else if tmp2 @ else 0 lit then then then          \ ( m T meta|0 )
	?dup 0= if 2drop 0 lit else
		21 lit spga ?dup 0= if 2drop drop 0 lit else          \ ( m T meta fl )
			2 lit pick 80 lit mzero
			2 lit pick TFL t!
			dup 4 lit + @ 2 lit pick TTX t!
			dup 8 lit + @ 2 lit pick TROOT t!
			dup C lit + @ 2 lit pick TCNT t!
			dup 18 lit + @ 2 lit pick TCH t!
			dup 1C lit + @ 2 lit pick TCE t!
			dup 14 lit + @ dup 3 lit pick TFN t!  dup 3 lit pick TFLO t!  3FC lit + 3FD lit / 2 lit pick TFPN t!
			10 lit + @                                       \ ( m T last )
			over TFL t@ 20000 lit + 2 lit pick TFP t!
			begin ?dup while
				dup tmp2 @ 0 lit -rot blk1
				tmp2 @ 8 lit + @ 3FD lit /  2 lit pick TFP t@ swap 2 lit lshift + !
				tmp2 @ 4 lit + @ ?dup if 0 lit do
					tmp2 @ i 2 lit lshift + C lit + @  over TFL t@ tmp2 @ 8 lit + @ i + 3 lit lshift + tuck !  0 lit swap 4 lit + !
				loop then
				tmp2 @ @
			repeat
			tuck TM t!
			1 lit over TREF t!
		then
	then
then ;

\ topen ( m -- T | 0 )  the tree whose meta pages are m and m+1.
: topen
stopen kmlock
0 lit TMAX 0 lit do dup 0= if i trn dup TREF t@ if dup TM t@ 3 lit pick = if nip else drop then else drop then then loop
?dup if nip dup TREF t@ 1 lit + over TREF t! else tload then
stopen kmunlock ;

\ tclose ( T -- )  opened once fewer; forgotten with the last.  tclose?
\ ( T -- ok ) the same unless another is opening or closing a tree (for
\ a hart, which must not wait).
: tclose0
dup TREF t@ 1 lit - dup 2 lit pick TREF t!
0= if dup TFL t@ 21 lit spgf  80 lit mzero else drop then ;
: tclose   stopen kmlock tclose0 stopen kmunlock ;
: tclose?  stopen kmtry if tclose0 stopen kmunlock 1 lit else drop 0 lit then ;

\ tinit ( m -- )  an empty tree's meta pages at m and m+1, written.
: tinit
tmp2 @ 1000 lit mzero
52545453 lit tmp2 @ !  tmp2 @ 8 lit cksum tmp2 @ 20 lit + !
1 lit over tmp2 @ blk1
tmp2 @ 1000 lit mzero  1 lit swap 1 lit + tmp2 @ blk1
bflsh ;

\ tcreate ( -- m | 0 )  a new tree, empty, its meta pages written: m.
: tcreate
stopen kmlock
gtr @ 2 lit chunkn if
	gtr @ TCH t@ dup tinit
else 0 lit then
stopen kmunlock ;

\ ── Transactions ──

\ own? ( p -- flag ), own! own0 ( p -- )  a page this transaction made.
: obit  dup 5 lit rshift 2 lit lshift XBMAP x@ +  1 lit rot 1F lit and lshift ;   \ ( p -- addr bit )
: own?  obit swap @ and ;
: own!  obit over @ or swap ! ;
: own0  obit invert over @ and swap ! ;

\ dpush ( p -- ), fpush ( p -- )  a page this transaction made, or freed
\ (one a commit had: free once it commits); too many, and it fails.
: dpush  XNDIRTY x@ DLMAX = if drop 1 lit XERR x! else XNDIRTY x@ 2 lit lshift XDIRTY x@ + !  XNDIRTY x@ 1 lit + XNDIRTY x! then ;
: fpush  XNFREED x@ DLMAX = if drop 1 lit XERR x! else XNFREED x@ 2 lit lshift XFREED x@ + !  XNFREED x@ 1 lit + XNFREED x! then ;

: bmpages  npg @ 7FFF lit + F lit rshift ;         \ ( -- n )  the bitmap's pages

\ tfree  a transaction's memory given back (tx 0 after).
: tfree
XKIND x@ 2 lit = if
	XBMAP x@ ?dup if bmpages spgf then
	XDIRTY x@ ?dup if 8 lit spgf then
	XFREED x@ ?dup if 8 lit spgf then
	XTMP x@ ?dup if 1 lit spgf then
	XTMP2 x@ ?dup if 1 lit spgf then
then
tx 1 lit spgf  0 lit tx! ;

\ tbegin ( T kind -- txn | 0 )  a transaction on T, now the calling one's:
\ kind 1 a reader (a snapshot of its last commit; 0 if it has RMAX
\ already), 2 its writer (waiting for the writer before it to finish).
: tbegin
1 lit spga ?dup 0= if 2drop 0 lit else
	dup 1000 lit mzero  dup tx!  tuck XKIND + !  tuck XTREE + !  drop
	XKIND x@ 1 lit = if
		stl
		0 lit RMAX 0 lit do dup 0= if XTREE x@ TRD + i 2 lit lshift + @ 0= if drop i 1 lit + then then loop
		?dup if
			dup XRSLOT x!  XTREE x@ TTX t@ 1 lit +  XTREE x@ TRD + rot 1 lit - 2 lit lshift + !
			XTREE x@ TTX t@ XTXID x!  XTREE x@ TROOT t@ XROOT x!  XTREE x@ TCNT t@ XCNT x!
			stu
		else stu tfree then
	else
		XTREE x@ TWLK + kmlock
		stl XTREE x@ TTX t@ 1 lit + XTXID x!  XTREE x@ TROOT t@ XROOT x!  XTREE x@ TCNT t@ XCNT x! stu
		bmpages spga dup XBMAP x!  8 lit spga dup XDIRTY x!  8 lit spga dup XFREED x!
		1 lit spga dup XTMP x!  1 lit spga dup XTMP2 x!
		and and and and if
			XBMAP x@ bmpages C lit lshift mzero
		else XTREE x@ TWLK + kmunlock tfree then
	then
then
tx ;

\ tend  the transaction over: its reader's place, or the writer, given up.
: tend
tunpin
XKIND x@ 1 lit = if
	stl 0 lit XTREE x@ TRD + XRSLOT x@ 1 lit - 2 lit lshift + ! stu
	tfree
else
	XTREE x@ TWLK +  tfree  kmunlock
then ;

\ pnew ( -- p buf | 0 0 )  a new page of this transaction's, cached, dirty,
\ its header zero; 0 0 if there is none to be had (XERR then set).
: pnew
palloc ?dup 0= if 1 lit XERR x! 0 lit 0 lit else
	dup own! dup dpush dup pslot! dup 10 lit mzero
then ;

\ pwr ( p -- p' buf | 0 0 )  page p to change: itself if this transaction
\ made it, else a copy (p freed when this commits).
: pwr
dup own? if
	dup pget  stl dup bslot dup cfl@ 2 lit or swap cfl! stu
else
	dup pget S3 x!  pnew dup if
		S3 x@ over 1000 lit mcpy  rot fpush  1 lit XCHG x!
	else rot drop then
then ;

\ pdrop ( p -- )  a page of the tree no longer used: free now if this
\ transaction made it, else once it commits.
: pdrop
dup own? if
	dup own0
	stl dup ps@ ?dup if 1 lit - dup cfl@ 2 lit invert and swap cfl! then
	0 lit XTREE x@ flpush stu
else fpush then
1 lit XCHG x! ;

\ ── A page's cells ──

: pty    h@ ;                                    \ ( b -- type )
: pcnt   2 lit + h@ ;                            \ ( b -- n )
: pinit  dup 10 lit mzero  tuck h!  1000 lit swap 4 lit + h! ;   \ ( type b -- )
: slot@  1 lit lshift C lit + + h@ ;             \ ( b i -- off )
: slot!  1 lit lshift C lit + + h! ;             \ ( off b i -- )
: cell   over swap slot@ + ;                     \ ( b i -- c )
: lks    dup 4 lit + swap h@ ;                   \ ( c -- key n )  a leaf's
: lvs    dup 4 lit + over h@ + swap 2 lit + h@ ; \ ( c -- value n )
: bks    dup 8 lit + swap h@ ;                   \ ( c -- key n )  a branch's
: bch    4 lit + @ ;                             \ ( c -- child )
: ckof   swap pty 1 lit = if lks else bks then ; \ ( b c -- key n )
: csize  swap pty 1 lit = if dup h@ swap 2 lit + h@ + 4 lit + else h@ 8 lit + then 3 lit + FFFFFFFC lit and ;   \ ( b c -- n )
: pfree? 1000 lit over pcnt 1 lit lshift C lit + - swap 6 lit + h@ - ;   \ ( b -- free bytes )

\ pput ( src n b i -- )  a cell of n bytes put at i (room is there, in one
\ piece).
: pput
L5 x! L4 x! L6 x! L7 x!
L4 x@ 4 lit + h@ L6 x@ - dup L4 x@ 4 lit + h!
L7 x@ over L4 x@ + L6 x@ bcpy
L4 x@ C lit + L5 x@ 1 lit lshift +  dup 2 lit +  L4 x@ pcnt L5 x@ - 1 lit lshift  bcpy
L4 x@ L5 x@ slot!
L4 x@ pcnt 1 lit + L4 x@ 2 lit + h!
L4 x@ 6 lit + h@ L6 x@ + L4 x@ 6 lit + h! ;

\ pdel ( b i -- )  cell i taken out (its bytes a hole until pcomp).
: pdel
L5 x! L4 x!
L4 x@ dup L5 x@ cell csize
L4 x@ 6 lit + h@ swap - L4 x@ 6 lit + h!
L4 x@ C lit + L5 x@ 1 lit + 1 lit lshift +  dup 2 lit -  L4 x@ pcnt L5 x@ - 1 lit - 1 lit lshift  bcpy
L4 x@ pcnt 1 lit - L4 x@ 2 lit + h! ;

\ pcomp ( b -- )  its cells made one piece again (by way of XTMP2).
: pcomp
dup XTMP2 x@ 1000 lit mcpy
dup h@ over pinit
XTMP2 x@ 8 lit + @ over 8 lit + !
XTMP2 x@ pcnt ?dup if 0 lit do
	XTMP2 x@ i cell  XTMP2 x@ over csize  2 lit pick dup pcnt pput
loop then
drop ;

\ pfit ( b n -- ok )  room for a cell of n bytes made in b, if b has it.
: pfit
over pfree? over 2 lit + u< if 2drop 0 lit else
	over dup 4 lit + h@ swap pcnt 1 lit lshift C lit + - over 2 lit + u< if over pcomp then
	2drop 1 lit
then ;

\ lsrch ( b key n -- i found )  where key is, or would go, in a leaf.
: lsrch
S2 x! S1 x! S0 x!
0 lit S0 x@ pcnt
begin 2dup u< while
	2dup + 1 lit rshift
	S0 x@ dup 2 lit pick cell ckof S1 x@ S2 x@ bcmp 0< if rot drop 1 lit + swap else nip then
repeat
drop
dup S0 x@ pcnt u< if S0 x@ over cell S0 x@ swap ckof S1 x@ S2 x@ bcmp 0= else 0 lit then ;

\ bsrch ( b key n -- ci )  the child of a branch holding key: the cells
\ whose key is key or before it.
: bsrch
S2 x! S1 x! S0 x!
0 lit S0 x@ pcnt
begin 2dup u< while
	2dup + 1 lit rshift
	S0 x@ dup 2 lit pick cell ckof S1 x@ S2 x@ bcmp 1 lit < if rot drop 1 lit + swap else nip then
repeat
drop ;

: child   ?dup if 1 lit - cell bch else 8 lit + @ then ;    \ ( b ci -- p )
: child!  ?dup if 1 lit - cell 4 lit + ! else 8 lit + ! then ;  \ ( p b ci -- )

\ ── Down the tree ──

\ rdown ( -- b | 0 )  the leaf where the key (XKEY) is or would go, the
\ path to it noted (XPPG, XPBUF, XPIX, XDEPTH its level); 0 if the tree
\ is empty.
: rdown
0 lit XDEPTH x!  XROOT x@
dup if
	begin
		XDEPTH x@ 10 lit = if "store: a tree too deep" panic then
		dup pget
		over XDEPTH x@ pp!  dup XDEPTH x@ pb!  nip
		dup pty 1 lit = if 1 lit else
			dup XKEY xa XKLEN x@ bsrch
			dup XDEPTH x@ pix!  child
			XDEPTH x@ 1 lit + XDEPTH x!  0 lit
		then
	until
then ;

\ wdown ( -- b | 0 )  the same, each page on the way made this
\ transaction's (pwr) and its parent pointed at it; an empty tree gets a
\ leaf.  0 if a page could not be had.
: wdown
0 lit XDEPTH x!
XROOT x@ 0= if pnew ?dup if 1 lit swap pinit XROOT x! 1 lit XCHG x! else drop then then
XROOT x@ ?dup if
	pwr ?dup if
		over XROOT x!
		begin
			XDEPTH x@ 10 lit = if "store: a tree too deep" panic then
			over XDEPTH x@ pp!  dup XDEPTH x@ pb!  nip
			dup pty 1 lit = if 1 lit else
				dup XKEY xa XKLEN x@ bsrch
				dup XDEPTH x@ pix!
				2dup child pwr ?dup if
					L0 x!  dup L1 x!  -rot child!
					XDEPTH x@ 1 lit + XDEPTH x!
					L1 x@ L0 x@  0 lit
				else 2drop 2drop 0 lit 1 lit then
			then
		until
	else drop 0 lit then
else 0 lit then ;

\ ── Splits ──
\
\ A full page splits in two: its cells and the new one in order (vcell k:
\ the kth of them, the new one at Q5), copied out to XTMP first.

: vcell  dup Q5 x@ = if drop Q6 x@ Q7 x@ else dup Q5 x@ u> if 1 lit - then XTMP x@ swap cell XTMP x@ over csize then ;   \ ( k -- c n )
: vn     XTMP x@ pcnt 1 lit + ;                  \ ( -- n )  how many
: vhalf  XTMP x@ 6 lit + h@ Q7 x@ + 1 lit rshift ;   \ ( -- n )  half their bytes
: papp   dup pcnt pput ;                         \ ( c n b -- )  a cell put last

\ pins ( rp -- ok )  the page rp, holding the keys from XSKEY on, put in
\ the level above the one just split (XDEPTH), splitting that in turn
\ when full (its middle cell going up, the left half keeping the cells
\ before it, the right those after, its first child the middle's), up to
\ a new root.
: pins
R0 x!  XDEPTH x@ R1 x!
begin
	XSKLEN x@ XCELL2 xa h!  0 lit XCELL2 xa 2 lit + h!  R0 x@ XCELL2 xa 4 lit + !
	XSKEY xa XCELL2 xa 8 lit + XSKLEN x@ bcpy
	XSKLEN x@ 8 lit + 3 lit + FFFFFFFC lit and R2 x!
	R1 x@ 0= if
		pnew ?dup if
			2 lit over pinit  XROOT x@ over 8 lit + !
			XCELL2 xa R2 x@ rot 0 lit pput  XROOT x!  1 lit
		else drop 0 lit then  1 lit
	else
		R1 x@ 1 lit - R1 x!
		R1 x@ pb@ R2 x@ pfit if
			XCELL2 xa R2 x@ R1 x@ pb@ R1 x@ pix@ pput  1 lit 1 lit
		else
			R1 x@ pb@ XTMP x@ 1000 lit mcpy
			R1 x@ pix@ Q5 x!  XCELL2 xa Q6 x!  R2 x@ Q7 x!
			pnew ?dup 0= if drop 0 lit 1 lit else
				R3 x!  R0 x!
				2 lit R1 x@ pb@ pinit  XTMP x@ 8 lit + @ R1 x@ pb@ 8 lit + !
				2 lit R3 x@ pinit
				0 lit Q0 x!  FFFFFFFF lit Q1 x!
				vn 0 lit do
					Q1 x@ 0< if i vcell nip Q0 x@ + dup Q0 x! vhalf u< 0= if i Q1 x! then then
				loop
				Q1 x@ 0< if vn 1 lit - Q1 x! then
				vn 0 lit do
					i vcell
					i Q1 x@ u< if R1 x@ pb@ papp else
					i Q1 x@ = if
						drop dup bks dup XSKLEN x! XSKEY xa swap bcpy  bch R3 x@ 8 lit + !
					else R3 x@ papp then then
				loop
				0 lit
			then
		then
	then
until ;

\ lsplit ( b i n -- ok )  leaf b, full, split for the cell at XCELL (n
\ bytes) to go at i: the first cells to b until it holds half their bytes
\ (and at least one, and one left for the right), the rest to a new page,
\ whose first key goes up.
: lsplit
Q7 x!  Q5 x!  dup XTMP x@ 1000 lit mcpy  XCELL xa Q6 x!
pnew ?dup 0= if 2drop 0 lit else
	Q3 x!  Q2 x!  Q4 x!
	1 lit Q4 x@ pinit  1 lit Q3 x@ pinit
	0 lit Q0 x!
	vn 0 lit do
		i vcell
		i 0= Q0 x@ vhalf u< i vn 1 lit - u< and or if
			dup Q0 x@ + Q0 x!  Q4 x@ papp
		else Q3 x@ papp then
	loop
	Q3 x@ 0 lit cell lks dup XSKLEN x! XSKEY xa swap bcpy
	Q2 x@ pins
then ;

\ ── The operations ──
\
\ On the calling transaction (tx), the key at XKEY (XKLEN bytes), a value
\ at XVAL (XVLEN).  Each pins the pages it uses; tunpin lets them go.

\ tput ( -- ok )  the key's value set (the key added if new).  0 if the
\ key or value is too long, or no page could be had (XERR: the
\ transaction then fails).
: tput
XKLEN x@ 1 lit - FF lit u< 0= XVLEN x@ 400 lit u> or if 0 lit else
	XKLEN x@ XCELL xa h!  XVLEN x@ XCELL xa 2 lit + h!
	XKEY xa XCELL xa 4 lit + XKLEN x@ bcpy
	XVAL xa XCELL xa 4 lit + XKLEN x@ + XVLEN x@ bcpy
	XKLEN x@ XVLEN x@ + 4 lit + 3 lit + FFFFFFFC lit and L2 x!
	wdown ?dup 0= if 0 lit else
		dup L3 x!  XKEY xa XKLEN x@ lsrch
		if dup L3 x@ swap pdel else XCNT x@ 1 lit + XCNT x! then
		1 lit XCHG x!
		L3 x@ L2 x@ pfit if XCELL xa L2 x@ L3 x@ 3 lit pick pput drop 1 lit
		else L3 x@ swap L2 x@ lsplit then
	then
then ;

\ dempty  the leaf at XDEPTH, emptied, gone: out of its parent (a branch
\ left without a child goes too; a root left with one gives way to it).
: dempty
XDEPTH x@ L2 x!
begin
	L2 x@ pp@ pdrop
	L2 x@ 0= if 0 lit XROOT x!  1 lit else
		L2 x@ 1 lit - L2 x!  L2 x@ pb@ L3 x!
		L2 x@ pix@ ?dup if 1 lit - L3 x@ swap pdel 1 lit else
			L3 x@ pcnt if L3 x@ 0 lit cell bch L3 x@ 8 lit + !  L3 x@ 0 lit pdel 1 lit else 0 lit then
		then
		dup if L2 x@ 0= L3 x@ pcnt 0= and if L3 x@ 8 lit + @ XROOT x!  0 lit pp@ pdrop then then
	then
until ;

\ tdel ( -- found )  the key taken out, if it is there.
: tdel
rdown dup if XKEY xa XKLEN x@ lsrch nip then
dup if
	drop wdown ?dup if
		dup XKEY xa XKLEN x@ lsrch drop over swap pdel
		XCNT x@ 1 lit - XCNT x!  1 lit XCHG x!
		pcnt 0= if dempty then 1 lit
	else 0 lit then
then ;

\ tget ( buf max -- n | -1 )  the key's value to buf (at most max bytes):
\ its length, or -1 if the key is not there.
: tget
rdown ?dup if
	dup XKEY xa XKLEN x@ lsrch if
		cell lvs L2 x!  -rot  L2 x@ 2dup u< if drop else nip then bcpy  L2 x@
	else 2drop 2drop FFFFFFFF lit then
else 2drop FFFFFFFF lit then ;

\ tnext ( buf -- n | -1 )  the first key after the key (the first of all,
\ if XKLEN is 0) to buf: its length, or -1 if there is none.
: tnext
rdown ?dup if
	dup L2 x!  XKEY xa XKLEN x@ lsrch if 1 lit + then L3 x!
	begin
		L3 x@ L2 x@ pcnt u< if
			L2 x@ L3 x@ cell lks dup L1 x! rot swap bcpy  L1 x@ 1 lit
		else
			FFFFFFFF lit L0 x!
			XDEPTH x@ ?dup if 0 lit do
				L0 x@ 0< if XDEPTH x@ 1 lit - i - dup pix@ over pb@ pcnt u< if L0 x! else drop then then
			loop then
			L0 x@ 0< if drop FFFFFFFF lit 1 lit else
				L0 x@ pix@ 1 lit + dup L0 x@ pix!  L0 x@ pb@ swap child
				L0 x@ 1 lit + XDEPTH x!
				begin
					dup pget  over XDEPTH x@ pp!  dup XDEPTH x@ pb!  nip
					dup pty 1 lit = if L2 x!  0 lit L3 x!  1 lit else
						0 lit XDEPTH x@ pix!  8 lit + @  XDEPTH x@ 1 lit + XDEPTH x!  0 lit
					then
				until
				0 lit
			then
		then
	until
else drop FFFFFFFF lit then ;

\ ── Commit and abort ──

\ tabort  the transaction undone: its pages free again, nothing written.
: tabort
tunpin
XKIND x@ 2 lit = if
	stl
	XNDIRTY x@ ?dup if 0 lit do
		i 2 lit lshift XDIRTY x@ + @ dup own? if
			dup own0
			dup ps@ ?dup if 1 lit - 0 lit swap cfl!  0 lit over ps! then
			0 lit XTREE x@ flpush
		else drop then
	loop then
	stu
then
tend ;

\ wrun ( p n -- )  n pages from p, this transaction's (in the cache),
\ written in one request and then clean.
: wrun
?dup if
	2dup 0 lit do dup i + ps@ 1 lit - sbuf i 2 lit lshift XWL + x! loop drop
	2dup 1 lit -rot XWL xa swap blkreq
	XTREE x@ TNW t@ over + XTREE x@ TNW t!
	stl 0 lit do dup i + ps@ 1 lit - dup cfl@ 2 lit invert and swap cfl! loop stu
then drop ;

\ tcommit ( -- err )  the transaction made durable, and over: 0, or -28
\ if it failed (it is then undone).  A writer: its tree's free list
\ (with what this commit freed, and the old list's own pages) written to
\ pages from the chunk; its pages written, in runs of consecutive pages;
\ a flush; the meta page (the chunk's bounds in it); a flush.  A reader, or a
\ writer that changed nothing: simply over.
: tcommit
XERR x@ if tabort FFFFFFE4 lit else
XKIND x@ 1 lit = XCHG x@ 0= XNFREED x@ 0= and or if tend 0 lit else
	XTREE x@ L0 x!
	stl
	XNFREED x@ ?dup if 0 lit do i 2 lit lshift XFREED x@ + @ XTXID x@ L0 x@ flpush loop then
	\ the list's pages before its first change stay; the rest are freed
	L0 x@ TFLO t@ 3FD lit /  L0 x@ TFPN t@  2dup u> if nip else drop then L3 x!
	L0 x@ TFPN t@ L3 x@ u> if L0 x@ TFPN t@ L3 x@ do L0 x@ TFP t@ i 2 lit lshift + @ XTXID x@ L0 x@ flpush loop then
	L0 x@ TFN t@ L1 x!
	stu
	\ and new pages for the rest: (previous page, count, first entry's index, entries)
	L1 x@ 3FC lit + 3FD lit / L2 x!
	L2 x@ L0 x@ TFPN t!
	L2 x@ L3 x@ u> if L2 x@ L3 x@ do
		L0 x@ TCH t@ L0 x@ TCE t@ u< 0= if L0 x@ chunk 0= if "store: the disk is full" panic then then
		stl L0 x@ TCH t@ dup 1 lit + L0 x@ TCH t! stu
		dup own! dup dpush  L0 x@ TFP t@ i 2 lit lshift + !
	loop
	L2 x@ L3 x@ do
		L0 x@ TFP t@ i 2 lit lshift + @ pslot!  dup 1000 lit mzero
		i if L0 x@ TFP t@ i 1 lit - 2 lit lshift + @ else 0 lit then over !
		i 3FD lit * over 8 lit + !
		L1 x@ i 3FD lit * - dup 3FD lit u> if drop 3FD lit then  2dup swap 4 lit + !
		L0 x@ TFL t@ i 3FD lit * 3 lit lshift +  swap
		?dup if 0 lit do dup i 3 lit lshift + @ 2 lit pick i 2 lit lshift + C lit + ! loop then
		2drop
	loop then
	\ every page made, in runs
	0 lit 0 lit
	XNDIRTY x@ ?dup if 0 lit do
		i 2 lit lshift XDIRTY x@ + @ dup own? if
			dup own0
			over if 2 lit pick 2 lit pick + over = 2 lit pick 20 lit u< and else 0 lit then
			if drop 1 lit + else -rot wrun 1 lit then
		else drop then
	loop then
	wrun
	bflsh
	XTMP2 x@ 1000 lit mzero
	52545453 lit XTMP2 x@ !  XTXID x@ XTMP2 x@ 4 lit + !  XROOT x@ XTMP2 x@ 8 lit + !  XCNT x@ XTMP2 x@ C lit + !
	L2 x@ if L0 x@ TFP t@ L2 x@ 1 lit - 2 lit lshift + @ else 0 lit then XTMP2 x@ 10 lit + !  L1 x@ XTMP2 x@ 14 lit + !
	L0 x@ TCH t@ XTMP2 x@ 18 lit + !  L0 x@ TCE t@ XTMP2 x@ 1C lit + !
	XTMP2 x@ 8 lit cksum XTMP2 x@ 20 lit + !
	1 lit L0 x@ TM t@ XTXID x@ 1 lit and + XTMP2 x@ blk1
	bflsh
	stl XTXID x@ L0 x@ TTX t!  XROOT x@ L0 x@ TROOT t!  XCNT x@ L0 x@ TCNT t!  L0 x@ TFN t@ L0 x@ TFLO t!  L0 x@ TNC t@ 1 lit + L0 x@ TNC t! stu
	tend 0 lit
then then ;

\ ── Mounting ──

: pvalid  dup @ 504C5453 lit = if dup 4 lit cksum swap 10 lit + @ = else drop 0 lit then ;   \ ( buf -- ok )

\ nsize  the cache's size: the largest power of two of pages (the clock's
\ hand wraps by a mask) at most a quarter of those free, 256 (1 MiB) at
\ least: 4096, 16 MiB, on a 128 MiB machine.
: nsize  100 lit begin dup 1 lit lshift pgfree# 2 lit rshift u> 0= while 1 lit lshift repeat nslot ! ;

\ stmount ( fresh -- )  the store found on the disk (fresh: a new one made
\ whatever is there, as when none is): the device, the cache, the pool's
\ newer whole meta page, the file system's tree (fst).
: stmount
klk @ 0= if lknew klk ! then
lknew stlk !
0 lit pmlk !  0 lit stopen !  0 lit chand !  0 lit stleak !
blkinit
bcap @ SBASE - dup 100 lit u< if "store: the disk is too small" panic then npg !
nsize
NSLOT pgalloc dup cbase !  0= if "store: no memory for the cache" panic then
NSLOT 2 lit lshift FFF lit + C lit rshift
dup pgalloc dup cpg ! over C lit lshift mzero
dup pgalloc dup cfl ! over C lit lshift mzero
dup pgalloc dup cpn ! swap C lit lshift mzero
cpg @ cfl @ cpn @ and and 0= if "store: no memory for the cache" panic then
npg @ 2 lit lshift FFF lit + C lit rshift dup pgalloc dup pslot ! dup 0= if "store: no memory for the cache" panic then
swap C lit lshift mzero
TMAX 7 lit lshift dup alloc dup trees ! swap mzero
80 lit alloc dup gtr ! 80 lit mzero
1 lit pgalloc pmbuf !  2 lit pgalloc tmp2 !
