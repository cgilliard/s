93 82 41 40	# addi t0,gp,1028
63 EA 59 0C	# bltu s3,t0,ffc <__panic>
#     sw      a0, 0(gp)
23 A0 A1 00	# sw a0,0(gp)
#     addi    gp, gp, 4
93 81 41 00	# addi gp,gp,4
#     RET
6F 00 00 1A	# j 10d4 <__dispatch>

# emit_li -- emit `li <reg>, a0` as lui+addi so the value can be any 32-bit number
#   (a single addi caps at +-2048; this is what lifts the 2047 call-site limit).
#   a1 = `lui <reg>,0` template word, a2 = `addi <reg>,<reg>,0` template word.
#   hi=(v+0x800)>>12 in the lui imm, lo=v&0xFFF in the addi imm (sign-extended).
#   Builds both words into a3/a4 (a-regs survive emit_word's RID return); uses
#   only t0 + a0/a3/a4, so t1-t6 callers (.Lc_callword, gen_bst) are preserved.
# emit_li:
#     li      t0, 0x800
B7 12 00 00	# lui t0,0x1
93 82 02 80	# addi t0,t0,-2048 # 800 <Lret_19+0x10>
#     add     t0, a0, t0
B3 02 55 00	# add t0,a0,t0
#     srli    t0, t0, 12                  # hi = (v + 0x800) >> 12
93 D2 C2 00	# srli t0,t0,0xc
#     slli    t0, t0, 12
93 92 C2 00	# slli t0,t0,0xc
#     or      a3, t0, a1                  # complete `lui <reg>, hi`
B3 E6 B2 00	# or a3,t0,a1
#     slli    t0, a0, 20                  # lo (v's low 12 bits) -> imm[31:20]
93 12 45 01	# slli t0,a0,0x14
#     or      a4, t0, a2                  # complete `addi <reg>, <reg>, lo`
33 E7 C2 00	# or a4,t0,a2
#     mv      a0, a3
13 85 06 00	# mv a0,a3
#     CALL    emit_word
93 8D CD FF	# addi s11,s11,-4
63 EE AD 09	# bltu s11,s10,ffc <__panic>
93 02 40 03	# li t0,52
23 A0 5D 00	# sw t0,0(s11)
6F F0 9F FB	# j f24 <emit_word>
#     mv      a0, a4
13 05 07 00	# mv a0,a4
#     CALL    emit_word
93 8D CD FF	# addi s11,s11,-4
63 E2 AD 09	# bltu s11,s10,ffc <__panic>
93 02 50 03	# li t0,53
23 A0 5D 00	# sw t0,0(s11)
6F F0 1F FA	# j f24 <emit_word>
#     RET
6F 00 C0 14	# j 10d4 <__dispatch>

