63 7A 6E 03	# bgeu t3,s6,f1c <.Lfq_nf>
#     lw      t0, 0(t3)
83 22 0E 00	# lw t0,0(t3)
#     bne     t0, t5, .Lfq_adv
63 92 E2 03	# bne t0,t5,f14 <.Lfq_adv>
#     lw      t0, 4(t3)
83 22 4E 00	# lw t0,4(t3)
#     bne     t0, t6, .Lfq_adv
63 9E F2 01	# bne t0,t6,f14 <.Lfq_adv>
#     lw      t0, 8(t3)                   # kind
83 22 8E 00	# lw t0,8(t3)
#     li      t1, 2
13 03 20 00	# li t1,2
#     bne     t0, t1, .Lfq_adv            # only an immediate ??? is invocable
63 98 62 00	# bne t0,t1,f14 <.Lfq_adv>
