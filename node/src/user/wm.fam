"e-space:pre-wrap;word-break:break-all;outline:none;color:#ddd;background:#111}</style></head><body><" wr
"div id=dock><button class=app id=newt title='New terminal'><svg width=34 height=34 viewBox='0 0 24 2" wr
"4'><rect x=2 y=4 width=20 height=16 rx=2.5 fill='#222' stroke='#bbb' stroke-width=1.2 /><path d='M6 " wr
"9.5l3 2.5-3 2.5M11 15h6' stroke='#7ee787' stroke-width=1.8 fill=none stroke-linecap=round stroke-lin" wr
