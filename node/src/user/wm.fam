"tX-x)+'px';w.d.style.top=Math.max(0,e.clientY-y)+'px'}function up(){document.removeEventListener('mo" wr
"usemove',mv);document.removeEventListener('mouseup',up)}document.addEventListener('mousemove',mv);do" wr
"cument.addEventListener('mouseup',up);e.preventDefault();};w.ws=new WebSocket(wsurl);w.ws.binaryType" wr
"='arraybuffer';w.ws.onopen=function(){w.up=1};w.ws.onmessage=function(e){var a=new Uint8Array(e.data" wr
");for(var j=0;j<a.length;j++){var c=a[j];if(c==8)w.s=w.s.slice(0,-1);else if(c==10||c>=32)w.s+=Strin" wr
"g.fromCharCode(c)}if(w.s.length>200000)w.s=w.s.slice(-100000);show(w);};w.ws.onclose=w.ws.onerror=fu" wr
