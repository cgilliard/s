\ lpage  the login form's page (from src/user/wm-login.html, as page).
: lpage
"HTTP/1.0 200 OK" wr crlf "Content-Type: text/html; charset=utf-8" wr crlf "Cache-Control: no-store" wr crlf crlf
"<!doctype html><html><head><meta charset=utf-8><meta name=viewport content='width=device-width,initi" wr
"al-scale=1'><title>tabernacle</title><link rel=icon type=image/svg+xml href=data:image/svg+xml,%3Csv" wr
"g%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2064%2064%27%20width=%2764%27%20height" wr
"=%2764%27%3E%3Ccircle%20cx=%2732%27%20cy=%2732%27%20r=%2730%27%20fill=%27%23B8892B%27/%3E%3Cpolygon%" wr
"20points=%2732,13%2013,47%2051,47%27%20fill=%27%231B1F3B%27/%3E%3Crect%20x=%2730%27%20y=%2729%27%20w" wr
"idth=%274%27%20height=%2718%27%20fill=%27%23B8892B%27/%3E%3C/svg%3E><style>*{box-sizing:border-box}h" wr
"tml,body{margin:0;height:100%;font:14px system-ui,sans-serif;color:#ddd}body{background:#1d2b3a line" wr
"ar-gradient(135deg,#1d3557,#2b2d42);display:flex;align-items:center;justify-content:center}form{back" wr
"ground:rgba(8,8,12,.85);border-radius:12px;padding:28px 28px 22px;width:300px;display:flex;flex-dire" wr
"ction:column;gap:12px;box-shadow:0 10px 40px rgba(0,0,0,.4)}h1{margin:0 0 6px;font-size:18px;font-we" wr
"ight:600;color:#fff}label{display:flex;flex-direction:column;gap:5px;color:#bbb}input{font:inherit;p" wr
"adding:8px 10px;border-radius:6px;border:1px solid #444;background:#111;color:#eee}input:focus{outli" wr
"ne:none;border-color:#6cb6ff}button{font:inherit;margin-top:6px;padding:9px;border:0;border-radius:6" wr
"px;background:#3a6ea5;color:#fff;cursor:pointer}button:hover{background:#4a80bb}#bad{color:#ff8a80;m" wr
"in-height:1em}</style></head><body><form method=post action=/login autocomplete=off><h1>tabernacle</" wr
"h1><label>Name<input name=name autofocus></label><label>Password<input name=password type=password><" wr
"/label><div id=bad></div><button type=submit>Log in</button></form><script>if(location.search=='?bad" wr
"')document.getElementById('bad').textContent='Login incorrect';</script></body></html>" wr ;

\ ── Sessions ──
\
\ NS records of 200 bytes: in use (+0); the token, 32 hex digits and a
\ NUL (+4); the user and group, decimal (+28, +30); the home (+38, 64
\ bytes); runas's arguments, runas USER GROUP SHELL, each NUL-ended and an
\ empty one last (+78, 128); last active (+F8); the password as typed at
\ logging in, NUL-ended, for the wallet (+100, 128); runas's arguments for
\ the wallet, runas USER GROUP wallet (+180, 128).  A record is zeroed when
\ its session ends.
:M NS 8 lit ;
: ss variable ;  : cs variable ;  : sq variable ;  : fgp variable ;  : fge variable ;  : fgk variable ;  : fgd variable ;
: lnm variable ;  : lpw variable ;  : lnf variable ;
: srec  9 lit lshift ss @ + ;                                \ ( i -- a )
\ wnow ( -- t )  the time, Unix seconds (/proc/time).
: wtb variable ;  : wnn variable ;
: wnow
"/proc/time" 0 lit open dup 0< if drop 0 lit else
	dup wtb @ 1F lit read dup 0< if drop 0 lit then wtb @ + 0 lit swap c!  close drop  wtb @ atoi
then ;
\ wtouch ( i -- )  session i active now.
: wtouch  srec F8 lit + wnn @ swap ! ;
\ sfind ( c -- i | -1 )  the session the client's cookie names.
: sfind
FFFFFFFF lit sq !
"Cookie: " hfind ?dup if
	\ wm= in the cookie's line
	begin dup c@ dup D lit <> swap 0= 0= and over "wm=" 3 lit pwsame 0= and while 1 lit + repeat
	dup "wm=" 3 lit pwsame if
		3 lit +  NS 0 lit do i srec @ if dup i srec 4 lit + 20 lit pwsame if i sq ! then then loop
	then drop
then
sq @ dup 0< 0= if dup wtouch then ;
\ fget ( b e key dst -- )  the form's field key (b to e, name=value&...)
\ at dst, decoded (+ a space, %XX a byte), NUL-ended, 127 bytes at most;
\ empty if not there.
: fhex  dup 39 lit u> if 20 lit or 57 lit - else 30 lit - then F lit and ;   \ ( c -- n )
: fget
fgd ! fgk ! fge ! fgp !  0 lit fgd @ c!
begin fgp @ fge @ u< while
	fgp @ fgk @ dup strlen pwsame  fgp @ fgk @ strlen + c@ 3D lit = and if
		fgp @ fgk @ strlen + 1 lit + fgp !  fgd @
		begin fgp @ fge @ u<  fgp @ c@ 26 lit <> and  over fgd @ - 7F lit u< and while
			fgp @ c@ dup 2B lit = if drop 20 lit else
			dup 25 lit = if drop fgp @ 1 lit + c@ fhex 4 lit lshift fgp @ 2 lit + c@ fhex or  fgp @ 2 lit + fgp ! then then
			over c! 1 lit +  fgp @ 1 lit + fgp !
		repeat
		0 lit swap c!  fge @ fgp !
	else
		begin fgp @ fge @ u< fgp @ c@ 26 lit <> and while fgp @ 1 lit + fgp ! repeat
		fgp @ 1 lit + fgp !
	then
repeat ;
\ bodyok ( c body -- flag )  the request's body all here (Content-Length).
: bodyok
over "Content-Length: " hfind ?dup if atoi else 0 lit then
swap 2 lit pick 10 lit + @ - +  swap C lit + @ u> 0= ;
\ seeother ( s -- )  a 303 to s, then the client closed by the caller.
: seeother  "HTTP/1.0 303 See Other" wr crlf "Location: " wr wr crlf "Cache-Control: no-store" wr crlf ;
\ plogin ( c body -- )  the form checked; a session, its cookie set.
: plogin
over 10 lit + @ 2 lit pick C lit + @ +  ( c body end )
2dup "name" lnm @ fget  "password" lpw @ fget
lnm @ c@ if lnm @ pwfind if lpw @ 1 lit pwfld pwok else 0 lit then else 0 lit then
dup if
	\ a password still in plain text: hashed in its place
	1 lit pwfld pwp5? 0= if lpw @ lnf @ pwmake  lnm @ lnf @ pwset drop  lnm @ pwfind drop then
	\ a free session: its index and 1 (0: none)
	FFFFFFFF lit NS 0 lit do i srec @ 0= over 0< and if drop i then loop
	dup 0< if drop 0 lit else 1 lit + then  nip
then
?dup if
	1 lit - dup wtouch srec  1 lit over !
	\ the password kept for the wallet until the session ends
	dup 100 lit + lpw @ scpy 0 lit swap c!
	"/dev/random" 0 lit open dup 0< if drop else dup lnf @ 10 lit read drop close drop then
	lnf @ 10 lit 2 lit pick 4 lit + pwhex 0 lit swap c!
	dup 28 lit + 2 lit pwfld scpy 0 lit swap c!
	dup 30 lit + 3 lit pwfld scpy 0 lit swap c!
	dup 38 lit + 4 lit pwfld scpy 0 lit swap c!
	\ runas's arguments as spawnv takes them: each NUL-ended, an empty one last
	dup 78 lit + "runas" scpy 0 lit over c! 1 lit +  2 lit pwfld scpy 0 lit over c! 1 lit +  3 lit pwfld scpy 0 lit over c! 1 lit +
	5 lit pwfld dup c@ 0= if drop "sh" then scpy 0 lit over c! 1 lit +  0 lit swap c!
	dup 180 lit + "runas" scpy 0 lit over c! 1 lit +  2 lit pwfld scpy 0 lit over c! 1 lit +  3 lit pwfld scpy 0 lit over c! 1 lit +
	"wallet" scpy 0 lit over c! 1 lit +  0 lit swap c!
	"/" seeother "Set-Cookie: wm=" wr 4 lit + wr "; Path=/; HttpOnly; SameSite=Strict" wr crlf crlf
else "/?bad" seeother crlf then
lpw @ 80 lit 0 lit do 0 lit over i + c! loop drop
cclose ;
\ send ( i -- )  session i ended: each of its windows told (a WebSocket
\ close) and closed, its record cleared.
\ plogout ( c -- )  its session ended, every window of it closed.
: send
NC 0 lit do i crec 14 lit + @ over 1 lit + = if
	i crec @ cfd !  0 lit 0 lit 8 lit wsend  i crec cclose
then loop
srec 200 lit 0 lit do 0 lit over i + c! loop drop ;
: plogout
dup sfind dup 0< 0= if send else drop then
dup @ cfd !  "/" seeother "Set-Cookie: wm=; Path=/; Max-Age=0" wr crlf crlf  cclose ;
\ wexpire  each session idle past idle seconds (no request with its
\ cookie, no typing in its windows) ended, as by logout.
: wexpire
NS 0 lit do
	i srec @ if wnn @ i srec F8 lit + @ - idle @ u> if i send then then
loop ;

\ wskey ( c -- c flag )  the WebSocket handshake's accept key (the key the
\ client sent hashed with RFC 6455's GUID) at ab; 0 if it sent none.
\ w101  the handshake's answer.
: wskey
dup "Sec-WebSocket-Key: " hfind ?dup if
	kb @ begin over c@ 20 lit u> while over c@ over c! 1 lit + swap 1 lit + swap repeat nip
	"258EAFA5-E914-47DA-95CA-C5AB0DC85B11" scpy kb @ -  kb @ swap sha1
	shd @ 14 lit ab @ b64 0 lit swap c!  1 lit
else 0 lit then ;
: w101
"HTTP/1.1 101 Switching Protocols" wr crlf "Upgrade: websocket" wr crlf "Connection: Upgrade" wr crlf
"Sec-WebSocket-Accept: " wr ab @ wr crlf crlf ;
\ uspawn ( args -- )  runas started with those arguments (packed, from the
\ session's record), in the session's user's home, its descriptors as fdv
\ says (wm being root).
: uspawn
"/proc/self/cwd" 1 lit open dup 0< if drop else dup cs @ srec 38 lit + dup strlen write drop close drop then
"runas" swap fdv @ spawnv drop
"/proc/self/cwd" 1 lit open dup 0< if drop else dup "/" 1 lit write drop close drop then ;

\ upgrade ( c -- )  a terminal's WebSocket: the handshake answered, a
\ terminal made and the session's user's shell started on it.
: upgrade
wskey 0= if "HTTP/1.0 400 Bad Request" wr crlf crlf cclose else
	fdv @ 8 lit + pty 0< if "HTTP/1.0 503 Service Unavailable" wr crlf crlf cclose else
		fdv @ 8 lit + @ over 8 lit + !
		w101
		fdv @ C lit + @ dup fdv @ 4 lit + !  dup fdv @ 8 lit + !  fdv @ C lit + !  3 lit fdv @ !
		cs @ 1 lit + over 14 lit + !
		cs @ srec 78 lit + uspawn
		fdv @ 4 lit + @ close drop
		1 lit over 4 lit + !  0 lit swap C lit + !
	then
then ;

\ jq ( dst s -- dst' )  s copied, each ' a double quote (fam's strings
\ hold none).  jesc ( dst s -- dst' )  s copied as a JSON string's
\ inside: a double quote and a backslash escaped, a control byte \u00XX.
: jd variable ;  : ub variable ;
: jq  begin dup c@ ?dup while dup 27 lit = if drop 22 lit then 2 lit pick c! swap 1 lit + swap 1 lit + repeat drop ;
: jput  jd @ c!  jd @ 1 lit + jd ! ;                        \ ( c -- )
: jhex  F lit and dup A lit u< if 30 lit + else 57 lit + then ;   \ ( n -- c )
: jesc
swap jd !
begin dup c@ ?dup while
	dup 20 lit u< if
		5C lit jput 75 lit jput 30 lit jput 30 lit jput  dup 4 lit rshift jhex jput  jhex jput
	else
		dup 22 lit = over 5C lit = or if 5C lit jput then jput
	then
	1 lit +
repeat drop jd @ ;
\ wunlk ( c -- )  the wallet's first line: {"op":"unlock","password":...},
\ the session's password; the copy made for it cleared after.
: wunlk
ub @ "{'op':'unlock','password':'" jq  over 14 lit + @ 1 lit - srec 100 lit + jesc  "'}" jq  A lit over c! 1 lit +
ub @ -  swap 18 lit + @ ub @ rot write drop
ub @ 400 lit 0 lit do 0 lit over i + c! loop drop ;

\ wupgr ( c -- )  a wallet's WebSocket: the handshake answered, two pipes
\ made (the wallet's input, its output) and `wallet` started on them as
\ the session's user, its errors nowhere; the password written it first.
: wupgr
wskey 0= if "HTTP/1.0 400 Bad Request" wr crlf crlf cclose else
	fdv @ 10 lit + pipe 0< if "HTTP/1.0 503 Service Unavailable" wr crlf crlf cclose else
	fdv @ 18 lit + pipe 0< if
		fdv @ 10 lit + @ close drop  fdv @ 14 lit + @ close drop
		"HTTP/1.0 503 Service Unavailable" wr crlf crlf cclose
	else
		\ fdv: 10 its input's read end, 14 its write end (wm's); 18 its
		\ output's read end (wm's), 1C its write end
		fdv @ 18 lit + @ over 8 lit + !  fdv @ 14 lit + @ over 18 lit + !
		w101
		fdv @ 10 lit + @ fdv @ 4 lit + !  fdv @ 1C lit + @ fdv @ 8 lit + !  FFFFFFFF lit fdv @ C lit + !  3 lit fdv @ !
		cs @ 1 lit + over 14 lit + !
		cs @ srec 180 lit + uspawn
		fdv @ 10 lit + @ close drop  fdv @ 1C lit + @ close drop
		0 lit over 1C lit + @ !  2 lit over 4 lit + !  0 lit over C lit + !
		wunlk
	then then
then ;

\ request ( c -- )  more of a request read; once whole: the page, a
\ WebSocket, or 404.
: request
dup @ over 10 lit + @ 2 lit pick C lit + @ + FFF lit 3 lit pick C lit + @ - read
dup 0 lit > 0= if drop cclose else
	over C lit + dup @ rot + swap !
	dup e2 @ hfind ?dup if
		over "POST /login " pfx? if
			2dup bodyok if plogin else 2drop then
		else
			drop
			dup "GET /tty " pfx? if
				dup sfind dup cs ! 0< if "HTTP/1.0 403 Forbidden" wr crlf crlf cclose else upgrade then
			else
			dup "GET /wallet " pfx? if
				dup sfind dup cs ! 0< if "HTTP/1.0 403 Forbidden" wr crlf crlf cclose else wupgr then
			else
			dup "POST /logout " pfx? if plogout else
			dup "GET / " pfx? over "GET /? " pfx? or over "GET /?" pfx? or if
				dup sfind 0< if lpage else page then cclose
			else
			"HTTP/1.0 404 Not Found" wr crlf crlf cclose then then then then
		then
	else dup C lit + @ FFF lit = if cclose else drop then then
then ;

\ wsize ( fd a n -- )  a text frame, "rows cols": the size of the terminal
\ (fd its master end) set, for the program on it to read (tty).
: wr1 variable ;  : wr2 variable ;  : wrk variable ;
: x10+  swap dup 3 lit lshift swap 1 lit lshift + + ;      \ ( acc d -- acc*10+d )
: wsize
0 lit wr1 !  0 lit wr2 !  0 lit wrk !
0 lit do
	dup i + c@ 30 lit - dup A lit u< if
		wrk @ if wr2 @ swap x10+ wr2 ! else wr1 @ swap x10+ wr1 ! then
	else drop wr1 @ if 1 lit wrk ! then then
loop drop
wr1 @ 10 lit lshift wr2 @ or 3 lit swap tty drop ;

\ wtext ( c a n -- )  a message to the wallet: one line (any newline in
\ it made a space), on its input.
: wtext
2dup 0 lit do dup i + c@ dup A lit = swap D lit = or if 20 lit over i + c! then loop drop
rot 18 lit + @ -rot  2 lit pick -rot write drop  e2 @ 1 lit + 1 lit write drop ;

\ frame1 ( c -- more )  the first frame buffered, if whole, taken: typing
\ (a binary frame) to the terminal, its size (a text frame, wsize), a
\ wallet's message (a text frame, wtext), a ping answered, a close
\ returned (the client closed: 0); what follows kept.  1 when there may be
\ another.
: fbuf variable ;  : fn variable ;  : fh variable ;  : fl variable ;
: frame1
dup 10 lit + @ fbuf !  dup C lit + @ fn !
fn @ 2 lit u< if drop 0 lit else
fbuf @ 1 lit + c@ 7F lit and fl !  2 lit fh !
fl @ 7F lit = if cclose 0 lit else
fl @ 7E lit = fn @ 4 lit u< and if drop 0 lit else
	fl @ 7E lit = if fbuf @ 2 lit + c@ 8 lit lshift fbuf @ 3 lit + c@ or fl !  4 lit fh ! then
	fbuf @ 1 lit + c@ 80 lit and if fh @ 4 lit + fh ! then
	fh @ fl @ + 4100 lit u> if cclose 0 lit else
	fn @ fh @ fl @ + u< if drop 0 lit else
		fbuf @ 1 lit + c@ 80 lit and if fl @ ?dup if
			0 lit do fbuf @ fh @ + i + dup c@ fbuf @ fh @ + 4 lit - i 3 lit and + c@ xor swap c! loop
		then then
		fbuf @ c@ F lit and
		dup 2 lit = fl @ and  2 lit pick 4 lit + @ 1 lit = and if over 8 lit + @ fbuf @ fh @ + fl @ write drop then
		dup 1 lit = fl @ and if
			over 4 lit + @ 2 lit = if over fbuf @ fh @ + fl @ wtext else over 8 lit + @ fbuf @ fh @ + fl @ wsize then
		then
		dup 9 lit = if fbuf @ fh @ + fl @ A lit wsend then
		8 lit = if 0 lit 0 lit 8 lit wsend cclose 0 lit else
			fn @ fh @ fl @ + - ?dup if 0 lit do fbuf @ fh @ + fl @ + i + c@ fbuf @ i + c! loop then
			fn @ fh @ fl @ + - swap C lit + !  1 lit
		then
	then then
then then then ;

: frames  begin dup frame1 0= until drop ;                   \ ( c -- )

\ wsread ( c -- )  frames arriving on a WebSocket.
: wsread
dup @ over 10 lit + @ 2 lit pick C lit + @ + 4400 lit 3 lit pick C lit + @ - read
dup 0 lit > 0= if drop cclose else over C lit + dup @ rot + swap !  frames then ;

\ ttyread ( c -- )  what its terminal shows, sent as a binary frame; when
\ the program and its terminal are done, a close, and the client gone.
: ttyread
dup 8 lit + @ io @ 1000 lit read
dup 0 lit > if io @ swap 2 lit wsend drop else drop 0 lit 0 lit 8 lit wsend cclose then ;

\ wread ( c -- )  what the wallet wrote: each whole line a text frame
\ (an empty one none); when it is done (its output closed, or a line
\ past 17 KiB), a close, and the client gone.
: wlb variable ;  : wl variable ;  : wp variable ;
: wlines
0 lit wp !
begin
	wp @ wl !
	begin wl @ wlb @ @ u<  wlb @ 4 lit + wl @ + c@ A lit <> and while wl @ 1 lit + wl ! repeat
	wl @ wlb @ @ u<
while
	wl @ wp @ - ?dup if wlb @ 4 lit + wp @ + swap 1 lit wsend then
	wl @ 1 lit + wp !
repeat
\ the rest, a line begun, moved to the front
wlb @ @ wp @ - dup if dup 0 lit do wlb @ 4 lit + wp @ + i + c@ wlb @ 4 lit + i + c! loop then
wlb @ ! ;
: wread
dup 1C lit + @ wlb !
dup 8 lit + @  wlb @ 4 lit + wlb @ @ +  43FC lit wlb @ @ -  read
dup 0 lit > if wlb @ @ + wlb @ !  wlines drop else drop 0 lit 0 lit 8 lit wsend cclose then ;

\ accept1  a client taken (if all the slots are busy, answered 503 and
\ closed at once: a WebSocket's handshake then fails, its window says so).
: accept1
lsn @ accept dup 0< if drop else
	FFFFFFFF lit NC 0 lit do dup 0< if i crec @ 0< if drop i then then loop
	dup 0< if drop dup cfd ! "HTTP/1.0 503 Service Unavailable" wr crlf crlf close drop else
		crec tuck !  0 lit over 4 lit + !  FFFFFFFF lit over 8 lit + !  0 lit swap C lit + !
	then
then ;

\ entries  poll's entries made: the listener; each client's socket, and
\ its terminal (or its wallet's output) once it has one.
: pent  np @ 3 lit lshift pe @ + tuck !  1 lit swap 4 lit + !  np @ 2 lit lshift pm @ + !  np @ 1 lit + np ! ;   \ ( tag fd -- )
: entries
0 lit np !
0 lit lsn @ pent
NC 0 lit do
	i crec @ 0< 0= if
		i crec dup @ pent
		i crec 4 lit + @ if i crec 1 lit or i crec 8 lit + @ pent then
	then
loop ;

\ handle ( tag -- )  an entry with something to do.
: handle
?dup 0= if accept1 else
dup 1 lit and if 1 lit - dup @ 0< 0= over 8 lit + @ 0< 0= and if dup @ cfd !  dup 4 lit + @ 2 lit = if wread else ttyread then else drop then else
dup @ 0< if drop else
dup @ cfd !  dup 4 lit + @ if  dup 14 lit + @ ?dup if 1 lit - wtouch then  wsread else request then
then then then ;

\ The reaper's stacks first: the kernel wants them in the memory it gave
\ (64 KiB, the heap a part of it); the rest (the clients' buffers, 17 KiB
\ each) from malloc, which maps more.
tcode[ drop begin FFFFFFFF lit st2 wait 0< if 5F5E100 lit sleep then 0 lit until ]tcode
4000 lit alloc 4000 lit + 0 lit thread 0< if "wm: no thread" eputs 0A lit eputc 1 lit exit then
NS 9 lit lshift alloc dup ss !  NS 7 lit lshift 0 lit do 0 lit over i 2 lit lshift + ! loop drop
80 lit alloc lnm !  80 lit alloc lpw !  100 lit alloc lnf !  20 lit alloc wtb !  wnow wnn !
1010 lit malloc io !  100 lit alloc kb !  40 lit alloc ab !  8 lit alloc e2 !  20 lit alloc fdv !  400 lit alloc ub !
A0D0A0D lit e2 @ !  0 lit e2 @ 4 lit + c!
NC 5 lit lshift alloc cl !
NC 0 lit do
	FFFFFFFF lit i crec !  FFFFFFFF lit i crec 8 lit + !  FFFFFFFF lit i crec 18 lit + !  0 lit i crec 14 lit + !
	4400 lit malloc i crec 10 lit + !  4404 lit malloc i crec 1C lit + !
loop
NC 0 lit do i crec 10 lit + @ 0= i crec 1C lit + @ 0= or if "wm: no memory" eputs 0A lit eputc 1 lit exit then loop
io @ 0= if "wm: no memory" eputs 0A lit eputc 1 lit exit then
NC 1 lit lshift 1 lit + dup 3 lit lshift alloc pe !  2 lit lshift alloc pm !
1 lit arg ?dup if atoi else 50 lit then port !
2 lit arg ?dup if atoi else 708 lit then idle !
2 lit socket dup lsn ! 0< if "wm: no socket" eputs 0A lit eputc 1 lit exit then
lsn @ 1 lit 0 lit port @ net ?dup if "wm: cannot bind: " eputs . 0A lit eputc 1 lit exit then
lsn @ 3 lit 0 lit 0 lit net drop
"wm: port " puts port @ u. ", sessions idle " puts idle @ u. " s at most" puts 0A lit putc
begin
	entries
	pe @ np @ EE6B2800 lit poll drop
	wnow wnn !  wexpire
	np @ 0 lit do
		i 3 lit lshift pe @ + 6 lit + h@ if i 2 lit lshift pm @ + @ handle then
	loop
0 lit until
