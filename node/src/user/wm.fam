"()!=w)focusw(w)};w.k.onclick=function(){if(!w.min&&topw()==w)minw(w);else focusw(w)};tb.onmousedown=" wr
"function(e){if(e.button!=0||(e.target!=tb&&e.target!=tt)||w.d.classList.contains('max'))return;var x" wr
