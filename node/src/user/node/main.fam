\ main.fam — the node (docs/NODE.md), the program /bin/node in the image
\ (scripts/build.sh): the node's modules in order, then this.
\
\     node [IP:PORT ...]
\
\ Its peers at IP:PORT, up to 8 (default 10.0.2.2:3747: the host, seen
\ from QEMU's user-mode network; the OS has no DNS, so the seeds' names
\ are not looked up yet), and more as they tell of them (GetPeers).  It
\ syncs from the first that answers, then serves for good: its peers, the API
\ (TCP 3738, the token in /etc/node/token) and its image to tabernacles
\ (UDP 3737).  For now only the recursive dev network (tabminer's
\ --network dev-recursive): there is no mainnet chain yet.  Its state is
\ the tree /var/node: at a start, if it holds a chain, the node resumes
\ from its tip (its headers loaded, then whatever the peer has since
\ caught up to, by nstep, once the peer answers); if not, the tree is
\ made afresh and the node syncs (a removed tree's pages are not given
\ back yet, so that costs its size on the disk).  The fast sync's block S
\ is 144 below the best header, as tabminer's.  Room for 65,536 headers
\ in memory (19 MB): a year of mainnet.

: mdc variable ;  : mnet variable ;  : mpt variable ;  : mip variable ;  : mport variable ;

\ mfile ( path -- addr n )  a whole data file of at most 1.25 MiB, in memory.
: mfile
dup 0 lit open  dup 0< if drop nhead "no " puts puts 0A lit putc 1 lit exit then  nip
140000 lit alloc
0 lit begin
	2 lit pick  2 lit pick 2 lit pick +  140000 lit 3 lit pick -  read
	dup 0 lit > while +
repeat drop
rot close drop ;

\ mnum ( -- n )  the decimal number at mpt, mpt past it.
: mnum  0 lit begin mpt @ c@ 30 lit - dup A lit u< while swap A lit * + mpt @ 1 lit + mpt ! repeat drop ;
\ maddr ( s -- flag )  IP:PORT at s into mip and mport.
: maddr
mpt !  0 lit mip !  -1 lit
4 lit 0 lit do
	mpt @ c@ 30 lit - A lit u< and
	mnum  dup FF lit u> if 2drop 0 lit 0 lit then  mip @ 8 lit lshift or mip !
	i 3 lit < if mpt @ c@ 2E lit = and  mpt @ 1 lit + mpt ! then
loop
mpt @ c@ 3A lit = and  mpt @ 1 lit + mpt !
mpt @ c@ 30 lit - A lit u< and  mnum dup mport !  dup 0= 0= swap 10000 lit u< and and
mpt @ c@ 0= and ;

\ The recursive dev network (tabminer's ChainParams::DEV_RECURSIVE), as
\ headers.fam takes it: 2^10 items, 254 parents, 64 accesses; genesis's
\ target 2^228; the easiest 2^248 - 1; the drift 7,200 s; the median of
\ 11; the final height; 10 s blocks, a half-life of 300 s, from block 1.
: mparams
64 lit alloc dup mnet !
A lit over 0 lit w!  FE lit over 1 lit w!  40 lit over 2 lit w!
dup 3 lit 2 lit lshift + 8 lit wzero  10 lit over A lit w!
8 lit 0 lit do FFFFFFFF lit over i B lit + w! loop  FFFFFF lit over 12 lit w!
1C20 lit over 13 lit w!  B lit over 14 lit w!  3279DB0 lit over 15 lit w!
A lit over 16 lit w!  12C lit over 17 lit w!  1 lit swap 18 lit w! ;

\ the peers given: their addresses in mpa (8 of 2 words), mpn of them
: mpa variable ;  : mpn variable ;
40 lit alloc mpa !  A000202 lit mpa @ !  EA3 lit mpa @ 4 lit + !  1 lit mpn !
argn 9 lit > if "usage: node [IP:PORT ...] (8 at most)" puts 0A lit putc 1 lit exit then
argn 1 lit u> if
	argn 1 lit - mpn !
	mpn @ 0 lit do
		i 1 lit + arg maddr 0= if nhead "not IP:PORT: " puts i 1 lit + arg puts 0A lit putc 1 lit exit then
		mip @ mpa @ i 3 lit lshift + !  mport @ mpa @ i 3 lit lshift + 4 lit + !
	loop
then
mpa @ @ mip !  mpa @ 4 lit + @ mport !
\ mrest  the peers given after the first added (peer 0 is pinit's).
: mrest  mpn @ 1 lit u> if mpn @ 1 lit do mpa @ i 3 lit lshift + dup @ swap 4 lit + @ padd drop loop then ;

"/lib/akjv.txt.gz" mfile powinit
"/lib/chainver" mfile drop cvinit
\ mtree ( -- fd )  /var/node, made if missing.
: mtree  "/var/node" TREE CREATE or 2 lit or open  dup 0< if nhead "no store (a disk is needed): " puts . 0A lit putc 1 lit exit then ;
\ mpeer  the peer's address on the line.
: mpeer
mip @ 18 lit rshift u. 2E lit putc  mip @ 10 lit rshift FF lit and u. 2E lit putc
mip @ 8 lit rshift FF lit and u. 2E lit putc  mip @ FF lit and u. 3A lit putc  mport @ u. ;

"/var" mkdir drop
mtree stinit  sninit  ninit  xinit tinit qinit yinit
"/lib/devchain" mfile drop 4 lit + mdc !
mparams  mnet @ mdc @ 60 lit + 10000 lit hinit
mdc @ dup 60 lit + prinit
\ our status: genesis, no work
20 lit alloc dup mygen !  0 lit he hid swap 8 lit wcopy
20 lit alloc dup mytip !  mygen @ swap 8 lit wcopy
20 lit alloc dup mywork ! 8 lit wzero  0 lit myh !
1 lit vrb !
\ the verifier, a process of its own, so the node serves while it checks
vinit  vjw @ if nhead "verifying in nodev (a process of its own)" puts else nhead "nodev not started: verifying here" puts then 0A lit putc
nload if
	\ resumed: the peer asked, and caught up to if ahead; if it does not
	\ answer yet, nstep goes on asking
	mip @ mport @ E99 lit pinit  mrest
	pping if
		nhead "the peer " puts mpeer " is at height " puts pst-h u. 0A lit putc
		pst-h myh @ u> if ncatch then
	else nhead "no answer from " puts mpeer " yet; asking it again as we serve" puts 0A lit putc then
else
	\ afresh: the tree made again (whatever a sync cut short left in it gone)
	stfd @ close drop  "/var/node" remove drop  mtree stfd !
	mip @ mport @ E99 lit pinit  mrest
	\ from each given in turn while none answers
	FFFFFFFF lit
	mpn @ 0 lit do
		dup FFFFFFFF lit = if
			drop  i puse  i prec @ mip !  i prec 4 lit + @ mport !
			nhead "syncing from " puts mpeer 0A lit putc
			90 lit nsync
		then
	loop
	?dup if
		nhead "the sync stopped: " puts .
		"  (-1 no answer, -2 another chain, -3 headers, -4 a proof of work, -5 a block not fetched, -6 a chain proof, -7 a part, -8 the state, -9 a block after S)" puts 0A lit putc
		1 lit exit
	then
	nhead "synced, height " puts myh @ u. 0A lit putc
then
E9A lit ainit
nhead "the API on port 3738, token " puts atk @ puts 0A lit putc
begin E10 lit aserve 0 lit until
