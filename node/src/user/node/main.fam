\ main.fam — the node (docs/NODE.md), the program /bin/node in the image
\ (scripts/build.sh): the node's modules in order, then this.
\
\     node [-n main|devrec] [-w N] [IP:PORT ...]
\
\ The network: mainnet (main, the default) or the recursive dev network
\ (devrec: tabminer's --network dev-recursive), its parameters, chain
\ proof constants and genesis from /lib/netmain or /lib/netdevrec, its
\ verifier /lib/chainver or /lib/chainverdev.  Settings first from
\ /etc/node/config (below), the command line over them.  Its peers at
\ HOST:PORT (an address, or a name looked up: dns.fam), up to 8; none
\ given, mainnet's seeds (tabminer's, tabernacle1/2.root.sx:3737, or the
\ configuration's), and for devrec 10.0.2.2:3747 (the host seen from
\ QEMU's user-mode network); and more as they tell of them (GetPeers).
\ It syncs from the first that answers on its chain, then serves for good: its peers, the API (TCP 3738,
\ the token in /etc/node/token) and its image to tabernacles (UDP 3737).
\ Its state is the tree /var/node: at a start, if it holds a chain, the
\ node resumes from its tip (its headers loaded, then whatever the peer
\ has since caught up to, by nstep, once the peer answers); if not, the
\ tree is made afresh and the node syncs (a removed tree's pages are not
\ given back yet, so that costs its size on the disk).  The fast sync's
\ block S is 144 below the best header, as tabminer's.  Room for 16,384
\ headers in memory (4.7 MB): when it fills, those below the newest half
\ go to the store alone (sync.fam's ncompact), and a start loads the last
\ 2,048 (nload).  `-w N` (for tests) holds N instead.
: mdc variable ;  : mnet variable ;  : mpt variable ;  : mip variable ;  : mport variable ;

\ mfile ( path -- addr n )  a whole data file of at most 1.25 MiB, in memory.
: mfile
dup 0 lit open  dup 0< if drop nhead "no " puts puts 0A lit putc 1 lit exit then  nip
140000 lit alloc
0 lit begin
	2 lit pick  2 lit pick 2 lit pick +  140000 lit 3 lit pick -  read
	dup 0 lit > while +
repeat drop
rot close drop ;

\ mnum ( -- n )  the decimal number at mpt, mpt past it.
: mnum  0 lit begin mpt @ c@ 30 lit - dup A lit u< while swap A lit * + mpt @ 1 lit + mpt ! repeat drop ;
\ maddr ( s -- flag )  IP:PORT at s into mip and mport.
: maddr
mpt !  0 lit mip !  -1 lit
4 lit 0 lit do
	mpt @ c@ 30 lit - A lit u< and
	mnum  dup FF lit u> if 2drop 0 lit 0 lit then  mip @ 8 lit lshift or mip !
	i 3 lit < if mpt @ c@ 2E lit = and  mpt @ 1 lit + mpt ! then
loop
mpt @ c@ 3A lit = and  mpt @ 1 lit + mpt !
mpt @ c@ 30 lit - A lit u< and  mnum dup mport !  dup 0= 0= swap 10000 lit u< and and
mpt @ c@ 0= and ;

\ Settings: the network (its file, /lib/netmain or /lib/netdevrec, made by
\ tabminer's fam_vectors.rs: its parameters, its chain proof's constants,
\ genesis's header; and its verifier, /lib/chainver or /lib/chainverdev),
\ the ports (UDP for peers, TCP for the API), the headers held, the peers.
\ From /etc/node/config if there, lines "key value" (# a comment):
\ network, port, api-port, window, peer (IP:PORT, again for more); then
\ the command line: -n NETWORK, -w N, and peers, which replace the file's.
: mpa variable ;  : mpn variable ;  : mpf variable ;  : mhc variable ;
: mnname variable ;  : mudp variable ;  : mapi variable ;  : mcpa variable ;  : mcfn variable ;
: mcb2 variable ;  : mls variable ;  : mle variable ;  : mlnx variable ;  : mlv variable ;  : mkn variable ;
: musage  "usage: node [-n main|devrec] [-w N] [HOST:PORT ...] (8 at most)" puts 0A lit putc 1 lit exit ;
\ mpeer  the peer's address on the line.
: mpeer
mip @ 18 lit rshift u. 2E lit putc  mip @ 10 lit rshift FF lit and u. 2E lit putc
mip @ 8 lit rshift FF lit and u. 2E lit putc  mip @ FF lit and u. 3A lit putc  mport @ u. ;
\ The resolver (mres, mrpt), the configuration's peers and seeds (as
\ given: HOST:PORT, looked up once it is all read), the names' scratch.
: mres variable ;  : mrpt variable ;  : msds variable ;  : msdn variable ;  : mhnb variable ;
\ madd ( s -- )  a peer from the configuration, kept.
: madd  mcfn @ 8 lit u< if mcpa @ mcfn @ 2 lit lshift + !  mcfn @ 1 lit + mcfn ! else drop then ;
\ mseed ( s -- )  a seed from the configuration, kept.
: mseed  msdn @ 8 lit u< if msds @ msdn @ 2 lit lshift + !  msdn @ 1 lit + msdn ! else drop then ;
\ mhost ( s -- flag )  HOST:PORT at s into mip and mport: an IPv4
\ address, or a name looked up at the resolver (dns.fam).
: mhost
dup maddr if drop -1 lit else
	0 lit begin 2dup + c@ dup 0= 0= swap 3A lit <> and over FF lit u< and while 1 lit + repeat
	2dup + c@ 3A lit = if
		2dup mhnb @ swap bcopy  0 lit mhnb @ 2 lit pick + c!
		+ 1 lit + atoi mport !
		mport @ dup 0= 0= swap 10000 lit u< and if
			mhnb @ mres @ mrpt @ dlook dup mip !
			dup if nhead mhnb @ puts " is " puts mpeer 0A lit putc else nhead mhnb @ puts ": not found" puts 0A lit putc then
			0= 0=
		else 0 lit then
	else 2drop 0 lit then
then ;
\ mpush ( -- )  mip, mport the next peer (8 at most).
: mpush  mpn @ 8 lit u< if mip @ mpa @ mpn @ 3 lit lshift + !  mport @ mpa @ mpn @ 3 lit lshift + 4 lit + !  mpn @ 1 lit + mpn ! then ;
\ mline ( s -- )  a line of the configuration applied.
: mline
dup c@ dup 0= swap 23 lit = or if drop else
	dup begin dup c@ dup 0= 0= swap 20 lit <> and while 1 lit + repeat
	dup c@ if 0 lit over c! 1 lit + else drop 0 lit then mlv !
	0 lit mkn !
	mlv @ if
		dup "network" streq if mlv @ mnname !  1 lit mkn ! then
		dup "port" streq if mlv @ atoi mudp !  1 lit mkn ! then
		dup "api-port" streq if mlv @ atoi mapi !  1 lit mkn ! then
		dup "window" streq if mlv @ atoi 10 lit max mhc !  1 lit mkn ! then
		dup "peer" streq if mlv @ madd  1 lit mkn ! then
		dup "seed" streq if mlv @ mseed  1 lit mkn ! then
		dup "resolver" streq if
			mlv @ maddr if mip @ mres !  mport @ mrpt ! else nhead "config: the resolver not IP:PORT" puts 0A lit putc then
			1 lit mkn !
		then
	then
	mkn @ if drop else nhead "config: not understood: " puts puts 0A lit putc then
then ;
\ mcfg  /etc/node/config, if there (4 KiB at most).
: mcfg
"/etc/node/config" 0 lit open dup 0< if drop else
	1000 lit alloc mcb2 !
	dup mcb2 @ FFF lit read  dup 0< if drop 0 lit then  mcb2 @ + 0 lit swap c!  close drop
	mcb2 @ mls !
	begin mls @ c@ while
		mls @ begin dup c@ dup 0= 0= swap A lit <> and while 1 lit + repeat mle !
		mle @ c@ if mle @ 1 lit + else mle @ then mlnx !
		0 lit mle @ c!
		mls @ mline
		mlnx @ mls !
	repeat
then ;

\ /etc/node made if missing, for the configuration (and the API's token)
"/etc" mkdir drop  "/etc/node" mkdir drop
"main" mnname !  E99 lit mudp !  E9A lit mapi !  4000 lit mhc !  0 lit mcfn !  40 lit alloc mcpa !
A000203 lit mres !  35 lit mrpt !  20 lit alloc msds !  0 lit msdn !  100 lit alloc mhnb !
mcfg
\ flags, then peers
1 lit mpf !
begin argn mpf @ u> if mpf @ arg c@ 2D lit = else 0 lit then while
	argn mpf @ 1 lit + u> 0= if musage then
	mpf @ arg "-w" streq if mpf @ 1 lit + arg atoi 10 lit max mhc ! else
	mpf @ arg "-n" streq if mpf @ 1 lit + arg mnname ! else musage then then
	mpf @ 2 lit + mpf !
repeat
mnname @ "main" streq if 0 lit nnet ! else
	mnname @ "devrec" streq if 1 lit nnet ! else
		nhead "no network " puts mnname @ puts " (main, devrec)" puts 0A lit putc 1 lit exit
	then
then
40 lit alloc mpa !  0 lit mpn !
argn mpf @ - 8 lit u> if musage then
argn mpf @ u> if
	\ the command line's, every one needed
	argn mpf @ - 0 lit do
		i mpf @ + arg mhost if mpush else nhead "not HOST:PORT (or not found): " puts i mpf @ + arg puts 0A lit putc 1 lit exit then
	loop
else
	\ the configuration's, those found
	mcfn @ ?dup if 0 lit do mcpa @ i 2 lit lshift + @ mhost if mpush then loop then
then
\ none: mainnet's seeds (the configuration's, or tabminer's), by name;
\ the recursive dev network's at the host's 3747 (a tabminer there, seen
\ from QEMU's user-mode network)
mpn @ 0= if
	nnet @ if A000202 lit mip !  EA3 lit mport !  mpush else
		msdn @ 0= if "tabernacle1.root.sx:3737" mseed  "tabernacle2.root.sx:3737" mseed then
		msdn @ 0 lit do msds @ i 2 lit lshift + @ mhost if mpush then loop
	then
then
mpn @ 0= if nhead "no peers: none given, and none found" puts 0A lit putc 1 lit exit then
mpa @ @ mip !  mpa @ 4 lit + @ mport !
\ mrest  the peers given after the first added (peer 0 is pinit's).
: mrest  mpn @ 1 lit u> if mpn @ 1 lit do mpa @ i 3 lit lshift + dup @ swap 4 lit + @ padd drop loop then ;

"/lib/akjv.txt.gz" mfile powinit
nnet @ if "/lib/chainverdev" else "/lib/chainver" then mfile drop cvinit
\ mtree ( -- fd )  /var/node, made if missing.
: mtree  "/var/node" TREE CREATE or 2 lit or open  dup 0< if nhead "no store (a disk is needed): " puts . 0A lit putc 1 lit exit then ;

"/var" mkdir drop
mtree stinit  sninit  ninit  xinit tinit qinit yinit
\ the network: its parameters, then its chain proof's constants and genesis
nnet @ if "/lib/netdevrec" else "/lib/netmain" then mfile drop  dup mnet !  64 lit + mdc !
mnet @ mdc @ 60 lit + mhc @ hinit
mhc @ 1 lit rshift nkeep !  mhc @ 1 lit rshift 800 lit umin nldn !
mdc @ dup 60 lit + prinit
\ our status: genesis, no work
20 lit alloc dup mygen !  0 lit he hid swap 8 lit wcopy
20 lit alloc dup mytip !  mygen @ swap 8 lit wcopy
20 lit alloc dup mywork ! 8 lit wzero  0 lit myh !
1 lit vrb !
\ the verifier, a process of its own, so the node serves while it checks
vinit  vjw @ if nhead "verifying in nodev (a process of its own)" puts else nhead "nodev not started: verifying here" puts then 0A lit putc
nload if
	\ resumed: the peer asked, and caught up to if ahead; if it does not
	\ answer yet, nstep goes on asking
	mip @ mport @ mudp @ pinit  mrest
	pping if
		nhead "the peer " puts mpeer " is at height " puts pst-h u. 0A lit putc
		pst-h myh @ u> if ncatch then
	else nhead "no answer from " puts mpeer " yet; asking it again as we serve" puts 0A lit putc then
else
	\ a chain in the store not taken up: said, and left as it is
	nlh @ if
		nhead "the store's chain (to height " puts nlh @ u. ") could not be taken up; to sync afresh, remove /var/node (rm /var/node)" puts 0A lit putc
		1 lit exit
	then
	\ afresh: the tree made again (whatever a sync cut short, before its
	\ first block, left in it gone)
	stfd @ close drop  "/var/node" remove drop  mtree stfd !
	mip @ mport @ mudp @ pinit  mrest
	\ from each given in turn while none answers, or each is on another
	\ chain (a seed serving images only, say)
	\ (each at height 0, no block yet: asked again every 30 s until one has)
	begin
		FFFFFFFF lit
		mpn @ 0 lit do
			dup FFFFFFFF lit =  over FFFFFFFE lit = or  over FFFFFFF6 lit = or if
				drop  i puse  i prec @ mip !  i prec 4 lit + @ mport !
				nhead "syncing from " puts mpeer 0A lit putc
				90 lit nsync
			then
		loop
		dup FFFFFFF6 lit =
	while
		drop  nhead "nothing to sync yet: the chain has no block past its genesis; asking again in 30 s" puts 0A lit putc
		1E lit 0 lit do 3B9ACA00 lit sleep loop
	repeat
	?dup if
		nhead "the sync stopped: " puts .
		"  (-1 no answer, -2 another chain, -3 headers, -4 a proof of work, -5 a block not fetched, -6 a chain proof, -7 a part, -8 the state, -9 a block after S, -10 no block yet)" puts 0A lit putc
		1 lit exit
	then
	nhead "synced, height " puts myh @ u. 0A lit putc
then
\ the pool kept from before (pool.fam's qload), against the state now
qload  qln @ if nhead "the pool: " puts qlok @ u. " of " puts qln @ u. " kept from before taken back" puts 0A lit putc then
mapi @ ainit
nhead "the API on port " puts mapi @ u. ", token " puts atk @ puts 0A lit putc
begin E10 lit aserve 0 lit until
