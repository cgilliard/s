\ p2_done:
;

\ compress ( a b c -- )  c (8 words) = perm(a || b)'s first 8; c may be a or b.
: compress
rot p2s @ 8 lit wcopy  swap p2s @ 20 lit + 8 lit wcopy
p2s @ perm16  p2s @ swap 8 lit wcopy ;

\ hash ( x n c -- )  c (8 words) = the sponge of the n words at x.
: hash
p2s @ 10 lit wzero
over tom p2s @ 8 lit w!
over 0= if p2s @ perm16 then
-rot
begin dup while
	dup 8 lit u< if dup else 8 lit then
	dup 0 lit do 2 lit pick i w@ p2s @ i w@ f+ p2s @ i w! loop
	p2s @ perm16
	tuck - -rot 2 lit lshift + swap
repeat
2drop p2s @ swap 8 lit wcopy ;

: mi variable ;  : mp variable ;  : mh variable ;  : mc variable ;

\ mroot ( row n index path h c -- )  c (8 words) = the root above the leaf
\ row of n words at index, from its path: h siblings of 8 words, the leaf's
\ first.
: mroot
mc ! mh ! mp ! mi !
mc @ hash
mh @ begin dup while
	mi @ 1 lit and if mp @ mc @ mc @ compress else mc @ mp @ mc @ compress then
	mp @ 20 lit + mp !  mi @ 1 lit rshift mi !
	1 lit -
repeat
drop ;

\ mverify ( root row n index path h -- flag )  the row is leaf index of the
\ tree of h levels (at most 31) whose root is root.
: mverify
dup 1F lit u>  over 1 lit swap lshift 4 lit pick u> 0= or if
	2drop 2drop 2drop 0 lit
else
	mvt @ mroot  mvt @ 8 lit wcmp 0=
then ;
