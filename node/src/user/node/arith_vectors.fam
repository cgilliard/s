\ arith_vectors.fam — tabminer's values for arith.fam (docs/NODE.md, step 1).
\ Written by miner/src/fam_vectors.rs (`cargo test --lib write_arith_vectors
\ -- --ignored`); not to be edited.  Run: tools/fam --test
\ src/user/node/arith.fam src/user/node/arith_vectors.fam

: vx variable ;  : vy variable ;  : vz variable ;  : vw variable ;
: vinit  arinit vx @ 0= if 40 lit alloc vx !  40 lit alloc vy !  40 lit alloc vz !  40 lit alloc vw ! then ;
\ v! ( x0 .. xn-1 a n -- )  the n values at a, x0 first.
: v!  begin dup while 1 lit - rot 2 lit pick 2 lit pick w! repeat 2drop ;
\ canonical values in and out of the Montgomery words.
: cadd  tom swap tom f+ fromm ;
: csub  swap tom swap tom f- fromm ;
: cmul  tom swap tom fmul fromm ;
: cneg  tom fneg fromm ;
: cinv  tom finv fromm ;
: e4tom   4 lit 0 lit do dup i e4@ tom over i e4! loop drop ;
: e4from  4 lit 0 lit do dup i e4@ fromm over i e4! loop drop ;

