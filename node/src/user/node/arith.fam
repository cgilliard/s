\ f+ ( a b -- c ), f- ( a b -- a-b ), fneg ( a -- -a ), mod p.
:M f+
83220100 ,   \ lw t0,0(sp)
03234100 ,   \ lw t1,4(sp)
13014100 ,   \ addi sp,sp,4
B3025300 ,   \ add t0,t1,t0
B70F0078 ,   \ lui t6,0x78000
938F1F00 ,   \ addi t6,t6,1
63E4F201 ,   \ bltu t0,t6,fa_t0_t1_t0_0
B382F241 ,   \ sub t0,t0,t6
\ fa_t0_t1_t0_0:
23205100 ,   \ sw t0,0(sp)
;
:M f-
83220100 ,   \ lw t0,0(sp)   ( b )
03234100 ,   \ lw t1,4(sp)   ( a )
13014100 ,   \ addi sp,sp,4
B3035340 ,   \ sub t2,t1,t0
63785300 ,   \ bgeu t1,t0,fs_done
B70F0078 ,   \ lui t6,0x78000
938F1F00 ,   \ addi t6,t6,1
B383F301 ,   \ add t2,t2,t6
\ fs_done:
23207100 ,   \ sw t2,0(sp)
;
:M fneg
83220100 ,   \ lw t0,0(sp)
63880200 ,   \ beq t0,zero,fn_done
B70F0078 ,   \ lui t6,0x78000
938F1F00 ,   \ addi t6,t6,1
B3825F40 ,   \ sub t0,t6,t0
\ fn_done:
23205100 ,   \ sw t0,0(sp)
;
:M fsq  dup fmul ;
\ tom ( a -- aR ), fromm ( aR -- a )  into and out of Montgomery form.
: tom   R2 fmul ;
: fromm 1 lit fmul ;
\ fpow ( a e -- a^e )  by squaring; finv ( a -- 1/a ) as a^(p-2) (0 for 0).
: fpow
ONE -rot
begin dup while
	dup 1 lit and if rot 2 lit pick fmul -rot then
	1 lit rshift swap fsq swap
repeat
2drop ;
: finv  P 2 lit - fpow ;

\ ── The extension: x^4 = 11 ──

: e4@  2 lit lshift + @ ;                  \ ( a i -- x )
: e4!  2 lit lshift + ! ;                  \ ( x a i -- )
: w*   dup dup f+ dup dup f+ dup f+ f+ f+ ;   \ ( x -- 11x )

\ e4+ e4- ( a b c -- )  c = a + b, a - b.
: e4+  4 lit 0 lit do 2 lit pick i e4@ 2 lit pick i e4@ f+ over i e4! loop 2drop drop ;
: e4-  4 lit 0 lit do 2 lit pick i e4@ 2 lit pick i e4@ f- over i e4! loop 2drop drop ;

\ e4mul ( a b c -- )  c = a b: the sixteen products (a subroutine of the
\ word's own, through ra, which fam's calls leave alone), kept below the
\ data stack, then summed, the wrapped ones times 11.
: e4mul sqt @
