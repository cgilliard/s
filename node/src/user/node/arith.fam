\ e4inv ( a c -- )  c = 1/a (0 for 0): with a' = a(-x), a a' = b0 + b2 x^2,
\ whose norm n = b0^2 - 11 b2^2 is in the base field; 1/a = a' (b0 - b2 x^2)/n.
: e4inv
swap
dup 0 lit e4@ et1 @ 0 lit e4!
dup 1 lit e4@ fneg et1 @ 1 lit e4!
dup 2 lit e4@ et1 @ 2 lit e4!
dup 3 lit e4@ fneg et1 @ 3 lit e4!
et1 @ et2 @ e4mul
et2 @ 0 lit e4@ fsq  et2 @ 2 lit e4@ fsq w* f-  finv
et2 @ 0 lit e4@ over fmul et3 @ 0 lit e4!
et2 @ 2 lit e4@ fmul fneg et3 @ 2 lit e4!
0 lit et3 @ 1 lit e4!  0 lit et3 @ 3 lit e4!
et1 @ et3 @ rot e4mul ;

\ ── Wide integers ──

: w@  2 lit lshift + @ ;                   \ ( a i -- x )
: w!  2 lit lshift + ! ;                   \ ( x a i -- )

\ wzero ( a n -- ), wcopy ( a c n -- )
: wzero  0 lit do 0 lit over i w! loop drop ;
: wcopy  0 lit do over i w@ over i w! loop 2drop ;

\ wadd ( a b c n -- carry ), wsub ( a b c n -- borrow )  c = a + b, a - b.
: wadd
0 lit swap 0 lit do
	3 lit pick i w@  3 lit pick i w@  over +  tuck u>  -rot  tuck +  tuck u>  rot or 1 lit and
	swap 2 lit pick i w!
loop
nip nip nip ;
: wsub
0 lit swap 0 lit do
	3 lit pick i w@  3 lit pick i w@  2dup u< -rot -  rot 2dup u< -rot -  -rot or 1 lit and
	swap 2 lit pick i w!
loop
nip nip nip ;

\ wcmp ( a b n -- c )  -1, 0 or 1 as a is below, equal to or above b.
: wcmp
0 lit swap
begin dup while
	1 lit -
	over 0= if
		3 lit pick over w@  3 lit pick 2 lit pick w@
		2dup u< if 2drop FFFFFFFF lit else u> if 1 lit else 0 lit then then
		rot drop swap
	then
repeat
drop nip nip ;

: wq variable ;  : wb variable ;  : wn variable ;
: w@0  dup 0< if 2drop 0 lit else w@ then ;          \ ( a i -- x )  0 below 0
: w@n  dup wn @ u< if w@ else 2drop 0 lit then ;     \ ( a i -- x )  0 from n on

\ wshl ( a c n s -- ), wshr ( a c n s -- )  c = a shifted s bits (c may be a).
: wshl
dup 5 lit rshift wq ! 1F lit and wb !
begin dup while
	1 lit -
	2 lit pick over wq @ - w@0  wb @ lshift
	wb @ if 3 lit pick 2 lit pick wq @ - 1 lit - w@0 20 lit wb @ - rshift or then
	2 lit pick 2 lit pick w!
repeat
2drop drop ;
: wshr
dup 5 lit rshift wq ! 1F lit and wb !  dup wn !
0 lit do
	over i wq @ + w@n wb @ rshift
	wb @ if 2 lit pick i wq @ + 1 lit + w@n 20 lit wb @ - lshift or then
	over i w!
loop
2drop ;

\ wbits ( a n -- bits )  the bits a needs: 0 for 0.
: nbits  0 lit swap begin dup while 1 lit rshift swap 1 lit + swap repeat drop ;   \ ( x -- bits )
: wbits
0 lit swap
begin dup while
	1 lit -
	over 0= if 2 lit pick over w@ ?dup if nbits over 5 lit lshift + rot drop swap then then
repeat
drop nip ;

: wa variable ;  : wbv variable ;  : wm variable ;  : wc variable ;

\ wmul ( a n b m c -- )  c (n + m words) = a b.  c is neither a nor b.
: wmul
wc ! wm ! wbv ! swap wa !
dup wm @ + wc @ swap wzero
0 lit do
	0 lit
	wm @ 0 lit do
		wa @ j w@  wbv @ i w@  um*
		-rot  tuck +  tuck u> 1 lit and  rot + swap
		wc @ i j + w@  over +  tuck u> 1 lit and  rot + swap
		wc @ i j + w!
	loop
	wc @ i wm @ + w!
loop ;

\ wdivmod ( a b q r n -- )  q = a / b, r = a mod b (b not 0): a bit at a
\ time, the remainder shifted in and b taken off when it fits (or the
\ shift carried out of it).  q and r are neither a nor b.
: wdivmod
wn ! wc ! wm ! wbv ! wa !
wm @ wn @ wzero  wc @ wn @ wzero
wn @ 5 lit lshift
begin dup while
	1 lit -
	wc @ wn @ 1 lit - w@ 0<
	wc @ wc @ wn @ 1 lit wshl
	wa @ 2 lit pick 5 lit rshift w@ 2 lit pick 1F lit and rshift 1 lit and  wc @ @ or wc @ !
	wc @ wbv @ wn @ wcmp 0< 0= or if
		wc @ wbv @ wc @ wn @ wsub drop
		wm @ over 5 lit rshift 2 lit lshift +  dup @  2 lit pick 1F lit and 1 lit swap lshift or  swap !
	then
repeat
drop ;

\ ud% ( lo hi d -- r )  the 64-bit hi:lo mod d (d not 0), 64 steps.
: ud%
83220100 ,   \ lw t0,0(sp)   ( d )
03234100 ,   \ lw t1,4(sp)   ( hi )
83238100 ,   \ lw t2,8(sp)   ( lo )
13018100 ,   \ addi sp,sp,8
130E0000 ,   \ li t3,0   ( the remainder )
930E0004 ,   \ li t4,64   ( bits )
\ udm_loop:
135FF301 ,   \ srli t5,t1,31   ( hi:lo's top bit, into the remainder )
13131300 ,   \ slli t1,t1,1
93DFF301 ,   \ srli t6,t2,31
3363F301 ,   \ or t1,t1,t6
93931300 ,   \ slli t2,t2,1
1355FE01 ,   \ srli a0,t3,31   ( the bit the remainder shifts out )
131E1E00 ,   \ slli t3,t3,1
336EEE01 ,   \ or t3,t3,t5
63140500 ,   \ bne a0,zero,udm_sub
63645E00 ,   \ bltu t3,t0,udm_next
\ udm_sub:
330E5E40 ,   \ sub t3,t3,t0
\ udm_next:
938EFEFF ,   \ addi t4,t4,-1
E3980EFC ,   \ bne t4,zero,udm_loop
2320C101 ,   \ sw t3,0(sp)
;

\ log2x256 ( a -- n )  log2 of the 128-bit a (4 words, not 0) in 1/256
\ bits, rounded up, exactly as tabminer's log2_x256_ceil: the mantissa
\ with 62 fractional bits, squared eight times.
: log2x256
dup 4 lit wbits 1 lit -
dup 3E lit u< if
	over lgt @ 4 lit 3E lit 4 lit pick - wshl
else
	over lgt @ 4 lit 3 lit pick 3E lit - wshr
then
nip 0 lit
8 lit 0 lit do
	lgt @ 2 lit lgt @ 2 lit lgp @ wmul
	lgp @ lgt @ 4 lit 3E lit wshr
	1 lit lshift
	lgt @ 1 lit w@ 0< if lgt @ lgt @ 2 lit 1 lit wshr 1 lit or then
loop
swap 8 lit lshift + 1 lit + ;

\ arinit  the table and the scratch: before any of the above (again, a
\ no-op).
: arinit
sqt @ 0= if
	sqinit
	10 lit alloc et1 !  10 lit alloc et2 !  10 lit alloc et3 !
	10 lit alloc lgt !  10 lit alloc lgp !
then ;

\ ticks ( -- t )  the time register's low word (rdtime, which user mode
\ may read: docs/OS.md): 10 MHz on QEMU's virt board, so an interval up
\ to 429 s is the difference of two.
:M ticks
1301C1FF ,   \ addi sp,sp,-4
F32710C0 ,   \ rdtime a5
2320F100 ,   \ sw a5,0(sp)
;
:M tickh                    \ ( -- t )  its high word (rdtimeh)
1301C1FF ,   \ addi sp,sp,-4
F32710C8 ,   \ rdtimeh a5
2320F100 ,   \ sw a5,0(sp)
;
\ tnow ( -- lo hi )  the whole time register, the high word read twice so
\ the two agree.
: tnow  begin tickh ticks tickh rot over <> while 2drop repeat ;
