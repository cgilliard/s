03230300 ,   \ lw t1,0(t1)   ( S[|u-v|] )
338F6240 ,   \ sub t5,t0,t1
B302E600 ,   \ add t0,a2,a4   ( u+v )
3303E640 ,   \ sub t1,a2,a4   ( u-v )
