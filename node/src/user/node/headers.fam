\ headers.fam — the header chain and fork choice (docs/NODE.md, step 4),
\ after arith.fam, poseidon2.fam, difficulty.fam and pow.fam.  As tabminer's
\ Chain::accept_headers (miner/src/chain.rs): a header is stored when its
\ parent is stored, its height is the parent's plus one and not past the
\ chain's end, its timestamp is after the median of the last eleven on its
\ branch and at most the drift past the clock, and its proof of work meets
\ the ASERT target from its parent, in full.  The best header is the one of
\ most work, each block counting 2^256 / (target + 1); a tie keeps the
\ first.  A header that breaks a rule is not stored.
\
\ Headers are held in memory (an entry each, 288 bytes, found by its id
\ through a table of at least twice as many slots), a window of them: the
\ node keeps the main chain's in its store (with their work), and before
\ the room runs out drops all below a height (hprune: genesis and the
\ main chain's block 1, ASERT's anchor, kept), the oldest kept becoming
\ roots (no parent); and at a start loads the last ones from the store,
\ the first a root (hroot).  hat finds only what is held (hbase the
\ lowest height held but the two kept).  Not reentrant.
\
\ A network is 25 words: the dataset's log2 items, parents and accesses;
\ the genesis target (8 words); the easiest target (8 words); the drift; the
\ median's window; the final height; the block time; the half-life; and
\ whether the schedule starts at block 1.
\
\ hinit ( net genesis cap -- )  the network, its genesis header (204 bytes,
\ not checked), room for cap headers.
\ hacc ( h nowlo nowhi -- code )  offers the header h at the clock now: 0
\ stored, 1 already stored, -1 malformed (a digest not canonical), -2 its
\ parent unknown, -3 a wrong height, -4 past the chain's end, -5 a timestamp
\ not after the median, -6 one past the clock and its drift, -7 its proof
\ of work refused.  As tabminer's verdicts: known, UnknownParent, BadHeight,
\ ChainEnded, TimestampTooOld, TimestampTooNew, BadProofOfWork; -8 no room;
\ -9 its parent set aside (hmark: a block of its branch refused).
\ hmark ( e -- )  entry e set aside, its block refused, and every entry
\ above it: none is the best again, nor takes a child.
\ hprune ( from -- )  every entry below height from dropped but genesis
\ and the main chain's block 1; those left whose parent went, roots.
\ hroot ( h work -- )  header h (204 bytes) taken as a root, its
\ cumulative work given (8 canonical words), unchecked: one the store
\ kept.  htrust set: hacc checks only how a header joins (its id, parent,
\ height), as for the store's.
\ hbest ( -- e ), hid ( e -- id ), hwork ( e -- work ), hhdr ( e -- h )
\ the best entry; an entry's id and cumulative work (8 canonical words) and
\ header.

: hquick variable ;                           \ set: the quick check only (a fast sync's headers; hconf after)
: hnet variable ;  : hent variable ;  : hcap variable ;  : hcnt variable ;
: htab variable ;  : hbst variable ;
: htg variable ;  : hsch variable ;  : hts variable ;  : hidb variable ;  : hwk variable ;
: hpar variable ;  : hnew variable ;  : hfid variable ;  : hfr variable ;
: hc variable ;  : hh variable ;  : hnl variable ;  : hnh variable ;
: htrust variable ;  : hrw variable ;  : hbase variable ;  : hb1 variable ;  : hmap variable ;  : hpf variable ;  : hpn variable ;

:M HENT 120 lit ;                             \ an entry's bytes
: htn variable ;
:M HTABN htn @ ;                              \ the table's slots: a power of two, at least twice the room

: nw  2 lit lshift hnet @ + @ ;               \ ( k -- x )  network word k
: he  HENT * hent @ + ;                       \ ( i -- e )
: hhdr ;                                      \ ( e -- h )  the header comes first
: hid  CC lit + ;
: hwork  EC lit + ;
: hparent  10C lit + ;                        \ ( e -- addr )  the parent's index
: hfirst  110 lit + ;                         \ ( e -- addr )  block 1 of its branch (-1: none, or dropped: hb1's)
: hout  114 lit + ;                           \ ( e -- addr )  set aside (hmark): not 0
: hidx  hent @ - HENT / ;                     \ ( e -- i )
: hheight  20 lit + @ ;
: htslo  24 lit + @ ;  : htshi  28 lit + @ ;
: hbest  hbst @ he ;
: 0<>  0= 0= ;

\ hfind ( id -- i | -1 )  the entry with that id (8 canonical words).
: hfind
hfid !  FFFFFFFF lit hfr !
hfid @ @ HTABN 1 lit - and
begin dup 2 lit lshift htab @ + @ ?dup while
	1 lit - dup he hid hfid @ 8 lit wcmp 0= if hfr ! else drop then
	1 lit + HTABN 1 lit - and
repeat drop hfr @ ;
\ hindex ( i -- )  the table finds entry i.
: hindex
dup he hid @ HTABN 1 lit - and
begin dup 2 lit lshift htab @ + @ while 1 lit + HTABN 1 lit - and repeat
2 lit lshift htab @ + swap 1 lit + swap ! ;

: hinit  ( net genesis cap -- )
dup hcap !  HENT * malloc hent !               \ (malloc's: mapped as needed, not the program's fixed memory)
1 lit begin dup hcap @ 1 lit lshift u< while 1 lit lshift repeat htn !
HTABN 2 lit lshift malloc dup htab ! HTABN wzero
hcap @ 2 lit lshift malloc hmap !  FFFFFFFF lit hb1 !  0 lit hbase !
swap 64 lit alloc dup hnet ! 19 lit wcopy
1 lit 0 lit nw lshift pwitems !  1 lit nw pwpar !  2 lit nw pwacc !
20 lit alloc htg !  54 lit alloc hsch !  14 lit nw 3 lit lshift alloc hts !  20 lit alloc hidb !  20 lit alloc hwk !
0 lit he 33 lit wcopy
0 lit he dup hid blockid  0 lit he hid dfrom
0 lit he hwork 8 lit wzero
FFFFFFFF lit 0 lit he hparent !  FFFFFFFF lit 0 lit he hfirst !  0 lit 0 lit he hout !
1 lit hcnt !  0 lit hbst !  0 lit hindex ;

\ u64> ( alo ahi blo bhi -- flag )  a above b, unsigned.
: u64>  rot 2dup = if 2drop u> else u< nip nip then ;

\ The median's pairs: p@ ( k -- lo hi ), pgt ( k -- flag ) pair k-1 above
\ pair k, pswap ( k -- ) exchanges them.
: p@  3 lit lshift hts @ + dup @ swap 4 lit + @ ;
: pgt  dup 1 lit - p@ rot p@ u64> ;
: pswap
3 lit lshift hts @ + dup 8 lit -
over @ over @ 3 lit pick ! over !
4 lit + swap 4 lit + swap
over @ over @ 3 lit pick ! over ! 2drop ;

\ hmedian ( e -- lo hi )  the median timestamp of the window of entries
\ ending at e on its branch (fewer from genesis).
: hmedian
0 lit swap
begin
	dup htslo 2 lit pick 3 lit lshift hts @ + !
	dup htshi 2 lit pick 3 lit lshift hts @ + 4 lit + !
	swap 1 lit + swap
	over 14 lit nw u<  over hheight 0<> and  over hparent @ 0< 0= and
while
	hparent @ he
repeat
drop
dup 1 lit u> if
	dup 1 lit do
		i begin dup if dup pgt else 0 lit then while dup pswap 1 lit - repeat drop
	loop
then
1 lit rshift p@ ;

\ htarget ( pe -- )  htg = the target after the entry pe: ASERT anchored at
\ block 1 of its branch if the schedule starts there (and pe is not
\ genesis), else at genesis; the anchor's parent a block time before it.
: htarget
dup hheight 0<> 18 lit nw 0<> and if
	1 lit hsch @ 0 lit w!  dup hfirst @ dup 0< if drop hb1 @ then he
else
	0 lit hsch @ 0 lit w!  0 lit he
then
dup htslo swap htshi
swap dup 16 lit nw - swap 16 lit nw u< rot swap -
hsch @ 2 lit w!  hsch @ 1 lit w!
17 lit nw hsch @ 3 lit w!  16 lit nw hsch @ 4 lit w!
hnet @ C lit + hsch @ 14 lit + 8 lit wcopy
hnet @ 2C lit + hsch @ 34 lit + 8 lit wcopy
hsch @ over hheight 2 lit pick htslo 3 lit pick htshi htg @ asert drop ;

: hstore
hcnt @ hcap @ u< 0= if -8 lit hc ! else
	hcnt @ he hnew !
	hh @ hnew @ 33 lit wcopy
	hidb @ hnew @ hid 8 lit wcopy
	htg @ hwk @ bwork  hpar @ he hwork hwk @ hnew @ hwork wsat+
	hpar @ hnew @ hparent !  0 lit hnew @ hout !
	hh @ hheight 1 lit = if hcnt @ else hpar @ he hfirst @ then hnew @ hfirst !
	hcnt @ hindex
	hnew @ hwork hbest hwork 8 lit wcmp 0 lit > if hcnt @ hbst ! then
	hcnt @ 1 lit + hcnt !
then ;

: hacc  ( h nowlo nowhi -- code )
hnh ! hnl ! hh !  0 lit hc !
hh @ hdr-ok 0= if -1 lit hc ! then
hc @ 0= if hh @ hidb @ blockid  hidb @ dfrom  hidb @ hfind 0< 0= if 1 lit hc ! then then
hc @ 0= if hh @ hfind dup hpar ! 0< if -2 lit hc ! then then
hc @ 0= if hpar @ he hout @ if -9 lit hc ! then then
hc @ 0= if hpar @ he hheight 1 lit + dup 0= swap hh @ hheight <> or if -3 lit hc ! then then
hc @ 0= if hh @ hheight 15 lit nw u> if -4 lit hc ! then then
hc @ 0= htrust @ 0= and if hh @ htslo hh @ htshi hpar @ he hmedian u64> 0= if -5 lit hc ! then then
hc @ 0= htrust @ 0= and if
	hnl @ 13 lit nw + dup hnl @ u<
	hnh @ swap if dup FFFFFFFF lit = if 2drop FFFFFFFF lit FFFFFFFF lit else 1 lit + then then
	hh @ htslo -rot hh @ htshi -rot u64> if -6 lit hc ! then
then
\ the target always (the entry's work is counted from it), the work not
\ if trusted
hc @ 0= if
	hpar @ he htarget
	htrust @ 0= if hh @ htg @ hquick @ if quickpow else fullpow then 0= if -7 lit hc ! then then
then
hc @ 0= if hstore then
hc @ ;

\ vrb  set (the program node does), the sync's progress said on the
\ console, each step a line "node: ...": here each header's full proof
\ of work; in sync.fam the sync's steps and each block followed.
: vrb variable ;


\ nhead  "node: " and the time of day (UTC, to the hundredth: the date
\ /proc/time gave at the first line, and the time register since), so
\ the lines show what took how long, whatever the parts measured.  The
\ seconds are counted on from the last line, a second at a time: right
\ however far apart lines are.
: cok variable ;  : cdate variable ;  : clo variable ;  : chi variable ;  : csec variable ;  : cfr variable ;
: cdl variable ;  : cdh variable ;  : cbuf variable ;
: cstart
20 lit alloc cbuf !  0 lit cbuf @ c!
"/proc/time" 0 lit open dup 0< if drop else dup cbuf @ 1F lit read dup 0< if drop 0 lit then cbuf @ + 0 lit swap c! close drop then
cbuf @ atoi cdate !  tnow chi ! clo !  0 lit csec !  0 lit cfr !  1 lit cok ! ;
: ctick
tnow  dup chi @ - cdh !  chi !
dup clo @ u< if cdh @ 1 lit - cdh ! then  dup clo @ - cdl !  clo !
begin cdh @ cdl @ 989680 lit u< 0= or while
	cdl @ 989680 lit u< if cdh @ 1 lit - cdh ! then  cdl @ 989680 lit - cdl !  csec @ 1 lit + csec !
repeat
cfr @ cdl @ +  dup 989680 lit u< 0= if 989680 lit - csec @ 1 lit + csec ! then  cfr ! ;
\ secs ( -- s )  seconds since the first (the same count nhead keeps).
: secs  cok @ 0= if cstart then  ctick csec @ ;
: n2d  dup A lit u< if 30 lit putc then u. ;     \ ( n -- )  two digits at least
: nhead
"node: " puts  cok @ 0= if cstart then  ctick
cdate @ csec @ + 15180 lit %  dup E10 lit / n2d 3A lit putc  dup E10 lit % 3C lit / n2d 3A lit putc
3C lit % n2d 2E lit putc  cfr @ 186A0 lit / n2d 20 lit putc ;

\ hat ( h -- e | 0 )  the best branch's entry at height h, if held
\ (genesis and block 1 always are).
: hat
dup 0= if drop 0 lit he else
dup 1 lit = hb1 @ 0< 0= and hbase @ 1 lit u> and if drop hb1 @ he else
	hbest begin dup hheight 2 lit pick u> over hparent @ 0< 0= and while hparent @ he repeat
	dup hheight rot = 0= if drop 0 lit then
then then ;
\ hconf ( from -- flag )  the full proof of work of the best branch's
\ headers from height `from` up (tabminer's confirm_work).
: hconf
-1 lit swap  hbest
begin dup hheight 2 lit pick u< 0= over hheight and while
	vrb @ if nhead "the proof of work of header " puts dup hheight u. 0A lit putc then
	dup hparent @ he htarget  dup htg @ fullpow 0= if rot drop 0 lit -rot then
	hparent @ he
repeat 2drop ;

\ hmark ( e -- )
: hmark
hidx  hcnt @ over do
	i over = if 1 lit i he hout ! else i he hparent @ dup 0< if drop else he hout @ if 1 lit i he hout ! then then then
loop drop
0 lit  hcnt @ 1 lit do
	i he hout @ 0= if i he hwork over he hwork 8 lit wcmp 0 lit > if drop i then then
loop hbst ! ;

\ hprune ( from -- )
: hprune
hpf !  hb1 @ 0< if 1 lit hat ?dup if hidx hb1 ! then then
0 lit hpn !
hcnt @ 0 lit do
	i 0= i hb1 @ = or i he hheight hpf @ u< 0= or if
		i hpn @ <> if i he hpn @ he 48 lit wcopy then
		hpn @ hmap @ i w!  hpn @ 1 lit + hpn !
	else FFFFFFFF lit hmap @ i w! then
loop
hpn @ 0 lit do
	i he hparent @ dup 0< 0= if hmap @ swap w@ then i he hparent !
	i he hfirst @ dup 0< 0= if hmap @ swap w@ then i he hfirst !
loop
hb1 @ 0< 0= if hmap @ hb1 @ w@ hb1 ! then
hmap @ hbst @ w@ hbst !
hpn @ hcnt !  hpf @ hbase !
htab @ HTABN wzero  hcnt @ 0 lit do i hindex loop ;

\ hroot ( h work -- )
: hroot
hrw !  hh !  hcnt @ hcap @ u< if
	hcnt @ he hnew !
	hh @ hnew @ 33 lit wcopy
	hh @ hidb @ blockid  hidb @ dfrom  hidb @ hnew @ hid 8 lit wcopy
	hrw @ hnew @ hwork 8 lit wcopy
	FFFFFFFF lit hnew @ hparent !  0 lit hnew @ hout !  hb1 @ hnew @ hfirst !
	hcnt @ hindex
	hnew @ hwork hbest hwork 8 lit wcmp 0 lit > if hcnt @ hbst ! then
	hcnt @ 1 lit + hcnt !
then ;
