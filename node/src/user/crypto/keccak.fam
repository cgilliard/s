;

\ kci! ( lo hi i -- )  round constant i.
: kci!  3 lit lshift kcrc @ + tuck 4 lit + ! ! ;
: kcinit
kcsf !  kcr !
kcst @ 0= if
	C8 lit alloc kcst !  C0 lit alloc kcrc !
	1 lit 0 lit 0 lit kci!  8082 lit 0 lit 1 lit kci!  808A lit 80000000 lit 2 lit kci!  80008000 lit 80000000 lit 3 lit kci!
	808B lit 0 lit 4 lit kci!  80000001 lit 0 lit 5 lit kci!  80008081 lit 80000000 lit 6 lit kci!  8009 lit 80000000 lit 7 lit kci!
	8A lit 0 lit 8 lit kci!  88 lit 0 lit 9 lit kci!  80008009 lit 0 lit A lit kci!  8000000A lit 0 lit B lit kci!
	8000808B lit 0 lit C lit kci!  8B lit 80000000 lit D lit kci!  8089 lit 80000000 lit E lit kci!  8003 lit 80000000 lit F lit kci!
	8002 lit 80000000 lit 10 lit kci!  80 lit 80000000 lit 11 lit kci!  800A lit 0 lit 12 lit kci!  8000000A lit 80000000 lit 13 lit kci!
	80008081 lit 80000000 lit 14 lit kci!  8080 lit 80000000 lit 15 lit kci!  80000001 lit 0 lit 16 lit kci!  80008008 lit 80000000 lit 17 lit kci!
then
kcst @ 32 lit 0 lit do 0 lit over i 2 lit lshift + ! loop drop
0 lit kcp !  0 lit kcsq ! ;
: kcf  kcst @ kcrc @ kcraw ;
\ kcx ( b i -- )  byte i of the state xored with b.
: kcx  kcst @ + dup c@ rot xor swap c! ;
: kcabs
?dup if 0 lit do
	dup i + c@ kcp @ kcx
	kcp @ 1 lit + dup kcp !  kcr @ = if kcf 0 lit kcp ! then
loop then drop ;
: kcpad  kcsf @ kcp @ kcx  80 lit kcr @ 1 lit - kcx  kcf  0 lit kcp !  FFFFFFFF lit kcsq ! ;
: kcsqz
kcsq @ 0= if kcpad then
?dup if 0 lit do
	kcp @ kcr @ = if kcf 0 lit kcp ! then
	kcst @ kcp @ + c@ over i + c!  kcp @ 1 lit + kcp !
loop then drop ;
: shake128  kcdl ! kcd !  A8 lit 1F lit kcinit kcabs  kcd @ kcdl @ kcsqz ;
: shake256  kcdl ! kcd !  88 lit 1F lit kcinit kcabs  kcd @ kcdl @ kcsqz ;
: sha3256  kcd !  88 lit 6 lit kcinit kcabs  kcd @ 20 lit kcsqz ;
: sha3512  kcd !  48 lit 6 lit kcinit kcabs  kcd @ 40 lit kcsqz ;
