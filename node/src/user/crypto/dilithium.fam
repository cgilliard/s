\ dlpmacr ( acc a b tbl -- )  acc[i] = acc[i] + a[i]*b[i] mod q.
: dlpmacr
03260100 ,   \ lw a2,0(sp)   ( tbl )
83274100 ,   \ lw a5,4(sp)   ( b )
03278100 ,   \ lw a4,8(sp)   ( a )
8326C100 ,   \ lw a3,12(sp)   ( acc )
