\ crypto/sha512.fam — SHA-512, HMAC-SHA512 and PBKDF2-HMAC-SHA512, for the
\ OS's passwords (docs/GUI_WALLET.md, Logging in) and BIP39's seed (the
\ wallet).  A module, not a program: a program names it in its first
\ lines (`\ uses: crypto/sha512.fam`, scripts/build.sh).  A 64-bit value
\ is two words, the high one first, in memory and on the stack.
\
\ sha512 ( src len -- )  the digest of len bytes at src, at h5d (64).
\ hmac512 ( key klen msg mlen -- )  HMAC-SHA512 of the message, at h5d.
\ pbkdf512 ( pw pwlen salt slen iters out olen -- )  PBKDF2-HMAC-SHA512:
\ olen bytes (64 at most, one block) at out; the salt 400 bytes at most.

: h5st variable ;  : h5ws variable ;  : h5k variable ;  : h5v variable ;  : h5b variable ;  : h5d variable ;
: h5n variable ;  : h5t variable ;  : h5ip variable ;  : h5op variable ;  : h5u variable ;  : h5x variable ;
: h5kb variable ;  : h5sb variable ;  : h5iv0 variable ;
: h5sa variable ;  : h5sc variable ;  : h5sn variable ;  : h5fa variable ;  : h5fb variable ;
: h5ma variable ;  : h5mn variable ;  : h5pp variable ;  : h5pn variable ;  : h5it variable ;  : h5o variable ;  : h5on variable ;

: h5tt variable ;
\ h5bc ( src dst n -- )  n bytes copied; h5wc ( src dst n -- )  n words.
: h5bc  ?dup if 0 lit do over i + c@ over i + c! loop then 2drop ;
: h5wc  0 lit do over i 2 lit lshift + @ over i 2 lit lshift + ! loop 2drop ;
: @64  dup @ swap 4 lit + @ ;                       \ ( a -- hi lo )
: !64  tuck 4 lit + ! ! ;                            \ ( hi lo a -- )
: x64  rot xor -rot xor swap ;                       \ ( a b -- a^b )  pairs
: &64  rot and -rot and swap ;                       \ ( a b -- a&b )
: ~64  invert swap invert swap ;                     \ ( a -- ~a )
\ +64 ( a b -- a+b )  with the carry.
: +64  rot over + tuck u> 1 lit and  rot + rot + swap ;
\ r64 ( hi lo n -- hi' lo' )  rotated right by n (not 0 nor 32).
: r64
h5sn !  h5sc ! h5sa !
h5sn @ 20 lit u< 0= if h5sa @ h5sc @ h5sa ! h5sc !  h5sn @ 20 lit - h5sn ! then
h5sa @ h5sn @ rshift  h5sc @ 20 lit h5sn @ - lshift or
h5sc @ h5sn @ rshift  h5sa @ 20 lit h5sn @ - lshift or ;
\ s64 ( hi lo n -- hi' lo' )  shifted right by n (1 to 31).
: s64
h5sn !  h5sc ! h5sa !
h5sa @ h5sn @ rshift
h5sc @ h5sn @ rshift  h5sa @ 20 lit h5sn @ - lshift or ;
\ The functions ( hi lo -- hi' lo' ): S0, S1 of the state, s0, s1 of the
\ schedule.
: hS0  h5fb ! h5fa !  h5fa @ h5fb @ 1C lit r64  h5fa @ h5fb @ 22 lit r64 x64  h5fa @ h5fb @ 27 lit r64 x64 ;
: hS1  h5fb ! h5fa !  h5fa @ h5fb @ E lit r64  h5fa @ h5fb @ 12 lit r64 x64  h5fa @ h5fb @ 29 lit r64 x64 ;
: hs0  h5fb ! h5fa !  h5fa @ h5fb @ 1 lit r64  h5fa @ h5fb @ 8 lit r64 x64  h5fa @ h5fb @ 7 lit s64 x64 ;
: hs1  h5fb ! h5fa !  h5fa @ h5fb @ 13 lit r64  h5fa @ h5fb @ 3D lit r64 x64  h5fa @ h5fb @ 6 lit s64 x64 ;

: h5be@  dup c@ 18 lit lshift over 1 lit + c@ 10 lit lshift or over 2 lit + c@ 8 lit lshift or swap 3 lit + c@ or ;   \ ( a -- x )
: h5be!  over 18 lit rshift over c!  over 10 lit rshift over 1 lit + c!  over 8 lit rshift over 2 lit + c!  3 lit + c! ;  \ ( x a -- )
: h5k!  3 lit lshift h5k @ + !64 ;                  \ ( hi lo i -- )
: h5i!  3 lit lshift h5iv0 @ + !64 ;
: h5w  3 lit lshift h5ws @ + ;                      \ ( i -- a )  schedule word i
: h5s  3 lit lshift h5v @ + ;                       \ ( i -- a )  working word i (a to h)
: h5init
h5st @ 0= if
	40 lit alloc h5st !  7C4 lit alloc h5ws !  40 lit alloc h5v !  100 lit alloc h5b !  40 lit alloc h5d !
	40 lit alloc h5ip !  40 lit alloc h5op !  40 lit alloc h5u !  40 lit alloc h5x !  80 lit alloc h5kb !
	404 lit alloc h5sb !  280 lit alloc h5k !  40 lit alloc h5iv0 !  8 lit alloc h5tt !
