\ crypto/passwd_test.fam — the password module (crypto/passwd.fam), as
\ root on a disk: a hash made and checked, the right password and a wrong
\ one; a hash Python's hashlib made (PBKDF2-HMAC-SHA512, 10,000
\ iterations) taken; a password in plain text taken; /etc/passwd
\ written, a user's field set again, the others as they were.  Prints
\ "passwd: N as expected, M not".

: tpas variable ;  : tfai variable ;  : tf variable ;
: tchk  swap if drop tpas @ 1 lit + tpas ! else "passwd: " puts puts 0A lit putc tfai @ 1 lit + tfai ! then ;   \ ( flag str -- )
100 lit alloc tf !
\ made, then checked
"correct horse" tf @ pwmake
tf @ "$p5$4e20$" 9 lit pwsame  tf @ strlen 9 lit 20 lit + 1 lit + 40 lit + = and  "a field not as $p5$4e20$salt$hash" tchk
"correct horse" tf @ pwok  "the password not taken" tchk
"correct horsf" tf @ pwok 0=  "a wrong password taken" tchk
\ Python's
"correct horse" "$p5$2710$000102030405060708090a0b0c0d0e0f$102122177ac7c6240d9f7788843dffad0bbb260354b873641305ebebb1ec1d70" pwok  "hashlib's hash not taken" tchk
"correct horsf" "$p5$2710$000102030405060708090a0b0c0d0e0f$102122177ac7c6240d9f7788843dffad0bbb260354b873641305ebebb1ec1d70" pwok 0=  "a wrong password taken by hashlib's hash" tchk
\ plain text, as before
"hunter2" "hunter2" pwok  "a plain password not taken" tchk
"hunter3" "hunter2" pwok 0=  "a wrong plain password taken" tchk
\ /etc/passwd: set alice's, bob's kept
"/etc" mkdir drop
A lit tf @ c!
"/etc/passwd" 1 lit CREATE or TRUNC or open
dup "alice:pw1:1000:1000:/home/alice:/bin/sh" dup strlen write drop  dup tf @ 1 lit write drop
dup "bob:pw2:1001:1001:/home/bob:/bin/sh" dup strlen write drop  dup tf @ 1 lit write drop  close drop
"alice" pwfind  1 lit pwfld "pw1" streq and  "alice not found with her password" tchk
"nobody" pwfind 0=  "nobody found" tchk
"alice" "$p5$1$00$11" pwset  "alice's field not set" tchk
"alice" pwfind  1 lit pwfld "$p5$1$00$11" streq and  4 lit pwfld "/home/alice" streq and  "alice's line not as set" tchk
"bob" pwfind  1 lit pwfld "pw2" streq and  5 lit pwfld "/bin/sh" streq and  "bob's line changed" tchk
"passwd: " puts tpas @ u. " as expected, " puts tfai @ u. " not" puts 0A lit putc
0 lit exit
