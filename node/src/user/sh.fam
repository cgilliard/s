\ sh.fam — the shell (docs/OS.md): a line at a time from its input, each a
\ pipeline of commands (`a | b | c`), each command a program's name and its
\ arguments, with `< path` taking its input from a file (or /dev, /proc),
\ `> path` its output to one (made, or emptied), `>> path` added to its end.
\ It waits for the whole pipeline, unless the line ends with `&`: then its
\ pid is shown and the next prompt comes at once (its input /dev/null
\ unless `<` says otherwise); before each prompt, a background command
\ that ended is waited for and told (`[pid] done`).  A command's name with
\ a / in it is run as it is; one without is looked for in each directory
\ of the search path in turn (`/bin` to begin with).  Its own: `cd [dir]`
\ (the root without one), `path [dirs]` (the search path shown, or set:
\ directories with : between), and `exit`, as the end of its input.

: line variable ;            \ the line read (256 bytes)
: abuf variable ;            \ the commands' arguments, packed
: fbuf variable ;            \ the paths of < and >
: cmds variable ;            \ per command: its arguments, < path, > path
: ncmd variable ;
: lp variable ;              \ where in the line
: ap variable ;              \ where in abuf
: fq variable ;              \ where in fbuf
: pin variable ;             \ the read end of the pipe into the next command
: pfdv variable ;            \ pipe's two descriptors
: fdv variable ;             \ spawnv's fds: 3, then the child's 0, 1, 2
: pids variable ;
: wst variable ;
: oflg variable ;            \ the flags a > opens with
: bg variable ;              \ the line ends with & (-1; 1: an & before its end)
: bgp variable ;             \ the background commands' pids (16; 0 free)
: stb variable ;             \ /proc/<pid>/status: its path, then its text
: pathv variable ;           \ the search path (256 bytes): directories, : between
: pbuf variable ;            \ a directory and a command's name, joined
: pa variable ;  : pr variable ;  : pq variable ;

: cmd  4 lit lshift cmds @ + ;      \ ( i -- entry )  args, < path, > path, appending

\ rdline ( -- n | -1 )  a line into line, NUL-ended; -1 at the end of the
\ input.
: rdline
0 lit
begin
	getc dup 0< if drop dup 0= if drop FFFFFFFF lit then 1 lit else
	dup A lit = if drop 1 lit else
	over FE lit u< if over line @ + c! 1 lit + else drop then 0 lit
	then then
until
dup 0< 0= if 0 lit over line @ + c! then ;

: ws?  dup 20 lit = swap 9 lit = or ;                       \ ( c -- flag )
: special?  dup 7C lit = over 3C lit = or over 3E lit = or swap 26 lit = or ; \ ( c -- flag ) | < > &
: skipws  begin lp @ c@ ws? while lp @ 1 lit + lp ! repeat ;

\ token ( dst -- dst' )  the word at lp copied to dst, NUL-ended.
: token
begin lp @ c@ dup if dup ws? over special? or 0= else 0 lit then while
	over c! 1 lit +  lp @ 1 lit + lp !
repeat
drop 0 lit over c! 1 lit + ;

: newcmd  ap @ ncmd @ cmd !  0 lit ncmd @ cmd 4 lit + !  0 lit ncmd @ cmd 8 lit + !  0 lit ncmd @ cmd C lit + ! ;
: endcmd  0 lit ap @ c!  ap @ 1 lit + ap !  ncmd @ 1 lit + ncmd ! ;

\ redir ( off -- )  the path after < (4) or > (8), for this command.
: redir  lp @ 1 lit + lp !  skipws  fq @ swap ncmd @ cmd + !  fq @ token fq ! ;

\ parse ( -- ok )  the line into cmds; not ok if a command is empty.
: parse
line @ lp !  abuf @ ap !  fbuf @ fq !  0 lit ncmd !  0 lit bg !  newcmd
1 lit
begin skipws lp @ c@ while
	lp @ c@ 7C lit = if
		lp @ 1 lit + lp !
		ap @ ncmd @ cmd @ = if drop 0 lit then
		endcmd newcmd
	else lp @ c@ 26 lit = if
		lp @ 1 lit + lp !  skipws
		lp @ c@ if drop 0 lit  1 lit bg ! else bg @ 1 lit = 0= if FFFFFFFF lit bg ! then then
	else lp @ c@ 3C lit = if 4 lit redir else
	lp @ c@ 3E lit = if
		lp @ 1 lit + c@ 3E lit = if 1 lit ncmd @ cmd C lit + !  lp @ 1 lit + lp ! then
		8 lit redir else
	ap @ token ap !
	then then then then
repeat
ap @ ncmd @ cmd @ = if ncmd @ if drop 0 lit then then
endcmd ;

\ cin ( i -- fd )  command i's input: its < path, the pipe from the one
\ before, or the shell's own (/dev/null in the background).
: cin
dup cmd 4 lit + @ ?dup if
	0 lit open swap if pin @ ?dup if close drop then then
else
	if pin @ else bg @ if "/dev/null" 0 lit open dup 0< if drop 0 lit then else 0 lit then then
then ;

\ cout ( i -- fd )  its output: its > path (made or emptied; >> appends),
\ a pipe to the next (pin then its read end), or the shell's own.
: cout
0 lit pin !
dup ncmd @ 1 lit - = if 1 lit else pfdv @ pipe drop  pfdv @ @ pin !  pfdv @ 4 lit + @ then
swap dup cmd C lit + @ if A01 lit else 601 lit then oflg !
cmd 8 lit + @ ?dup if oflg @ open swap dup 1 lit = if drop else close drop then then ;

\ has/ ( s -- flag )  a / in s.
: has/  begin dup c@ dup 2F lit <> and while 1 lit + repeat c@ 0= 0= ;

\ prun ( args -- pid | error )  the command whose arguments (its name
\ first) are args started, with fdv's descriptors: its name as it is if it
\ has a /, else each directory of the path in turn and the name, until one
\ is found (-2 if none is).
: prun
pa !
pa @ has/ if pa @ pa @ fdv @ spawnv else
	FFFFFFFE lit pr !  pathv @ pq !
	begin pr @ FFFFFFFE lit = pq @ c@ 0= 0= and while
		pbuf @ begin pq @ c@ dup 3A lit <> and over pbuf @ - 40 lit u< and while
			pq @ c@ over c! 1 lit +  pq @ 1 lit + pq !
		repeat
		begin pq @ c@ dup 3A lit <> and while pq @ 1 lit + pq ! repeat
		pq @ c@ if pq @ 1 lit + pq ! then
		dup pbuf @ <> if 2F lit over c! 1 lit + then
		pa @ scpy 0 lit swap c!
		pbuf @ pa @ fdv @ spawnv pr !
	repeat
	pr @
then ;

\ launch ( i -- )  command i started (its pid noted, 0 if it did not: its
\ < or > path not opened, or the program not found or not to be run).
: launch
dup cin  over cout
fdv @ 8 lit + !  fdv @ 4 lit + !  3 lit fdv @ !  2 lit fdv @ C lit + !
fdv @ 4 lit + @ 0< if "sh: " eputs dup cmd 4 lit + @ eputs ": cannot open" eputs 0A lit eputc 0 lit else
fdv @ 8 lit + @ 0< if "sh: " eputs dup cmd 8 lit + @ eputs ": cannot open" eputs 0A lit eputc 0 lit else
dup cmd @ prun
dup 0< if
	"sh: " eputs over cmd @ eputs
	dup FFFFFFFE lit = if ": not found" else dup FFFFFFF3 lit = if ": not allowed" else ": cannot run" then then eputs 0A lit eputc
	drop 0 lit
then
then then
swap 2 lit lshift pids @ + !
fdv @ 4 lit + @ dup 0< if drop else ?dup if close drop then then
fdv @ 8 lit + @ dup 0< if drop else dup 1 lit = if drop else close drop then then ;

\ cd  the shell's working directory (/proc/self/cwd written): its
\ argument, or the root.
: cd
0 lit cmd @ snext dup c@ 0= if drop "/" then
"/proc/self/cwd" 1 lit open
dup 0< if drop drop "sh: cd: no /proc" eputs 0A lit eputc else
	2dup swap dup strlen write 0< if "sh: cd: no such directory: " eputs swap eputs 0A lit eputc else nip then
	close drop
then ;

\ zombie? ( pid -- flag )  it has ended (its status's state Z).
: zombie?
stb @ "/proc/" scpy swap snum "/status" scpy 0 lit swap c!
stb @ 0 lit open dup 0< if drop 0 lit else
	dup stb @ 40 lit + 3F lit read swap close drop
	dup 0 lit > if
		stb @ 40 lit + + 0 lit swap c!  stb @ 40 lit +
		2 lit 0 lit do begin dup c@ dup 20 lit = swap 0= or 0= while 1 lit + repeat dup c@ if 1 lit + then loop
		c@ 5A lit =
	else drop 0 lit then
then ;

\ bgadd ( pid -- )  noted as running in the background (if a slot is free).
: bgadd
10 lit 0 lit do dup if i 2 lit lshift bgp @ + dup @ 0= if ! 0 lit else drop then then loop drop ;

\ reapbg  the background commands that ended, waited for and told.
: reapbg
10 lit 0 lit do
	i 2 lit lshift bgp @ + @ ?dup if
		dup zombie? if
			"[" puts dup u. "] done" puts 0A lit putc  wst wait drop
			0 lit i 2 lit lshift bgp @ + !
		else drop then
	then
loop ;

\ setpath  the path shown (no argument), or set to the argument.
: setpath
0 lit cmd @ snext dup c@ 0= if drop pathv @ puts 0A lit putc else
	dup strlen FF lit u< if pathv @ swap scpy 0 lit swap c! else drop "sh: path: too long" eputs 0A lit eputc then
then ;

: run
ncmd @ 8 lit u> if "sh: too many commands" eputs 0A lit eputc else
0 lit cmd @ c@ if
	0 lit cmd @ "exit" streq if 0 lit exit then
	0 lit cmd @ "path" streq if setpath else
	0 lit cmd @ "cd" streq if cd else
	0 lit pin !
	ncmd @ 0 lit do i launch loop
	bg @ if
		ncmd @ 0 lit do i 2 lit lshift pids @ + @ ?dup if bgadd then loop
		ncmd @ 1 lit - 2 lit lshift pids @ + @ ?dup if "[" puts u. "]" puts 0A lit putc then
	else
		ncmd @ 0 lit do i 2 lit lshift pids @ + @ ?dup if wst wait drop then loop
	then
	then then
then then ;

100 lit alloc line !  400 lit alloc abuf !  200 lit alloc fbuf !
800 lit alloc cmds !  8 lit alloc pfdv !  14 lit alloc fdv !  40 lit alloc pids !
40 lit alloc dup bgp !  10 lit 0 lit do 0 lit over i 2 lit lshift + ! loop drop  80 lit alloc stb !
100 lit alloc dup pathv ! "/bin" scpy 0 lit swap c!  80 lit alloc pbuf !
begin
	reapbg
	0 lit 1 lit 0 lit tty drop          \ its terminal in line mode (a program may have left it raw)
	"$ " puts
	rdline 0< if 0 lit exit then
	parse if run else bg @ 1 lit = if "sh: & only ends a line" else "sh: a command is missing" then eputs 0A lit eputc then
0 lit until
