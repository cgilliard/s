\ kernel.fam — the OS's kernel (docs/OS.md), steps 1 to 5.  The traps
\ (every interrupt and exception comes through one entry, which saves the
\ registers and calls ktrap), each hart's timer (100 ticks a second), the
\ page allocator (RAM in 4 KiB pages, a sorted list of free ranges, first
\ fit, neighbours merged when freed), every hart the machine has (started
\ from where they wait, lib/mach.fam and tabernacle; locks without atomic
\ instructions; queues with one writer and one reader; the software
\ interrupt that wakes a hart), and processes and threads in user mode,
\ scheduled on every hart by lottery, with their system calls.
\
\ Definitions only: src/boot.fam is the kernel's main, and the Test blocks
\ below run with `tools/fam --test [--smp=N] src/kernel.fam`
\ (scripts/oscheck.sh).
\
\ The kernel runs in machine mode on the stdlib's stacks (data stack sp,
\ return ids s10/s11, loop frames s8); each hart started later has its own,
\ and shares s10, which the variables are found from.  A trap arriving in
\ kernel code uses the stacks of the hart it arrives on, below what the
\ interrupted code holds: fam only ever stores to a stack after moving its
\ pointer past the slot, so nothing there is lost.  Variables are shared by
\ every hart; what is a hart's own is in an array indexed by its id.

\ ── Machine registers (raw words) ──

: mcause@                    \ ( -- mcause )
F3222034 ,   \ csrrs t0,mcause,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mepc@                      \ ( -- mepc )
F3221034 ,   \ csrrs t0,mepc,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtval@                     \ ( -- mtval )
F3223034 ,   \ csrrs t0,mtval,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtvec@                     \ ( -- mtvec )
F3225030 ,   \ csrrs t0,mtvec,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mhartid@                   \ ( -- id )  this hart's
F32240F1 ,   \ csrrs t0,mhartid,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: gp@                        \ ( -- gp )  the heap's next free byte
93820100 ,   \ addi t0,gp,0
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: s10@                       \ ( -- s10 )  where the variables are found from
93020D00 ,   \ addi t0,s10,0
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtime@                     \ ( -- t )  the CLINT's mtime, low word (10 MHz)
B7C20002 ,   \ lui t0,0x200c
03A382FF ,   \ lw t1,-8(t0)
1301C1FF ,   \ addi sp,sp,-4
23206100 ,   \ sw t1,0(sp)
;

: cmp@                       \ ( -- lo hi )  this hart's mtimecmp
732E40F1 ,   \ csrrs t3,mhartid,zero
131E3E00 ,   \ slli t3,t3,0x3
B7420002 ,   \ lui t0,0x2004
B382C201 ,   \ add t0,t0,t3
03A30200 ,   \ lw t1,0(t0)
83A34200 ,   \ lw t2,4(t0)
130181FF ,   \ addi sp,sp,-8
23226100 ,   \ sw t1,4(sp)
23207100 ,   \ sw t2,0(sp)
;

\ cmp! ( lo hi -- )  this hart's mtimecmp: the high word set out of reach
\ first, so no half-written value is ever due.
: cmp!
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
13018100 ,   \ addi sp,sp,8
732E40F1 ,   \ csrrs t3,mhartid,zero
131E3E00 ,   \ slli t3,t3,0x3
B7420002 ,   \ lui t0,0x2004
B382C201 ,   \ add t0,t0,t3
130EF0FF ,   \ addi t3,zero,-1
23A2C201 ,   \ sw t3,4(t0)
23A06200 ,   \ sw t1,0(t0)
23A27200 ,   \ sw t2,4(t0)
;

: ipi                        \ ( h -- )  hart h's software interrupt raised
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
93922200 ,   \ slli t0,t0,0x2
37030002 ,   \ lui t1,0x2000
B3826200 ,   \ add t0,t0,t1
93031000 ,   \ addi t2,zero,1
23A07200 ,   \ sw t2,0(t0)
;

: msipclr                    \ this hart's software interrupt cleared
F32240F1 ,   \ csrrs t0,mhartid,zero
93922200 ,   \ slli t0,t0,0x2
37030002 ,   \ lui t1,0x2000
B3826200 ,   \ add t0,t0,t1
23A00200 ,   \ sw zero,0(t0)
;

: tmron                      \ timer interrupts on (mie.MTIE, mstatus.MIE)
93020008 ,   \ addi t0,zero,128
73A04230 ,   \ csrrs zero,mie,t0
73600430 ,   \ csrrsi zero,mstatus,8
;

: tmroff                     \ timer interrupts off
93020008 ,   \ addi t0,zero,128
73B04230 ,   \ csrrc zero,mie,t0
;

: swon                       \ software interrupts on (mie.MSIE)
73604430 ,   \ csrrsi zero,mie,8
;

: wfi                        \ sleep until an interrupt is pending
73005010 ,   \ wfi
;

\ halt ( code -- )  QEMU exits with code (the SiFive test finisher).
: halt
03230100 ,   \ lw t1,0(sp)
13014100 ,   \ addi sp,sp,4
B7021000 ,   \ lui t0,0x100
13130301 ,   \ slli t1,t1,0x10
B7330000 ,   \ lui t2,0x3
93833333 ,   \ addi t2,t2,819
33637300 ,   \ or t1,t1,t2
23A06200 ,   \ sw t1,0(t0)
6F000000 ,   \ jal zero,.
;

:M fence  0F00F00F , ;       \ fence iorw,iorw: what came before, before what follows

\ ── Memory (raw words) ──

\ mcpy ( src dst n -- )  n bytes, a multiple of 4.
: mcpy
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
638E0300 ,   \ beq t2,zero,done
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
93824200 ,   \ addi t0,t0,4
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,loop
;

\ mmove ( src dst n -- )  as mcpy, the two allowed to overlap.
: mmove
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
63820304 ,   \ beq t2,zero,done
63E06202 ,   \ bltu t0,t1,backward
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
93824200 ,   \ addi t0,t0,4
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,forward
6F004002 ,   \ jal zero,done
B3827200 ,   \ add t0,t0,t2               backward:
33037300 ,   \ add t1,t1,t2
9382C2FF ,   \ addi t0,t0,-4
1303C3FF ,   \ addi t1,t1,-4
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,backward
;

\ mzero ( addr n -- )
: mzero
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
13018100 ,   \ addi sp,sp,8
638A0300 ,   \ beq t2,zero,done
23200300 ,   \ sw zero,0(t1)
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39A03FE ,   \ bne t2,zero,loop
;

\ panic ( msg -- )  a kernel bug: say so and stop.
: panic  "kernel panic: " puts puts 0A lit putc 1 lit halt ;

\ rnd ( -- n )  xorshift32 over rndseed: not for secrets; the lottery's
\ draws (step 5) and tests.  rndseed must not be 0.
: rndseed variable ;
: rnd
rndseed @
dup D lit lshift xor
dup 11 lit rshift xor
dup 5 lit lshift xor
dup rndseed ! ;

\ ── Each hart's own ──
\
\ Hart ids run below 960 (the mailboxes' page, lib/stdlib.fam).  An array
\ of a word per hart id for each of these, taken from the heap once.

:M MAXH 3C0 lit ;
: htick  variable ;          \ timer interrupts taken
: hipi   variable ;          \ software interrupts taken
: hup    variable ;          \ started (hart 0: always)
: hjob   variable ;          \ the job asked of it (0: none)
: hres   variable ;          \ what its job found (0: all well)
: hq     variable ;          \ its queue from hart 0
: hcur   variable ;          \ the thread it runs (0: none)
: harea  variable ;          \ its own trap area (mscratch when no thread runs)
: hstale variable ;          \ its PMP is to be reloaded (a block was unmapped)
: kvok   variable ;

\ harr ( h var -- addr )  hart h's word of a per-hart array.
: harr  @ swap 2 lit lshift + ;

: kvars
kvok @ 0= if
	MAXH 2 lit lshift dup alloc dup htick ! swap mzero
	MAXH 2 lit lshift dup alloc dup hipi ! swap mzero
	MAXH 2 lit lshift dup alloc dup hup ! swap mzero
	MAXH 2 lit lshift dup alloc dup hjob ! swap mzero
	MAXH 2 lit lshift dup alloc dup hres ! swap mzero
	MAXH 2 lit lshift dup alloc dup hq ! swap mzero
	MAXH 2 lit lshift dup alloc dup hcur ! swap mzero
	MAXH 2 lit lshift dup alloc dup harea ! swap mzero
	MAXH 2 lit lshift dup alloc dup hstale ! swap mzero
	1 lit kvok !
then ;

\ ── The timer ──

: period  variable ;         \ mtime between ticks

: ticks@  mhartid@ htick harr @ ;            \ ( -- n )  this hart's ticks

\ ktick  a timer interrupt: count it, and set this hart's next one a period
\ on from this one's (not from now: the rate does not drift).
: ktick
mhartid@ htick harr dup @ 1 lit + swap !
cmp@                         \ ( lo hi )
swap period @ +              \ ( hi lo' )
dup period @ u< if swap 1 lit + swap then   \ the low word wrapped: carry
swap cmp! ;

\ tmrinit  this hart's timer: 100 ticks a second (10 ms slices), the first
\ a period from now.
: tmrinit
186A0 lit period !           \ 100,000 at 10 MHz
0 lit mhartid@ htick harr !
mtime@ period @ +            \ ( lo' )
200BFFC lit @                \ ( lo' hi )  mtime's high word, carried
over period @ u< if 1 lit + then
cmp!
tmron ;

\ ── Pages ──
\
\ The free ranges, sorted by address: an entry is the range's first byte
\ and its length in pages.  A range never touches the next (they are
\ merged when freed), so the table holds as many entries as RAM has holes.

: pgtab  variable ;          \ the table: PGMAX entries of 8 bytes
: pgn    variable ;          \ entries in use
: PGMAX  200 lit ;           \ 512 entries, one 4 KiB page

: pgent  3 lit lshift pgtab @ + ;            \ ( i -- entry )
: pglen  pgent 4 lit + @ ;                   \ ( i -- pages )
: pgend  pgent dup @ swap 4 lit + @ C lit lshift + ;   \ ( i -- end )

\ pginit ( base limit -- )  all of [base, limit) free, page-aligned.  The
\ table is taken from the heap the first time.
: pginit
pgtab @ 0= if 1000 lit alloc pgtab ! then
over - C lit rshift          \ ( base pages )
pgtab @ 4 lit + !
pgtab @ !
1 lit pgn ! ;

\ pgdel ( i -- )  remove entry i.
: pgdel
begin
dup 1 lit + pgn @ u<
while
dup 1 lit + pgent            \ ( i src )
over pgent                   \ ( i src dst )
over @ over !
swap 4 lit + @ swap 4 lit + !
1 lit +
repeat
drop
pgn @ 1 lit - pgn ! ;

\ pgins ( start pages i -- )  a new entry i, those from i on moved up.
: pgins
pgn @ PGMAX = if "page table full" panic then
pgn @                        \ ( start pages i j )
begin
2dup u<
while
1 lit - dup pgent            \ ( start pages i j-1 src )
dup 8 lit +                  \ ( ... src dst )
over @ over !
swap 4 lit + @ swap 4 lit + !
repeat
drop pgent                   \ ( start pages e )
tuck 4 lit + !
!
pgn @ 1 lit + pgn ! ;

\ pgfit ( pages -- i )  the first range at least that long (pgn: none).
: pgfit
0 lit
begin
dup pgn @ u<
if 2dup pglen u> else 0 lit then
while
1 lit +
repeat
nip ;

\ pgalloc ( pages -- addr | 0 )  first fit, taken from the range's start.
: pgalloc
dup pgfit                    \ ( pages i )
dup pgn @ u< 0= if
2drop 0 lit
else
swap over pgent              \ ( i pages e )
2dup 4 lit + @ swap -        \ ( i pages e left )
over 4 lit + !               \ ( i pages e )
dup @                        \ ( i pages e start )
rot C lit lshift             \ ( i e start bytes )
over +                       \ ( i e start start' )
rot !                        \ ( i start )
swap
dup pglen 0= if pgdel else drop then
then ;

\ pgafter ( addr -- i )  the first range starting above addr.
: pgafter
0 lit
begin
dup pgn @ u<
if 2dup pgent @ u> else 0 lit then
while
1 lit +
repeat
nip ;

\ pgfree ( addr pages -- )  back into the table, merged with the range
\ before it and the one after when they touch.
: pgfree
over pgafter                 \ ( addr pages i )
dup if dup 1 lit - pgend 3 lit pick = else 0 lit then
if
\ it extends the range before
dup 1 lit - pgent 4 lit +    \ ( addr pages i lenp )
dup @ 3 lit pick + swap !    \ ( addr pages i )
dup pgn @ u< if
dup 1 lit - pgend over pgent @ = if
\ and now reaches the one after: join them
dup pglen
over 1 lit - pgent 4 lit +
dup @ rot + swap !
dup pgdel
then
then
drop 2drop
else
dup pgn @ u< if 2 lit pick 2 lit pick C lit lshift + over pgent @ = else 0 lit then
if
\ it reaches back to the range after
pgent                        \ ( addr pages e )
dup 4 lit + dup @ 3 lit pick + swap !
nip !
else
pgins
then
then ;

\ pgfree# ( -- pages )  free pages in all.  (A `do` runs its body at least
\ once, so an empty table is a case of its own.)
: pgfree#
0 lit pgn @ ?dup if 0 lit do i pglen + loop then ;

\ pgtag ( addr pages -- )  tests: each page's first word set to addr.
: pgtag  0 lit do dup i C lit lshift + over swap ! loop drop ;
\ pgchk ( addr pages -- ok )  tests: each page's first word still addr.
: pgchk  1 lit -rot 0 lit do dup i C lit lshift + @ over = rot and swap loop drop ;

\ ── Locks, without atomic instructions ──
\
\ A tournament of two-hart Peterson locks: a hart takes the lock at the
\ leaf for its id, then each node above, against the one other hart that
\ can reach that node from the other side; about log2 of the harts steps,
\ not one per hart as Lamport's bakery lock takes.  Peterson's lock needs
\ a hart's write of its flag ordered before its read of the other's, which
\ RISC-V's memory model does not give without a fence: there is one there.
\ A lock: its leaves N (a power of two above every hart id), its levels,
\ then a flag per side of each node (2N words), then each node's victim
\ (N words).

: lkn    variable ;          \ every lock's leaves, set before any is made
: lkl    variable ;          \ and its levels

\ lknew ( -- lock )  a lock, from the heap.
: lknew
lkn @ C lit * 8 lit + dup alloc tuck swap mzero
lkl @ over 4 lit + !
lkn @ over ! ;

\ lock ( lock -- )  taken, by this hart; held until unlock.
: lock
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83250500 ,   \ lw a1,0(a0)                ( N )
03264500 ,   \ lw a2,4(a0)                ( levels )
93068500 ,   \ addi a3,a0,8               ( the flags )
13973500 ,   \ slli a4,a1,0x3
3387E600 ,   \ add a4,a3,a4               ( the victims )
F32740F1 ,   \ csrrs a5,mhartid,zero
B387B700 ,   \ add a5,a5,a1               ( this hart's leaf )
63040606 ,   \ beq a2,zero,done
93F21700 ,   \ andi t0,a5,1               level: ( our side )
13D31700 ,   \ srli t1,a5,0x1             ( the node )
93131300 ,   \ slli t2,t1,0x1
B3E35300 ,   \ or t2,t2,t0
93932300 ,   \ slli t2,t2,0x2
B3837600 ,   \ add t2,a3,t2
130E1000 ,   \ addi t3,zero,1
23A0C301 ,   \ sw t3,0(t2)                ( our flag up )
931E2300 ,   \ slli t4,t1,0x2
B30ED701 ,   \ add t4,a4,t4
23A05E00 ,   \ sw t0,0(t4)                ( and ourselves the victim )
0F003003 ,   \ fence rw,rw                ( both seen before we look )
13CF1200 ,   \ xori t5,t0,1
931F1300 ,   \ slli t6,t1,0x1
B3EFEF01 ,   \ or t6,t6,t5
939F2F00 ,   \ slli t6,t6,0x2
B38FF601 ,   \ add t6,a3,t6               ( the other side's flag )
03AE0F00 ,   \ lw t3,0(t6)                wait:
63060E00 ,   \ beq t3,zero,won
03AE0E00 ,   \ lw t3,0(t4)
E30A5EFE ,   \ beq t3,t0,wait             ( its flag up and we the victim )
93070300 ,   \ addi a5,t1,0               won: ( up to the node )
1306F6FF ,   \ addi a2,a2,-1
E31206FA ,   \ bne a2,zero,level
0F003003 ,   \ fence rw,rw                done: ( the lock before what it guards )
;

\ unlock ( lock -- )  given up, from the top node down.
: unlock
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83250500 ,   \ lw a1,0(a0)
03264500 ,   \ lw a2,4(a0)
93068500 ,   \ addi a3,a0,8
F32740F1 ,   \ csrrs a5,mhartid,zero
B387B700 ,   \ add a5,a5,a1
0F003003 ,   \ fence rw,rw                ( what it guards, before )
63060602 ,   \ beq a2,zero,done
1306F6FF ,   \ addi a2,a2,-1              level:
B3D2C700 ,   \ srl t0,a5,a2
13F31200 ,   \ andi t1,t0,1               ( our side at that level )
93D21200 ,   \ srli t0,t0,0x1             ( the node )
93921200 ,   \ slli t0,t0,0x1
B3E26200 ,   \ or t0,t0,t1
93922200 ,   \ slli t0,t0,0x2
B3825600 ,   \ add t0,a3,t0
23A00200 ,   \ sw zero,0(t0)              ( our flag down )
E31E06FC ,   \ bne a2,zero,level
;

\ ── Queues with one writer and one reader ──
\
\ head, tail, and 64 words: the writer alone moves head, the reader alone
\ tail, so they need fences, not a lock.

\ qnew ( -- q )
: qnew  108 lit dup alloc tuck swap mzero ;

\ qpush ( v q -- ok )  0 when full.
: qpush
dup @ over 4 lit + @ - 40 lit u< 0= if 2drop 0 lit else
	dup @ 3F lit and 2 lit lshift over 8 lit + +
	rot swap !
	fence                                \ the word, before the head that shows it
	dup @ 1 lit + swap !
	1 lit
then ;

\ qpop ( q -- v 1 | 0 )
: qpop
dup 4 lit + @ over @ = if drop 0 lit else
	fence                                \ the head, before the word it shows
	dup 4 lit + @ 3F lit and 2 lit lshift over 8 lit + + @
	fence                                \ the word read, before its slot is free
	swap dup 4 lit + @ 1 lit + swap 4 lit + !
	1 lit
then ;

\ ── Every hart: what it shares ──
\
\ Hart 0 runs the kernel's main; the others wait where lib/stdlib.fam (or
\ tabernacle) left them, each having marked its mailbox present, until
\ hstart gives each a record: where to go, and its own stacks, trap area
\ and trap entry.  A started hart runs hmain: its timer, then the jobs hart
\ 0 asks of it (its job word, and a software interrupt), sleeping between.

: nharts  variable ;         \ harts running (1 before hstart)
: hmax    variable ;         \ the highest hart id + 1
: hentrya variable ;         \ where a started hart begins
: hstarted variable ;
: klk     variable ;         \ the kernel's lock
: lkk     variable ;         \ tests: each hart's turns
: lkc     variable ;         \ tests: the count they keep

: mbox  2 lit lshift 87FF1000 lit + ;       \ ( h -- addr )  its mailbox word

\ lkstrs  a test job: lkk times, under the kernel's lock, add 1 to lkc
\ (read, then written: without the lock, two harts would lose counts).
: lkstrs  lkk @ 0 lit do klk @ lock lkc @ 1 lit + lkc ! klk @ unlock loop ;

\ qstrs  a test job: from this hart's queue, lkk numbers, 1 on, in order.
: qstrs
mhartid@ hq harr @ 1 lit
begin dup lkk @ u> 0= while
	over qpop if over <> if 1 lit mhartid@ hres harr ! then 1 lit + then
repeat
2drop ;

: hrun  dup 1 lit = if lkstrs then 2 lit = if qstrs then ;   \ ( job -- )

\ kfault  an exception (or an interrupt nobody takes) in the kernel: a bug.
: kfault
"kernel: hart " puts mhartid@ u. " trap " puts mcause@ u.x
" at " puts mepc@ u.x
" (" puts mtval@ u.x ")" puts 0A lit putc
1 lit halt ;

\ ── User mode ──
\
\ A hart's trap area, or a thread's control block (below), past the
\ registers: 128 the kernel's sp, s8, s10, s11 and gp as trun left them,
\ 148 where trun goes on, 152 set when the thread stops running, 160 its
\ process's code (its first byte, the byte past it), 168 its memory.

: area@                      \ ( -- area )  this hart's trap area
F3220034 ,   \ csrrs t0,mscratch,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mpp@                       \ ( -- mode )  the mode the trap came from: 0 user, 3 machine
F3220030 ,   \ csrrs t0,mstatus,zero
93D2B200 ,   \ srli t0,t0,0xb
93F23200 ,   \ andi t0,t0,3
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mepc!                      \ ( pc -- )  where mret goes
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73901234 ,   \ csrrw zero,mepc,t0
;

: sysarg  area@ + @ ;        \ ( offset -- value )  a register the process trapped with
: sysret  area@ 28 lit + ! ; \ ( value -- )  its a0 when it goes on
\ inr ( a e lo hi -- ok )  [a, e) within [lo, hi).
: inr  rot u< 0= -rot u< 0= and ;

\ umap? ( addr end -- ok )  within one of the process's mapped blocks.
: umap?
0 lit 4 lit 0 lit do
	2 lit pick 2 lit pick
	i 3 lit lshift area@ B4 lit + @ 30 lit + +  dup @ swap 4 lit + @  inr
	i 3 lit lshift area@ B4 lit + @ 30 lit + + @ 0= 0= and or
loop
nip nip ;

\ urange ( addr n -- ok )  n bytes from addr within the process's code, its
\ memory, or a block it mapped: what it may give the kernel to read.
: urange
over + 2dup u> if 2drop 0 lit else
	2dup area@ A0 lit + @ area@ A4 lit + @ inr
	2 lit pick 2 lit pick area@ A8 lit + @ area@ AC lit + @ inr or
	-rot umap? or
then ;

\ uwrange ( addr n -- ok )  the same but for its code: what the kernel may
\ write for it.
: uwrange
over + 2dup u> if 2drop 0 lit else
	2dup area@ A8 lit + @ area@ AC lit + @ inr
	-rot umap? or
then ;

\ upmp  PMP for the thread's process: its code read and execute (entries
\ 1-2, top of range, from the thread block, mscratch), its memory read and
\ write (3-4), its mapped blocks read and write (5-12, from the process);
\ user mode reaches nothing else, since an access matching no entry is
\ denied in user mode (allowed in machine mode).  An empty block's entry is
\ off: a zero-length range is not enough, since QEMU takes a TOR range's end
\ as the bound less one, and [0, 0) as all of memory.
: upmp
F3220034 ,   \ csrrs t0,mscratch,zero
03A3020A ,   \ lw t1,160(t0)              ( code start )
13532300 ,   \ srli t1,t1,0x2
7310133B ,   \ csrw pmpaddr1,t1
03A3420A ,   \ lw t1,164(t0)              ( code end )
13532300 ,   \ srli t1,t1,0x2
7310233B ,   \ csrw pmpaddr2,t1
03A3820A ,   \ lw t1,168(t0)              ( memory start )
13532300 ,   \ srli t1,t1,0x2
7310333B ,   \ csrw pmpaddr3,t1
03A3C20A ,   \ lw t1,172(t0)              ( memory end )
13532300 ,   \ srli t1,t1,0x2
7310433B ,   \ csrw pmpaddr4,t1
83A3420B ,   \ lw t2,180(t0)              ( the process, for its mapped blocks )
03A30303 ,   \ lw t1,48(t2)
13532300 ,   \ srli t1,t1,0x2
7310533B ,   \ csrw pmpaddr5,t1
03A34303 ,   \ lw t1,52(t2)
13532300 ,   \ srli t1,t1,0x2
7310633B ,   \ csrw pmpaddr6,t1
03A38303 ,   \ lw t1,56(t2)
13532300 ,   \ srli t1,t1,0x2
7310733B ,   \ csrw pmpaddr7,t1
03A3C303 ,   \ lw t1,60(t2)
13532300 ,   \ srli t1,t1,0x2
7310833B ,   \ csrw pmpaddr8,t1
03A30304 ,   \ lw t1,64(t2)
13532300 ,   \ srli t1,t1,0x2
7310933B ,   \ csrw pmpaddr9,t1
03A34304 ,   \ lw t1,68(t2)
13532300 ,   \ srli t1,t1,0x2
7310A33B ,   \ csrw pmpaddr10,t1
03A38304 ,   \ lw t1,72(t2)
13532300 ,   \ srli t1,t1,0x2
7310B33B ,   \ csrw pmpaddr11,t1
03A3C304 ,   \ lw t1,76(t2)
13532300 ,   \ srli t1,t1,0x2
7310C33B ,   \ csrw pmpaddr12,t1
37030D00 ,   \ lui t1,0xd0               ( entry 2: code, R+X, TOR )
7310033A ,   \ csrw pmpcfg0,t1
03A30303 ,   \ lw t1,48(t2)              ( entries 4, 6: memory, block 1, R+W; )
33336000 ,   \ snez t1,t1                ( a block's entry off when it is empty )
33036040 ,   \ neg t1,t1
370E0B00 ,   \ lui t3,0xb0
337E6E00 ,   \ and t3,t3,t1
130EBE00 ,   \ addi t3,t3,11
73101E3A ,   \ csrw pmpcfg1,t3
03A38303 ,   \ lw t1,56(t2)              ( entries 8, 10: blocks 2, 3 )
33336000 ,   \ snez t1,t1
33036040 ,   \ neg t1,t1
137EB300 ,   \ andi t3,t1,11
03A30304 ,   \ lw t1,64(t2)
33336000 ,   \ snez t1,t1
33036040 ,   \ neg t1,t1
B70E0B00 ,   \ lui t4,0xb0
B3FE6E00 ,   \ and t4,t4,t1
336EDE01 ,   \ or t3,t3,t4
73102E3A ,   \ csrw pmpcfg2,t3
03A38304 ,   \ lw t1,72(t2)              ( entry 12: block 4 )
33336000 ,   \ snez t1,t1
33036040 ,   \ neg t1,t1
137EB300 ,   \ andi t3,t1,11
73103E3A ,   \ csrw pmpcfg3,t3
;

\ hfresh  upmp, this hart's stale mark cleared first: an unmap that marks
\ it after this sees it cleared only by a later upmp (sunmap).
: hfresh  0 lit mhartid@ hstale harr ! fence upmp ;

\ The programs the image carries (scripts/mkimage.sh): a table past them,
\ its offset and "PROG" in the image's last 8 bytes, where the kernel's
\ return ids begin (s10).  An entry: the name (16 bytes), the offset, the
\ length, the memory to start with.

: progtab  s10@ 4 lit - @ 474F5250 lit = if s10@ 8 lit - @ 80000000 lit + else 0 lit then ;  \ ( -- table | 0 )

\ streq ( a b -- ok )  two NUL-terminated strings the same.
: streq
begin
	over c@ over c@ over <>
	if 2drop drop 0 lit 1 lit else
	0= if 2drop 1 lit 1 lit else
	1 lit + swap 1 lit + swap 0 lit then then
until ;

\ pfind ( name -- entry | 0 )
: pfind
progtab ?dup 0= if drop 0 lit else
	dup @ ?dup 0= if 2drop 0 lit else
		0 lit swap 0 lit do
			dup 0= if over 4 lit + i 1C lit * + 3 lit pick over streq if nip else drop then then
		loop
		nip nip
	then
then ;

\ ── Processes and threads ──
\
\ A thread's control block (256 bytes) is its trap area while it runs: the
\ entry saves its registers there (its pc at 0, x1-x31 at 4-124), the
\ kernel's stacks for its traps are kept at 128-144 (where trun left them),
\ trun goes on at 148 when 152 is set, its process's code and memory at
\ 160-172 (for PMP and the checks of what it passes); then its state at 176
\ (0 free, 1 ready, 2 running, 3 asleep, 4 blocked, 6 ended, not yet
\ joined, 7 ended, its slot freed once it is off its hart: while the
\ thread is there, the hart's way back is in it), its process 180, its tickets 184, when to wake 188, what it
\ waits on 192, the ticks it has run 196, what it ended with 204, where a
\ child's status goes 208, what kind of wait 212 (1 a child, 2 a thread, 3
\ a lock, 4 a word), whether that wait has a time limit 216, and whether
\ a hart is on it 220: from when tpick gives it to a hart until that hart
\ is off it again (tafter).  Until then it is not run elsewhere, even woken
\ (the hart going back to its loop still uses its block), nor its slot
\ reused.
\
\ A process (256 bytes): its state at 0 (0 free, 1 living, 2 ended, its
\ parent not yet told), its parent's pid at 4, exit code 8, threads not
\ ended 12, memory (first byte 16, pages 20), code (first byte 24, the byte
\ past it 28), tickets 32, program's table entry 36 (whose name is its
\ first 16 bytes), whether it is ending 40; then its mapped blocks
\ (docs/OS.md, section 10), 48 on: 4 pairs (first byte, byte past), each 0
\ when empty, which `map` and `unmap` change and `upmp` puts in PMP
\ entries 5-12 (so a process holds code, its first region, and 4 blocks);
\ the ticks its threads have run 80; and at 128, its 16 descriptors (each
\ an open file of the table below, or 0).
\
\ Each hart runs hloop: a thread drawn by lottery among those ready (each
\ holding its tickets), run until it traps back (its slice over at a timer
\ tick, a call that blocks, its end), then the next; when none is ready,
\ wfi.  The tables are the kernel's lock's (klk), held briefly.

:M MAXT 100 lit ;            \ 256 threads
:M MAXP 40 lit ;             \ 64 processes
: thr  variable ;            \ the threads' table
: prc  variable ;            \ the processes'

: thn     8 lit lshift thr @ + ;           \ ( i -- t )
: prn     8 lit lshift prc @ + ;           \ ( i -- p )
: tid     thr @ - 8 lit rshift 1 lit + ;   \ ( t -- tid )
: pid     prc @ - 8 lit rshift 1 lit + ;   \ ( p -- pid )
: tproc   B4 lit + @ ;                     \ ( t -- p )
: tstate  B0 lit + @ ;                     \ ( t -- state )
: tstate! B0 lit + ! ;                     \ ( state t -- )
: cproc   area@ tproc ;                    \ ( -- p )  the process trapping

: mscr!                  \ ( area -- )
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73900234 ,   \ csrrw zero,mscratch,t0
;
: kdi  73700430 , ;          \ interrupts off (mstatus.MIE)
: kei  73600430 , ;          \ and on

: thi  variable ;            \ the thread slots ever used: the loops over the
: phi  variable ;            \ threads (and processes) go no further

\ ptinit  the tables, from the pages.
:M MAXF 100 lit ;            \ 256 open files
: fil  variable ;            \ their table

: ptinit
0 lit thi !  0 lit phi !
10 lit pgalloc dup 0= if "no memory for the threads" panic then dup thr ! 10000 lit mzero
4 lit pgalloc dup 0= if "no memory for the processes" panic then dup prc ! 4000 lit mzero
2 lit pgalloc dup 0= if "no memory for the open files" panic then dup fil ! 2000 lit mzero ;

\ hpoke  every other started hart woken: a thread is ready.
: hpoke  hmax @ 0 lit do i mhartid@ <> if i hup harr @ if i ipi then then loop ;

\ max ( a b -- larger )  unsigned.
: max  2dup u< if swap then drop ;


\ ── Open files (docs/OS.md, section 5) ──
\
\ An open file (32 bytes, in fil): its kind at 0 (0 free, 1 the console, 2
\ null, 3 a pipe's end, 4 a /proc key's text, 5 a /proc key to write), the
\ descriptors on it 4, its page 8 (a pipe's, or the text's), the text's
\ read position 12 and length 16, the process a key is of 20 and which key
\ 24 (1 tickets, 2 kill), its mode 28 (1 read, 2 write, 3 both).  A pipe is
\ a page: its read ends 0, its write ends 4, bytes written 8 and read 12
\ (counting on, so their difference is what it holds), its 2 KiB of data
\ from 2048.
\
\ A call that cannot go on (nothing to read, no room to write) waits on a
\ token (the pipe's page, or cin for the console) with its pc on the ecall
\ itself, so it runs again from the start when woken (tretry): whatever
\ wakes it (fwake) need not know what it waited for.

: fln  5 lit lshift fil @ + ;                \ ( i -- f )
: pfd  swap 2 lit lshift + 80 lit + ;        \ ( fd p -- slot )
: kerr?  FFFFF000 lit u< 0= ;                \ ( x -- flag )  an error, not an address

\ fnew ( kind mode -- f | 0 )  an open file, one descriptor on it.
: fnew
0 lit MAXF 0 lit do dup 0= if i fln dup @ 0= if nip else drop then then loop
dup if dup 20 lit mzero  tuck 1C lit + !  tuck !  1 lit over 4 lit + ! else nip nip then ;

\ fwake ( token -- )  the threads waiting on it ready, and those polling.
: fwake
0 lit
thi @ 0 lit do
	i thn dup tstate 4 lit = if
		dup D4 lit + @ dup 5 lit = if drop dup C0 lit + @ 3 lit pick = else 6 lit = then
		if 0 lit over D4 lit + !  0 lit over D8 lit + !  1 lit swap tstate!  1 lit or else drop then
	else drop then
loop
nip if hpoke then ;

\ fclose ( f -- )  a descriptor fewer on it; with the last, it is gone (a
\ pipe's end: its peers woken, the page freed with the last end).
: fclose
dup 4 lit + @ 1 lit - dup 2 lit pick 4 lit + !
if drop else
	dup @ 3 lit = if
		dup 8 lit + @  over 1C lit + @ 1 lit = if 0 lit else 4 lit then + dup @ 1 lit - swap !
		dup 8 lit + @ dup fwake  dup @ over 4 lit + @ or 0= if 1 lit pgfree else drop then
	then
	dup @ 4 lit = if dup 8 lit + @ ?dup if 1 lit pgfree then then
	0 lit swap !
then ;

\ The console: input from the UART, polled by hart 0 at its ticks (and
\ while idle), kept in a 1 KiB ring as lines are edited: typed bytes echoed,
\ backspace and delete erase, Enter ends the line (read gets whole lines
\ only), ^D ends the input (a read at a line's start gets 0).

: cin    variable ;          \ the token console readers wait on
: cbuf   variable ;          \ the ring
: chead  variable ;          \ bytes in (the line being edited after crdy)
: crdy   variable ;          \ bytes ready to read
: ctail  variable ;          \ bytes read
: ceof   variable ;          \ ^D at a line's start: the next read gets 0

: cinit  400 lit alloc cbuf !  0 lit chead !  0 lit crdy !  0 lit ctail !  0 lit ceof ! ;
: cb  3FF lit and cbuf @ + ;                 \ ( i -- addr )

\ ckey ( c -- )  a byte typed.  Under klk.
: ckey
dup D lit = over A lit = or if
	drop chead @ ctail @ - 3FF lit u< if
		A lit chead @ cb c!  chead @ 1 lit + dup chead ! crdy !  D lit putc A lit putc  cin fwake
	then
else
dup 8 lit = over 7F lit = or if
	drop chead @ crdy @ <> if chead @ 1 lit - chead !  8 lit putc 20 lit putc 8 lit putc then
else
dup 4 lit = if
	drop chead @ crdy @ = if 1 lit ceof ! else chead @ crdy ! then cin fwake
else
dup 20 lit u< if drop else
	chead @ ctail @ - 3FE lit u< if dup chead @ cb c!  chead @ 1 lit + chead !  putc else drop then
then then then then ;

\ cpoll  what the UART has, taken.  Not from a trap of the kernel's (it
\ might hold klk): from user mode's, or hstep's.
: cpoll  klk @ lock begin 10000005 lit c@ 1 lit and while 10000000 lit c@ ckey repeat klk @ unlock ;

\ thnew ( -- t | 0 ), prnew ( -- p | 0 )  a free slot.
: thnew
0 lit MAXT 0 lit do dup 0= if i thn dup tstate over DC lit + @ or 0= if nip else drop then then loop
dup if dup tid thi @ max thi ! then ;
: prnew
0 lit MAXP 0 lit do dup 0= if i prn dup @ 0= if nip else drop then then loop
dup if dup pid phi @ max phi ! then ;

: spe variable ;  : spp variable ;  : spt variable ;

\ pspawn ( name tickets parent -- pid | error )  a process running a
\ program of the image, its one thread ready.  Under klk.  -2: no such
\ program, -11: no room in the tables, -12: no memory.
: pspawn
rot pfind dup spe !
0= if 2drop FFFFFFFE lit else
prnew dup spp ! 0= if 2drop FFFFFFF5 lit else
thnew dup spt ! 0= if 2drop FFFFFFF5 lit else
spe @ 18 lit + @ FFF lit + C lit rshift dup pgalloc
dup 0= if 2drop 2drop FFFFFFF4 lit else
	dup 2 lit pick C lit lshift mzero
	spp @ 100 lit mzero
	spp @ 10 lit + !
	spp @ 14 lit + !
	spp @ 4 lit + !
	dup spp @ 20 lit + !
	spe @ spp @ 24 lit + !
	spe @ 10 lit + @ 80000000 lit + spp @ 18 lit + !
	spp @ 18 lit + @ spe @ 14 lit + @ + FFF lit + FFFFF000 lit and spp @ 1C lit + !   \ code to a page's end (mkimage pads it)
	1 lit spp @ C lit + !
	1 lit spp @ !
	spt @ 100 lit mzero
	spt @ B8 lit + !
	spp @ spt @ B4 lit + !
	spp @ 18 lit + @ dup spt @ ! spt @ A0 lit + !
	spp @ 1C lit + @ spt @ A4 lit + !
	spp @ 10 lit + @ dup spt @ A8 lit + ! spt @ 28 lit + !
	spp @ 10 lit + @ spp @ 14 lit + @ C lit lshift + dup spt @ AC lit + ! spt @ 2C lit + !
	1 lit spt @ tstate!
	hpoke
	spp @ pid
then then then then ;

\ thart ( t -- h+1 | 0 )  the hart running it.
: thart  0 lit hmax @ 0 lit do i hcur harr @ 2 lit pick = if drop i 1 lit + then loop nip ;

\ preap ( child t -- )  an ended child's status given to t, a thread of
\ its parent waiting for it (t 0: nobody), and its slot freed.
: preap
dup if
	over pid over 28 lit + !
	dup D0 lit + @ ?dup if 2 lit pick 8 lit + @ swap ! then
	0 lit over D4 lit + !
	1 lit swap tstate!
else drop then
0 lit swap ! ;

\ pwaiter ( child -- t | 0 )  a thread of its parent waiting for it.
: pwaiter
0 lit
thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 1 lit = and
		over tproc 4 lit pick 4 lit + @ 1 lit - prn = and
		if dup C0 lit + @ dup FFFFFFFF lit = swap 4 lit pick pid = or if nip else drop then else drop then
	then
loop
nip ;

\ pfinish ( p -- )  its last thread has ended: its descriptors closed, its memory and mapped
\ blocks back, its unjoined threads' slots free, its children given to the
\ kernel (those ended, freed), and its parent told (the kernel says so on
\ the console).
: pfinish
dup 80 lit + 10 lit 0 lit do dup @ ?dup if fclose then 0 lit over ! 4 lit + loop drop
dup 10 lit + @ over 14 lit + @ pgfree
dup 30 lit + 4 lit 0 lit do
	dup @ ?dup if over 4 lit + @ swap - C lit rshift 2 lit pick @ swap pgfree then
	8 lit +
loop drop
thi @ 0 lit do
	i thn dup tproc 2 lit pick = over tstate 6 lit = and if
		dup DC lit + @ if 7 lit else 0 lit then swap tstate!
	else drop then
loop
phi @ 0 lit do
	i prn dup @ if
		dup 4 lit + @ 2 lit pick pid = if
			dup @ 2 lit = if 0 lit swap ! else 0 lit swap 4 lit + ! then
		else drop then
	else drop then
loop
2 lit over !
dup 4 lit + @ 0= if
	"kernel: " puts dup 24 lit + @ puts " ended: " puts dup 8 lit + @ . 0A lit putc
	0 lit swap !
else
	dup pwaiter ?dup if preap hpoke else drop then
then ;

\ tdead ( t -- )  a thread gone; its process finished with its last.
: tdead
0 lit over tstate!
tproc dup C lit + @ 1 lit - dup 2 lit pick C lit + !
0= if pfinish else drop then ;


\ pexit ( p code -- )  a process ends: its threads not running gone now,
\ those running stopped at their next trap (a software interrupt brings
\ one), then gone too.  Under klk.
: pexit
over 8 lit + !
1 lit over 28 lit + !
thi @ 0 lit do
	i thn dup tproc 2 lit pick = if
		dup tstate 2 lit = if
			thart ?dup if 1 lit - ipi then
		else
			dup tstate dup 0= over 6 lit = or swap 7 lit = or if drop else tdead then
		then
	else drop then
loop
drop ;

\ runnable ( t -- ok )  ready, or asleep or waiting with a time limit and
\ its time come.
: runnable
dup DC lit + @ if drop 0 lit else
dup tstate
dup 1 lit = if 2drop 1 lit else
dup 3 lit = swap 4 lit = 2 lit pick D8 lit + @ and or if
	BC lit + @ mtime@ swap - 0< 0=
else drop 0 lit then then then ;

\ rndbelow ( n -- r )  0 to n-1, at random (a mask, drawn again past n:
\ there is no division here worth having).
: rndbelow
1 lit begin 2dup u> while 1 lit lshift repeat 1 lit -
begin rnd over and dup 3 lit pick u< 0= while drop repeat
nip nip ;

\ tgo ( t -- t )  claimed to run: a wait whose time ran out returns -110.
: tgo
1 lit over DC lit + !
dup tstate 4 lit = if
	FFFFFF92 lit over 28 lit + !
	dup E0 lit + @ if dup @ 4 lit + over !  0 lit over E0 lit + ! then
then
0 lit over D8 lit + !  0 lit over D4 lit + !
2 lit over tstate! ;

\ tpick ( -- t | 0 )  the lottery: a runnable thread, each with the chance
\ of its tickets over all theirs.  Under klk.
: tpick
0 lit thi @ 0 lit do i thn dup runnable if B8 lit + @ + else drop then loop
?dup 0= if 0 lit else
	rndbelow
	0 lit swap
	thi @ 0 lit do
		over 0= if
			i thn dup runnable if
				B8 lit + @ 2dup u< if drop nip i thn swap else - then
			else drop then
		then
	loop
	drop
	dup if tgo then
then ;

\ trun ( t -- )  the thread run on this hart, in user mode, until it traps
\ back to stay (the entry then goes on here, after the mret).  Interrupts
\ are off while mscratch is the thread's: one taken in machine mode then
\ would save the kernel's registers over the thread's.
: trun
kdi
dup mhartid@ hcur harr !
mscr!
hfresh
F3220034 ,   \ csrrs t0,mscratch,zero
23A02208 ,   \ sw sp,128(t0)              ( the kernel's stacks, for its traps )
23A28209 ,   \ sw s8,132(t0)
23A4A209 ,   \ sw s10,136(t0)
23A6B209 ,   \ sw s11,140(t0)
23A83208 ,   \ sw gp,144(t0)
17030000 ,   \ auipc t1,0x0
1303830A ,   \ addi t1,t1,168             ( past the mret: where it comes back )
23AA6208 ,   \ sw t1,148(t0)
03A30200 ,   \ lw t1,0(t0)
73101334 ,   \ csrrw zero,mepc,t1         ( its pc )
37230000 ,   \ lui t1,0x2
13030380 ,   \ addi t1,t1,-2048
73300330 ,   \ csrrc zero,mstatus,t1      ( MPP: user mode )
13030008 ,   \ addi t1,zero,128
73200330 ,   \ csrrs zero,mstatus,t1      ( MPIE: interrupts on in it )
83A04200 ,   \ lw ra,4(t0)                ( its registers )
03A18200 ,   \ lw sp,8(t0)
83A1C200 ,   \ lw gp,12(t0)
03A20201 ,   \ lw tp,16(t0)
03A38201 ,   \ lw t1,24(t0)
83A3C201 ,   \ lw t2,28(t0)
03A40202 ,   \ lw s0,32(t0)
83A44202 ,   \ lw s1,36(t0)
03A58202 ,   \ lw a0,40(t0)
83A5C202 ,   \ lw a1,44(t0)
03A60203 ,   \ lw a2,48(t0)
83A64203 ,   \ lw a3,52(t0)
03A78203 ,   \ lw a4,56(t0)
83A7C203 ,   \ lw a5,60(t0)
03A80204 ,   \ lw a6,64(t0)
83A84204 ,   \ lw a7,68(t0)
03A98204 ,   \ lw s2,72(t0)
83A9C204 ,   \ lw s3,76(t0)
03AA0205 ,   \ lw s4,80(t0)
83AA4205 ,   \ lw s5,84(t0)
03AB8205 ,   \ lw s6,88(t0)
83ABC205 ,   \ lw s7,92(t0)
03AC0206 ,   \ lw s8,96(t0)
83AC4206 ,   \ lw s9,100(t0)
03AD8206 ,   \ lw s10,104(t0)
83ADC206 ,   \ lw s11,108(t0)
03AE0207 ,   \ lw t3,112(t0)
83AE4207 ,   \ lw t4,116(t0)
03AF8207 ,   \ lw t5,120(t0)
83AFC207 ,   \ lw t6,124(t0)
83A24201 ,   \ lw t0,20(t0)
73002030 ,   \ mret
mhartid@ harea harr @ mscr!
kei ;

\ tafter ( t -- )  a thread back from running: gone if its process is
\ ending, ready again if its slice ran out (or it yielded).
: tafter
klk @ lock
0 lit over DC lit + !
dup tstate 7 lit = if 0 lit swap tstate! else
dup tproc 28 lit + @ if
	dup tstate dup 0= swap 6 lit = or if drop else tdead then
else
	dup tstate 2 lit = if 1 lit over tstate! then
	tstate 1 lit = if hpoke then
then then
klk @ unlock ;

: kready variable ;          \ the tables made: threads may be run

\ hstep  one turn of a hart's loop: a test job asked of it, or (once the
\ kernel is ready) a thread, or sleep until an interrupt.
: hstep
mhartid@ hjob harr @ ?dup if
	hrun fence 0 lit mhartid@ hjob harr !
else
	kready @ if klk @ lock tpick klk @ unlock else 0 lit then
	?dup if
		trun
		mhartid@ hcur harr @  0 lit mhartid@ hcur harr !  tafter
	else
		mhartid@ 0= kready @ and if cpoll then
		wfi
	then
then ;

: hloop  begin hstep 0 lit until ;                          \ for good
: hrunfor  mtime@ + begin hstep dup mtime@ - 0< until drop ;  \ ( ticks -- ) for a while

\ kspawn ( name tickets -- pid | error )  a process the kernel starts, its
\ 0, 1 and 2 the console.
\ ufd ( fd -- f | 0 )  the calling process's descriptor fd.
: ufd  dup F lit u> if drop 0 lit else area@ tproc pfd @ then ;

\ fdput ( f p -- fd | -24 )  a descriptor of p on f, the lowest free.
: fdput
FFFFFFE8 lit
10 lit 0 lit do
	dup 0< if over i swap pfd @ 0= if drop i then then
loop
dup 0< if nip nip else rot over 3 lit pick pfd ! nip then ;

\ pcons ( p -- )  its 0, 1 and 2 on a new console file.
: pcons
1 lit 3 lit fnew ?dup if
	3 lit over 4 lit + !
	3 lit 0 lit do dup 2 lit pick i swap pfd ! loop drop
then drop ;

\ A process's arguments are at 20 KiB into its memory (where its heap would
\ begin): their length, then the strings, each NUL-ended, an empty one
\ last; the first is the program's name.  lib/user.fam's start puts the
\ heap past them.

\ kargs ( name p -- )  the arguments of a process the kernel starts.
: kargs
10 lit + @ 5000 lit +
0 lit begin 2 lit pick over + c@ ?dup while 2 lit pick 4 lit + 2 lit pick + c! 1 lit + repeat
2 lit + 3 lit + FFFFFFFC lit and swap ! drop ;

: kspawn
klk @ lock over swap 0 lit pspawn
dup 0< 0= if dup 1 lit - prn dup pcons 2 lit pick swap kargs then nip
klk @ unlock ;

\ ── System calls ──
\
\ Each runs in the trap from user mode, area@ the calling thread; it sets
\ the result (a0) and the pc past the ecall (sret), or stops the thread
\ (tblock: it waits; tstop: its slice or its life is over).  Pointers it is
\ given are checked to be the process's.  The result goes in a0, where the
\ first argument came: set it only once the arguments are read.

: sret    sysret mepc@ 4 lit + mepc!  0 lit area@ E0 lit + ! ;   \ ( v -- )
\ tretry ( token kind -- )  the call waits (kind 5 on token, 6 a poll) and
\ runs again when woken: its pc stays on the ecall, its arguments in place.
: tretry  area@ D4 lit + !  area@ C0 lit + !  1 lit area@ E0 lit + !  4 lit area@ tstate!  mepc@ area@ !  1 lit area@ 98 lit + ! ;
: tblock  area@ tstate!  mepc@ 4 lit + area@ !  1 lit area@ 98 lit + ! ;   \ ( state -- )
: tstop   mepc@ area@ !  1 lit area@ 98 lit + ! ;
: uword   dup 3 lit and 0= swap 4 lit uwrange and ;          \ ( addr -- ok ) an aligned word of its

\ ustr ( addr -- ok )  a NUL-terminated name of at most 15 bytes, its own.
: ustr
1 lit 0 lit
10 lit 0 lit do
	dup 0= if
		2 lit pick i + 1 lit urange 0= if 2drop 0 lit 1 lit else
		2 lit pick i + c@ 0= if drop 1 lit then then
	then
loop
0= if drop 0 lit then
nip ;

\ 1 exit(code): the process ends.
: sexit  klk @ lock cproc 28 lit sysarg pexit klk @ unlock tstop ;

\ uargl ( src -- len | 0 )  arguments a program gave (strings NUL-ended, an
\ empty one last, at most 1 KiB, the first not empty): their length, the
\ empty one's NUL included; 0 if they are not such, or not its.
: uargl
dup 1 lit urange 0= if drop 0 lit else dup c@ 0= if drop 0 lit else
0 lit swap
400 lit 1 lit do
	over 0= if
		dup i + 1 lit urange 0= if nip FFFFFFFF lit swap else
		dup i + c@ 0= over i + 1 lit - c@ 0= and if nip i 1 lit + swap then then
	then
loop
drop dup FFFFFFFF lit = if drop 0 lit then
then then ;

: sal variable ;             \ the arguments' length, spawn checked

\ sfds? ( -- ok )  spawn's fds: 0, or its own word count n (at most 16)
\ then n descriptors of the caller's, or -1 (the child's closed).
: sfds?
30 lit sysarg ?dup 0= if 1 lit else
	dup 4 lit urange 0= if drop 0 lit else
	dup @ 10 lit u> if drop 0 lit else
	dup dup @ 1 lit + 2 lit lshift urange 0= if drop 0 lit else
		1 lit swap
		dup @ ?dup if 0 lit do
			dup i 1 lit + 2 lit lshift + @ dup FFFFFFFF lit = if drop else ufd 0= if nip 0 lit swap then then
		loop then
		drop
	then then then then ;

\ pfdset ( p -- )  the child's descriptors: spawn's fds, or the caller's
\ 0, 1 and 2.
: pfdset
30 lit sysarg ?dup 0= if
	3 lit 0 lit do i ufd ?dup if dup 4 lit + dup @ 1 lit + swap !  over i swap pfd ! then loop drop
else
	dup @ ?dup if 0 lit do
		dup i 1 lit + 2 lit lshift + @ dup FFFFFFFF lit = if drop else
			ufd dup 4 lit + dup @ 1 lit + swap !  2 lit pick i swap pfd !
		then
	loop then
	2drop
then ;

\ pargs ( p -- )  the child's arguments: spawn's, or its name alone.
: pargs
10 lit + @ 5000 lit +
2C lit sysarg if
	sal @ ?dup if 0 lit do 2C lit sysarg i + c@ over 4 lit + i + c! loop then
	sal @
else
	0 lit begin 28 lit sysarg over + c@ ?dup while 2 lit pick 4 lit + 2 lit pick + c! 1 lit + repeat
	2 lit +
then
3 lit + FFFFFFFC lit and swap ! ;

\ 2 spawn(name, args, fds): a child running that program, with this one's
\ tickets; its arguments args (0: its name alone), its descriptors as fds
\ says (0: this one's 0, 1 and 2).  -14 bad arguments, -9 a bad descriptor.
: sspawn
28 lit sysarg ustr 0= if FFFFFFF2 lit sret else
2C lit sysarg dup if uargl dup sal ! 0= else drop 0 lit then if FFFFFFF2 lit sret else
klk @ lock
sfds? 0= if klk @ unlock FFFFFFF7 lit sret else
	28 lit sysarg cproc 20 lit + @ cproc pid pspawn
	dup 0< 0= if dup 1 lit - prn dup pfdset pargs then
	klk @ unlock sret
then then then ;

\ 3 wait(pid, &status): a child's end (pid -1: any child's); its pid.
: swait
2C lit sysarg dup if uword 0= else drop 0 lit then if FFFFFFF2 lit sret else
klk @ lock
0 lit
phi @ 0 lit do
	dup 0= if
		i prn dup @ 2 lit = over 4 lit + @ cproc pid = and
		over pid 28 lit sysarg = 28 lit sysarg FFFFFFFF lit = or and
		if nip else drop then
	then
loop
?dup if
	dup 8 lit + @ 2C lit sysarg ?dup if ! else drop then
	dup pid swap 0 lit swap !
	klk @ unlock sret
else
	0 lit phi @ 0 lit do i prn dup @ 1 lit = swap 4 lit + @ cproc pid = and or loop
	if
		28 lit sysarg area@ C0 lit + !
		2C lit sysarg area@ D0 lit + !
		1 lit area@ D4 lit + !
		4 lit tblock klk @ unlock
	else
		klk @ unlock FFFFFFF6 lit sret
	then
then then ;

\ 4 thread(entry, stack, arg): a thread of this process at entry, its stacks
\ the 16 KiB below stack (loop frames, return ids, then its data stack), its
\ variables and heap this thread's; its argument in a0.
: sthread
28 lit sysarg dup 4 lit + area@ A0 lit + @ area@ A4 lit + @ inr
2C lit sysarg dup 4000 lit - swap area@ A8 lit + @ area@ AC lit + @ inr and
0= if FFFFFFF2 lit sret else
klk @ lock
thnew ?dup 0= if klk @ unlock FFFFFFF5 lit sret else
	dup 100 lit mzero
	area@ A0 lit + over A0 lit + 10 lit mcpy
	area@ tproc over B4 lit + !
	area@ B8 lit + @ over B8 lit + !
	28 lit sysarg over !
	2C lit sysarg dup 2000 lit - 2 lit pick 8 lit + !
	dup 2 lit pick 60 lit + !
	1000 lit - over 6C lit + !
	area@ 68 lit + @ over 68 lit + !
	area@ C lit + @ over C lit + !
	30 lit sysarg over 28 lit + !
	cproc C lit + dup @ 1 lit + swap !
	1 lit over tstate!
	tid klk @ unlock hpoke sret
then then ;

\ 5 thread_exit(value): this thread ends; a thread joining it gets value.
: stexit
klk @ lock
28 lit sysarg area@ CC lit + !
0 lit thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 2 lit = and
		over tproc cproc = and over C0 lit + @ area@ tid = and
		if nip else drop then
	then
loop
?dup if
	28 lit sysarg over 28 lit + !  0 lit over D4 lit + !  1 lit swap tstate!
	7 lit area@ tstate!
	hpoke
else
	6 lit area@ tstate!
then
cproc C lit + dup @ 1 lit - tuck swap !
0= if cproc pfinish then
klk @ unlock
mepc@ area@ !  1 lit area@ 98 lit + ! ;

\ 6 join(tid): a thread of this process ended: what it ended with.
: sjoin
28 lit sysarg dup 1 lit - MAXT u< 0= if drop FFFFFFFD lit sret else
1 lit - thn
klk @ lock
dup tstate 0= over tproc cproc <> or over area@ = or if drop klk @ unlock FFFFFFFD lit sret else
dup tstate 6 lit = if
	dup CC lit + @ swap dup DC lit + @ if 7 lit else 0 lit then swap tstate! klk @ unlock sret
else
	tid area@ C0 lit + !  2 lit area@ D4 lit + !  4 lit tblock klk @ unlock
then then then ;

\ 7 yield: the rest of its slice given up.
: syield  0 lit sysret mepc@ 4 lit + area@ !  1 lit area@ 98 lit + ! ;

\ 8 sleep(ns)
: ssleep  28 lit sysarg 64 lit / mtime@ + area@ BC lit + ! 0 lit sysret 3 lit tblock ;

\ 9 lock(addr): a mutex, the word at addr (0 free); the atomic part done
\ here.  Waits while it is held.
: slock
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg @ 0= if
	1 lit 28 lit sysarg ! klk @ unlock 0 lit sret
else
	28 lit sysarg area@ C0 lit + ! 3 lit area@ D4 lit + ! 0 lit sysret 4 lit tblock klk @ unlock
then then ;

\ twaiter ( addr kind -- t | 0 )  a thread of the calling process waiting
\ on addr in that kind of wait.
: twaiter
0 lit thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 4 lit pick = and
		over tproc cproc = and over C0 lit + @ 5 lit pick = and
		if nip else drop then
	then
loop
nip nip ;

\ 10 unlock(addr): handed to a thread waiting for it, if one is.
: sunlock
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg 3 lit twaiter ?dup if
	0 lit over D4 lit + !  1 lit swap tstate!  klk @ unlock hpoke
else
	0 lit 28 lit sysarg !  klk @ unlock
then
0 lit sret then ;

\ 11 await(addr, expected, ns): waits while the word at addr is expected
\ (0, or -11 if it already is not; ns 0: no limit, else -110 when it runs
\ out).
: sawait
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg @ 2C lit sysarg <> if klk @ unlock FFFFFFF5 lit sret else
	28 lit sysarg area@ C0 lit + !  4 lit area@ D4 lit + !
	30 lit sysarg ?dup if 64 lit / mtime@ + area@ BC lit + !  1 lit area@ D8 lit + ! then
	0 lit sysret
	4 lit tblock klk @ unlock
then then ;

\ 12 wake(addr, n): up to n threads awaiting addr woken; how many.
: swake
klk @ lock
0 lit
begin dup 2C lit sysarg u< if 28 lit sysarg 4 lit twaiter else 0 lit then ?dup while
	0 lit over D4 lit + !  0 lit over D8 lit + !  1 lit swap tstate!  1 lit +
repeat
klk @ unlock dup if hpoke then sret ;

\ prefresh  the other harts running a thread of this process told to
\ reload their PMP (a block was mapped or unmapped), by a software
\ interrupt, each marked stale until it has; this hart does it itself
\ (the caller).
: prefresh
hmax @ 0 lit do
	i mhartid@ <> if
		i hcur harr @ ?dup if tproc cproc = if 1 lit i hstale harr ! fence i ipi then then
	then
loop ;

\ pwait  until no other hart is marked stale: none can reach a block just
\ unmapped, so its pages may go back.  Without klk (a hart marked may be
\ waiting for it, interrupts off); this hart's own mark, from another's
\ unmap, it clears itself, so two waiting on each other both go on.
: pwait
begin
	fence
	mhartid@ hstale harr @ if hfresh then
	1 lit hmax @ 0 lit do i mhartid@ <> if i hstale harr @ if drop 0 lit then then loop
until ;

\ mslot ( addr -- slot | 0 )  the process's map slot whose first byte is
\ addr, or 0.  An empty slot's is 0, so addr 0 finds the first empty one.
: mslot
0 lit swap
4 lit 0 lit do
	over 0= if
		i 3 lit lshift cproc 30 lit + +
		dup @ 2 lit pick = if rot drop swap else drop then
	then
loop
drop ;

: mpages variable ;  : msl variable ;

\ 13 map(bytes): a block of that many bytes (rounded up to pages), zeroed,
\ in one of the process's 4 slots; its first byte, or 0 (bytes 0, no free
\ slot, or no memory): 0 is never a mapped address, and a RAM address has
\ its high bit set, so the caller cannot tell map's errors by sign.
: smap
28 lit sysarg dup 0= if drop 0 lit sret else
FFF lit + C lit rshift mpages !
klk @ lock
0 lit mslot dup msl ! 0= if klk @ unlock 0 lit sret else
	mpages @ pgalloc dup 0= if drop klk @ unlock 0 lit sret else
		dup mpages @ C lit lshift mzero
		dup msl @ !
		dup mpages @ C lit lshift + msl @ 4 lit + !
		upmp prefresh
		klk @ unlock sret
	then
then then ;

\ 14 unmap(addr): the block at addr given back; 0, or -22.  Its pages go
\ back only once every hart running a thread of the process has reloaded
\ its PMP, so none can touch them once they are another's.
: sunmap
28 lit sysarg
klk @ lock
mslot dup 0= if drop klk @ unlock FFFFFFEA lit sret else
	dup @ swap dup 4 lit + @ 2 lit pick - C lit rshift swap   \ ( first pages slot )
	0 lit over !  0 lit swap 4 lit + !
	upmp prefresh
	klk @ unlock
	pwait
	klk @ lock pgfree klk @ unlock
	0 lit sret
then ;

\ ── Descriptors: open, read, write, close, pipe, poll (docs/OS.md, 5) ──
\
\ Under klk throughout.  A handler gives a result, or BLK when it waited
\ (tretry), for the call to run again when woken.

:M BLK 7FFFFFFF lit ;

: kpb variable ;             \ a path, copied in (64 bytes)

\ upath ( addr -- ok )  a NUL-ended path of the process's, at most 63
\ bytes, copied to kpb.
: upath
1 lit 0 lit
40 lit 0 lit do
	dup 0= if
		2 lit pick i + 1 lit urange 0= if 2drop 0 lit 1 lit else
		2 lit pick i + c@ dup i kpb @ + c! 0= if drop 1 lit then then
	then
loop
0= if drop 0 lit then
nip ;

\ kpfx ( s prefix -- rest | 0 )  s begins with prefix: what follows it.
: kpfx
begin dup c@ if over c@ over c@ = else 0 lit then while 1 lit + swap 1 lit + swap repeat
dup c@ if 2drop 0 lit else drop then ;

\ katoi ( s -- n rest )  a decimal number at s (0 if none).
: katoi
0 lit swap
begin dup c@ 30 lit - A lit u< while
	dup c@ 30 lit - rot dup 3 lit lshift swap 1 lit lshift + + swap 1 lit +
repeat ;

\ A /proc key's text, made when it is opened (a page, freed at its close).
: tb variable ;              \ where the text goes on
: tc  tb @ c!  tb @ 1 lit + tb ! ;                         \ ( c -- )
: ts  begin dup c@ ?dup while tc 1 lit + repeat drop ;      \ ( s -- )
: tn  dup A lit u< if 30 lit + tc else dup A lit / tn A lit % 30 lit + tc then ;   \ ( u -- )

\ ptext ( -- f | 0 )  an open file for a key's text, tb at its page.
: ptext
4 lit 1 lit fnew dup if
	1 lit pgalloc ?dup if over 8 lit + !  dup 8 lit + @ tb ! else 0 lit swap ! 0 lit then
then ;
: tend  tb @ over 8 lit + @ - over 10 lit + ! ;            \ ( f -- f )  its length

\ pbusy ( p -- ok )  a thread of p ready or running.
: pbusy
0 lit thi @ 0 lit do
	i thn dup tproc 3 lit pick = swap tstate dup 1 lit = swap 2 lit = or and or
loop nip ;

\ pkib ( p -- KiB )  its memory and mapped blocks.
: pkib
dup 14 lit + @ swap 30 lit +
4 lit 0 lit do dup @ ?dup if over 4 lit + @ swap - C lit rshift rot + swap then 8 lit + loop
drop 2 lit lshift ;

\ pcmd ( p -- )  its arguments, spaced (an ended one's: its program's name).
: pcmd
dup @ 1 lit = if
	10 lit + @ 5000 lit +  dup @ dup 400 lit u> if drop 400 lit then
	0 lit swap ?dup if 0 lit do
		over 4 lit + i + c@ ?dup if swap if 20 lit tc then tc 0 lit else drop 1 lit then
	loop then
	2drop
else 24 lit + @ ts then ;

\ pstatus ( p -- )  one line: pid, parent, state (R running or ready, S
\ waiting, Z ended), threads, KiB, ticks run, arguments.
: pstatus
dup pid tn 20 lit tc
dup 4 lit + @ tn 20 lit tc
dup @ 2 lit = if 5A lit else dup pbusy if 52 lit else 53 lit then then tc 20 lit tc
dup C lit + @ tn 20 lit tc
dup @ 1 lit = if dup pkib else 0 lit then tn 20 lit tc
dup 50 lit + @ tn 20 lit tc
pcmd ;

: pp variable ;  : pk variable ;  : pq variable ;  : pm variable ;

\ ppath ( s -- )  "<pid>/<key>" or "self/<key>": pp the process (0: none
\ such), pk the key (1 status, 2 cmd, 3 tickets, 4 kill; 0 none).
: ppath
0 lit pp !  0 lit pk !
dup "self/" kpfx ?dup if nip area@ tproc pp ! else
	katoi swap
	dup 1 lit - MAXP u< if 1 lit - prn dup @ if pp ! else drop then else drop then
	dup c@ 2F lit = if 1 lit + else 0 lit pp ! then
then
dup "status" streq if 1 lit pk ! then
dup "cmd" streq if 2 lit pk ! then
dup "tickets" streq if 3 lit pk ! then
"kill" streq if 4 lit pk ! then ;

\ pgen ( q -- )  key q's text, a newline last.
: pgen
dup 1 lit = if area@ tproc pid tn then
dup 2 lit = if nharts @ tn then
dup 3 lit = if pgfree# 2 lit lshift tn then
dup 4 lit = if 0 lit htick harr @ dup 64 lit / tn 2E lit tc 64 lit % dup A lit u< if 30 lit tc then tn then
dup 5 lit = if pp @ pstatus then
dup 6 lit = if pp @ pcmd then
7 lit = if pp @ 20 lit + @ tn then
A lit tc ;

\ popen ( s mode -- f | 0 | error )  a key under /proc: self, harts, mem
\ (KiB free), uptime (seconds), and <pid>/ status, cmd, tickets (also
\ written: the process's tickets), kill (written only: it ends, -9).
: popen
pm !  0 lit pq !
dup "self" streq if 1 lit pq ! then
dup "harts" streq if 2 lit pq ! then
dup "mem" streq if 3 lit pq ! then
dup "uptime" streq if 4 lit pq ! then
pq @ if drop else
	ppath
	pp @ if pk @ ?dup if 4 lit + pq ! then then
then
pq @ 0= if FFFFFFFE lit else
pq @ 7 lit u< 0= pm @ 1 lit <> and if
	5 lit 2 lit fnew dup if pp @ pid over 14 lit + !  pq @ 6 lit - over 18 lit + ! then
else
pq @ 8 lit = pm @ 1 lit <> or if FFFFFFF3 lit else
	ptext dup if pq @ pgen tend then
then then then ;

\ 15 open(path, flags): /dev/console, /dev/null, or a /proc key; flags 0
\ read, 1 write, 2 both.  Its descriptor; -2 no such, -13 not that way,
\ -22 bad flags, -24 no descriptor free, -12 no room.
: sopen
klk @ lock
28 lit sysarg upath 0= if FFFFFFF2 lit else
2C lit sysarg dup 2 lit u> if drop FFFFFFEA lit else 1 lit +
	kpb @ "/dev/console" streq if 1 lit swap fnew else
	kpb @ "/dev/null" streq if 2 lit swap fnew else
	kpb @ "/proc/" kpfx ?dup if swap popen else drop FFFFFFFE lit then
	then then
	dup 0= if drop FFFFFFF4 lit else
	dup kerr? 0= if
		dup area@ tproc fdput dup 0< if swap fclose else nip then
	then then
then then
klk @ unlock sret ;

\ cread ( -- r )  from the console: what is ready, to the end of a line.
: cread
ceof @ if 0 lit ceof ! 0 lit else
ctail @ crdy @ = if cin 5 lit tretry BLK else
	0 lit
	begin
		dup 30 lit sysarg u< ctail @ crdy @ u< and
		over 0= if 1 lit else over 2C lit sysarg + 1 lit - c@ A lit <> then and
	while
		ctail @ cb c@  over 2C lit sysarg + c!
		ctail @ 1 lit + ctail !  1 lit +
	repeat
then then ;

\ pread ( pipe -- r )  what it holds, up to n; 0 when empty with no writer.
: pread
dup 8 lit + @ over C lit + @ = if
	dup 4 lit + @ if 5 lit tretry BLK else drop 0 lit then
else
	0 lit
	begin dup 30 lit sysarg u< 2 lit pick dup 8 lit + @ swap C lit + @ <> and while
		over dup C lit + @ 7FF lit and 800 lit + + c@  over 2C lit sysarg + c!
		over C lit + dup @ 1 lit + swap !
		1 lit +
	repeat
	swap fwake
then ;

\ pwrite ( pipe -- r )  all n bytes, waiting for room as it must (E8: how
\ many were written before the wait); -32 with no reader.
: pwrite
dup @ 0= if
	drop area@ E0 lit + @ if area@ E8 lit + @ else 0 lit then ?dup 0= if FFFFFFE0 lit then
else
	area@ E0 lit + @ if area@ E8 lit + @ else 0 lit then
	begin dup 30 lit sysarg u< 2 lit pick dup 8 lit + @ swap C lit + @ - 800 lit u< and while
		dup 2C lit sysarg + c@  2 lit pick dup 8 lit + @ 7FF lit and 800 lit + + c!
		over 8 lit + dup @ 1 lit + swap !
		1 lit +
	repeat
	over fwake
	dup 30 lit sysarg = if nip else area@ E8 lit + !  5 lit tretry BLK then
then ;

\ ptread ( f -- r )  a key's text, from where reading is.
: ptread
0 lit
begin dup 30 lit sysarg u< 2 lit pick dup C lit + @ swap 10 lit + @ u< and while
	over dup 8 lit + @ swap C lit + @ + c@  over 2C lit sysarg + c!
	over C lit + dup @ 1 lit + swap !  1 lit +
repeat
nip ;

\ pkwrite ( f -- r )  a key written: the number in what is written.
: pkwrite
0 lit 30 lit sysarg ?dup if 0 lit do
	2C lit sysarg i + c@ dup 30 lit - A lit u< if 30 lit - swap dup 3 lit lshift swap 1 lit lshift + + else drop then
loop then
over 14 lit + @ 1 lit - prn dup @ 1 lit = if
	2 lit pick 18 lit + @ 1 lit = if
		over 0= if 2drop drop FFFFFFEA lit else
			2dup 20 lit + !
			thi @ 0 lit do i thn dup tproc 2 lit pick = if 2 lit pick swap B8 lit + ! else drop then loop
			2drop drop 30 lit sysarg
		then
	else
		FFFFFFF7 lit pexit 2drop 30 lit sysarg
	then
else 2drop drop FFFFFFFD lit then ;

\ 16 read(fd, buf, n): what there is, at least a byte (waiting for it), or
\ 0 at the end.  -9 not a descriptor to read, -14 not its buffer.
: sread
klk @ lock
28 lit sysarg ufd dup 0= if drop FFFFFFF7 lit else
dup 1C lit + @ 1 lit and 0= if drop FFFFFFF7 lit else
2C lit sysarg 30 lit sysarg uwrange 0= if drop FFFFFFF2 lit else
dup @
dup 1 lit = if 2drop cread else
dup 2 lit = if 2drop 0 lit else
dup 3 lit = if drop 8 lit + @ pread else
4 lit = if ptread else drop 0 lit
then then then then then then then
klk @ unlock dup BLK = if drop else sret then ;

\ 17 write(fd, buf, n): all of it (waiting for room); -9, -14, -32 a pipe
\ no one reads.
: swrite
klk @ lock
28 lit sysarg ufd dup 0= if drop FFFFFFF7 lit else
dup 1C lit + @ 2 lit and 0= if drop FFFFFFF7 lit else
2C lit sysarg 30 lit sysarg urange 0= if drop FFFFFFF2 lit else
dup @
dup 1 lit = if
	2drop 30 lit sysarg ?dup if 2C lit sysarg swap 0 lit do dup i + c@ putc loop drop then 30 lit sysarg
else
dup 2 lit = if 2drop 30 lit sysarg else
dup 3 lit = if drop 8 lit + @ pwrite else
drop pkwrite
then then then then then then
klk @ unlock dup BLK = if drop else sret then ;

\ 19 close(fd): 0, or -9.
: sclose
klk @ lock
28 lit sysarg ufd ?dup if fclose  0 lit 28 lit sysarg area@ tproc pfd !  0 lit else FFFFFFF7 lit then
klk @ unlock sret ;

: sp1 variable ;  : sf1 variable ;  : sf2 variable ;

\ 20 pipe(fds): fds[0] its read end, fds[1] its write end; 0, or -14,
\ -23 no open file free, -12 no memory, -24 no descriptor free.
: spipe
klk @ lock
28 lit sysarg 8 lit uwrange 0= if FFFFFFF2 lit else
3 lit 1 lit fnew sf1 !  3 lit 2 lit fnew sf2 !
sf1 @ 0= sf2 @ 0= or if sf1 @ ?dup if 0 lit swap ! then sf2 @ ?dup if 0 lit swap ! then FFFFFFE9 lit else
1 lit pgalloc dup sp1 ! 0= if 0 lit sf1 @ !  0 lit sf2 @ !  FFFFFFF4 lit else
	sp1 @ 10 lit mzero  1 lit sp1 @ !  1 lit sp1 @ 4 lit + !
	sp1 @ sf1 @ 8 lit + !  sp1 @ sf2 @ 8 lit + !
	sf1 @ area@ tproc fdput dup 0< if drop sf1 @ fclose sf2 @ fclose FFFFFFE8 lit else
	sf2 @ area@ tproc fdput dup 0< if
		drop 0 lit swap area@ tproc pfd !  sf1 @ fclose sf2 @ fclose FFFFFFE8 lit
	else
		28 lit sysarg 4 lit + !  28 lit sysarg !  0 lit
	then then
then then then
klk @ unlock sret ;

\ fready ( f -- events )  1 readable (or at its end), 4 writable, 16 the
\ other end gone; only those its mode allows (and 16).
: fready
dup @ 1 lit = if ceof @ ctail @ crdy @ <> or if 5 lit else 4 lit then else
dup @ 2 lit = if 5 lit else
dup @ 3 lit = if
	dup 8 lit + @ over 1C lit + @ 1 lit = if
		dup 4 lit + @ 0= if drop 11 lit else dup 8 lit + @ swap C lit + @ <> if 1 lit else 0 lit then then
	else
		dup @ 0= if drop 14 lit else dup 8 lit + @ swap C lit + @ - 800 lit u< if 4 lit else 0 lit then then
	then
else
dup @ 4 lit = if 1 lit else 4 lit then then then then
swap 1C lit + @ dup 1 lit and if 1 lit else 0 lit then swap 2 lit and if 4 lit or then 10 lit or and ;

\ 22 poll(fds, n, ns): fds n entries of 8 bytes (a descriptor; the events
\ wanted, 16 bits; those found, 16 bits: 1 in, 4 out, 16 hung up, 32 not a
\ descriptor; a negative descriptor is passed over); waits until one has
\ any (ns 0: no limit): how many, or -110 when the time ran out.
: spoll
klk @ lock
2C lit sysarg dup 40 lit u> if drop FFFFFFEA lit else
3 lit lshift 28 lit sysarg swap uwrange 0= if FFFFFFF2 lit else
0 lit
2C lit sysarg ?dup if 0 lit do
	28 lit sysarg i 3 lit lshift +
	dup @ 0< if 0 lit else
		dup @ ufd ?dup if fready over 4 lit + @ FFFF lit and 30 lit or and else 20 lit then
	then
	dup rot 6 lit + h!  if 1 lit + then
loop then
dup 0= if
	30 lit sysarg if
		area@ E0 lit + @ 0= if 30 lit sysarg 64 lit / mtime@ + area@ E4 lit + ! then
		area@ E4 lit + @ area@ BC lit + !  1 lit area@ D8 lit + !
	then
	drop 0 lit 6 lit tretry BLK
then
then then
klk @ unlock dup BLK = if drop else sret then ;

\ ksys  a system call (ecall from user mode): the number in a7.
: ksys
44 lit sysarg
dup 1 lit = if drop sexit else
dup 2 lit = if drop sspawn else
dup 3 lit = if drop swait else
dup 4 lit = if drop sthread else
dup 5 lit = if drop stexit else
dup 6 lit = if drop sjoin else
dup 7 lit = if drop syield else
dup 8 lit = if drop ssleep else
dup 9 lit = if drop slock else
dup A lit = if drop sunlock else
dup B lit = if drop sawait else
dup C lit = if drop swake else
dup D lit = if drop smap else
dup E lit = if drop sunmap else
dup F lit = if drop sopen else
dup 10 lit = if drop sread else
dup 11 lit = if drop swrite else
dup 13 lit = if drop sclose else
dup 14 lit = if drop spipe else
16 lit = if spoll else FFFFFFDA lit sret
then then then then then then then then then then then then then then then then then then then then ;

\ ukill  an exception in user mode: the process ends (-1), the system goes on.
: ukill
"kernel: process killed: trap " puts mcause@ u.x
" at " puts mepc@ u.x " (" puts mtval@ u.x ")" puts 0A lit putc
klk @ lock cproc FFFFFFFF lit pexit klk @ unlock tstop ;

\ kipi  a software interrupt: cleared, and counted (what it asks is in the
\ hart's job word, or the thread's process ending).
: kipi  msipclr mhartid@ hipi harr dup @ 1 lit + swap ! ;

\ hipiok  a software interrupt's part: the hart's stale mark cleared (its
\ PMP reloaded if a thread runs, which is stopped if its process is
\ ending; from the kernel, no thread runs and the next trun reloads it).
: hipiok
mpp@ 0= if cproc 28 lit + @ if 0 lit mhartid@ hstale harr ! tstop else hfresh then
else 0 lit mhartid@ hstale harr ! then ;

\ ktrap  what the entry calls, with every register saved.  Interrupts are
\ taken from either mode: a timer's ends a thread's slice (counted to it),
\ a software interrupt stops a thread whose process is ending.  An
\ exception from user mode is the thread's (a system call, or its end),
\ from the kernel a bug.
: ktrap
mcause@
dup 80000007 lit = if drop ktick mpp@ 0= if
	area@ C4 lit + dup @ 1 lit + swap !  cproc 50 lit + dup @ 1 lit + swap !
	mhartid@ 0= if cpoll then
	tstop
then else
dup 80000003 lit = if drop kipi hipiok else
mpp@ if drop kfault else
8 lit = if ksys else ukill then
then then then ;

\ [skip ... skip]  compile the code between where it is but jump over it.
:I [skip  here ,j0 ;
:I skip]  jpat! ;

: trapvec variable ;         \ the entry, for the harts started later

\ trapinit  the trap entry: mscratch holds the area (a hart's, 256 bytes,
\ or the running thread's control block) where the entry saves x1-x31 (x5
\ by way of mscratch itself) before calling ktrap, and from where it
\ restores them for mret.  A trap from user mode runs ktrap on the
\ kernel's stacks, as trun saved them; when ktrap stops the thread (152
\ set), the entry goes on where trun left off rather than back to it.  mtvec points at the
\ entry, 16 bytes past the auipc (auipc, addi, csrw, and [skip's jump).
: trapinit
kvars
100 lit alloc
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73900234 ,   \ csrrw zero,mscratch,t0
97020000 ,   \ auipc t0,0x0
93820201 ,   \ addi t0,t0,16
73905230 ,   \ csrrw zero,mtvec,t0
[skip
F3920234 ,   \ csrrw t0,mscratch,t0      ( t0 = the area, mscratch = t0 )
23A21200 ,   \ sw ra,4(t0)
23A42200 ,   \ sw sp,8(t0)
23A63200 ,   \ sw gp,12(t0)
23A84200 ,   \ sw tp,16(t0)
23AC6200 ,   \ sw t1,24(t0)
23AE7200 ,   \ sw t2,28(t0)
23A08202 ,   \ sw s0,32(t0)
23A29202 ,   \ sw s1,36(t0)
23A4A202 ,   \ sw a0,40(t0)
23A6B202 ,   \ sw a1,44(t0)
23A8C202 ,   \ sw a2,48(t0)
23AAD202 ,   \ sw a3,52(t0)
23ACE202 ,   \ sw a4,56(t0)
23AEF202 ,   \ sw a5,60(t0)
23A00205 ,   \ sw a6,64(t0)
23A21205 ,   \ sw a7,68(t0)
23A42205 ,   \ sw s2,72(t0)
23A63205 ,   \ sw s3,76(t0)
23A84205 ,   \ sw s4,80(t0)
23AA5205 ,   \ sw s5,84(t0)
23AC6205 ,   \ sw s6,88(t0)
23AE7205 ,   \ sw s7,92(t0)
23A08207 ,   \ sw s8,96(t0)
23A29207 ,   \ sw s9,100(t0)
23A4A207 ,   \ sw s10,104(t0)
23A6B207 ,   \ sw s11,108(t0)
23A8C207 ,   \ sw t3,112(t0)
23AAD207 ,   \ sw t4,116(t0)
23ACE207 ,   \ sw t5,120(t0)
23AEF207 ,   \ sw t6,124(t0)
73230034 ,   \ csrrs t1,mscratch,zero    ( the interrupted t0 )
23AA6200 ,   \ sw t1,20(t0)
73900234 ,   \ csrrw zero,mscratch,t0    ( mscratch = the area again )
73230030 ,   \ csrrs t1,mstatus,zero     ( from user mode (MPP 0): )
1353B300 ,   \ srli t1,t1,0xb
13733300 ,   \ andi t1,t1,3
631C0300 ,   \ bne t1,zero,kernel
03A10208 ,   \ lw sp,128(t0)             ( the kernel's stacks, as urun left them )
03AC4208 ,   \ lw s8,132(t0)
03AD8208 ,   \ lw s10,136(t0)
83ADC208 ,   \ lw s11,140(t0)
83A10209 ,   \ lw gp,144(t0)
ktrap                                     \ kernel:
F3220034 ,   \ csrrs t0,mscratch,zero
03A38209 ,   \ lw t1,152(t0)             ( the thread stops: back to trun )
63040302 ,   \ beq t1,zero,back
23AC0208 ,   \ sw zero,152(t0)
03A10208 ,   \ lw sp,128(t0)
03AC4208 ,   \ lw s8,132(t0)
03AD8208 ,   \ lw s10,136(t0)
83ADC208 ,   \ lw s11,140(t0)
83A10209 ,   \ lw gp,144(t0)
13000000 ,   \ nop                       ( interrupts stay off: trun's after it )
03A34209 ,   \ lw t1,148(t0)
67000300 ,   \ jalr zero,0(t1)
F3220034 ,   \ csrrs t0,mscratch,zero    back: ( to where the trap came from )
83A04200 ,   \ lw ra,4(t0)
03A18200 ,   \ lw sp,8(t0)
83A1C200 ,   \ lw gp,12(t0)
03A20201 ,   \ lw tp,16(t0)
03A38201 ,   \ lw t1,24(t0)
83A3C201 ,   \ lw t2,28(t0)
03A40202 ,   \ lw s0,32(t0)
83A44202 ,   \ lw s1,36(t0)
03A58202 ,   \ lw a0,40(t0)
83A5C202 ,   \ lw a1,44(t0)
03A60203 ,   \ lw a2,48(t0)
83A64203 ,   \ lw a3,52(t0)
03A78203 ,   \ lw a4,56(t0)
83A7C203 ,   \ lw a5,60(t0)
03A80204 ,   \ lw a6,64(t0)
83A84204 ,   \ lw a7,68(t0)
03A98204 ,   \ lw s2,72(t0)
83A9C204 ,   \ lw s3,76(t0)
03AA0205 ,   \ lw s4,80(t0)
83AA4205 ,   \ lw s5,84(t0)
03AB8205 ,   \ lw s6,88(t0)
83ABC205 ,   \ lw s7,92(t0)
03AC0206 ,   \ lw s8,96(t0)
83AC4206 ,   \ lw s9,100(t0)
03AD8206 ,   \ lw s10,104(t0)
83ADC206 ,   \ lw s11,108(t0)
03AE0207 ,   \ lw t3,112(t0)
83AE4207 ,   \ lw t4,116(t0)
03AF8207 ,   \ lw t5,120(t0)
83AFC207 ,   \ lw t6,124(t0)
83A24201 ,   \ lw t0,20(t0)
73002030 ,   \ mret
skip]
mtvec@ trapvec ! ;

\ ── Every hart: starting them ──

\ hmain  where a started hart lives: its timer, then its loop.
: hmain
swon tmrinit
area@ mhartid@ harea harr !
fence 1 lit mhartid@ hup harr !
hloop ;

\ hentry  compiles the code a started hart begins at (its address into
\ hentrya): its stacks, its trap area and entry from the record in a0, then
\ hmain.
: hentry
97020000 ,   \ auipc t0,0x0
93824201 ,   \ addi t0,t0,20              ( the code below )
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
[skip
03214500 ,   \ lw sp,4(a0)
032C8500 ,   \ lw s8,8(a0)
032DC500 ,   \ lw s10,12(a0)
832D0501 ,   \ lw s11,16(a0)
83214501 ,   \ lw gp,20(a0)
83228501 ,   \ lw t0,24(a0)
73900234 ,   \ csrrw zero,mscratch,t0
8322C501 ,   \ lw t0,28(a0)
73905230 ,   \ csrrw zero,mtvec,t0
hmain
skip]
hentrya ! ;

\ hpresent ( -- n )  harts marked present in the mailboxes.
: hpresent  0 lit MAXH 1 lit do i mbox @ 1 lit = if 1 lit + then loop ;

\ hupn ( -- n )  harts started and running.
: hupn  0 lit hmax @ 1 lit u> if hmax @ 1 lit do i hup harr @ if 1 lit + then loop then ;

\ hlate  the harts started that have not said so, and their mailboxes.
: hlate
"kernel: not started:" puts
hmax @ 1 lit do
	i hup harr @ 0= if i mbox @ 1 lit u> if
		20 lit putc i u. "=" puts i mbox @ u.x
	then then
loop
0A lit putc ;

\ hstart  every hart waiting started.  The harts start at once, but
\ reaching their mailboxes may take a moment (under QEMU, with more harts
\ than the host has cores, a hart's thread waits its turn): hart 0 waits
\ until 100 ms pass with no new one, and a hart it starts has 10 s to say so.  Each started hart gets 36 KiB of the heap: its record
\ and trap area, 16 KiB of data stack, 4 KiB each of loop frames, return ids
\ and heap.  Then the locks' size, from the highest hart id.
: hstart
hstarted @ 0= if
	1 lit hstarted !
	hentry
	1 lit nharts !  1 lit hmax !
	1 lit mhartid@ hup harr !
	hpresent mtime@
	begin mtime@ over - F4240 lit u< while
		hpresent 2 lit pick <> if 2drop hpresent mtime@ then
	repeat
	2drop
	MAXH 1 lit do
		i mbox @ 1 lit = if
			9000 lit alloc FFF lit + FFFFF000 lit and   \ ( blk )
			hentrya @ over !
			dup 5000 lit + over 4 lit + !              \ sp
			dup 6000 lit + over 8 lit + !              \ s8
			s10@ over C lit + !                        \ s10, shared
			dup 7000 lit + over 10 lit + !             \ s11
			dup 7000 lit + over 14 lit + !             \ gp
			dup 40 lit + over 18 lit + !               \ the trap area
			trapvec @ over 1C lit + !                  \ the trap entry
			fence
			i mbox !
			fence
			i ipi
			nharts @ 1 lit + nharts !
			i 1 lit + hmax !
		then
	loop
	mtime@
	begin hupn nharts @ 1 lit - u< while
		mtime@ over - 5F5E100 lit u> if hlate "a hart did not start" panic then
	repeat
	drop
	1 lit 0 lit
	begin over hmax @ u< while swap 1 lit lshift swap 1 lit + repeat
	lkl ! lkn !
	lknew klk !
then ;

\ hjobs ( job -- )  asked of every started hart.
: hjobs
hmax @ 1 lit u> if
	hmax @ 1 lit do
		i hup harr @ if dup i hjob harr ! fence i ipi then
	loop
then
drop ;

\ hjwait  until every started hart has done its job.
: hjwait
begin
	0 lit
	hmax @ 1 lit u> if hmax @ 1 lit do i hjob harr @ or loop then
while repeat
fence ;

\ kboot  the kernel made ready, on hart 0 at the start: its traps, every
\ hart, the pages (from past its heap, 64 KiB of which is kept for what it
\ takes before them, up to its stacks), the tables, its timer; then threads
\ may run (kready).  What the image (src/boot.fam) and the tests of the
\ whole kernel (scripts/oscheck.sh) begin with.
: kboot
trapinit
area@ mhartid@ harea harr !
hstart
gp@ 10000 lit + FFF lit + FFFFF000 lit and
87F00000 lit pginit
ptinit cinit 40 lit alloc kpb !
mtime@ 1 lit or rndseed !     \ the lottery's draws: not from 0, which xorshift never leaves
fence 1 lit kready !
"kernel: " puts nharts @ u. nharts @ 1 lit = if " hart, " else " harts, " then puts
pgfree# dup u. " pages free (" puts 8 lit rshift u. " MiB)" puts
0A lit putc
swon tmrinit                  \ hart 0 too takes software interrupts (stale PMP, a process ending)
;

Test {
	pg_one {
		\ a range of 64 pages: three taken in a row, given back in another
		\ order, and the table whole again
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit           \ ( base )
		pgfree# 40 lit asrt_eq
		1 lit pgalloc over asrt_eq
		2 lit pgalloc over 1000 lit + asrt_eq
		3 lit pgalloc over 3000 lit + asrt_eq
		pgfree# 3A lit asrt_eq
		pgn @ 1 lit asrt_eq
		dup 1000 lit + 2 lit pgfree          \ a hole in the middle
		pgn @ 2 lit asrt_eq
		dup 1 lit pgfree                     \ joins it
		pgn @ 2 lit asrt_eq
		dup 3000 lit + 3 lit pgfree          \ joins both sides
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_full {
		\ running out, and coming back
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit
		41 lit pgalloc 0 lit asrt_eq
		40 lit pgalloc over asrt_eq
		pgn @ 0 lit asrt_eq
		pgfree# 0 lit asrt_eq
		1 lit pgalloc 0 lit asrt_eq
		dup 40 lit pgfree
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_holes {
		\ every page taken one by one; every other given back (32 ranges),
		\ then the rest (one again)
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit
		40 lit 0 lit do 1 lit pgalloc drop loop
		pgn @ 0 lit asrt_eq
		20 lit 0 lit do dup i D lit lshift + 1 lit pgfree loop
		pgn @ 20 lit asrt_eq
		20 lit 0 lit do dup i D lit lshift + 1000 lit + 1 lit pgfree loop
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_rand {
		\ 1000 random takes and gives back over 16 slots, each block's
		\ pages tagged with its address and checked when it is given
		\ back (so no two blocks ever overlapped); at the end, whole
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup 40000 lit + pginit
		80 lit alloc                         \ ( S: 16 slots, address and pages )
		20 lit 0 lit do 0 lit over i 2 lit lshift + ! loop
		1234567 lit rndseed !
		3E8 lit 0 lit do
			rnd F lit and 3 lit lshift over +        \ ( S slot )
			dup @ if
				dup @ over 4 lit + @ pgchk assert
				dup @ over 4 lit + @ pgfree
				0 lit over !
			else
				rnd 7 lit and 1 lit +                \ ( S slot pages )
				dup pgalloc                          \ ( S slot pages addr )
				dup if
					2dup swap pgtag
					2 lit pick !
					over 4 lit + !
				else
					2drop
				then
			then
			drop
		loop
		10 lit 0 lit do
			dup i 3 lit lshift + dup @ if dup @ swap 4 lit + @ pgfree else drop then
		loop
		drop
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
	}
	tm_busy {
		\ a long computation interrupted by the timer again and again comes
		\ out as it does uninterrupted: the entry saves and restores
		\ everything it should
		1234567 lit rndseed !
		100000 lit 0 lit do rnd drop loop
		rndseed @                            \ ( undisturbed )
		trapinit tmrinit
		1234567 lit rndseed !
		100000 lit 0 lit do rnd drop loop
		tmroff
		rndseed @ asrt_eq
		ticks@ 2 lit u< 0= assert            \ and it was interrupted
	}
	timer {
		\ 20 ticks, each a period at least after the last: none early, and
		\ they keep coming
		trapinit tmrinit
		mtime@
		begin ticks@ 14 lit u< while wfi repeat
		tmroff
		mtime@ swap -                        \ elapsed
		period @ 13 lit * u< 0= assert       \ at least 19 periods
	}
	harts {
		\ every hart there is started; 1000 counts each under the lock come
		\ out whole; numbers sent to each hart through its queue arrive
		\ every one, in order
		trapinit hstart
		hupn nharts @ 1 lit - asrt_eq
		0 lit lkc !  3E8 lit lkk !
		1 lit hjobs lkstrs hjwait
		lkc @ nharts @ 3E8 lit * asrt_eq
		hmax @ 1 lit u> if
			hmax @ 1 lit do
				i hup harr @ if qnew i hq harr !  0 lit i hres harr ! then
			loop
		then
		2 lit hjobs
		lkk @ 1 lit + 1 lit do
			hmax @ 1 lit u> if
				hmax @ 1 lit do
					i hup harr @ if
						begin j i hq harr @ qpush until
					then
				loop
			then
		loop
		hjwait
		0 lit hmax @ 1 lit u> if hmax @ 1 lit do i hres harr @ or loop then
		0 lit asrt_eq
		"harts: " puts nharts @ u. 0A lit putc
	}
}
