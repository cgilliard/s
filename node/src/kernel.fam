\ kernel.fam — the OS's kernel (docs/OS.md): steps 1 and 3.  The traps
\ (every interrupt and exception comes through one entry, which saves the
\ registers and calls ktrap), each hart's timer (100 ticks a second), the
\ page allocator (RAM in 4 KiB pages, a sorted list of free ranges, first
\ fit, neighbours merged when freed), and every hart the machine has:
\ started from where they wait (lib/stdlib.fam, tabernacle), locks without
\ atomic instructions, queues with one writer and one reader, and the
\ software interrupt that wakes a hart.
\
\ Definitions only: src/boot.fam is the kernel's main, and the Test blocks
\ below run with `tools/fam --test [--smp=N] src/kernel.fam`
\ (scripts/oscheck.sh).
\
\ The kernel runs in machine mode on the stdlib's stacks (data stack sp,
\ return ids s10/s11, loop frames s8); each hart started later has its own,
\ and shares s10, which the variables are found from.  A trap arriving in
\ kernel code uses the stacks of the hart it arrives on, below what the
\ interrupted code holds: fam only ever stores to a stack after moving its
\ pointer past the slot, so nothing there is lost.  Variables are shared by
\ every hart; what is a hart's own is in an array indexed by its id.

\ ── Machine registers (raw words) ──

: mcause@                    \ ( -- mcause )
F3222034 ,   \ csrrs t0,mcause,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mepc@                      \ ( -- mepc )
F3221034 ,   \ csrrs t0,mepc,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtval@                     \ ( -- mtval )
F3223034 ,   \ csrrs t0,mtval,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtvec@                     \ ( -- mtvec )
F3225030 ,   \ csrrs t0,mtvec,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mhartid@                   \ ( -- id )  this hart's
F32240F1 ,   \ csrrs t0,mhartid,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: gp@                        \ ( -- gp )  the heap's next free byte
93820100 ,   \ addi t0,gp,0
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: s10@                       \ ( -- s10 )  where the variables are found from
93020D00 ,   \ addi t0,s10,0
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtime@                     \ ( -- t )  the CLINT's mtime, low word (10 MHz)
B7C20002 ,   \ lui t0,0x200c
03A382FF ,   \ lw t1,-8(t0)
1301C1FF ,   \ addi sp,sp,-4
23206100 ,   \ sw t1,0(sp)
;

: cmp@                       \ ( -- lo hi )  this hart's mtimecmp
732E40F1 ,   \ csrrs t3,mhartid,zero
131E3E00 ,   \ slli t3,t3,0x3
B7420002 ,   \ lui t0,0x2004
B382C201 ,   \ add t0,t0,t3
03A30200 ,   \ lw t1,0(t0)
83A34200 ,   \ lw t2,4(t0)
130181FF ,   \ addi sp,sp,-8
23226100 ,   \ sw t1,4(sp)
23207100 ,   \ sw t2,0(sp)
;

\ cmp! ( lo hi -- )  this hart's mtimecmp: the high word set out of reach
\ first, so no half-written value is ever due.
: cmp!
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
13018100 ,   \ addi sp,sp,8
732E40F1 ,   \ csrrs t3,mhartid,zero
131E3E00 ,   \ slli t3,t3,0x3
B7420002 ,   \ lui t0,0x2004
B382C201 ,   \ add t0,t0,t3
130EF0FF ,   \ addi t3,zero,-1
23A2C201 ,   \ sw t3,4(t0)
23A06200 ,   \ sw t1,0(t0)
23A27200 ,   \ sw t2,4(t0)
;

: ipi                        \ ( h -- )  hart h's software interrupt raised
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
93922200 ,   \ slli t0,t0,0x2
37030002 ,   \ lui t1,0x2000
B3826200 ,   \ add t0,t0,t1
93031000 ,   \ addi t2,zero,1
23A07200 ,   \ sw t2,0(t0)
;

: msipclr                    \ this hart's software interrupt cleared
F32240F1 ,   \ csrrs t0,mhartid,zero
93922200 ,   \ slli t0,t0,0x2
37030002 ,   \ lui t1,0x2000
B3826200 ,   \ add t0,t0,t1
23A00200 ,   \ sw zero,0(t0)
;

: tmron                      \ timer interrupts on (mie.MTIE, mstatus.MIE)
93020008 ,   \ addi t0,zero,128
73A04230 ,   \ csrrs zero,mie,t0
73600430 ,   \ csrrsi zero,mstatus,8
;

: tmroff                     \ timer interrupts off
93020008 ,   \ addi t0,zero,128
73B04230 ,   \ csrrc zero,mie,t0
;

: swon                       \ software interrupts on (mie.MSIE)
73604430 ,   \ csrrsi zero,mie,8
;

: wfi                        \ sleep until an interrupt is pending
73005010 ,   \ wfi
;

\ halt ( code -- )  QEMU exits with code (the SiFive test finisher).
: halt
03230100 ,   \ lw t1,0(sp)
13014100 ,   \ addi sp,sp,4
B7021000 ,   \ lui t0,0x100
13130301 ,   \ slli t1,t1,0x10
B7330000 ,   \ lui t2,0x3
93833333 ,   \ addi t2,t2,819
33637300 ,   \ or t1,t1,t2
23A06200 ,   \ sw t1,0(t0)
6F000000 ,   \ jal zero,.
;

:M fence  0F00F00F , ;       \ fence iorw,iorw: what came before, before what follows

\ ── Memory (raw words) ──

\ mcpy ( src dst n -- )  n bytes, a multiple of 4.
: mcpy
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
638E0300 ,   \ beq t2,zero,done
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
93824200 ,   \ addi t0,t0,4
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,loop
;

\ mmove ( src dst n -- )  as mcpy, the two allowed to overlap.
: mmove
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
63820304 ,   \ beq t2,zero,done
63E06202 ,   \ bltu t0,t1,backward
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
93824200 ,   \ addi t0,t0,4
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,forward
6F004002 ,   \ jal zero,done
B3827200 ,   \ add t0,t0,t2               backward:
33037300 ,   \ add t1,t1,t2
9382C2FF ,   \ addi t0,t0,-4
1303C3FF ,   \ addi t1,t1,-4
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,backward
;

\ mzero ( addr n -- )
: mzero
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
13018100 ,   \ addi sp,sp,8
638A0300 ,   \ beq t2,zero,done
23200300 ,   \ sw zero,0(t1)
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39A03FE ,   \ bne t2,zero,loop
;

\ panic ( msg -- )  a kernel bug: say so and stop.
: panic  "kernel panic: " puts puts 0A lit putc 1 lit halt ;

\ rnd ( -- n )  xorshift32 over rndseed: not for secrets; the lottery's
\ draws (step 5) and tests.  rndseed must not be 0.
: rndseed variable ;
: rnd
rndseed @
dup D lit lshift xor
dup 11 lit rshift xor
dup 5 lit lshift xor
dup rndseed ! ;

\ ── Each hart's own ──
\
\ Hart ids run below 960 (the mailboxes' page, lib/stdlib.fam).  An array
\ of a word per hart id for each of these, taken from the heap once.

:M MAXH 3C0 lit ;
: htick  variable ;          \ timer interrupts taken
: hipi   variable ;          \ software interrupts taken
: hup    variable ;          \ started (hart 0: always)
: hjob   variable ;          \ the job asked of it (0: none)
: hres   variable ;          \ what its job found (0: all well)
: hq     variable ;          \ its queue from hart 0
: kvok   variable ;

\ harr ( h var -- addr )  hart h's word of a per-hart array.
: harr  @ swap 2 lit lshift + ;

: kvars
kvok @ 0= if
	MAXH 2 lit lshift dup alloc dup htick ! swap mzero
	MAXH 2 lit lshift dup alloc dup hipi ! swap mzero
	MAXH 2 lit lshift dup alloc dup hup ! swap mzero
	MAXH 2 lit lshift dup alloc dup hjob ! swap mzero
	MAXH 2 lit lshift dup alloc dup hres ! swap mzero
	MAXH 2 lit lshift dup alloc dup hq ! swap mzero
	1 lit kvok !
then ;

\ ── The timer ──

: period  variable ;         \ mtime between ticks

: ticks@  mhartid@ htick harr @ ;            \ ( -- n )  this hart's ticks

\ ktick  a timer interrupt: count it, and set this hart's next one a period
\ on from this one's (not from now: the rate does not drift).
: ktick
mhartid@ htick harr dup @ 1 lit + swap !
cmp@                         \ ( lo hi )
swap period @ +              \ ( hi lo' )
dup period @ u< if swap 1 lit + swap then   \ the low word wrapped: carry
swap cmp! ;

\ tmrinit  this hart's timer: 100 ticks a second (10 ms slices), the first
\ a period from now.
: tmrinit
186A0 lit period !           \ 100,000 at 10 MHz
0 lit mhartid@ htick harr !
mtime@ period @ +            \ ( lo' )
200BFFC lit @                \ ( lo' hi )  mtime's high word, carried
over period @ u< if 1 lit + then
cmp!
tmron ;

\ ── Traps ──

\ kfault  an exception (or an interrupt nobody takes) in the kernel: a bug.
: kfault
"kernel: hart " puts mhartid@ u. " trap " puts mcause@ u.x
" at " puts mepc@ u.x
" (" puts mtval@ u.x ")" puts 0A lit putc
1 lit halt ;

\ ── User mode: the trap side ──
\
\ A hart's trap area, past the registers: 128 the kernel's sp, s8, s10, s11
\ and gp as urun left them, 148 where urun goes on, 152 set when the
\ process has ended, 156 its exit code, 160 its code's first byte and the
\ byte past it, 168 its memory's.

: area@                      \ ( -- area )  this hart's trap area
F3220034 ,   \ csrrs t0,mscratch,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mpp@                       \ ( -- mode )  the mode the trap came from: 0 user, 3 machine
F3220030 ,   \ csrrs t0,mstatus,zero
93D2B200 ,   \ srli t0,t0,0xb
93F23200 ,   \ andi t0,t0,3
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mepc!                      \ ( pc -- )  where mret goes
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73901234 ,   \ csrrw zero,mepc,t0
;

: sysarg  area@ + @ ;        \ ( offset -- value )  a register the process trapped with
: sysret  area@ 28 lit + ! ; \ ( value -- )  its a0 when it goes on
: uexit   area@ 9C lit + !  1 lit area@ 98 lit + ! ;   \ ( code -- )  it ends

\ inr ( a e lo hi -- ok )  [a, e) within [lo, hi).
: inr  rot u< 0= -rot u< 0= and ;

\ urange ( addr n -- ok )  n bytes from addr within the process's code or
\ its memory.
: urange
over + 2dup u> if 2drop 0 lit else
	2dup area@ A0 lit + @ area@ A4 lit + @ inr
	-rot area@ A8 lit + @ area@ AC lit + @ inr or
then ;

\ kwrite  write(fd, buf, n): to the console, for fds 1 and 2.
: kwrite
28 lit sysarg dup 1 lit = swap 2 lit = or 0= if FFFFFFF7 lit sysret else      \ -9: no such fd
2C lit sysarg 30 lit sysarg urange 0= if FFFFFFF2 lit sysret else            \ -14: not its memory
	30 lit sysarg ?dup if 2C lit sysarg swap 0 lit do dup i + c@ putc loop drop then
	30 lit sysarg sysret
then then ;

\ ksys  a system call (ecall from user mode): the number in a7.
: ksys
44 lit sysarg
dup 1 lit = if drop 28 lit sysarg uexit else
11 lit = if kwrite else FFFFFFDA lit sysret then                            \ -38: no such call
mepc@ 4 lit + mepc!
then ;

\ ukill  an exception in user mode: the process ends, the system goes on.
: ukill
"kernel: process killed: trap " puts mcause@ u.x
" at " puts mepc@ u.x " (" puts mtval@ u.x ")" puts 0A lit putc
FFFFFFFF lit uexit ;

\ kipi  a software interrupt: cleared, and counted (what it asks is in the
\ hart's job word).
: kipi  msipclr mhartid@ hipi harr dup @ 1 lit + swap ! ;

\ ktrap  what the entry calls, with every register saved.  Interrupts are
\ taken from either mode; an exception from user mode is the process's (a
\ system call, or its end), from the kernel a bug.
: ktrap
mcause@
dup 80000007 lit = if drop ktick else
dup 80000003 lit = if drop kipi else
mpp@ if drop kfault else
8 lit = if ksys else ukill then
then then then ;

\ [skip ... skip]  compile the code between where it is but jump over it.
:I [skip  here ,j0 ;
:I skip]  jpat! ;

: trapvec variable ;         \ the entry, for the harts started later

\ trapinit  the trap entry: mscratch holds a hart's trap area (256 bytes:
\ urun's words at 128 on) where the entry saves x1-x31 (x5 by way of
\ mscratch itself) before calling ktrap, and from where it restores them
\ for mret.  A trap from user mode runs ktrap on the kernel's stacks, as
\ urun saved them; when ktrap ends the process (uexit), the entry goes on
\ where urun left off rather than back to the process.  mtvec points at the
\ entry, 16 bytes past the auipc (auipc, addi, csrw, and [skip's jump).
: trapinit
kvars
100 lit alloc
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73900234 ,   \ csrrw zero,mscratch,t0
97020000 ,   \ auipc t0,0x0
93820201 ,   \ addi t0,t0,16
73905230 ,   \ csrrw zero,mtvec,t0
[skip
F3920234 ,   \ csrrw t0,mscratch,t0      ( t0 = the area, mscratch = t0 )
23A21200 ,   \ sw ra,4(t0)
23A42200 ,   \ sw sp,8(t0)
23A63200 ,   \ sw gp,12(t0)
23A84200 ,   \ sw tp,16(t0)
23AC6200 ,   \ sw t1,24(t0)
23AE7200 ,   \ sw t2,28(t0)
23A08202 ,   \ sw s0,32(t0)
23A29202 ,   \ sw s1,36(t0)
23A4A202 ,   \ sw a0,40(t0)
23A6B202 ,   \ sw a1,44(t0)
23A8C202 ,   \ sw a2,48(t0)
23AAD202 ,   \ sw a3,52(t0)
23ACE202 ,   \ sw a4,56(t0)
23AEF202 ,   \ sw a5,60(t0)
23A00205 ,   \ sw a6,64(t0)
23A21205 ,   \ sw a7,68(t0)
23A42205 ,   \ sw s2,72(t0)
23A63205 ,   \ sw s3,76(t0)
23A84205 ,   \ sw s4,80(t0)
23AA5205 ,   \ sw s5,84(t0)
23AC6205 ,   \ sw s6,88(t0)
23AE7205 ,   \ sw s7,92(t0)
23A08207 ,   \ sw s8,96(t0)
23A29207 ,   \ sw s9,100(t0)
23A4A207 ,   \ sw s10,104(t0)
23A6B207 ,   \ sw s11,108(t0)
23A8C207 ,   \ sw t3,112(t0)
23AAD207 ,   \ sw t4,116(t0)
23ACE207 ,   \ sw t5,120(t0)
23AEF207 ,   \ sw t6,124(t0)
73230034 ,   \ csrrs t1,mscratch,zero    ( the interrupted t0 )
23AA6200 ,   \ sw t1,20(t0)
73900234 ,   \ csrrw zero,mscratch,t0    ( mscratch = the area again )
73230030 ,   \ csrrs t1,mstatus,zero     ( from user mode (MPP 0): )
1353B300 ,   \ srli t1,t1,0xb
13733300 ,   \ andi t1,t1,3
631C0300 ,   \ bne t1,zero,kernel
03A10208 ,   \ lw sp,128(t0)             ( the kernel's stacks, as urun left them )
03AC4208 ,   \ lw s8,132(t0)
03AD8208 ,   \ lw s10,136(t0)
83ADC208 ,   \ lw s11,140(t0)
83A10209 ,   \ lw gp,144(t0)
ktrap                                     \ kernel:
F3220034 ,   \ csrrs t0,mscratch,zero
03A38209 ,   \ lw t1,152(t0)             ( the process ended: back to urun )
63040302 ,   \ beq t1,zero,back
23AC0208 ,   \ sw zero,152(t0)
03A10208 ,   \ lw sp,128(t0)
03AC4208 ,   \ lw s8,132(t0)
03AD8208 ,   \ lw s10,136(t0)
83ADC208 ,   \ lw s11,140(t0)
83A10209 ,   \ lw gp,144(t0)
73600430 ,   \ csrrsi zero,mstatus,8
03A34209 ,   \ lw t1,148(t0)
67000300 ,   \ jalr zero,0(t1)
F3220034 ,   \ csrrs t0,mscratch,zero    back: ( to where the trap came from )
83A04200 ,   \ lw ra,4(t0)
03A18200 ,   \ lw sp,8(t0)
83A1C200 ,   \ lw gp,12(t0)
03A20201 ,   \ lw tp,16(t0)
03A38201 ,   \ lw t1,24(t0)
83A3C201 ,   \ lw t2,28(t0)
03A40202 ,   \ lw s0,32(t0)
83A44202 ,   \ lw s1,36(t0)
03A58202 ,   \ lw a0,40(t0)
83A5C202 ,   \ lw a1,44(t0)
03A60203 ,   \ lw a2,48(t0)
83A64203 ,   \ lw a3,52(t0)
03A78203 ,   \ lw a4,56(t0)
83A7C203 ,   \ lw a5,60(t0)
03A80204 ,   \ lw a6,64(t0)
83A84204 ,   \ lw a7,68(t0)
03A98204 ,   \ lw s2,72(t0)
83A9C204 ,   \ lw s3,76(t0)
03AA0205 ,   \ lw s4,80(t0)
83AA4205 ,   \ lw s5,84(t0)
03AB8205 ,   \ lw s6,88(t0)
83ABC205 ,   \ lw s7,92(t0)
03AC0206 ,   \ lw s8,96(t0)
83AC4206 ,   \ lw s9,100(t0)
03AD8206 ,   \ lw s10,104(t0)
83ADC206 ,   \ lw s11,108(t0)
03AE0207 ,   \ lw t3,112(t0)
83AE4207 ,   \ lw t4,116(t0)
03AF8207 ,   \ lw t5,120(t0)
83AFC207 ,   \ lw t6,124(t0)
83A24201 ,   \ lw t0,20(t0)
73002030 ,   \ mret
skip]
mtvec@ trapvec ! ;

\ ── Pages ──
\
\ The free ranges, sorted by address: an entry is the range's first byte
\ and its length in pages.  A range never touches the next (they are
\ merged when freed), so the table holds as many entries as RAM has holes.

: pgtab  variable ;          \ the table: PGMAX entries of 8 bytes
: pgn    variable ;          \ entries in use
: PGMAX  200 lit ;           \ 512 entries, one 4 KiB page

: pgent  3 lit lshift pgtab @ + ;            \ ( i -- entry )
: pglen  pgent 4 lit + @ ;                   \ ( i -- pages )
: pgend  pgent dup @ swap 4 lit + @ C lit lshift + ;   \ ( i -- end )

\ pginit ( base limit -- )  all of [base, limit) free, page-aligned.  The
\ table is taken from the heap the first time.
: pginit
pgtab @ 0= if 1000 lit alloc pgtab ! then
over - C lit rshift          \ ( base pages )
pgtab @ 4 lit + !
pgtab @ !
1 lit pgn ! ;

\ pgdel ( i -- )  remove entry i.
: pgdel
begin
dup 1 lit + pgn @ u<
while
dup 1 lit + pgent            \ ( i src )
over pgent                   \ ( i src dst )
over @ over !
swap 4 lit + @ swap 4 lit + !
1 lit +
repeat
drop
pgn @ 1 lit - pgn ! ;

\ pgins ( start pages i -- )  a new entry i, those from i on moved up.
: pgins
pgn @ PGMAX = if "page table full" panic then
pgn @                        \ ( start pages i j )
begin
2dup u<
while
1 lit - dup pgent            \ ( start pages i j-1 src )
dup 8 lit +                  \ ( ... src dst )
over @ over !
swap 4 lit + @ swap 4 lit + !
repeat
drop pgent                   \ ( start pages e )
tuck 4 lit + !
!
pgn @ 1 lit + pgn ! ;

\ pgfit ( pages -- i )  the first range at least that long (pgn: none).
: pgfit
0 lit
begin
dup pgn @ u<
if 2dup pglen u> else 0 lit then
while
1 lit +
repeat
nip ;

\ pgalloc ( pages -- addr | 0 )  first fit, taken from the range's start.
: pgalloc
dup pgfit                    \ ( pages i )
dup pgn @ u< 0= if
2drop 0 lit
else
swap over pgent              \ ( i pages e )
2dup 4 lit + @ swap -        \ ( i pages e left )
over 4 lit + !               \ ( i pages e )
dup @                        \ ( i pages e start )
rot C lit lshift             \ ( i e start bytes )
over +                       \ ( i e start start' )
rot !                        \ ( i start )
swap
dup pglen 0= if pgdel else drop then
then ;

\ pgafter ( addr -- i )  the first range starting above addr.
: pgafter
0 lit
begin
dup pgn @ u<
if 2dup pgent @ u> else 0 lit then
while
1 lit +
repeat
nip ;

\ pgfree ( addr pages -- )  back into the table, merged with the range
\ before it and the one after when they touch.
: pgfree
over pgafter                 \ ( addr pages i )
dup if dup 1 lit - pgend 3 lit pick = else 0 lit then
if
\ it extends the range before
dup 1 lit - pgent 4 lit +    \ ( addr pages i lenp )
dup @ 3 lit pick + swap !    \ ( addr pages i )
dup pgn @ u< if
dup 1 lit - pgend over pgent @ = if
\ and now reaches the one after: join them
dup pglen
over 1 lit - pgent 4 lit +
dup @ rot + swap !
dup pgdel
then
then
drop 2drop
else
dup pgn @ u< if 2 lit pick 2 lit pick C lit lshift + over pgent @ = else 0 lit then
if
\ it reaches back to the range after
pgent                        \ ( addr pages e )
dup 4 lit + dup @ 3 lit pick + swap !
nip !
else
pgins
then
then ;

\ pgfree# ( -- pages )  free pages in all.  (A `do` runs its body at least
\ once, so an empty table is a case of its own.)
: pgfree#
0 lit pgn @ ?dup if 0 lit do i pglen + loop then ;

\ pgtag ( addr pages -- )  tests: each page's first word set to addr.
: pgtag  0 lit do dup i C lit lshift + over swap ! loop drop ;
\ pgchk ( addr pages -- ok )  tests: each page's first word still addr.
: pgchk  1 lit -rot 0 lit do dup i C lit lshift + @ over = rot and swap loop drop ;

\ ── User mode: running a program ──

\ upmp  PMP for the process in the trap area: its code read and execute
\ (entries 1-2, top of range), its memory read and write (3-4); user mode
\ reaches nothing else.  Entry 0 is lib/mach.fam's locked guard on hart 0.
: upmp
F3220034 ,   \ csrrs t0,mscratch,zero
03A3020A ,   \ lw t1,160(t0)
13532300 ,   \ srli t1,t1,0x2
7310133B ,   \ csrrw zero,pmpaddr1,t1
03A3420A ,   \ lw t1,164(t0)
13532300 ,   \ srli t1,t1,0x2
7310233B ,   \ csrrw zero,pmpaddr2,t1
03A3820A ,   \ lw t1,168(t0)
13532300 ,   \ srli t1,t1,0x2
7310333B ,   \ csrrw zero,pmpaddr3,t1
03A3C20A ,   \ lw t1,172(t0)
13532300 ,   \ srli t1,t1,0x2
7310433B ,   \ csrrw zero,pmpaddr4,t1
37030D00 ,   \ lui t1,0xd0               ( 2: top of range, read, execute )
7310033A ,   \ csrrw zero,pmpcfg0,t1
1303B000 ,   \ addi t1,zero,11           ( 4: top of range, read, write )
7310133A ,   \ csrrw zero,pmpcfg1,t1
;

\ urun ( cs ce ds de -- code )  a program run in user mode, on this hart,
\ until it ends: its code [cs, ce) (it starts at cs), its memory [ds, de)
\ (given to it in a0 and a1).  Every other register starts zero.  The
\ kernel's stacks are kept in the trap area for the traps it takes; when it
\ exits or is killed, the entry goes on here, after the mret.
: urun
area@ AC lit + !  area@ A8 lit + !  area@ A4 lit + !  area@ A0 lit + !
upmp
F3220034 ,   \ csrrs t0,mscratch,zero
23A02208 ,   \ sw sp,128(t0)
23A28209 ,   \ sw s8,132(t0)
23A4A209 ,   \ sw s10,136(t0)
23A6B209 ,   \ sw s11,140(t0)
23A83208 ,   \ sw gp,144(t0)
17030000 ,   \ auipc t1,0x0
1303830A ,   \ addi t1,t1,168            ( past the mret )
23AA6208 ,   \ sw t1,148(t0)
03A3020A ,   \ lw t1,160(t0)
73101334 ,   \ csrrw zero,mepc,t1        ( it starts at its code's first byte )
37230000 ,   \ lui t1,0x2
13030380 ,   \ addi t1,t1,-2048
73300330 ,   \ csrrc zero,mstatus,t1     ( MPP: user mode )
13030008 ,   \ addi t1,zero,128
73200330 ,   \ csrrs zero,mstatus,t1     ( MPIE: interrupts on in it )
03A5820A ,   \ lw a0,168(t0)
83A5C20A ,   \ lw a1,172(t0)
93000000 ,   \ addi ra,zero,0
13010000 ,   \ addi sp,zero,0
93010000 ,   \ addi gp,zero,0
13020000 ,   \ addi tp,zero,0
93020000 ,   \ addi t0,zero,0
13030000 ,   \ addi t1,zero,0
93030000 ,   \ addi t2,zero,0
13040000 ,   \ addi s0,zero,0
93040000 ,   \ addi s1,zero,0
13060000 ,   \ addi a2,zero,0
93060000 ,   \ addi a3,zero,0
13070000 ,   \ addi a4,zero,0
93070000 ,   \ addi a5,zero,0
13080000 ,   \ addi a6,zero,0
93080000 ,   \ addi a7,zero,0
13090000 ,   \ addi s2,zero,0
93090000 ,   \ addi s3,zero,0
130A0000 ,   \ addi s4,zero,0
930A0000 ,   \ addi s5,zero,0
130B0000 ,   \ addi s6,zero,0
930B0000 ,   \ addi s7,zero,0
130C0000 ,   \ addi s8,zero,0
930C0000 ,   \ addi s9,zero,0
130D0000 ,   \ addi s10,zero,0
930D0000 ,   \ addi s11,zero,0
130E0000 ,   \ addi t3,zero,0
930E0000 ,   \ addi t4,zero,0
130F0000 ,   \ addi t5,zero,0
930F0000 ,   \ addi t6,zero,0
73002030 ,   \ mret
area@ 9C lit + @ ;

\ The programs the image carries (scripts/mkimage.sh): a table past them,
\ its offset and "PROG" in the image's last 8 bytes, where the kernel's
\ return ids begin (s10).  An entry: the name (16 bytes), the offset, the
\ length, the memory to start with.

: ptab  s10@ 4 lit - @ 474F5250 lit = if s10@ 8 lit - @ 80000000 lit + else 0 lit then ;  \ ( -- table | 0 )

\ streq ( a b -- ok )  two NUL-terminated strings the same.
: streq
begin
	over c@ over c@ over <>
	if 2drop drop 0 lit 1 lit else
	0= if 2drop 1 lit 1 lit else
	1 lit + swap 1 lit + swap 0 lit then then
until ;

\ pfind ( name -- entry | 0 )
: pfind
ptab ?dup 0= if drop 0 lit else
	dup @ ?dup 0= if 2drop 0 lit else
		0 lit swap 0 lit do
			dup 0= if over 4 lit + i 1C lit * + 3 lit pick over streq if nip else drop then then
		loop
		nip nip
	then
then ;

: pmem  variable ;  : pdat variable ;

\ prun ( name -- code )  the program run to its end, on this hart, in its
\ memory (pages, zeroed, given back after).  -1: none such, or no memory,
\ or it was killed.
: prun
dup pfind ?dup 0= if
	"kernel: no program " puts puts 0A lit putc FFFFFFFF lit
else
	nip
	dup 18 lit + @ FFF lit + C lit rshift pmem !
	pmem @ pgalloc dup pdat ! 0= if
		drop "kernel: no memory for a program" puts 0A lit putc FFFFFFFF lit
	else
		pdat @ pmem @ C lit lshift mzero
		dup 10 lit + @ 80000000 lit +
		swap 14 lit + @ over +
		pdat @ dup pmem @ C lit lshift +
		urun
		pdat @ pmem @ pgfree
	then
then ;

\ ── Locks, without atomic instructions ──
\
\ A tournament of two-hart Peterson locks: a hart takes the lock at the
\ leaf for its id, then each node above, against the one other hart that
\ can reach that node from the other side; about log2 of the harts steps,
\ not one per hart as Lamport's bakery lock takes.  Peterson's lock needs
\ a hart's write of its flag ordered before its read of the other's, which
\ RISC-V's memory model does not give without a fence: there is one there.
\ A lock: its leaves N (a power of two above every hart id), its levels,
\ then a flag per side of each node (2N words), then each node's victim
\ (N words).

: lkn    variable ;          \ every lock's leaves, set before any is made
: lkl    variable ;          \ and its levels

\ lknew ( -- lock )  a lock, from the heap.
: lknew
lkn @ C lit * 8 lit + dup alloc tuck swap mzero
lkl @ over 4 lit + !
lkn @ over ! ;

\ lock ( lock -- )  taken, by this hart; held until unlock.
: lock
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83250500 ,   \ lw a1,0(a0)                ( N )
03264500 ,   \ lw a2,4(a0)                ( levels )
93068500 ,   \ addi a3,a0,8               ( the flags )
13973500 ,   \ slli a4,a1,0x3
3387E600 ,   \ add a4,a3,a4               ( the victims )
F32740F1 ,   \ csrrs a5,mhartid,zero
B387B700 ,   \ add a5,a5,a1               ( this hart's leaf )
63040606 ,   \ beq a2,zero,done
93F21700 ,   \ andi t0,a5,1               level: ( our side )
13D31700 ,   \ srli t1,a5,0x1             ( the node )
93131300 ,   \ slli t2,t1,0x1
B3E35300 ,   \ or t2,t2,t0
93932300 ,   \ slli t2,t2,0x2
B3837600 ,   \ add t2,a3,t2
130E1000 ,   \ addi t3,zero,1
23A0C301 ,   \ sw t3,0(t2)                ( our flag up )
931E2300 ,   \ slli t4,t1,0x2
B30ED701 ,   \ add t4,a4,t4
23A05E00 ,   \ sw t0,0(t4)                ( and ourselves the victim )
0F003003 ,   \ fence rw,rw                ( both seen before we look )
13CF1200 ,   \ xori t5,t0,1
931F1300 ,   \ slli t6,t1,0x1
B3EFEF01 ,   \ or t6,t6,t5
939F2F00 ,   \ slli t6,t6,0x2
B38FF601 ,   \ add t6,a3,t6               ( the other side's flag )
03AE0F00 ,   \ lw t3,0(t6)                wait:
63060E00 ,   \ beq t3,zero,won
03AE0E00 ,   \ lw t3,0(t4)
E30A5EFE ,   \ beq t3,t0,wait             ( its flag up and we the victim )
93070300 ,   \ addi a5,t1,0               won: ( up to the node )
1306F6FF ,   \ addi a2,a2,-1
E31206FA ,   \ bne a2,zero,level
0F003003 ,   \ fence rw,rw                done: ( the lock before what it guards )
;

\ unlock ( lock -- )  given up, from the top node down.
: unlock
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83250500 ,   \ lw a1,0(a0)
03264500 ,   \ lw a2,4(a0)
93068500 ,   \ addi a3,a0,8
F32740F1 ,   \ csrrs a5,mhartid,zero
B387B700 ,   \ add a5,a5,a1
0F003003 ,   \ fence rw,rw                ( what it guards, before )
63060602 ,   \ beq a2,zero,done
1306F6FF ,   \ addi a2,a2,-1              level:
B3D2C700 ,   \ srl t0,a5,a2
13F31200 ,   \ andi t1,t0,1               ( our side at that level )
93D21200 ,   \ srli t0,t0,0x1             ( the node )
93921200 ,   \ slli t0,t0,0x1
B3E26200 ,   \ or t0,t0,t1
93922200 ,   \ slli t0,t0,0x2
B3825600 ,   \ add t0,a3,t0
23A00200 ,   \ sw zero,0(t0)              ( our flag down )
E31E06FC ,   \ bne a2,zero,level
;

\ ── Queues with one writer and one reader ──
\
\ head, tail, and 64 words: the writer alone moves head, the reader alone
\ tail, so they need fences, not a lock.

\ qnew ( -- q )
: qnew  108 lit dup alloc tuck swap mzero ;

\ qpush ( v q -- ok )  0 when full.
: qpush
dup @ over 4 lit + @ - 40 lit u< 0= if 2drop 0 lit else
	dup @ 3F lit and 2 lit lshift over 8 lit + +
	rot swap !
	fence                                \ the word, before the head that shows it
	dup @ 1 lit + swap !
	1 lit
then ;

\ qpop ( q -- v 1 | 0 )
: qpop
dup 4 lit + @ over @ = if drop 0 lit else
	fence                                \ the head, before the word it shows
	dup 4 lit + @ 3F lit and 2 lit lshift over 8 lit + + @
	fence                                \ the word read, before its slot is free
	swap dup 4 lit + @ 1 lit + swap 4 lit + !
	1 lit
then ;

\ ── Every hart ──
\
\ Hart 0 runs the kernel's main; the others wait where lib/stdlib.fam (or
\ tabernacle) left them, each having marked its mailbox present, until
\ hstart gives each a record: where to go, and its own stacks, trap area
\ and trap entry.  A started hart runs hmain: its timer, then the jobs hart
\ 0 asks of it (its job word, and a software interrupt), sleeping between.

: nharts  variable ;         \ harts running (1 before hstart)
: hmax    variable ;         \ the highest hart id + 1
: hentrya variable ;         \ where a started hart begins
: hstarted variable ;
: klk     variable ;         \ the kernel's lock
: lkk     variable ;         \ tests: each hart's turns
: lkc     variable ;         \ tests: the count they keep

: mbox  2 lit lshift 87FF1000 lit + ;       \ ( h -- addr )  its mailbox word

\ lkstrs  a test job: lkk times, under the kernel's lock, add 1 to lkc
\ (read, then written: without the lock, two harts would lose counts).
: lkstrs  lkk @ 0 lit do klk @ lock lkc @ 1 lit + lkc ! klk @ unlock loop ;

\ qstrs  a test job: from this hart's queue, lkk numbers, 1 on, in order.
: qstrs
mhartid@ hq harr @ 1 lit
begin dup lkk @ u> 0= while
	over qpop if over <> if 1 lit mhartid@ hres harr ! then 1 lit + then
repeat
2drop ;

: hrun  dup 1 lit = if lkstrs then 2 lit = if qstrs then ;   \ ( job -- )

\ hmain  where a started hart lives.
: hmain
swon tmrinit
fence 1 lit mhartid@ hup harr !
begin
	mhartid@ hjob harr @ ?dup if
		hrun fence 0 lit mhartid@ hjob harr !
	else
		wfi
	then
0 lit until ;

\ hentry  compiles the code a started hart begins at (its address into
\ hentrya): its stacks, its trap area and entry from the record in a0, then
\ hmain.
: hentry
97020000 ,   \ auipc t0,0x0
93824201 ,   \ addi t0,t0,20              ( the code below )
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
[skip
03214500 ,   \ lw sp,4(a0)
032C8500 ,   \ lw s8,8(a0)
032DC500 ,   \ lw s10,12(a0)
832D0501 ,   \ lw s11,16(a0)
83214501 ,   \ lw gp,20(a0)
83228501 ,   \ lw t0,24(a0)
73900234 ,   \ csrrw zero,mscratch,t0
8322C501 ,   \ lw t0,28(a0)
73905230 ,   \ csrrw zero,mtvec,t0
hmain
skip]
hentrya ! ;

\ hpresent ( -- n )  harts marked present in the mailboxes.
: hpresent  0 lit MAXH 1 lit do i mbox @ 1 lit = if 1 lit + then loop ;

\ hupn ( -- n )  harts started and running.
: hupn  0 lit hmax @ 1 lit u> if hmax @ 1 lit do i hup harr @ if 1 lit + then loop then ;

\ hlate  the harts started that have not said so, and their mailboxes.
: hlate
"kernel: not started:" puts
hmax @ 1 lit do
	i hup harr @ 0= if i mbox @ 1 lit u> if
		20 lit putc i u. "=" puts i mbox @ u.x
	then then
loop
0A lit putc ;

\ hstart  every hart waiting started.  The harts start at once, but
\ reaching their mailboxes may take a moment (under QEMU, with more harts
\ than the host has cores, a hart's thread waits its turn): hart 0 waits
\ until 100 ms pass with no new one, and a hart it starts has 10 s to say so.  Each started hart gets 36 KiB of the heap: its record
\ and trap area, 16 KiB of data stack, 4 KiB each of loop frames, return ids
\ and heap.  Then the locks' size, from the highest hart id.
: hstart
hstarted @ 0= if
	1 lit hstarted !
	hentry
	1 lit nharts !  1 lit hmax !
	1 lit mhartid@ hup harr !
	hpresent mtime@
	begin mtime@ over - F4240 lit u< while
		hpresent 2 lit pick <> if 2drop hpresent mtime@ then
	repeat
	2drop
	MAXH 1 lit do
		i mbox @ 1 lit = if
			9000 lit alloc FFF lit + FFFFF000 lit and   \ ( blk )
			hentrya @ over !
			dup 5000 lit + over 4 lit + !              \ sp
			dup 6000 lit + over 8 lit + !              \ s8
			s10@ over C lit + !                        \ s10, shared
			dup 7000 lit + over 10 lit + !             \ s11
			dup 7000 lit + over 14 lit + !             \ gp
			dup 40 lit + over 18 lit + !               \ the trap area
			trapvec @ over 1C lit + !                  \ the trap entry
			fence
			i mbox !
			fence
			i ipi
			nharts @ 1 lit + nharts !
			i 1 lit + hmax !
		then
	loop
	mtime@
	begin hupn nharts @ 1 lit - u< while
		mtime@ over - 5F5E100 lit u> if hlate "a hart did not start" panic then
	repeat
	drop
	1 lit 0 lit
	begin over hmax @ u< while swap 1 lit lshift swap 1 lit + repeat
	lkl ! lkn !
	lknew klk !
then ;

\ hjobs ( job -- )  asked of every started hart.
: hjobs
hmax @ 1 lit u> if
	hmax @ 1 lit do
		i hup harr @ if dup i hjob harr ! fence i ipi then
	loop
then
drop ;

\ hjwait  until every started hart has done its job.
: hjwait
begin
	0 lit
	hmax @ 1 lit u> if hmax @ 1 lit do i hjob harr @ or loop then
while repeat
fence ;

Test {
	pg_one {
		\ a range of 64 pages: three taken in a row, given back in another
		\ order, and the table whole again
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit           \ ( base )
		pgfree# 40 lit asrt_eq
		1 lit pgalloc over asrt_eq
		2 lit pgalloc over 1000 lit + asrt_eq
		3 lit pgalloc over 3000 lit + asrt_eq
		pgfree# 3A lit asrt_eq
		pgn @ 1 lit asrt_eq
		dup 1000 lit + 2 lit pgfree          \ a hole in the middle
		pgn @ 2 lit asrt_eq
		dup 1 lit pgfree                     \ joins it
		pgn @ 2 lit asrt_eq
		dup 3000 lit + 3 lit pgfree          \ joins both sides
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_full {
		\ running out, and coming back
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit
		41 lit pgalloc 0 lit asrt_eq
		40 lit pgalloc over asrt_eq
		pgn @ 0 lit asrt_eq
		pgfree# 0 lit asrt_eq
		1 lit pgalloc 0 lit asrt_eq
		dup 40 lit pgfree
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_holes {
		\ every page taken one by one; every other given back (32 ranges),
		\ then the rest (one again)
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit
		40 lit 0 lit do 1 lit pgalloc drop loop
		pgn @ 0 lit asrt_eq
		20 lit 0 lit do dup i D lit lshift + 1 lit pgfree loop
		pgn @ 20 lit asrt_eq
		20 lit 0 lit do dup i D lit lshift + 1000 lit + 1 lit pgfree loop
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_rand {
		\ 1000 random takes and gives back over 16 slots, each block's
		\ pages tagged with its address and checked when it is given
		\ back (so no two blocks ever overlapped); at the end, whole
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup 40000 lit + pginit
		80 lit alloc                         \ ( S: 16 slots, address and pages )
		20 lit 0 lit do 0 lit over i 2 lit lshift + ! loop
		1234567 lit rndseed !
		3E8 lit 0 lit do
			rnd F lit and 3 lit lshift over +        \ ( S slot )
			dup @ if
				dup @ over 4 lit + @ pgchk assert
				dup @ over 4 lit + @ pgfree
				0 lit over !
			else
				rnd 7 lit and 1 lit +                \ ( S slot pages )
				dup pgalloc                          \ ( S slot pages addr )
				dup if
					2dup swap pgtag
					2 lit pick !
					over 4 lit + !
				else
					2drop
				then
			then
			drop
		loop
		10 lit 0 lit do
			dup i 3 lit lshift + dup @ if dup @ swap 4 lit + @ pgfree else drop then
		loop
		drop
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
	}
	tm_busy {
		\ a long computation interrupted by the timer again and again comes
		\ out as it does uninterrupted: the entry saves and restores
		\ everything it should
		1234567 lit rndseed !
		100000 lit 0 lit do rnd drop loop
		rndseed @                            \ ( undisturbed )
		trapinit tmrinit
		1234567 lit rndseed !
		100000 lit 0 lit do rnd drop loop
		tmroff
		rndseed @ asrt_eq
		ticks@ 2 lit u< 0= assert            \ and it was interrupted
	}
	timer {
		\ 20 ticks, each a period at least after the last: none early, and
		\ they keep coming
		trapinit tmrinit
		mtime@
		begin ticks@ 14 lit u< while wfi repeat
		tmroff
		mtime@ swap -                        \ elapsed
		period @ 13 lit * u< 0= assert       \ at least 19 periods
	}
	harts {
		\ every hart there is started; 1000 counts each under the lock come
		\ out whole; numbers sent to each hart through its queue arrive
		\ every one, in order
		trapinit hstart
		hupn nharts @ 1 lit - asrt_eq
		0 lit lkc !  3E8 lit lkk !
		1 lit hjobs lkstrs hjwait
		lkc @ nharts @ 3E8 lit * asrt_eq
		hmax @ 1 lit u> if
			hmax @ 1 lit do
				i hup harr @ if qnew i hq harr !  0 lit i hres harr ! then
			loop
		then
		2 lit hjobs
		lkk @ 1 lit + 1 lit do
			hmax @ 1 lit u> if
				hmax @ 1 lit do
					i hup harr @ if
						begin j i hq harr @ qpush until
					then
				loop
			then
		loop
		hjwait
		0 lit hmax @ 1 lit u> if hmax @ 1 lit do i hres harr @ or loop then
		0 lit asrt_eq
		"harts: " puts nharts @ u. 0A lit putc
	}
}
