\ kernel.fam — the OS's kernel (docs/OS.md), steps 1 to 5.  The traps
\ (every interrupt and exception comes through one entry, which saves the
\ registers and calls ktrap), each hart's timer (100 ticks a second), the
\ page allocator (RAM in 4 KiB pages, a sorted list of free ranges, first
\ fit, neighbours merged when freed), every hart the machine has (started
\ from where they wait, lib/mach.fam and tabernacle; locks without atomic
\ instructions; queues with one writer and one reader; the software
\ interrupt that wakes a hart), and processes and threads in user mode,
\ scheduled on every hart by lottery, with their system calls.
\
\ Definitions only: src/boot.fam is the kernel's main, and the Test blocks
\ below run with `tools/fam --test [--smp=N] src/kernel.fam`
\ (scripts/oscheck.sh).
\
\ The kernel runs in machine mode on the stdlib's stacks (data stack sp,
\ return ids s10/s11, loop frames s8); each hart started later has its own,
\ and shares s10, which the variables are found from.  A trap arriving in
\ kernel code uses the stacks of the hart it arrives on, below what the
\ interrupted code holds: fam only ever stores to a stack after moving its
\ pointer past the slot, so nothing there is lost.  Variables are shared by
\ every hart; what is a hart's own is in an array indexed by its id.

\ ── Machine registers (raw words) ──

: mcause@                    \ ( -- mcause )
F3222034 ,   \ csrrs t0,mcause,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mepc@                      \ ( -- mepc )
F3221034 ,   \ csrrs t0,mepc,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtval@                     \ ( -- mtval )
F3223034 ,   \ csrrs t0,mtval,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtvec@                     \ ( -- mtvec )
F3225030 ,   \ csrrs t0,mtvec,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mhartid@                   \ ( -- id )  this hart's
F32240F1 ,   \ csrrs t0,mhartid,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: gp@                        \ ( -- gp )  the heap's next free byte
93820100 ,   \ addi t0,gp,0
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: s10@                       \ ( -- s10 )  where the variables are found from
93020D00 ,   \ addi t0,s10,0
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mtime@                     \ ( -- t )  the CLINT's mtime, low word (10 MHz)
B7C20002 ,   \ lui t0,0x200c
03A382FF ,   \ lw t1,-8(t0)
1301C1FF ,   \ addi sp,sp,-4
23206100 ,   \ sw t1,0(sp)
;

: cmp@                       \ ( -- lo hi )  this hart's mtimecmp
732E40F1 ,   \ csrrs t3,mhartid,zero
131E3E00 ,   \ slli t3,t3,0x3
B7420002 ,   \ lui t0,0x2004
B382C201 ,   \ add t0,t0,t3
03A30200 ,   \ lw t1,0(t0)
83A34200 ,   \ lw t2,4(t0)
130181FF ,   \ addi sp,sp,-8
23226100 ,   \ sw t1,4(sp)
23207100 ,   \ sw t2,0(sp)
;

\ cmp! ( lo hi -- )  this hart's mtimecmp: the high word set out of reach
\ first, so no half-written value is ever due.
: cmp!
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
13018100 ,   \ addi sp,sp,8
732E40F1 ,   \ csrrs t3,mhartid,zero
131E3E00 ,   \ slli t3,t3,0x3
B7420002 ,   \ lui t0,0x2004
B382C201 ,   \ add t0,t0,t3
130EF0FF ,   \ addi t3,zero,-1
23A2C201 ,   \ sw t3,4(t0)
23A06200 ,   \ sw t1,0(t0)
23A27200 ,   \ sw t2,4(t0)
;

: ipi                        \ ( h -- )  hart h's software interrupt raised
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
93922200 ,   \ slli t0,t0,0x2
37030002 ,   \ lui t1,0x2000
B3826200 ,   \ add t0,t0,t1
93031000 ,   \ addi t2,zero,1
23A07200 ,   \ sw t2,0(t0)
;

: msipclr                    \ this hart's software interrupt cleared
F32240F1 ,   \ csrrs t0,mhartid,zero
93922200 ,   \ slli t0,t0,0x2
37030002 ,   \ lui t1,0x2000
B3826200 ,   \ add t0,t0,t1
23A00200 ,   \ sw zero,0(t0)
;

: tmron                      \ timer interrupts on (mie.MTIE, mstatus.MIE)
93020008 ,   \ addi t0,zero,128
73A04230 ,   \ csrrs zero,mie,t0
73600430 ,   \ csrrsi zero,mstatus,8
;

: tmroff                     \ timer interrupts off
93020008 ,   \ addi t0,zero,128
73B04230 ,   \ csrrc zero,mie,t0
;

: swon                       \ software interrupts on (mie.MSIE)
73604430 ,   \ csrrsi zero,mie,8
;

: wfi                        \ sleep until an interrupt is pending
73005010 ,   \ wfi
;

\ halt ( code -- )  QEMU exits with code (the SiFive test finisher).
: halt
03230100 ,   \ lw t1,0(sp)
13014100 ,   \ addi sp,sp,4
B7021000 ,   \ lui t0,0x100
13130301 ,   \ slli t1,t1,0x10
B7330000 ,   \ lui t2,0x3
93833333 ,   \ addi t2,t2,819
33637300 ,   \ or t1,t1,t2
23A06200 ,   \ sw t1,0(t0)
6F000000 ,   \ jal zero,.
;

:M fence  0F00F00F , ;       \ fence iorw,iorw: what came before, before what follows

\ ── Memory (raw words) ──

\ mcpy ( src dst n -- )  n bytes, a multiple of 4.
: mcpy
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
638E0300 ,   \ beq t2,zero,done
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
93824200 ,   \ addi t0,t0,4
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,loop
;

\ mmove ( src dst n -- )  as mcpy, the two allowed to overlap.
: mmove
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
83228100 ,   \ lw t0,8(sp)
1301C100 ,   \ addi sp,sp,12
63820304 ,   \ beq t2,zero,done
63E06202 ,   \ bltu t0,t1,backward
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
93824200 ,   \ addi t0,t0,4
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,forward
6F004002 ,   \ jal zero,done
B3827200 ,   \ add t0,t0,t2               backward:
33037300 ,   \ add t1,t1,t2
9382C2FF ,   \ addi t0,t0,-4
1303C3FF ,   \ addi t1,t1,-4
03AE0200 ,   \ lw t3,0(t0)
2320C301 ,   \ sw t3,0(t1)
9383C3FF ,   \ addi t2,t2,-4
E39603FE ,   \ bne t2,zero,backward
;

\ mzero ( addr n -- )
: mzero
83230100 ,   \ lw t2,0(sp)
03234100 ,   \ lw t1,4(sp)
13018100 ,   \ addi sp,sp,8
638A0300 ,   \ beq t2,zero,done
23200300 ,   \ sw zero,0(t1)
13034300 ,   \ addi t1,t1,4
9383C3FF ,   \ addi t2,t2,-4
E39A03FE ,   \ bne t2,zero,loop
;

\ panic ( msg -- )  a kernel bug: say so and stop.
: panic  "kernel panic: " puts puts 0A lit putc 1 lit halt ;

\ rnd ( -- n )  xorshift32 over rndseed: not for secrets; the lottery's
\ draws (step 5) and tests.  rndseed must not be 0.
: rndseed variable ;
: rnd
rndseed @
dup D lit lshift xor
dup 11 lit rshift xor
dup 5 lit lshift xor
dup rndseed ! ;

\ ── Each hart's own ──
\
\ Hart ids run below 960 (the mailboxes' page, lib/stdlib.fam).  An array
\ of a word per hart id for each of these, taken from the heap once.

:M MAXH 3C0 lit ;
: htick  variable ;          \ timer interrupts taken
: hipi   variable ;          \ software interrupts taken
: hup    variable ;          \ started (hart 0: always)
: hjob   variable ;          \ the job asked of it (0: none)
: hres   variable ;          \ what its job found (0: all well)
: hq     variable ;          \ its queue from hart 0
: hcur   variable ;          \ the thread it runs (0: none)
: harea  variable ;          \ its own trap area (mscratch when no thread runs)
: kvok   variable ;

\ harr ( h var -- addr )  hart h's word of a per-hart array.
: harr  @ swap 2 lit lshift + ;

: kvars
kvok @ 0= if
	MAXH 2 lit lshift dup alloc dup htick ! swap mzero
	MAXH 2 lit lshift dup alloc dup hipi ! swap mzero
	MAXH 2 lit lshift dup alloc dup hup ! swap mzero
	MAXH 2 lit lshift dup alloc dup hjob ! swap mzero
	MAXH 2 lit lshift dup alloc dup hres ! swap mzero
	MAXH 2 lit lshift dup alloc dup hq ! swap mzero
	MAXH 2 lit lshift dup alloc dup hcur ! swap mzero
	MAXH 2 lit lshift dup alloc dup harea ! swap mzero
	1 lit kvok !
then ;

\ ── The timer ──

: period  variable ;         \ mtime between ticks

: ticks@  mhartid@ htick harr @ ;            \ ( -- n )  this hart's ticks

\ ktick  a timer interrupt: count it, and set this hart's next one a period
\ on from this one's (not from now: the rate does not drift).
: ktick
mhartid@ htick harr dup @ 1 lit + swap !
cmp@                         \ ( lo hi )
swap period @ +              \ ( hi lo' )
dup period @ u< if swap 1 lit + swap then   \ the low word wrapped: carry
swap cmp! ;

\ tmrinit  this hart's timer: 100 ticks a second (10 ms slices), the first
\ a period from now.
: tmrinit
186A0 lit period !           \ 100,000 at 10 MHz
0 lit mhartid@ htick harr !
mtime@ period @ +            \ ( lo' )
200BFFC lit @                \ ( lo' hi )  mtime's high word, carried
over period @ u< if 1 lit + then
cmp!
tmron ;

\ ── Pages ──
\
\ The free ranges, sorted by address: an entry is the range's first byte
\ and its length in pages.  A range never touches the next (they are
\ merged when freed), so the table holds as many entries as RAM has holes.

: pgtab  variable ;          \ the table: PGMAX entries of 8 bytes
: pgn    variable ;          \ entries in use
: PGMAX  200 lit ;           \ 512 entries, one 4 KiB page

: pgent  3 lit lshift pgtab @ + ;            \ ( i -- entry )
: pglen  pgent 4 lit + @ ;                   \ ( i -- pages )
: pgend  pgent dup @ swap 4 lit + @ C lit lshift + ;   \ ( i -- end )

\ pginit ( base limit -- )  all of [base, limit) free, page-aligned.  The
\ table is taken from the heap the first time.
: pginit
pgtab @ 0= if 1000 lit alloc pgtab ! then
over - C lit rshift          \ ( base pages )
pgtab @ 4 lit + !
pgtab @ !
1 lit pgn ! ;

\ pgdel ( i -- )  remove entry i.
: pgdel
begin
dup 1 lit + pgn @ u<
while
dup 1 lit + pgent            \ ( i src )
over pgent                   \ ( i src dst )
over @ over !
swap 4 lit + @ swap 4 lit + !
1 lit +
repeat
drop
pgn @ 1 lit - pgn ! ;

\ pgins ( start pages i -- )  a new entry i, those from i on moved up.
: pgins
pgn @ PGMAX = if "page table full" panic then
pgn @                        \ ( start pages i j )
begin
2dup u<
while
1 lit - dup pgent            \ ( start pages i j-1 src )
dup 8 lit +                  \ ( ... src dst )
over @ over !
swap 4 lit + @ swap 4 lit + !
repeat
drop pgent                   \ ( start pages e )
tuck 4 lit + !
!
pgn @ 1 lit + pgn ! ;

\ pgfit ( pages -- i )  the first range at least that long (pgn: none).
: pgfit
0 lit
begin
dup pgn @ u<
if 2dup pglen u> else 0 lit then
while
1 lit +
repeat
nip ;

\ pgalloc ( pages -- addr | 0 )  first fit, taken from the range's start.
: pgalloc
dup pgfit                    \ ( pages i )
dup pgn @ u< 0= if
2drop 0 lit
else
swap over pgent              \ ( i pages e )
2dup 4 lit + @ swap -        \ ( i pages e left )
over 4 lit + !               \ ( i pages e )
dup @                        \ ( i pages e start )
rot C lit lshift             \ ( i e start bytes )
over +                       \ ( i e start start' )
rot !                        \ ( i start )
swap
dup pglen 0= if pgdel else drop then
then ;

\ pgafter ( addr -- i )  the first range starting above addr.
: pgafter
0 lit
begin
dup pgn @ u<
if 2dup pgent @ u> else 0 lit then
while
1 lit +
repeat
nip ;

\ pgfree ( addr pages -- )  back into the table, merged with the range
\ before it and the one after when they touch.
: pgfree
over pgafter                 \ ( addr pages i )
dup if dup 1 lit - pgend 3 lit pick = else 0 lit then
if
\ it extends the range before
dup 1 lit - pgent 4 lit +    \ ( addr pages i lenp )
dup @ 3 lit pick + swap !    \ ( addr pages i )
dup pgn @ u< if
dup 1 lit - pgend over pgent @ = if
\ and now reaches the one after: join them
dup pglen
over 1 lit - pgent 4 lit +
dup @ rot + swap !
dup pgdel
then
then
drop 2drop
else
dup pgn @ u< if 2 lit pick 2 lit pick C lit lshift + over pgent @ = else 0 lit then
if
\ it reaches back to the range after
pgent                        \ ( addr pages e )
dup 4 lit + dup @ 3 lit pick + swap !
nip !
else
pgins
then
then ;

\ pgfree# ( -- pages )  free pages in all.  (A `do` runs its body at least
\ once, so an empty table is a case of its own.)
: pgfree#
0 lit pgn @ ?dup if 0 lit do i pglen + loop then ;

\ pgtag ( addr pages -- )  tests: each page's first word set to addr.
: pgtag  0 lit do dup i C lit lshift + over swap ! loop drop ;
\ pgchk ( addr pages -- ok )  tests: each page's first word still addr.
: pgchk  1 lit -rot 0 lit do dup i C lit lshift + @ over = rot and swap loop drop ;

\ ── Locks, without atomic instructions ──
\
\ A tournament of two-hart Peterson locks: a hart takes the lock at the
\ leaf for its id, then each node above, against the one other hart that
\ can reach that node from the other side; about log2 of the harts steps,
\ not one per hart as Lamport's bakery lock takes.  Peterson's lock needs
\ a hart's write of its flag ordered before its read of the other's, which
\ RISC-V's memory model does not give without a fence: there is one there.
\ A lock: its leaves N (a power of two above every hart id), its levels,
\ then a flag per side of each node (2N words), then each node's victim
\ (N words).

: lkn    variable ;          \ every lock's leaves, set before any is made
: lkl    variable ;          \ and its levels

\ lknew ( -- lock )  a lock, from the heap.
: lknew
lkn @ C lit * 8 lit + dup alloc tuck swap mzero
lkl @ over 4 lit + !
lkn @ over ! ;

\ lock ( lock -- )  taken, by this hart; held until unlock.
: lock
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83250500 ,   \ lw a1,0(a0)                ( N )
03264500 ,   \ lw a2,4(a0)                ( levels )
93068500 ,   \ addi a3,a0,8               ( the flags )
13973500 ,   \ slli a4,a1,0x3
3387E600 ,   \ add a4,a3,a4               ( the victims )
F32740F1 ,   \ csrrs a5,mhartid,zero
B387B700 ,   \ add a5,a5,a1               ( this hart's leaf )
63040606 ,   \ beq a2,zero,done
93F21700 ,   \ andi t0,a5,1               level: ( our side )
13D31700 ,   \ srli t1,a5,0x1             ( the node )
93131300 ,   \ slli t2,t1,0x1
B3E35300 ,   \ or t2,t2,t0
93932300 ,   \ slli t2,t2,0x2
B3837600 ,   \ add t2,a3,t2
130E1000 ,   \ addi t3,zero,1
23A0C301 ,   \ sw t3,0(t2)                ( our flag up )
931E2300 ,   \ slli t4,t1,0x2
B30ED701 ,   \ add t4,a4,t4
23A05E00 ,   \ sw t0,0(t4)                ( and ourselves the victim )
0F003003 ,   \ fence rw,rw                ( both seen before we look )
13CF1200 ,   \ xori t5,t0,1
931F1300 ,   \ slli t6,t1,0x1
B3EFEF01 ,   \ or t6,t6,t5
939F2F00 ,   \ slli t6,t6,0x2
B38FF601 ,   \ add t6,a3,t6               ( the other side's flag )
03AE0F00 ,   \ lw t3,0(t6)                wait:
63060E00 ,   \ beq t3,zero,won
03AE0E00 ,   \ lw t3,0(t4)
E30A5EFE ,   \ beq t3,t0,wait             ( its flag up and we the victim )
93070300 ,   \ addi a5,t1,0               won: ( up to the node )
1306F6FF ,   \ addi a2,a2,-1
E31206FA ,   \ bne a2,zero,level
0F003003 ,   \ fence rw,rw                done: ( the lock before what it guards )
;

\ unlock ( lock -- )  given up, from the top node down.
: unlock
03250100 ,   \ lw a0,0(sp)
13014100 ,   \ addi sp,sp,4
83250500 ,   \ lw a1,0(a0)
03264500 ,   \ lw a2,4(a0)
93068500 ,   \ addi a3,a0,8
F32740F1 ,   \ csrrs a5,mhartid,zero
B387B700 ,   \ add a5,a5,a1
0F003003 ,   \ fence rw,rw                ( what it guards, before )
63060602 ,   \ beq a2,zero,done
1306F6FF ,   \ addi a2,a2,-1              level:
B3D2C700 ,   \ srl t0,a5,a2
13F31200 ,   \ andi t1,t0,1               ( our side at that level )
93D21200 ,   \ srli t0,t0,0x1             ( the node )
93921200 ,   \ slli t0,t0,0x1
B3E26200 ,   \ or t0,t0,t1
93922200 ,   \ slli t0,t0,0x2
B3825600 ,   \ add t0,a3,t0
23A00200 ,   \ sw zero,0(t0)              ( our flag down )
E31E06FC ,   \ bne a2,zero,level
;

\ ── Queues with one writer and one reader ──
\
\ head, tail, and 64 words: the writer alone moves head, the reader alone
\ tail, so they need fences, not a lock.

\ qnew ( -- q )
: qnew  108 lit dup alloc tuck swap mzero ;

\ qpush ( v q -- ok )  0 when full.
: qpush
dup @ over 4 lit + @ - 40 lit u< 0= if 2drop 0 lit else
	dup @ 3F lit and 2 lit lshift over 8 lit + +
	rot swap !
	fence                                \ the word, before the head that shows it
	dup @ 1 lit + swap !
	1 lit
then ;

\ qpop ( q -- v 1 | 0 )
: qpop
dup 4 lit + @ over @ = if drop 0 lit else
	fence                                \ the head, before the word it shows
	dup 4 lit + @ 3F lit and 2 lit lshift over 8 lit + + @
	fence                                \ the word read, before its slot is free
	swap dup 4 lit + @ 1 lit + swap 4 lit + !
	1 lit
then ;

\ ── Every hart: what it shares ──
\
\ Hart 0 runs the kernel's main; the others wait where lib/stdlib.fam (or
\ tabernacle) left them, each having marked its mailbox present, until
\ hstart gives each a record: where to go, and its own stacks, trap area
\ and trap entry.  A started hart runs hmain: its timer, then the jobs hart
\ 0 asks of it (its job word, and a software interrupt), sleeping between.

: nharts  variable ;         \ harts running (1 before hstart)
: hmax    variable ;         \ the highest hart id + 1
: hentrya variable ;         \ where a started hart begins
: hstarted variable ;
: klk     variable ;         \ the kernel's lock
: lkk     variable ;         \ tests: each hart's turns
: lkc     variable ;         \ tests: the count they keep

: mbox  2 lit lshift 87FF1000 lit + ;       \ ( h -- addr )  its mailbox word

\ lkstrs  a test job: lkk times, under the kernel's lock, add 1 to lkc
\ (read, then written: without the lock, two harts would lose counts).
: lkstrs  lkk @ 0 lit do klk @ lock lkc @ 1 lit + lkc ! klk @ unlock loop ;

\ qstrs  a test job: from this hart's queue, lkk numbers, 1 on, in order.
: qstrs
mhartid@ hq harr @ 1 lit
begin dup lkk @ u> 0= while
	over qpop if over <> if 1 lit mhartid@ hres harr ! then 1 lit + then
repeat
2drop ;

: hrun  dup 1 lit = if lkstrs then 2 lit = if qstrs then ;   \ ( job -- )

\ kfault  an exception (or an interrupt nobody takes) in the kernel: a bug.
: kfault
"kernel: hart " puts mhartid@ u. " trap " puts mcause@ u.x
" at " puts mepc@ u.x
" (" puts mtval@ u.x ")" puts 0A lit putc
1 lit halt ;

\ ── User mode ──
\
\ A hart's trap area, or a thread's control block (below), past the
\ registers: 128 the kernel's sp, s8, s10, s11 and gp as trun left them,
\ 148 where trun goes on, 152 set when the thread stops running, 160 its
\ process's code (its first byte, the byte past it), 168 its memory.

: area@                      \ ( -- area )  this hart's trap area
F3220034 ,   \ csrrs t0,mscratch,zero
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mpp@                       \ ( -- mode )  the mode the trap came from: 0 user, 3 machine
F3220030 ,   \ csrrs t0,mstatus,zero
93D2B200 ,   \ srli t0,t0,0xb
93F23200 ,   \ andi t0,t0,3
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
;

: mepc!                      \ ( pc -- )  where mret goes
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73901234 ,   \ csrrw zero,mepc,t0
;

: sysarg  area@ + @ ;        \ ( offset -- value )  a register the process trapped with
: sysret  area@ 28 lit + ! ; \ ( value -- )  its a0 when it goes on
\ inr ( a e lo hi -- ok )  [a, e) within [lo, hi).
: inr  rot u< 0= -rot u< 0= and ;

\ urange ( addr n -- ok )  n bytes from addr within the process's code or
\ its memory.
: urange
over + 2dup u> if 2drop 0 lit else
	2dup area@ A0 lit + @ area@ A4 lit + @ inr
	-rot area@ A8 lit + @ area@ AC lit + @ inr or
then ;

\ upmp  PMP for the process in the trap area: its code read and execute
\ (entries 1-2, top of range), its memory read and write (3-4); user mode
\ reaches nothing else.  Entry 0 is lib/mach.fam's locked guard on hart 0.
: upmp
F3220034 ,   \ csrrs t0,mscratch,zero
03A3020A ,   \ lw t1,160(t0)
13532300 ,   \ srli t1,t1,0x2
7310133B ,   \ csrrw zero,pmpaddr1,t1
03A3420A ,   \ lw t1,164(t0)
13532300 ,   \ srli t1,t1,0x2
7310233B ,   \ csrrw zero,pmpaddr2,t1
03A3820A ,   \ lw t1,168(t0)
13532300 ,   \ srli t1,t1,0x2
7310333B ,   \ csrrw zero,pmpaddr3,t1
03A3C20A ,   \ lw t1,172(t0)
13532300 ,   \ srli t1,t1,0x2
7310433B ,   \ csrrw zero,pmpaddr4,t1
37030D00 ,   \ lui t1,0xd0               ( 2: top of range, read, execute )
7310033A ,   \ csrrw zero,pmpcfg0,t1
1303B000 ,   \ addi t1,zero,11           ( 4: top of range, read, write )
7310133A ,   \ csrrw zero,pmpcfg1,t1
;

\ The programs the image carries (scripts/mkimage.sh): a table past them,
\ its offset and "PROG" in the image's last 8 bytes, where the kernel's
\ return ids begin (s10).  An entry: the name (16 bytes), the offset, the
\ length, the memory to start with.

: progtab  s10@ 4 lit - @ 474F5250 lit = if s10@ 8 lit - @ 80000000 lit + else 0 lit then ;  \ ( -- table | 0 )

\ streq ( a b -- ok )  two NUL-terminated strings the same.
: streq
begin
	over c@ over c@ over <>
	if 2drop drop 0 lit 1 lit else
	0= if 2drop 1 lit 1 lit else
	1 lit + swap 1 lit + swap 0 lit then then
until ;

\ pfind ( name -- entry | 0 )
: pfind
progtab ?dup 0= if drop 0 lit else
	dup @ ?dup 0= if 2drop 0 lit else
		0 lit swap 0 lit do
			dup 0= if over 4 lit + i 1C lit * + 3 lit pick over streq if nip else drop then then
		loop
		nip nip
	then
then ;

\ ── Processes and threads ──
\
\ A thread's control block (256 bytes) is its trap area while it runs: the
\ entry saves its registers there (its pc at 0, x1-x31 at 4-124), the
\ kernel's stacks for its traps are kept at 128-144 (where trun left them),
\ trun goes on at 148 when 152 is set, its process's code and memory at
\ 160-172 (for PMP and the checks of what it passes); then its state at 176
\ (0 free, 1 ready, 2 running, 3 asleep, 4 blocked, 6 ended, not yet
\ joined, 7 ended, its slot freed once it is off its hart: while the
\ thread is there, the hart's way back is in it), its process 180, its tickets 184, when to wake 188, what it
\ waits on 192, the ticks it has run 196, what it ended with 204, where a
\ child's status goes 208, what kind of wait 212 (1 a child, 2 a thread, 3
\ a lock, 4 a word), whether that wait has a time limit 216, and whether
\ a hart is on it 220: from when tpick gives it to a hart until that hart
\ is off it again (tafter).  Until then it is not run elsewhere, even woken
\ (the hart going back to its loop still uses its block), nor its slot
\ reused.
\
\ A process (64 bytes): its state (0 free, 1 living, 2 ended, its parent
\ not yet told), its parent's pid (0: the kernel), its exit code, its
\ threads not ended, its memory (first byte, pages), its code (first byte,
\ the byte past it), its tickets, its program's table entry (whose name
\ is its first 16 bytes), whether it is ending.
\
\ Each hart runs hloop: a thread drawn by lottery among those ready (each
\ holding its tickets), run until it traps back (its slice over at a timer
\ tick, a call that blocks, its end), then the next; when none is ready,
\ wfi.  The tables are the kernel's lock's (klk), held briefly.

:M MAXT 100 lit ;            \ 256 threads
:M MAXP 40 lit ;             \ 64 processes
: thr  variable ;            \ the threads' table
: prc  variable ;            \ the processes'

: thn     8 lit lshift thr @ + ;           \ ( i -- t )
: prn     6 lit lshift prc @ + ;           \ ( i -- p )
: tid     thr @ - 8 lit rshift 1 lit + ;   \ ( t -- tid )
: pid     prc @ - 6 lit rshift 1 lit + ;   \ ( p -- pid )
: tproc   B4 lit + @ ;                     \ ( t -- p )
: tstate  B0 lit + @ ;                     \ ( t -- state )
: tstate! B0 lit + ! ;                     \ ( state t -- )
: cproc   area@ tproc ;                    \ ( -- p )  the process trapping

: mscr!                  \ ( area -- )
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73900234 ,   \ csrrw zero,mscratch,t0
;
: kdi  73700430 , ;          \ interrupts off (mstatus.MIE)
: kei  73600430 , ;          \ and on

: thi  variable ;            \ the thread slots ever used: the loops over the
: phi  variable ;            \ threads (and processes) go no further

\ ptinit  the tables, from the pages.
: ptinit
0 lit thi !  0 lit phi !
10 lit pgalloc dup 0= if "no memory for the threads" panic then dup thr ! 10000 lit mzero
1 lit pgalloc dup 0= if "no memory for the processes" panic then dup prc ! 1000 lit mzero ;

\ hpoke  every other started hart woken: a thread is ready.
: hpoke  hmax @ 0 lit do i mhartid@ <> if i hup harr @ if i ipi then then loop ;

\ max ( a b -- larger )  unsigned.
: max  2dup u< if swap then drop ;


\ thnew ( -- t | 0 ), prnew ( -- p | 0 )  a free slot.
: thnew
0 lit MAXT 0 lit do dup 0= if i thn dup tstate over DC lit + @ or 0= if nip else drop then then loop
dup if dup tid thi @ max thi ! then ;
: prnew
0 lit MAXP 0 lit do dup 0= if i prn dup @ 0= if nip else drop then then loop
dup if dup pid phi @ max phi ! then ;

: spe variable ;  : spp variable ;  : spt variable ;

\ pspawn ( name tickets parent -- pid | error )  a process running a
\ program of the image, its one thread ready.  Under klk.  -2: no such
\ program, -11: no room in the tables, -12: no memory.
: pspawn
rot pfind dup spe !
0= if 2drop FFFFFFFE lit else
prnew dup spp ! 0= if 2drop FFFFFFF5 lit else
thnew dup spt ! 0= if 2drop FFFFFFF5 lit else
spe @ 18 lit + @ FFF lit + C lit rshift dup pgalloc
dup 0= if 2drop 2drop FFFFFFF4 lit else
	dup 2 lit pick C lit lshift mzero
	spp @ 40 lit mzero
	spp @ 10 lit + !
	spp @ 14 lit + !
	spp @ 4 lit + !
	dup spp @ 20 lit + !
	spe @ spp @ 24 lit + !
	spe @ 10 lit + @ 80000000 lit + spp @ 18 lit + !
	spp @ 18 lit + @ spe @ 14 lit + @ + spp @ 1C lit + !
	1 lit spp @ C lit + !
	1 lit spp @ !
	spt @ 100 lit mzero
	spt @ B8 lit + !
	spp @ spt @ B4 lit + !
	spp @ 18 lit + @ dup spt @ ! spt @ A0 lit + !
	spp @ 1C lit + @ spt @ A4 lit + !
	spp @ 10 lit + @ dup spt @ A8 lit + ! spt @ 28 lit + !
	spp @ 10 lit + @ spp @ 14 lit + @ C lit lshift + dup spt @ AC lit + ! spt @ 2C lit + !
	1 lit spt @ tstate!
	hpoke
	spp @ pid
then then then then ;

\ thart ( t -- h+1 | 0 )  the hart running it.
: thart  0 lit hmax @ 0 lit do i hcur harr @ 2 lit pick = if drop i 1 lit + then loop nip ;

\ preap ( child t -- )  an ended child's status given to t, a thread of
\ its parent waiting for it (t 0: nobody), and its slot freed.
: preap
dup if
	over pid over 28 lit + !
	dup D0 lit + @ ?dup if 2 lit pick 8 lit + @ swap ! then
	0 lit over D4 lit + !
	1 lit swap tstate!
else drop then
0 lit swap ! ;

\ pwaiter ( child -- t | 0 )  a thread of its parent waiting for it.
: pwaiter
0 lit
thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 1 lit = and
		over tproc 4 lit pick 4 lit + @ 1 lit - prn = and
		if dup C0 lit + @ dup FFFFFFFF lit = swap 4 lit pick pid = or if nip else drop then else drop then
	then
loop
nip ;

\ pfinish ( p -- )  its last thread has ended: its memory back, its
\ unjoined threads' slots free, its children given to the kernel (those
\ ended, freed), and its parent told (the kernel says so on the console).
: pfinish
dup 10 lit + @ over 14 lit + @ pgfree
thi @ 0 lit do
	i thn dup tproc 2 lit pick = over tstate 6 lit = and if
		dup DC lit + @ if 7 lit else 0 lit then swap tstate!
	else drop then
loop
phi @ 0 lit do
	i prn dup @ if
		dup 4 lit + @ 2 lit pick pid = if
			dup @ 2 lit = if 0 lit swap ! else 0 lit swap 4 lit + ! then
		else drop then
	else drop then
loop
2 lit over !
dup 4 lit + @ 0= if
	"kernel: " puts dup 24 lit + @ puts " ended: " puts dup 8 lit + @ . 0A lit putc
	0 lit swap !
else
	dup pwaiter ?dup if preap hpoke else drop then
then ;

\ tdead ( t -- )  a thread gone; its process finished with its last.
: tdead
0 lit over tstate!
tproc dup C lit + @ 1 lit - dup 2 lit pick C lit + !
0= if pfinish else drop then ;


\ pexit ( p code -- )  a process ends: its threads not running gone now,
\ those running stopped at their next trap (a software interrupt brings
\ one), then gone too.  Under klk.
: pexit
over 8 lit + !
1 lit over 28 lit + !
thi @ 0 lit do
	i thn dup tproc 2 lit pick = if
		dup tstate 2 lit = if
			thart ?dup if 1 lit - ipi then
		else
			dup tstate dup 0= over 6 lit = or swap 7 lit = or if drop else tdead then
		then
	else drop then
loop
drop ;

\ runnable ( t -- ok )  ready, or asleep or waiting with a time limit and
\ its time come.
: runnable
dup DC lit + @ if drop 0 lit else
dup tstate
dup 1 lit = if 2drop 1 lit else
dup 3 lit = swap 4 lit = 2 lit pick D8 lit + @ and or if
	BC lit + @ mtime@ swap - 0< 0=
else drop 0 lit then then then ;

\ rndbelow ( n -- r )  0 to n-1, at random (a mask, drawn again past n:
\ there is no division here worth having).
: rndbelow
1 lit begin 2dup u> while 1 lit lshift repeat 1 lit -
begin rnd over and dup 3 lit pick u< 0= while drop repeat
nip nip ;

\ tgo ( t -- t )  claimed to run: a wait whose time ran out returns -110.
: tgo
1 lit over DC lit + !
dup tstate 4 lit = if FFFFFF92 lit over 28 lit + ! then
0 lit over D8 lit + !  0 lit over D4 lit + !
2 lit over tstate! ;

\ tpick ( -- t | 0 )  the lottery: a runnable thread, each with the chance
\ of its tickets over all theirs.  Under klk.
: tpick
0 lit thi @ 0 lit do i thn dup runnable if B8 lit + @ + else drop then loop
?dup 0= if 0 lit else
	rndbelow
	0 lit swap
	thi @ 0 lit do
		over 0= if
			i thn dup runnable if
				B8 lit + @ 2dup u< if drop nip i thn swap else - then
			else drop then
		then
	loop
	drop
	dup if tgo then
then ;

\ trun ( t -- )  the thread run on this hart, in user mode, until it traps
\ back to stay (the entry then goes on here, after the mret).  Interrupts
\ are off while mscratch is the thread's: one taken in machine mode then
\ would save the kernel's registers over the thread's.
: trun
kdi
dup mhartid@ hcur harr !
mscr!
upmp
F3220034 ,   \ csrrs t0,mscratch,zero
23A02208 ,   \ sw sp,128(t0)              ( the kernel's stacks, for its traps )
23A28209 ,   \ sw s8,132(t0)
23A4A209 ,   \ sw s10,136(t0)
23A6B209 ,   \ sw s11,140(t0)
23A83208 ,   \ sw gp,144(t0)
17030000 ,   \ auipc t1,0x0
1303830A ,   \ addi t1,t1,168             ( past the mret: where it comes back )
23AA6208 ,   \ sw t1,148(t0)
03A30200 ,   \ lw t1,0(t0)
73101334 ,   \ csrrw zero,mepc,t1         ( its pc )
37230000 ,   \ lui t1,0x2
13030380 ,   \ addi t1,t1,-2048
73300330 ,   \ csrrc zero,mstatus,t1      ( MPP: user mode )
13030008 ,   \ addi t1,zero,128
73200330 ,   \ csrrs zero,mstatus,t1      ( MPIE: interrupts on in it )
83A04200 ,   \ lw ra,4(t0)                ( its registers )
03A18200 ,   \ lw sp,8(t0)
83A1C200 ,   \ lw gp,12(t0)
03A20201 ,   \ lw tp,16(t0)
03A38201 ,   \ lw t1,24(t0)
83A3C201 ,   \ lw t2,28(t0)
03A40202 ,   \ lw s0,32(t0)
83A44202 ,   \ lw s1,36(t0)
03A58202 ,   \ lw a0,40(t0)
83A5C202 ,   \ lw a1,44(t0)
03A60203 ,   \ lw a2,48(t0)
83A64203 ,   \ lw a3,52(t0)
03A78203 ,   \ lw a4,56(t0)
83A7C203 ,   \ lw a5,60(t0)
03A80204 ,   \ lw a6,64(t0)
83A84204 ,   \ lw a7,68(t0)
03A98204 ,   \ lw s2,72(t0)
83A9C204 ,   \ lw s3,76(t0)
03AA0205 ,   \ lw s4,80(t0)
83AA4205 ,   \ lw s5,84(t0)
03AB8205 ,   \ lw s6,88(t0)
83ABC205 ,   \ lw s7,92(t0)
03AC0206 ,   \ lw s8,96(t0)
83AC4206 ,   \ lw s9,100(t0)
03AD8206 ,   \ lw s10,104(t0)
83ADC206 ,   \ lw s11,108(t0)
03AE0207 ,   \ lw t3,112(t0)
83AE4207 ,   \ lw t4,116(t0)
03AF8207 ,   \ lw t5,120(t0)
83AFC207 ,   \ lw t6,124(t0)
83A24201 ,   \ lw t0,20(t0)
73002030 ,   \ mret
mhartid@ harea harr @ mscr!
kei ;

\ tafter ( t -- )  a thread back from running: gone if its process is
\ ending, ready again if its slice ran out (or it yielded).
: tafter
klk @ lock
0 lit over DC lit + !
dup tstate 7 lit = if 0 lit swap tstate! else
dup tproc 28 lit + @ if
	dup tstate dup 0= swap 6 lit = or if drop else tdead then
else
	dup tstate 2 lit = if 1 lit over tstate! then
	tstate 1 lit = if hpoke then
then then
klk @ unlock ;

: kready variable ;          \ the tables made: threads may be run

\ hstep  one turn of a hart's loop: a test job asked of it, or (once the
\ kernel is ready) a thread, or sleep until an interrupt.
: hstep
mhartid@ hjob harr @ ?dup if
	hrun fence 0 lit mhartid@ hjob harr !
else
	kready @ if klk @ lock tpick klk @ unlock else 0 lit then
	?dup if
		trun
		mhartid@ hcur harr @  0 lit mhartid@ hcur harr !  tafter
	else
		wfi
	then
then ;

: hloop  begin hstep 0 lit until ;                          \ for good
: hrunfor  mtime@ + begin hstep dup mtime@ - 0< until drop ;  \ ( ticks -- ) for a while

\ kspawn ( name tickets -- pid | error )  a process the kernel starts.
: kspawn  klk @ lock 0 lit pspawn klk @ unlock ;

\ ── System calls ──
\
\ Each runs in the trap from user mode, area@ the calling thread; it sets
\ the result (a0) and the pc past the ecall (sret), or stops the thread
\ (tblock: it waits; tstop: its slice or its life is over).  Pointers it is
\ given are checked to be the process's.  The result goes in a0, where the
\ first argument came: set it only once the arguments are read.

: sret    sysret mepc@ 4 lit + mepc! ;                         \ ( v -- )
: tblock  area@ tstate!  mepc@ 4 lit + area@ !  1 lit area@ 98 lit + ! ;   \ ( state -- )
: tstop   mepc@ area@ !  1 lit area@ 98 lit + ! ;
: uword   dup 3 lit and 0= swap 4 lit urange and ;          \ ( addr -- ok ) an aligned word of its

\ ustr ( addr -- ok )  a NUL-terminated name of at most 15 bytes, its own.
: ustr
1 lit 0 lit
10 lit 0 lit do
	dup 0= if
		2 lit pick i + 1 lit urange 0= if 2drop 0 lit 1 lit else
		2 lit pick i + c@ 0= if drop 1 lit then then
	then
loop
0= if drop 0 lit then
nip ;

\ 1 exit(code): the process ends.
: sexit  klk @ lock cproc 28 lit sysarg pexit klk @ unlock tstop ;

\ 2 spawn(name): a child running that program, with this one's tickets.
: sspawn
28 lit sysarg ustr 0= if FFFFFFF2 lit sret else
	klk @ lock 28 lit sysarg cproc 20 lit + @ cproc pid pspawn klk @ unlock sret
then ;

\ 3 wait(pid, &status): a child's end (pid -1: any child's); its pid.
: swait
2C lit sysarg dup if uword 0= else drop 0 lit then if FFFFFFF2 lit sret else
klk @ lock
0 lit
phi @ 0 lit do
	dup 0= if
		i prn dup @ 2 lit = over 4 lit + @ cproc pid = and
		over pid 28 lit sysarg = 28 lit sysarg FFFFFFFF lit = or and
		if nip else drop then
	then
loop
?dup if
	dup 8 lit + @ 2C lit sysarg ?dup if ! else drop then
	dup pid swap 0 lit swap !
	klk @ unlock sret
else
	0 lit phi @ 0 lit do i prn dup @ 1 lit = swap 4 lit + @ cproc pid = and or loop
	if
		28 lit sysarg area@ C0 lit + !
		2C lit sysarg area@ D0 lit + !
		1 lit area@ D4 lit + !
		4 lit tblock klk @ unlock
	else
		klk @ unlock FFFFFFF6 lit sret
	then
then then ;

\ 4 thread(entry, stack, arg): a thread of this process at entry, its stacks
\ the 16 KiB below stack (loop frames, return ids, then its data stack), its
\ variables and heap this thread's; its argument in a0.
: sthread
28 lit sysarg dup 4 lit + area@ A0 lit + @ area@ A4 lit + @ inr
2C lit sysarg dup 4000 lit - swap area@ A8 lit + @ area@ AC lit + @ inr and
0= if FFFFFFF2 lit sret else
klk @ lock
thnew ?dup 0= if klk @ unlock FFFFFFF5 lit sret else
	dup 100 lit mzero
	area@ A0 lit + over A0 lit + 10 lit mcpy
	area@ tproc over B4 lit + !
	area@ B8 lit + @ over B8 lit + !
	28 lit sysarg over !
	2C lit sysarg dup 2000 lit - 2 lit pick 8 lit + !
	dup 2 lit pick 60 lit + !
	1000 lit - over 6C lit + !
	area@ 68 lit + @ over 68 lit + !
	area@ C lit + @ over C lit + !
	30 lit sysarg over 28 lit + !
	cproc C lit + dup @ 1 lit + swap !
	1 lit over tstate!
	tid klk @ unlock hpoke sret
then then ;

\ 5 thread_exit(value): this thread ends; a thread joining it gets value.
: stexit
klk @ lock
28 lit sysarg area@ CC lit + !
0 lit thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 2 lit = and
		over tproc cproc = and over C0 lit + @ area@ tid = and
		if nip else drop then
	then
loop
?dup if
	28 lit sysarg over 28 lit + !  0 lit over D4 lit + !  1 lit swap tstate!
	7 lit area@ tstate!
	hpoke
else
	6 lit area@ tstate!
then
cproc C lit + dup @ 1 lit - tuck swap !
0= if cproc pfinish then
klk @ unlock
mepc@ area@ !  1 lit area@ 98 lit + ! ;

\ 6 join(tid): a thread of this process ended: what it ended with.
: sjoin
28 lit sysarg dup 1 lit - MAXT u< 0= if drop FFFFFFFD lit sret else
1 lit - thn
klk @ lock
dup tstate 0= over tproc cproc <> or over area@ = or if drop klk @ unlock FFFFFFFD lit sret else
dup tstate 6 lit = if
	dup CC lit + @ swap dup DC lit + @ if 7 lit else 0 lit then swap tstate! klk @ unlock sret
else
	tid area@ C0 lit + !  2 lit area@ D4 lit + !  4 lit tblock klk @ unlock
then then then ;

\ 7 yield: the rest of its slice given up.
: syield  0 lit sysret mepc@ 4 lit + area@ !  1 lit area@ 98 lit + ! ;

\ 8 sleep(ns)
: ssleep  28 lit sysarg 64 lit / mtime@ + area@ BC lit + ! 0 lit sysret 3 lit tblock ;

\ 9 lock(addr): a mutex, the word at addr (0 free); the atomic part done
\ here.  Waits while it is held.
: slock
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg @ 0= if
	1 lit 28 lit sysarg ! klk @ unlock 0 lit sret
else
	28 lit sysarg area@ C0 lit + ! 3 lit area@ D4 lit + ! 0 lit sysret 4 lit tblock klk @ unlock
then then ;

\ twaiter ( addr kind -- t | 0 )  a thread of the calling process waiting
\ on addr in that kind of wait.
: twaiter
0 lit thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 4 lit pick = and
		over tproc cproc = and over C0 lit + @ 5 lit pick = and
		if nip else drop then
	then
loop
nip nip ;

\ 10 unlock(addr): handed to a thread waiting for it, if one is.
: sunlock
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg 3 lit twaiter ?dup if
	0 lit over D4 lit + !  1 lit swap tstate!  klk @ unlock hpoke
else
	0 lit 28 lit sysarg !  klk @ unlock
then
0 lit sret then ;

\ 11 await(addr, expected, ns): waits while the word at addr is expected
\ (0, or -11 if it already is not; ns 0: no limit, else -110 when it runs
\ out).
: sawait
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg @ 2C lit sysarg <> if klk @ unlock FFFFFFF5 lit sret else
	28 lit sysarg area@ C0 lit + !  4 lit area@ D4 lit + !
	30 lit sysarg ?dup if 64 lit / mtime@ + area@ BC lit + !  1 lit area@ D8 lit + ! then
	0 lit sysret
	4 lit tblock klk @ unlock
then then ;

\ 12 wake(addr, n): up to n threads awaiting addr woken; how many.
: swake
klk @ lock
0 lit
begin dup 2C lit sysarg u< if 28 lit sysarg 4 lit twaiter else 0 lit then ?dup while
	0 lit over D4 lit + !  0 lit over D8 lit + !  1 lit swap tstate!  1 lit +
repeat
klk @ unlock dup if hpoke then sret ;

\ 17 write(fd, buf, n): to the console, for fds 1 and 2.
: kwrite
28 lit sysarg dup 1 lit = swap 2 lit = or 0= if FFFFFFF7 lit sret else
2C lit sysarg 30 lit sysarg urange 0= if FFFFFFF2 lit sret else
	30 lit sysarg ?dup if 2C lit sysarg swap 0 lit do dup i + c@ putc loop drop then
	30 lit sysarg sret
then then ;

\ ksys  a system call (ecall from user mode): the number in a7.
: ksys
44 lit sysarg
dup 1 lit = if drop sexit else
dup 2 lit = if drop sspawn else
dup 3 lit = if drop swait else
dup 4 lit = if drop sthread else
dup 5 lit = if drop stexit else
dup 6 lit = if drop sjoin else
dup 7 lit = if drop syield else
dup 8 lit = if drop ssleep else
dup 9 lit = if drop slock else
dup A lit = if drop sunlock else
dup B lit = if drop sawait else
dup C lit = if drop swake else
11 lit = if kwrite else FFFFFFDA lit sret
then then then then then then then then then then then then then ;

\ ukill  an exception in user mode: the process ends (-1), the system goes on.
: ukill
"kernel: process killed: trap " puts mcause@ u.x
" at " puts mepc@ u.x " (" puts mtval@ u.x ")" puts 0A lit putc
klk @ lock cproc FFFFFFFF lit pexit klk @ unlock tstop ;

\ kipi  a software interrupt: cleared, and counted (what it asks is in the
\ hart's job word, or the thread's process ending).
: kipi  msipclr mhartid@ hipi harr dup @ 1 lit + swap ! ;

\ ktrap  what the entry calls, with every register saved.  Interrupts are
\ taken from either mode: a timer's ends a thread's slice (counted to it),
\ a software interrupt stops a thread whose process is ending.  An
\ exception from user mode is the thread's (a system call, or its end),
\ from the kernel a bug.
: ktrap
mcause@
dup 80000007 lit = if drop ktick mpp@ 0= if area@ C4 lit + dup @ 1 lit + swap ! tstop then else
dup 80000003 lit = if drop kipi mpp@ 0= if cproc 28 lit + @ if tstop then then else
mpp@ if drop kfault else
8 lit = if ksys else ukill then
then then then ;

\ [skip ... skip]  compile the code between where it is but jump over it.
:I [skip  here ,j0 ;
:I skip]  jpat! ;

: trapvec variable ;         \ the entry, for the harts started later

\ trapinit  the trap entry: mscratch holds the area (a hart's, 256 bytes,
\ or the running thread's control block) where the entry saves x1-x31 (x5
\ by way of mscratch itself) before calling ktrap, and from where it
\ restores them for mret.  A trap from user mode runs ktrap on the
\ kernel's stacks, as trun saved them; when ktrap stops the thread (152
\ set), the entry goes on where trun left off rather than back to it.  mtvec points at the
\ entry, 16 bytes past the auipc (auipc, addi, csrw, and [skip's jump).
: trapinit
kvars
100 lit alloc
