\ ksys.fam — the OS's kernel (docs/OS.md), its last part: the system
\ calls, the trap handler and entry, starting the harts, and kboot; after
\ src/kernel.fam, src/store.fam and src/net.fam, whose words it uses.  The kernel's Test
\ blocks are at the end.

\ ── System calls ──
\
\ Each runs in the trap from user mode, area@ the calling thread; it sets
\ the result (a0) and the pc past the ecall (sret), or stops the thread
\ (tblock: it waits; tstop: its slice or its life is over).  Pointers it is
\ given are checked to be the process's.  The result goes in a0, where the
\ first argument came: set it only once the arguments are read.

: sret    sysret mepc@ 4 lit + mepc!  0 lit area@ E0 lit + ! ;   \ ( v -- )
\ tretry ( token kind -- )  the call waits (kind 5 on token, 6 a poll) and
\ runs again when woken: its pc stays on the ecall, its arguments in place.
: tretry  area@ D4 lit + !  area@ C0 lit + !  1 lit area@ E0 lit + !  4 lit area@ tstate!  mepc@ area@ !  1 lit area@ 98 lit + ! ;
: tblock  area@ tstate!  mepc@ 4 lit + area@ !  1 lit area@ 98 lit + ! ;   \ ( state -- )
: tstop   mepc@ area@ !  1 lit area@ 98 lit + ! ;
: uword   dup 3 lit and 0= swap 4 lit uwrange and ;          \ ( addr -- ok ) an aligned word of its

\ ustr ( addr -- ok )  a NUL-terminated name of at most 63 bytes, its own.
: ustr
1 lit 0 lit
40 lit 0 lit do
	dup 0= if
		2 lit pick i + 1 lit urange 0= if 2drop 0 lit 1 lit else
		2 lit pick i + c@ 0= if drop 1 lit then then
	then
loop
0= if drop 0 lit then
nip ;

\ 1 exit(code): the process ends.
: sexit  klk @ lock cproc 28 lit sysarg pexit klk @ unlock tstop ;

\ uargl ( src -- len | 0 )  arguments a program gave (strings NUL-ended, an
\ empty one last, at most 1 KiB, the first not empty): their length, the
\ empty one's NUL included; 0 if they are not such, or not its.
: uargl
dup 1 lit urange 0= if drop 0 lit else dup c@ 0= if drop 0 lit else
0 lit swap
400 lit 1 lit do
	over 0= if
		dup i + 1 lit urange 0= if nip FFFFFFFF lit swap else
		dup i + c@ 0= over i + 1 lit - c@ 0= and if nip i 1 lit + swap then then
	then
loop
drop dup FFFFFFFF lit = if drop 0 lit then
then then ;

: sal variable ;             \ the arguments' length, spawn checked

\ sfds? ( -- ok )  spawn's fds: 0, or its own word count n (at most 32)
\ then n descriptors of the caller's, or -1 (the child's closed).
: sfds?
30 lit sysarg ?dup 0= if 1 lit else
	dup 4 lit urange 0= if drop 0 lit else
	dup @ 20 lit u> if drop 0 lit else
	dup dup @ 1 lit + 2 lit lshift urange 0= if drop 0 lit else
		1 lit swap
		dup @ ?dup if 0 lit do
			dup i 1 lit + 2 lit lshift + @ dup FFFFFFFF lit = if drop else ufd 0= if nip 0 lit swap then then
		loop then
		drop
	then then then then ;

\ pfdset ( p -- )  the child's descriptors: spawn's fds, or the caller's
\ 0, 1 and 2.
: pfdset
30 lit sysarg ?dup 0= if
	3 lit 0 lit do i ufd ?dup if dup 4 lit + dup @ 1 lit + swap !  over i swap pfd ! then loop drop
else
	dup @ ?dup if 0 lit do
		dup i 1 lit + 2 lit lshift + @ dup FFFFFFFF lit = if drop else
			ufd dup 4 lit + dup @ 1 lit + swap !  2 lit pick i swap pfd !
		then
	loop then
	2drop
then ;

\ pargs ( p -- )  the child's arguments: spawn's, or its name alone.
: pargs
10 lit + @ 5000 lit +
2C lit sysarg if
	sal @ ?dup if 0 lit do 2C lit sysarg i + c@ over 4 lit + i + c! loop then
	sal @
else
	0 lit begin 28 lit sysarg over + c@ ?dup while 2 lit pick 4 lit + 2 lit pick + c! 1 lit + repeat
	2 lit +
then
3 lit + FFFFFFFC lit and swap ! ;

\ pusr ( p -- )  the child's user and group the caller's.
: pusr  cproc C4 lit + @ over C4 lit + !  cproc C8 lit + @ swap C8 lit + ! ;

\ pcwd ( p -- )  the child's working directory the caller's (a copy).
: pcwd  cproc C0 lit + @ ?dup if 1 lit pgalloc ?dup if tuck 1000 lit mcpy swap C0 lit + ! else 2drop then else drop then ;

\ binp ( name -- name' )  past a leading /bin/ (the image's programs are
\ /bin's); a byte at a time, none read past the name's end.
: binp
dup c@ 2F lit = if dup 1 lit + c@ 62 lit = if dup 2 lit + c@ 69 lit = if
dup 3 lit + c@ 6E lit = if dup 4 lit + c@ 2F lit = if 5 lit + then then then then then ;


\ 3 wait(pid, &status): a child's end (pid -1: any child's); its pid.
: swait
2C lit sysarg dup if uword 0= else drop 0 lit then if FFFFFFF2 lit sret else
klk @ lock
0 lit
phi @ 0 lit do
	dup 0= if
		i prn dup @ 2 lit = over 4 lit + @ cproc pid = and
		over pid 28 lit sysarg = 28 lit sysarg FFFFFFFF lit = or and
		if nip else drop then
	then
loop
?dup if
	dup 8 lit + @ 2C lit sysarg ?dup if ! else drop then
	dup pid swap pslot0
	klk @ unlock sret
else
	0 lit phi @ 0 lit do i prn dup @ 1 lit = swap 4 lit + @ cproc pid = and or loop
	if
		28 lit sysarg area@ C0 lit + !
		2C lit sysarg area@ D0 lit + !
		1 lit area@ D4 lit + !
		4 lit tblock klk @ unlock
	else
		klk @ unlock FFFFFFF6 lit sret
	then
then then ;

\ 4 thread(entry, stack, arg): a thread of this process at entry, its stacks
\ the 16 KiB below stack (loop frames, return ids, then its data stack), its
\ variables and heap this thread's; its argument in a0.
: sthread
28 lit sysarg dup 4 lit + area@ A0 lit + @ area@ A4 lit + @ inr
2C lit sysarg dup 4000 lit - swap area@ A8 lit + @ area@ AC lit + @ inr and
0= if FFFFFFF2 lit sret else
klk @ lock
thnew ?dup 0= if klk @ unlock FFFFFFF5 lit sret else
	dup 100 lit mzero
	area@ A0 lit + over A0 lit + 10 lit mcpy
	area@ tproc over B4 lit + !
	area@ B8 lit + @ over B8 lit + !
	28 lit sysarg over !
	2C lit sysarg dup 2000 lit - 2 lit pick 8 lit + !
	dup 2 lit pick 60 lit + !
	1000 lit - over 6C lit + !
	area@ 68 lit + @ over 68 lit + !
	area@ C lit + @ over C lit + !
	30 lit sysarg over 28 lit + !
	cproc C lit + dup @ 1 lit + swap !
	1 lit over tstate!
	tid klk @ unlock hpoke sret
then then ;

\ 5 thread_exit(value): this thread ends; a thread joining it gets value.
: stexit
klk @ lock
28 lit sysarg area@ CC lit + !
0 lit thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 2 lit = and
		over tproc cproc = and over C0 lit + @ area@ tid = and
		if nip else drop then
	then
loop
?dup if
	28 lit sysarg over 28 lit + !  0 lit over D4 lit + !  1 lit swap tstate!
	7 lit area@ tstate!
	hpoke
else
	6 lit area@ tstate!
then
cproc C lit + dup @ 1 lit - tuck swap !
0= if cproc pfinish then
klk @ unlock
mepc@ area@ !  1 lit area@ 98 lit + ! ;

\ 6 join(tid): a thread of this process ended: what it ended with.
: sjoin
28 lit sysarg dup 1 lit - MAXT u< 0= if drop FFFFFFFD lit sret else
1 lit - thn
klk @ lock
dup tstate 0= over tproc cproc <> or over area@ = or if drop klk @ unlock FFFFFFFD lit sret else
dup tstate 6 lit = if
	dup CC lit + @ swap dup DC lit + @ if 7 lit else 0 lit then swap tstate! klk @ unlock sret
else
	tid area@ C0 lit + !  2 lit area@ D4 lit + !  4 lit tblock klk @ unlock
then then then ;

\ 7 yield: the rest of its slice given up.
: syield  0 lit sysret mepc@ 4 lit + area@ !  1 lit area@ 98 lit + ! ;

\ 8 sleep(ns)
: ssleep  28 lit sysarg 64 lit / mtime@ + area@ BC lit + ! 0 lit sysret 3 lit tblock ;

\ 9 lock(addr): a mutex, the word at addr (0 free); the atomic part done
\ here.  Waits while it is held.
: slock
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg @ 0= if
	1 lit 28 lit sysarg ! klk @ unlock 0 lit sret
else
	28 lit sysarg area@ C0 lit + ! 3 lit area@ D4 lit + ! 0 lit sysret 4 lit tblock klk @ unlock
then then ;

\ twaiter ( addr kind -- t | 0 )  a thread of the calling process waiting
\ on addr in that kind of wait.
: twaiter
0 lit thi @ 0 lit do
	dup 0= if
		i thn dup tstate 4 lit = over D4 lit + @ 4 lit pick = and
		over tproc cproc = and over C0 lit + @ 5 lit pick = and
		if nip else drop then
	then
loop
nip nip ;

\ 10 unlock(addr): handed to a thread waiting for it, if one is.
: sunlock
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg 3 lit twaiter ?dup if
	0 lit over D4 lit + !  1 lit swap tstate!  klk @ unlock hpoke
else
	0 lit 28 lit sysarg !  klk @ unlock
then
0 lit sret then ;

\ 11 await(addr, expected, ns): waits while the word at addr is expected
\ (0, or -11 if it already is not; ns 0: no limit, else -110 when it runs
\ out).
: sawait
28 lit sysarg uword 0= if FFFFFFF2 lit sret else
klk @ lock
28 lit sysarg @ 2C lit sysarg <> if klk @ unlock FFFFFFF5 lit sret else
	28 lit sysarg area@ C0 lit + !  4 lit area@ D4 lit + !
	30 lit sysarg ?dup if 64 lit / mtime@ + area@ BC lit + !  1 lit area@ D8 lit + ! then
	0 lit sysret
	4 lit tblock klk @ unlock
then then ;

\ 12 wake(addr, n): up to n threads awaiting addr woken; how many.
: swake
klk @ lock
0 lit
begin dup 2C lit sysarg u< if 28 lit sysarg 4 lit twaiter else 0 lit then ?dup while
	0 lit over D4 lit + !  0 lit over D8 lit + !  1 lit swap tstate!  1 lit +
repeat
klk @ unlock dup if hpoke then sret ;

\ prefresh  the other harts running a thread of this process told to
\ reload their PMP (a block was mapped or unmapped), by a software
\ interrupt, each marked stale until it has; this hart does it itself
\ (the caller).
: prefresh
hmax @ 0 lit do
	i mhartid@ <> if
		i hcur harr @ ?dup if tproc cproc = if 1 lit i hstale harr ! fence i ipi then then
	then
loop ;

\ pwait  until no other hart is marked stale: none can reach a block just
\ unmapped, so its pages may go back.  Without klk (a hart marked may be
\ waiting for it, interrupts off); this hart's own mark, from another's
\ unmap, it clears itself, so two waiting on each other both go on.
: pwait
begin
	fence
	mhartid@ hstale harr @ if hfresh then
	1 lit hmax @ 0 lit do i mhartid@ <> if i hstale harr @ if drop 0 lit then then loop
until ;

\ mslot ( addr -- slot | 0 )  the process's map slot whose first byte is
\ addr, or 0.  An empty slot's is 0, so addr 0 finds the first empty one.
: mslot
0 lit swap
4 lit 0 lit do
	over 0= if
		i 3 lit lshift cproc 30 lit + +
		dup @ 2 lit pick = if rot drop swap else drop then
	then
loop
drop ;

: mpages variable ;  : msl variable ;

\ 13 map(bytes): a block of that many bytes (rounded up to pages), zeroed,
\ in one of the process's 4 slots; its first byte, or 0 (bytes 0, no free
\ slot, or no memory): 0 is never a mapped address, and a RAM address has
\ its high bit set, so the caller cannot tell map's errors by sign.
: smap
28 lit sysarg dup 0= if drop 0 lit sret else
FFF lit + C lit rshift mpages !
klk @ lock
0 lit mslot dup msl ! 0= if klk @ unlock 0 lit sret else
	mpages @ pgalloc dup 0= if drop klk @ unlock 0 lit sret else
		dup mpages @ C lit lshift mzero
		dup msl @ !
		dup mpages @ C lit lshift + msl @ 4 lit + !
		upmp prefresh
		klk @ unlock sret
	then
then then ;

\ 14 unmap(addr): the block at addr given back; 0, or -22.  Its pages go
\ back only once every hart running a thread of the process has reloaded
\ its PMP, so none can touch them once they are another's.
: sunmap
28 lit sysarg
klk @ lock
mslot dup 0= if drop klk @ unlock FFFFFFEA lit sret else
	dup @ swap dup 4 lit + @ 2 lit pick - C lit rshift swap   \ ( first pages slot )
	0 lit over !  0 lit swap 4 lit + !
	upmp prefresh
	klk @ unlock
	pwait
	klk @ lock pgfree klk @ unlock
	0 lit sret
then ;

\ ── Descriptors: open, read, write, close, pipe, poll (docs/OS.md, 5) ──
\
\ Under klk throughout.  A handler gives a result, or BLK when it waited
\ (tretry), for the call to run again when woken.

:M BLK 7FFFFFFF lit ;

: kpb variable ;             \ a path, copied in (64 bytes)

\ upath ( addr -- ok )  a NUL-ended path of the process's, at most 63
\ bytes, copied to kpb.
: upath
1 lit 0 lit
40 lit 0 lit do
	dup 0= if
		2 lit pick i + 1 lit urange 0= if 2drop 0 lit 1 lit else
		2 lit pick i + c@ dup i kpb @ + c! 0= if drop 1 lit then then
	then
loop
0= if drop 0 lit then
nip ;

\ kpfx ( s prefix -- rest | 0 )  s begins with prefix: what follows it.
: kpfx
begin dup c@ if over c@ over c@ = else 0 lit then while 1 lit + swap 1 lit + swap repeat
dup c@ if 2drop 0 lit else drop then ;

\ kvpath ( -- ok )  open's path made absolute (by the working directory,
\ when it does not begin with /) and plain ("" and "." dropped, ".." back
\ one; a final / kept) into kpb, 62 bytes at most: so /bin, /dev and
\ /proc are found by any path to them (bin from the root, ../dev).  Under
\ klk.
: kvb variable ;  : kvn variable ;  : kvl variable ;  : kva variable ;  : kve variable ;  : kvt variable ;
\ kcomp ( a n -- ok )  one name onto kpb (kvn long).
: kcomp
dup 0= if 2drop 1 lit else
dup 1 lit = if over c@ 2E lit = else 0 lit then if 2drop 1 lit else
dup 2 lit = if over c@ 2E lit = 2 lit pick 1 lit + c@ 2E lit = and else 0 lit then if
	2drop kvn @ begin dup if kpb @ over 1 lit - + c@ 2F lit <> else 0 lit then while 1 lit - repeat
	dup if 1 lit - then kvn !  1 lit
else
	kvn @ over + 1 lit + 3E lit u> if 2drop 0 lit else
		kvl !  2F lit kpb @ kvn @ + c!  kvn @ 1 lit + kvn !
		kpb @ kvn @ + kvl @ bcpy  kvn @ kvl @ + kvn !  1 lit
	then
then then then ;
\ kcomps ( a n -- ok )  each name of a path (/ between) onto kpb.
: kcomps
over + kve ! kva !  1 lit
begin kva @ kve @ u< over and while
	kva @ begin dup kve @ u< if dup c@ 2F lit <> else 0 lit then while 1 lit + repeat
	kva @ over kva @ - kcomp  rot and swap
	1 lit + kva !
repeat ;
: kvpath
28 lit sysarg upath 0= if 0 lit else
	kpb @ kvb @ 40 lit bcpy  0 lit kvn !  1 lit
	kvb @ c@ 2F lit <> if cproc C0 lit + @ ?dup if dup 4 lit + swap @ kcomps and then then
	kvb @ 0 lit begin 2dup + c@ while 1 lit + repeat dup kvt ! kcomps and
	kvn @ 0= if 2F lit kpb @ c!  1 lit kvn ! else
		kvt @ if kvb @ kvt @ + 1 lit - c@ 2F lit = kvn @ 3E lit u< and if 2F lit kpb @ kvn @ + c!  kvn @ 1 lit + kvn ! then then
	then
	0 lit kpb @ kvn @ + c!
then ;

\ katoi ( s -- n rest )  a decimal number at s (0 if none).
: katoi
0 lit swap
begin dup c@ 30 lit - A lit u< while
	dup c@ 30 lit - rot dup 3 lit lshift swap 1 lit lshift + + swap 1 lit +
repeat ;

\ A /proc key's text, made when it is opened (a page, freed at its close).
: tb variable ;              \ where the text goes on
: tc  tb @ c!  tb @ 1 lit + tb ! ;                         \ ( c -- )
: ts  begin dup c@ ?dup while tc 1 lit + repeat drop ;      \ ( s -- )
: tn  dup A lit u< if 30 lit + tc else dup A lit / tn A lit % 30 lit + tc then ;   \ ( u -- )

\ ptext ( -- f | 0 )  an open file for a key's text, tb at its page.
: ptext
4 lit 1 lit fnew dup if
	1 lit pgalloc ?dup if over 8 lit + !  dup 8 lit + @ tb ! else 0 lit swap ! 0 lit then
then ;
: tbend  tb @ over 8 lit + @ - over 10 lit + ! ;            \ ( f -- f )  its length

\ pbusy ( p -- ok )  a thread of p ready or running.
: pbusy
0 lit thi @ 0 lit do
	i thn dup tproc 3 lit pick = swap tstate dup 1 lit = swap 2 lit = or and or
loop nip ;

\ pkib ( p -- KiB )  its memory and mapped blocks.
: pkib
dup 14 lit + @ swap 30 lit +
4 lit 0 lit do dup @ ?dup if over 4 lit + @ swap - C lit rshift rot + swap then 8 lit + loop
drop 2 lit lshift ;

\ pcmd ( p -- )  its arguments, spaced (an ended one's: its program's name).
: pcmd
dup @ 1 lit = if
	10 lit + @ 5000 lit +  dup @ dup 400 lit u> if drop 400 lit then
	0 lit swap ?dup if 0 lit do
		over 4 lit + i + c@ ?dup if swap if 20 lit tc then tc 0 lit else drop 1 lit then
	loop then
	2drop
else 24 lit + @ ts then ;

\ pstatus ( p -- )  one line: pid, parent, state (R running or ready, S
\ waiting, Z ended), threads, KiB, ticks run, arguments.
: pstatus
dup pid tn 20 lit tc
dup 4 lit + @ tn 20 lit tc
dup @ 2 lit = if 5A lit else dup pbusy if 52 lit else 53 lit then then tc 20 lit tc
dup C lit + @ tn 20 lit tc
dup @ 1 lit = if dup pkib else 0 lit then tn 20 lit tc
dup 50 lit + @ tn 20 lit tc
pcmd ;

: pp variable ;  : pk variable ;  : pq variable ;  : pm variable ;

\ ppath ( s -- )  "<pid>/<key>" or "self/<key>": pp the process (0: none
\ such), pk the key (1 status, 2 cmd, 3 tickets, 4 kill; 0 none).
: ppath
0 lit pp !  0 lit pk !
dup "self/" kpfx ?dup if nip area@ tproc pp ! else
	katoi swap
	dup 1 lit - MAXP u< if 1 lit - prn dup @ if pp ! else drop then else drop then
	dup c@ 2F lit = if 1 lit + else 0 lit pp ! then
then
dup "status" streq if 1 lit pk ! then
dup "cmd" streq if 2 lit pk ! then
dup "tickets" streq if 3 lit pk ! then
dup "cwd" streq if 5 lit pk ! then
dup "user" streq if 6 lit pk ! then
"kill" streq if 4 lit pk ! then ;

\ rtc0 ( -- s )  the date, seconds since 1970: QEMU's goldfish RTC (the
\ virt machine's, at 0x101000) gives nanoseconds, its low word read first
\ (which latches the high), divided by 10^9 a bit at a time.  The caller
\ holds klk (rtcsec takes it).
: rl variable ;  : rh variable ;  : rr variable ;  : rq variable ;
: rtc0
101000 lit @ rl !  101004 lit @ rh !  0 lit rr !  0 lit rq !
40 lit 0 lit do
	rr @ 1 lit lshift rh @ 1F lit rshift or rr !
	rh @ 1 lit lshift rl @ 1F lit rshift or rh !
	rl @ 1 lit lshift rl !
	rq @ 1 lit lshift rq !
	rr @ 3B9ACA00 lit u< 0= if rr @ 3B9ACA00 lit - rr !  rq @ 1 lit or rq ! then
loop
rq @ ;

\ pgen ( q -- )  key q's text, a newline last.
: pgen
dup 1 lit = if area@ tproc pid tn then
dup 2 lit = if nharts @ tn then
dup 3 lit = if pgfree# 2 lit lshift tn then
dup 4 lit = if 0 lit htick harr @ dup 64 lit / tn 2E lit tc 64 lit % dup A lit u< if 30 lit tc then tn then
dup 11 lit = if rtc0 tn then
dup 5 lit = if pp @ pstatus then
dup 6 lit = if pp @ pcmd then
dup A lit = if pp @ C4 lit + @ tn 20 lit tc pp @ C8 lit + @ tn then
dup 9 lit = if pp @ C0 lit + @ ?dup if dup 4 lit + swap @ ?dup if 0 lit do dup i + c@ tc loop then drop else 2F lit tc then then
dup 7 lit = if pp @ 20 lit + @ tn then
10 lit = if nk @ if "tcp " ts ctcpn tn " retransmits " ts nretx @ tn else "none" ts then then
A lit tc ;

\ popen ( s mode -- f | 0 | error )  a key under /proc: self, harts, mem
\ (KiB free), uptime (seconds), time (the date: seconds since 1970), net
\ (TCP's sockets in use, its
\ retransmissions), halt (written only, by root: the machine stops), and
\ <pid>/ status, cmd, tickets (also written: the process's tickets), kill
\ (written only: it ends, -9).
: popen
pm !  0 lit pq !  0 lit pp !
dup "self" streq if 1 lit pq ! then
dup "harts" streq if 2 lit pq ! then
dup "mem" streq if 3 lit pq ! then
dup "uptime" streq if 4 lit pq ! then
dup "time" streq if 11 lit pq ! then
dup "net" streq if 10 lit pq ! then
dup "halt" streq if B lit pq ! then
pq @ if drop else
	ppath
	pp @ if pk @ ?dup if 4 lit + pq ! then then
then
pq @ 0= if FFFFFFFE lit else
pq @ 7 lit u< 0= pq @ 10 lit u< and pm @ 1 lit <> and if
	5 lit 2 lit fnew dup if pp @ pid over 14 lit + !  pq @ 9 lit = if 3 lit else pq @ A lit = if 4 lit else pq @ 6 lit - then then over 18 lit + ! then
else
pq @ 8 lit = pq @ B lit = or pm @ 1 lit <> or if FFFFFFF3 lit else
	ptext dup if pq @ pgen tbend then
then then then ;

\ cuid ( -- uid ), cgid ( -- gid )  the calling process's user and group
\ (the kernel's own work: root's).
: cuid  kthr? if cproc C4 lit + @ else 0 lit then ;
: cgid  kthr? if cproc C8 lit + @ else 0 lit then ;

\ 39 tty(fd, op, arg): a terminal's settings (the console's, or a pty's
\ through either end): op 0 its mode (0 lines, 1 raw: each byte ready as
\ typed, not echoed, no editing), 1 the mode set to arg; op 2 its size
\ (rows * 65536 + columns; 0 not known, as the console's until set), 3
\ the size set to arg (wm, from its page).  -25 not a terminal, -22 a bad
\ op, -9 a bad descriptor.
: ttya  dup @ 1 lit = if drop cmode @ else dup @ 9 lit = over @ A lit = or if 8 lit + @ 28 lit + else drop 0 lit then then ;   \ ( f -- a | 0 )
: stty
klk @ lock
28 lit sysarg ufd ?dup 0= if FFFFFFF7 lit else
ttya ?dup 0= if FFFFFFE7 lit else
2C lit sysarg
dup 0= if drop @ 1 lit and else
dup 1 lit = if drop 30 lit sysarg 1 lit and over !  0 lit swap 4 lit + !  0 lit else
dup 2 lit = if drop 8 lit + @ else
3 lit = if 30 lit sysarg swap 8 lit + !  0 lit else drop FFFFFFEA lit
then then then then then then
klk @ unlock sret ;

\ ── Randomness: virtio-rng (legacy MMIO, one queue, one request at a time) ──
\
\ /dev/random (file kind C): the host's randomness, as the device gives it,
\ each byte handed out once.  A read takes what is ready (up to 256
\ bytes); with none, it asks the device and waits for its interrupt.
\ Writes are taken and dropped.

:M RNGQN 4 lit ;               \ descriptors (one is used)
: rngk    variable ;           \ the device's registers (0: none)
: rngq    variable ;           \ its queue: two pages
: rngav   variable ;           \ requests made
: rngbuf  variable ;           \ what it gave: 256 bytes
: rnglen  variable ;           \ bytes in rngbuf
: rngpos  variable ;           \ bytes of them handed out
: rngbusy variable ;           \ a request is out
: rngirq  variable ;           \ its interrupt (0: polled)

\ rngfind ( -- base | 0 )  the virtio-mmio slot holding an entropy device.
: rngfind
0 lit 10001000 lit
begin dup 10009000 lit u< while
	over 0= if
		dup @ 74726976 lit = if dup 8 lit + @ 4 lit = if nip dup then then
	then
	1000 lit +
repeat
drop ;

\ rnginit ( base -- )  the device started, no request out.
: rnginit
dup rngk !
0 lit over 70 lit + !        \ reset
1 lit over 70 lit + !        \ acknowledged
3 lit over 70 lit + !        \ a driver
0 lit over 20 lit + !        \ no features
1000 lit over 28 lit + !     \ 4 KiB pages
0 lit over 30 lit + !
dup 34 lit + @ RNGQN u< if "virtio-rng queue too small" panic then
RNGQN over 38 lit + !
1000 lit over 3C lit + !
2 lit pgalloc dup 0= if "no memory for virtio-rng's queue" panic then dup rngq ! 2000 lit mzero
rngq @ C lit rshift over 40 lit + !
100 lit alloc rngbuf !  0 lit rngav !  0 lit rnglen !  0 lit rngpos !  0 lit rngbusy !  0 lit rngirq !
7 lit swap 70 lit + ! ;      \ running

\ rngreq  a request for 256 bytes into rngbuf (all of it handed out): its one
\ descriptor, device-written.  Under klk.
: rngreq
rngbuf @ rngq @ !  0 lit rngq @ 4 lit + !  100 lit rngq @ 8 lit + !  2 lit rngq @ C lit + !
rngav @ RNGQN 1 lit - and 1 lit lshift rngq @ 44 lit + + 0 lit swap h!
fence
rngav @ 1 lit + dup rngav ! rngq @ 42 lit + h!
fence
1 lit rngbusy !
0 lit rngk @ 50 lit + ! ;

\ rngdone? ( -- flag )  the request out answered; rngtake  its bytes ready.
: rngdone?  rngq @ 1002 lit + h@ rngav @ FFFF lit and = ;
: rngtake
fence
rngav @ 1 lit - RNGQN 1 lit - and 3 lit lshift rngq @ 1008 lit + + @
dup 100 lit u> if drop 100 lit then rnglen !  0 lit rngpos !  0 lit rngbusy ! ;

\ krngirq  the device's interrupt: acknowledged, its bytes taken, readers
\ woken.
: krngirq
rngk @ 60 lit + @ rngk @ 64 lit + !
klk @ lock rngbusy @ if rngdone? if rngtake then then rngbuf @ fwake klk @ unlock ;

\ rngread ( -- n )  read on /dev/random, under klk: the bytes ready, up to
\ what was asked; none, and the call waits for the device.  The next
\ request goes out as soon as the last byte is handed out.
: rngread
rngbusy @ if rngdone? if rngtake then then
rnglen @ rngpos @ = if
	rngbusy @ 0= if rngreq then
	rngirq @ 0= if begin rngdone? until rngtake then
then
rnglen @ rngpos @ - ?dup 0= if rngbuf @ 5 lit tretry BLK else
	30 lit sysarg 2dup u> if swap then drop
	dup ?dup if 0 lit do rngbuf @ rngpos @ + i + c@  2C lit sysarg i + c! loop then
	dup rngpos @ + rngpos !
	rnglen @ rngpos @ = rngbusy @ 0= and if rngreq then
then ;

\ yopen ( s mode -- f | error )  /dev/tty/<N>: its slave end, for its
\ maker or root.
: yopen
swap katoi c@ if 2drop FFFFFFFE lit else
dup F lit u> if 2drop FFFFFFFE lit else
2 lit lshift kpty @ + @ ?dup 0= if drop FFFFFFFE lit else
cuid 0= over 24 lit + @ cuid = or 0= if 2drop FFFFFFF3 lit else
	A lit rot fnew dup if 2dup 8 lit + !  over 4 lit + dup @ 1 lit + swap ! then nip
then then then then ;

\ The directories of /dev and /proc: /dev, /dev/tty, /proc and /proc/<pid>
\ (or /proc/self/), each read as a listing like the store's (a name a
\ line, a directory's with a / after).
\ vend? ( s -- flag )  s is empty or "/"; vdir? ( s -- flag )  open's path
\ is s, or s and a /.
: vend?  dup c@ 0= if drop 1 lit else dup c@ 2F lit = swap 1 lit + c@ 0= and then ;
: vdir?  kpb @ swap kpfx ?dup if vend? else 0 lit then ;

\ vdir ( -- q | 0 )  open's path one of them: 1 /dev, 2 /dev/tty, 3 /proc,
\ 4 a process's (pp).
: vdir
"/dev" vdir? if 1 lit else
"/dev/tty" vdir? if 2 lit else
"/proc" vdir? if 3 lit else
kpb @ "/proc/self/" streq if area@ tproc pp ! 4 lit else
kpb @ "/proc/" kpfx ?dup if
	dup c@ 30 lit - A lit u< if
		katoi vend? if
			dup 1 lit - MAXP u< if 1 lit - prn dup @ if pp ! 4 lit else drop 0 lit then else drop 0 lit then
		else drop 0 lit then
	else drop 0 lit then
else 0 lit then then then then then ;

\ vgen ( q -- )  directory q's listing.
: tl  ts A lit tc ;                                          \ ( s -- )  a line
: vgen
dup 1 lit = if "console" tl progtab if "image" tl then "null" tl rngk @ if "random" tl then "tty/" tl then
dup 2 lit = if 10 lit 0 lit do i 2 lit lshift kpty @ + @ if i tn A lit tc then loop then
dup 3 lit = if
	phi @ 0 lit do i prn @ if i 1 lit + tn "/" tl then loop
	"halt" tl "harts" tl "mem" tl "net" tl "self" tl "time" tl "uptime" tl
then
4 lit = if "cmd" tl "cwd" tl "kill" tl "status" tl "tickets" tl "user" tl then ;

\ dimage ( mode -- f | 0 | error )  /dev/image: the image this machine
\ booted, as tabernacle checked it (0x80000000 to s10, its end: kind 11,
\ as an image program read as /bin/<name>), to read only (-13 to write);
\ -2 with no image (the kernel alone).  So the node serves its own image
\ (docs/NODE.md, step 9).
: dimage
progtab 0= if drop FFFFFFFE lit else
1 lit = 0= if FFFFFFF3 lit else
B lit 1 lit fnew dup if
	80000000 lit over 8 lit + !  s10@ 80000000 lit - over 10 lit + !  0 lit over C lit + !
then then then ;

\ 15 open(path, flags): /dev/console, /dev/image, /dev/null, /dev/random, /dev/tty/<N>, a /proc key,
\ or one of the directories above (to read); flags 0 read, 1 write, 2
\ both.  Its descriptor; -2 no such, -13 not that way, -21 a directory to
\ write, -22 bad flags, -24 no descriptor free, -12 no room.
: sopen1
klk @ lock
kvpath 0= if FFFFFFF2 lit else
2C lit sysarg 3 lit and dup 2 lit u> if drop FFFFFFEA lit else 1 lit +
	vdir ?dup if swap 1 lit <> if drop FFFFFFEB lit else ptext dup if swap vgen tbend else nip then then else
	kpb @ "/dev/image" streq if dimage else
	kpb @ "/dev/console" streq if 1 lit swap fnew else
	kpb @ "/dev/null" streq if 2 lit swap fnew else
	kpb @ "/dev/random" streq if rngk @ if C lit swap fnew else drop FFFFFFFE lit then else
	kpb @ "/dev/tty/" kpfx ?dup if swap yopen else
	kpb @ "/proc/" kpfx ?dup if swap popen else drop FFFFFFFE lit then
	then then then then then then
	dup 0= if drop FFFFFFF4 lit else
	dup kerr? 0= if
		dup area@ tproc fdput dup 0< if swap fclose else nip then
	then then
then then
klk @ unlock sret ;

\ cread ( -- r )  from the console: what is ready, to the end of a line.
: cread
ceof @ if 0 lit ceof ! 0 lit else
ctail @ crdy @ = if cin 5 lit tretry BLK else
	0 lit
	begin
		dup 30 lit sysarg u< ctail @ crdy @ u< and
		over 0= if 1 lit else cmode @ @ 1 lit and if 1 lit else over 2C lit sysarg + 1 lit - c@ A lit <> then then and
	while
		ctail @ cb c@  over 2C lit sysarg + c!
		ctail @ 1 lit + ctail !  1 lit +
	repeat
then then ;

\ pread ( pipe -- r )  what it holds, up to n; 0 when empty with no writer.
: pread
dup 8 lit + @ over C lit + @ = if
	dup 4 lit + @ if 5 lit tretry BLK else drop 0 lit then
else
	0 lit
	begin dup 30 lit sysarg u< 2 lit pick dup 8 lit + @ swap C lit + @ <> and while
		over dup C lit + @ 7FF lit and 800 lit + + c@  over 2C lit sysarg + c!
		over C lit + dup @ 1 lit + swap !
		1 lit +
	repeat
	swap fwake
then ;

\ pwrite ( pipe -- r )  all n bytes, waiting for room as it must (E8: how
\ many were written before the wait); -32 with no reader.
: pwrite
dup @ 0= if
	drop area@ E0 lit + @ if area@ E8 lit + @ else 0 lit then ?dup 0= if FFFFFFE0 lit then
else
	area@ E0 lit + @ if area@ E8 lit + @ else 0 lit then
	begin dup 30 lit sysarg u< 2 lit pick dup 8 lit + @ swap C lit + @ - 800 lit u< and while
		dup 2C lit sysarg + c@  2 lit pick dup 8 lit + @ 7FF lit and 800 lit + + c!
		over 8 lit + dup @ 1 lit + swap !
		1 lit +
	repeat
	over fwake
	dup 30 lit sysarg = if nip else area@ E8 lit + !  5 lit tretry BLK then
then ;

\ ptread ( f -- r )  a key's text, from where reading is.
: ptread
0 lit
begin dup 30 lit sysarg u< 2 lit pick dup C lit + @ swap 10 lit + @ u< and while
	over dup 8 lit + @ swap C lit + @ + c@  over 2C lit sysarg + c!
	over C lit + dup @ 1 lit + swap !  1 lit +
repeat
nip ;

\ pknum  the numbers in what is written to a key: pkn1, and pkn2 (-1 if
\ there is one only).
: pkn1 variable ;  : pkn2 variable ;  : pkst variable ;
: pknum
0 lit pkn1 !  FFFFFFFF lit pkn2 !  0 lit pkst !
30 lit sysarg ?dup if 0 lit do
	2C lit sysarg i + c@ 30 lit - dup A lit u< if
		pkst @ 2 lit u< if pkn1 @ dup 3 lit lshift swap 1 lit lshift + + pkn1 !  1 lit pkst !
		else pkn2 @ 0< if 0 lit pkn2 ! then pkn2 @ dup 3 lit lshift swap 1 lit lshift + + pkn2 !  3 lit pkst ! then
	else drop pkst @ 1 lit = if 2 lit pkst ! then then
loop then ;

\ pkwrite ( f -- r )  a key written: tickets (the number written; the
\ process's own user's, or root), kill (ends it, -9; the same), user
\ (root only: its user and group, the two numbers written, the group the
\ user's if one), halt (root only: QEMU exits, 0; the store's commits are
\ whole, so nothing is left half written).  Under klk.
: pkwrite
dup 18 lit + @ 5 lit = if drop cuid if FFFFFFFF lit else "kernel: halted" puts 0A lit putc 0 lit halt 0 lit then else
pknum
dup 14 lit + @ 1 lit - prn
dup @ 1 lit = 0= if 2drop FFFFFFFD lit else
cuid 0= over C4 lit + @ cuid = or 0= if 2drop FFFFFFFF lit else
over 18 lit + @
dup 1 lit = if drop
	pkn1 @ 0= if 2drop FFFFFFEA lit else
		pkn1 @ over 20 lit + !
		thi @ 0 lit do i thn dup tproc 2 lit pick = if pkn1 @ swap B8 lit + ! else drop then loop
		2drop 30 lit sysarg
	then
else dup 2 lit = if drop FFFFFFF7 lit pexit drop 30 lit sysarg
else drop
	cuid if 2drop FFFFFFFF lit else
		pkn1 @ over C4 lit + !  pkn2 @ 0< if pkn1 @ else pkn2 @ then over C8 lit + !
		2drop 30 lit sysarg
	then
then then then then then ;

\ ── Terminals (docs/OS.md, section 7) ──
\
\ A terminal (pty) is a page: its master ends 0 and slave ends 4 (kinds 9
\ and 10); what is typed (written to the master) 8, the edited lines ready
\ C, read by the slave 10, its ^D 14; what it shows (written by the slave,
\ and the echo) 18, read by the master 1C (free-running counts); its number
\ 20 (/dev/tty/N), its maker's user 24; what is typed, 1 KiB from 400; what
\ it shows, 2 KiB from 800.  The slave end has the console's line
\ discipline, and a newline written to it shows as CR LF.

: yo  dup 18 lit + @ 7FF lit and 800 lit + + ;                 \ ( t -- a ) where it shows next
: yroom  dup 18 lit + @ swap 1C lit + @ - 800 lit swap - ;     \ ( t -- n ) room to show
: yout  dup yroom if tuck yo c!  18 lit + dup @ 1 lit + swap ! else 2drop then ;   \ ( c t -- )
: yi    swap 3FF lit and 400 lit + + ;                         \ ( i t -- a )

\ ykeyl ( c t -- )  a byte typed on terminal t in line mode, as the
\ console's (ckeyl): echoed, backspace and delete erase, Enter ends the
\ line, ^D the input.  Under klk.
: ykeyl
over D lit = 2 lit pick A lit = or if
	nip dup 8 lit + @ over 10 lit + @ - 3FF lit u< if
		A lit over dup 8 lit + @ swap yi c!
		dup 8 lit + @ 1 lit + over 8 lit + !  dup 8 lit + @ over C lit + !
		D lit over yout  A lit over yout
	then
else
over 8 lit = 2 lit pick 7F lit = or if
	nip dup 8 lit + @ over C lit + @ <> if
		dup 8 lit + @ 1 lit - over 8 lit + !
		8 lit over yout  20 lit over yout  8 lit over yout
	then
else
over 4 lit = if
	nip dup 8 lit + @ over C lit + @ = if 1 lit over 14 lit + ! else dup 8 lit + @ over C lit + ! then
else
over 20 lit u< if nip else
	dup 8 lit + @ over 10 lit + @ - 3FE lit u< if
		2dup dup 8 lit + @ swap yi c!
		dup 8 lit + @ 1 lit + over 8 lit + !
		tuck yout
	else nip then
then then then then
fwake ;

\ ykey ( c t -- )  a byte typed on terminal t: raw (its mode, at 28, 1),
\ ready at once and not echoed; in line mode an escape sequence dropped
\ whole (its state at 2C), the rest to ykeyl.  Under klk.
: ykey
dup 28 lit + @ 1 lit and if
	dup 8 lit + @ over 10 lit + @ - 3FF lit u< if
		2dup dup 8 lit + @ swap yi c!
		dup 8 lit + @ 1 lit + over 8 lit + !  dup 8 lit + @ over C lit + !
	then
	nip fwake
else
	2dup 2C lit + esc? if nip fwake else ykeyl then
then ;

\ ymread ( t -- r )  the master read: what the terminal shows, up to n;
\ 0 once it is empty with no slave end.
: ymread
dup 18 lit + @ over 1C lit + @ = if
	dup 4 lit + @ if 5 lit tretry BLK else drop 0 lit then
else
	0 lit
	begin dup 30 lit sysarg u< 2 lit pick dup 18 lit + @ swap 1C lit + @ <> and while
		over dup 1C lit + @ 7FF lit and 800 lit + + c@  over 2C lit sysarg + c!
		over 1C lit + dup @ 1 lit + swap !  1 lit +
	repeat
	swap fwake
then ;

\ ymwrite ( t -- n )  the master write: each byte typed.
: ymwrite
30 lit sysarg ?dup if 0 lit do 2C lit sysarg i + c@ over ykey loop then
drop 30 lit sysarg ;

\ ysread ( t -- r )  the slave read: what lines are ready, to a line's end
\ (waiting for one); 0 after ^D at a line's start, or with no master.
: ysread
dup 14 lit + @ if 0 lit swap 14 lit + ! 0 lit else
dup C lit + @ over 10 lit + @ = if
	dup @ if 5 lit tretry BLK else drop 0 lit then
else
	0 lit
	begin
		dup 30 lit sysarg u< 2 lit pick dup 10 lit + @ swap C lit + @ u< and
		over 0= if 1 lit else 2 lit pick 28 lit + @ 1 lit and if 1 lit else over 2C lit sysarg + 1 lit - c@ A lit <> then then and
	while
		over dup 10 lit + @ swap yi c@  over 2C lit sysarg + c!
		over 10 lit + dup @ 1 lit + swap !  1 lit +
	repeat
	nip
then then ;

\ yswrite ( t -- r )  the slave write: all n bytes shown (a newline as CR
\ LF), waiting for room as it must (E8 how many before the wait); -5 with no
\ master end.
: yswrite
dup @ 0= if drop FFFFFFFB lit else
	area@ E0 lit + @ if area@ E8 lit + @ else 0 lit then
	begin dup 30 lit sysarg u< 2 lit pick yroom 2 lit u< 0= and while
		dup 2C lit sysarg + c@ dup A lit = if D lit 3 lit pick yout then 2 lit pick yout
		1 lit +
	repeat
	over fwake
	dup 30 lit sysarg = if nip else area@ E8 lit + !  5 lit tretry BLK then
then ;

\ yready ( f -- events )  poll's, for a terminal's end.
: yready
dup 8 lit + @ swap @ 9 lit = if
	dup 18 lit + @ over 1C lit + @ <> if 5 lit else 4 lit then
	swap 4 lit + @ 0= if 10 lit or then
else
	dup 14 lit + @ over C lit + @ 2 lit pick 10 lit + @ <> or if 1 lit else 0 lit then
	over yroom 2 lit u< 0= if 4 lit or then
	swap @ 0= if 10 lit or then
then ;

\ 21 pty(fds): a terminal, fds[0] its master end, fds[1] its slave end:
\ its number (/dev/tty/N), or -14, -23 none free, -12, -24.
: yp variable ;  : yf1 variable ;  : yf2 variable ;
: spty
klk @ lock
28 lit sysarg 8 lit uwrange 0= if FFFFFFF2 lit else
FFFFFFFF lit 10 lit 0 lit do dup 0< if i 2 lit lshift kpty @ + @ 0= if drop i then then loop
dup 0< if drop FFFFFFE9 lit else
9 lit 3 lit fnew yf1 !  A lit 3 lit fnew yf2 !
yf1 @ 0= yf2 @ 0= or if drop yf1 @ ?dup if 0 lit swap ! then yf2 @ ?dup if 0 lit swap ! then FFFFFFE9 lit else
1 lit pgalloc dup yp ! 0= if drop 0 lit yf1 @ !  0 lit yf2 @ !  FFFFFFF4 lit else
	yp @ 40 lit mzero  1 lit yp @ !  1 lit yp @ 4 lit + !
	dup yp @ 20 lit + !  cuid yp @ 24 lit + !
	yp @ over 2 lit lshift kpty @ + !
	yp @ yf1 @ 8 lit + !  yp @ yf2 @ 8 lit + !
	yf1 @ area@ tproc fdput dup 0< if nip yf1 @ fclose yf2 @ fclose else
	yf2 @ area@ tproc fdput dup 0< if
		nip swap 0 lit swap area@ tproc pfd !  yf1 @ fclose yf2 @ fclose
	else
		28 lit sysarg 4 lit + !  28 lit sysarg !
	then then
then then then then
klk @ unlock sret ;

\ ── Sockets (UDP; the socket's layout above nusock, src/net.fam) ──

\ ufsock ( fd -- page | 0 )  the calling process's socket fd.  Under klk.
: ufsock  ufd dup if dup @ 8 lit = if 8 lit + @ else drop 0 lit then then ;

\ uslp ( page -- port )  its port, one chosen if it has none.  Under klk.
: uslp  dup 4 lit + @ ?dup if nip else nephem dup rot 4 lit + ! then ;

\ usend ( port ip to buf n -- n )  a datagram: -90 too long, -89 to no
\ one, -113 the gateway not known yet.
: usend
dup 5C0 lit u> if 2drop 2drop drop FFFFFFA6 lit else
2 lit pick 0= 3 lit pick 0= or if 2drop 2drop drop FFFFFFA7 lit else
ngwok @ 0= if 2drop 2drop drop FFFFFF8F lit else
nudpout
then then then ;

\ urecv ( page from -- n | BLK )  the first datagram queued, up to n bytes
\ of it into buf (the rest dropped), from where it came (address, port) at
\ from unless 0; waits for one.  Under klk.
: urecv
over dup 10 lit + @ swap 14 lit + @ = if drop 5 lit tretry BLK else
	over dup 14 lit + @ 7 lit and B lit lshift + 40 lit +
	over if dup 4 lit + @ 2 lit pick !  dup 8 lit + @ 2 lit pick 4 lit + ! then
	nip
	dup @ 30 lit sysarg 2dup u> if swap then drop
	swap C lit + 2C lit sysarg 2 lit pick bcpy
	swap 14 lit + dup @ 1 lit + swap !
then ;

\ tcrd ( p -- n | BLK )  read on a TCP socket: what has arrived, up to n
\ bytes (waiting for some); 0 at its end (or its error).  A window grown by
\ a segment's worth told to the peer.  Under klk.
: tcrd
dup crh @ over crtl @ = if
	dup cflg @ 8 lit and over cst @ 4 lit u< or if cerr @ else 5 lit tretry BLK then
else
	2C lit sysarg  over crh @ 2 lit pick crtl @ - 30 lit sysarg cmin
	swap over 3 lit pick 1000 lit + 1000 lit 5 lit pick crtl @ rget
	over crtl @ over + 2 lit pick crtl !
	over cfree# 2 lit pick cadv @ - 5B4 lit u< 0= 2 lit pick cst @ 4 lit u< 0= and if over 10 lit 0 lit ntcpout then
	nip
then ;

\ tcwr ( p -- n | BLK )  write on a TCP socket: all n bytes, into what is
\ written as there is room (waiting for more; E8 how many before the wait),
\ sent as the window allows; -32 once it cannot send (or its error).  Under
\ klk.
: cwm variable ;
: tcwr
dup cst @ dup 4 lit = swap 7 lit = or 0= if dup cerr @ ?dup if nip else drop FFFFFFE0 lit then else
	area@ E0 lit + @ if area@ E8 lit + @ else 0 lit then
	2C lit sysarg over +
	30 lit sysarg 2 lit pick -
	3 lit pick dup csw @ swap cackd - 2000 lit swap - cmin
	?dup if
		dup cwm !  3 lit pick 2000 lit + 2000 lit 5 lit pick csw @ rput
		over csw @ cwm @ + 2 lit pick csw !
		cwm @ +  over tout
	else drop then
	dup 30 lit sysarg = if nip else area@ E8 lit + !  5 lit tretry BLK then
then ;

\ uwrite ( page -- n )  write on a connected socket: the datagram to its
\ peer (-89 not connected).  Under klk.
: uwrite
dup 8 lit + @ 0= if drop FFFFFFA7 lit else
dup uslp over 8 lit + @ rot C lit + @ 2C lit sysarg 30 lit sysarg usend
then ;

\ 16 read(fd, buf, n): what there is, at least a byte (waiting for it), or
\ 0 at the end.  -9 not a descriptor to read, -14 not its buffer.
: sread1
klk @ lock
28 lit sysarg ufd dup 0= if drop FFFFFFF7 lit else
dup 1C lit + @ 1 lit and 0= if drop FFFFFFF7 lit else
2C lit sysarg 30 lit sysarg uwrange 0= if drop FFFFFFF2 lit else
dup @
dup 1 lit = if 2drop cread else
dup 2 lit = if 2drop 0 lit else
dup 3 lit = if drop 8 lit + @ pread else
dup 8 lit = if drop 8 lit + @ dup @ 1 lit = if 0 lit urecv else tcrd then else
dup 9 lit = if drop 8 lit + @ ymread else
dup A lit = if drop 8 lit + @ ysread else
dup B lit = if drop ptread else
dup C lit = if 2drop rngread else
4 lit = if ptread else drop 0 lit
then then then then then then then then then then then then
klk @ unlock dup BLK = if drop else sret then ;

\ 17 write(fd, buf, n): all of it (waiting for room); -9, -14, -32 a pipe
\ no one reads.
: swrite1
klk @ lock
28 lit sysarg ufd dup 0= if drop FFFFFFF7 lit else
dup 1C lit + @ 2 lit and 0= if drop FFFFFFF7 lit else
2C lit sysarg 30 lit sysarg urange 0= if drop FFFFFFF2 lit else
dup @
dup 1 lit = if
	2drop 30 lit sysarg ?dup if 2C lit sysarg swap 0 lit do dup i + c@ putc loop drop then 30 lit sysarg
else
dup 2 lit = if 2drop 30 lit sysarg else
dup 3 lit = if drop 8 lit + @ pwrite else
dup 8 lit = if drop 8 lit + @ dup @ 1 lit = if uwrite else tcwr then else
dup 9 lit = if drop 8 lit + @ ymwrite else
dup A lit = if drop 8 lit + @ yswrite else
dup C lit = if 2drop 30 lit sysarg else
drop pkwrite
then then then then then then then then then then
klk @ unlock dup BLK = if drop else sret then ;

\ 19 close(fd): 0, or -9.
: sclose
klk @ lock
28 lit sysarg ufd ?dup if fclose  0 lit 28 lit sysarg area@ tproc pfd !  0 lit else FFFFFFF7 lit then
klk @ unlock sret ;

: sp1 variable ;  : sf1 variable ;  : sf2 variable ;

\ 20 pipe(fds): fds[0] its read end, fds[1] its write end; 0, or -14,
\ -23 no open file free, -12 no memory, -24 no descriptor free.
: spipe
klk @ lock
28 lit sysarg 8 lit uwrange 0= if FFFFFFF2 lit else
3 lit 1 lit fnew sf1 !  3 lit 2 lit fnew sf2 !
sf1 @ 0= sf2 @ 0= or if sf1 @ ?dup if 0 lit swap ! then sf2 @ ?dup if 0 lit swap ! then FFFFFFE9 lit else
1 lit pgalloc dup sp1 ! 0= if 0 lit sf1 @ !  0 lit sf2 @ !  FFFFFFF4 lit else
	sp1 @ 10 lit mzero  1 lit sp1 @ !  1 lit sp1 @ 4 lit + !
	sp1 @ sf1 @ 8 lit + !  sp1 @ sf2 @ 8 lit + !
	sf1 @ area@ tproc fdput dup 0< if drop sf1 @ fclose sf2 @ fclose FFFFFFE8 lit else
	sf2 @ area@ tproc fdput dup 0< if
		drop 0 lit swap area@ tproc pfd !  sf1 @ fclose sf2 @ fclose FFFFFFE8 lit
	else
		28 lit sysarg 4 lit + !  28 lit sysarg !  0 lit
	then then
then then then
klk @ unlock sret ;

\ fready ( f -- events )  1 readable (or at its end), 4 writable, 16 the
\ other end gone; only those its mode allows (and 16).  A file in the
\ store (kind 7) is always both: reading or writing it never waits.
: fready
dup @ 1 lit = if ceof @ ctail @ crdy @ <> or if 5 lit else 4 lit then else
dup @ 2 lit = if 5 lit else
dup @ 3 lit = if
	dup 8 lit + @ over 1C lit + @ 1 lit = if
		dup 4 lit + @ 0= if drop 11 lit else dup 8 lit + @ swap C lit + @ <> if 1 lit else 0 lit then then
	else
		dup @ 0= if drop 14 lit else dup 8 lit + @ swap C lit + @ - 800 lit u< if 4 lit else 0 lit then then
	then
else
dup @ 4 lit = over @ B lit = or if 1 lit else
dup @ 7 lit = if 5 lit else
dup @ 9 lit = over @ A lit = or if dup yready else
dup @ 8 lit = if dup 8 lit + @ dup @ 1 lit = if dup 10 lit + @ swap 14 lit + @ <> if 5 lit else 4 lit then else cready then else
dup @ C lit = if rngbusy @ if rngdone? if rngtake then then rnglen @ rngpos @ <> if 5 lit else rngbusy @ 0= if rngreq then 4 lit then else 4 lit
then then then then then then then then
swap 1C lit + @ dup 1 lit and if 1 lit else 0 lit then swap 2 lit and if 4 lit or then 10 lit or and ;

\ 22 poll(fds, n, ns): fds n entries of 8 bytes (a descriptor; the events
\ wanted, 16 bits; those found, 16 bits: 1 in, 4 out, 16 hung up, 32 not a
\ descriptor; a negative descriptor is passed over); waits until one has
\ any (ns 0: no limit): how many, or -110 when the time ran out.
: spoll
klk @ lock
2C lit sysarg dup 40 lit u> if drop FFFFFFEA lit else
3 lit lshift 28 lit sysarg swap uwrange 0= if FFFFFFF2 lit else
0 lit
2C lit sysarg ?dup if 0 lit do
	28 lit sysarg i 3 lit lshift +
	dup @ 0< if 0 lit else
		dup @ ufd ?dup if fready over 4 lit + @ FFFF lit and 30 lit or and else 20 lit then
	then
	dup rot 6 lit + h!  if 1 lit + then
loop then
dup 0= if
	30 lit sysarg if
		area@ E0 lit + @ 0= if 30 lit sysarg 64 lit / mtime@ + area@ E4 lit + ! then
		area@ E4 lit + @ area@ BC lit + !  1 lit area@ D8 lit + !
	then
	drop 0 lit 6 lit tretry BLK
then
then then
klk @ unlock dup BLK = if drop else sret then ;

\ 30 socket(kind): a socket, kind 1 UDP, 2 TCP: its descriptor; -22
\ another kind, -19 no network device, -23 no open file free, -12 no
\ memory (or TCP's 32 sockets taken), -24.
: ssocket
klk @ lock
28 lit sysarg dup 1 lit = swap 2 lit = or 0= if FFFFFFEA lit else
nk @ 0= if FFFFFFED lit else
8 lit 3 lit fnew ?dup 0= if FFFFFFE9 lit else
28 lit sysarg 1 lit = if 4 lit pgalloc dup if dup 40 lit mzero  1 lit over ! then else cnew then
?dup 0= if 0 lit swap ! FFFFFFF4 lit else
	over 8 lit + !
	dup area@ tproc fdput dup 0< if swap fclose else nip then
then then then then
klk @ unlock sret ;

\ tnet ( p -- r | BLK )  net() on a TCP socket: 1 bind, 3 listen (bound),
\ 2 connect (waiting until it is, or is refused: -111, or times out:
\ -110; -113 no gateway yet, unless to this machine: 127.x.x.x is it).
: tnet
2C lit sysarg 1 lit = if
	34 lit sysarg FFFF lit u> over 4 lit + @ or if drop FFFFFFEA lit else
	34 lit sysarg ?dup 0= if cephem then
	dup ctaken if 2drop FFFFFF9E lit else swap 4 lit + ! 0 lit then
	then
else 2C lit sysarg 3 lit = if
	dup 4 lit + @ 0= over cst @ or if drop FFFFFFEA lit else 1 lit swap cst ! 0 lit then
else 2C lit sysarg 2 lit = if
	dup cerr @ ?dup if nip else
	dup cst @ 2 lit = if 5 lit tretry BLK else
	dup cst @ 3 lit u> if drop 0 lit else
	dup cst @ if drop FFFFFFEA lit else
	30 lit sysarg 0= 34 lit sysarg 0= or 34 lit sysarg FFFF lit u> or if drop FFFFFFEA lit else
	ngwok @ 0= 30 lit sysarg nlocal MYIP <> and if drop FFFFFF8F lit else
		30 lit sysarg nlocal over 8 lit + !  34 lit sysarg over C lit + !
		dup 4 lit + @ 0= if cephem over 4 lit + ! then
		mtime@ over ciss !  dup ciss @ over cuna !  dup ciss @ over cnxt !
		dup 2 lit 0 lit ntcpout
		dup cnxt @ 1 lit + over cnxt !  2 lit over cst !
		mtime@ over crto @ + 1 lit or over cdl !
		5 lit tretry BLK
	then then then then then then
else drop FFFFFFEA lit then then then ;

\ 31 net(fd, op, ip, port): op 1 binds it to port (0: one chosen), op 2
\ connects it to ip and port (read and write go there; for UDP only what
\ comes from there arrives), op 3 (TCP) listens.  0, or -88 not a socket,
\ -22, -98 the port taken; tnet's.
: snet
klk @ lock
28 lit sysarg ufsock ?dup 0= if FFFFFFA8 lit else
dup @ 2 lit = if tnet else
2C lit sysarg 1 lit = if
	34 lit sysarg FFFF lit u> over 4 lit + @ or if drop FFFFFFEA lit else
	34 lit sysarg ?dup 0= if nephem then
	dup nusock if 2drop FFFFFF9E lit else swap 4 lit + ! 0 lit then
	then
else 2C lit sysarg 2 lit = if
	30 lit sysarg 0= 34 lit sysarg 0= or 34 lit sysarg FFFF lit u> or if drop FFFFFFEA lit else
	30 lit sysarg over 8 lit + !  34 lit sysarg over C lit + !  uslp drop 0 lit
	then
else drop FFFFFFEA lit then then
then then
klk @ unlock dup BLK = if drop else sret then ;

\ 32 accept(fd): a connection to the listening TCP socket fd, as a new
\ descriptor (waiting for one): -88, -22 not listening, -23, -24.
: saccept
klk @ lock
28 lit sysarg ufsock ?dup 0= if FFFFFFA8 lit else
dup @ 2 lit <> over cst @ 1 lit <> or if drop FFFFFFEA lit else
dup crh @ over crtl @ = if 5 lit tretry BLK else
8 lit 3 lit fnew ?dup 0= if drop FFFFFFE9 lit else
	over dup crtl @ 1F lit and 2 lit lshift 100 lit + + @ over 8 lit + !
	dup area@ tproc fdput dup 0< if
		swap 0 lit swap !  nip
	else
		nip swap dup crtl @ 1 lit + swap crtl !
	then
then then then then
klk @ unlock dup BLK = if drop else sret then ;

\ 33 sendto(fd, buf, n, ip, port): a datagram (the socket bound first if
\ it is not): n, or -88, -14, and usend's.
: ssendto
klk @ lock
28 lit sysarg ufsock ?dup 0= if klk @ unlock FFFFFFA8 lit else
dup @ 1 lit <> if drop klk @ unlock FFFFFFEA lit else
2C lit sysarg 30 lit sysarg urange 0= if drop klk @ unlock FFFFFFF2 lit else
uslp klk @ unlock
34 lit sysarg 38 lit sysarg 2C lit sysarg 30 lit sysarg usend
then then then sret ;

\ 34 recvfrom(fd, buf, n, from): urecv's; -88, -14.
: srecvf
klk @ lock
28 lit sysarg ufsock ?dup 0= if FFFFFFA8 lit else
dup @ 1 lit <> if drop FFFFFFEA lit else
2C lit sysarg 30 lit sysarg uwrange 0= if drop FFFFFFF2 lit else
34 lit sysarg ?dup if 8 lit uwrange else 1 lit then 0= if drop FFFFFFF2 lit else
34 lit sysarg urecv
then then then then
klk @ unlock dup BLK = if drop else sret then ;

\ ── Files (docs/OS.md, sections 6 and 11) ──
\
\ The file system is the store's first tree.  A path is made absolute (from
\ the process's working directory) and plain (no "." or "..", no doubled
\ /), the root being the empty path.  At a file's path: its header, 32
\ bytes (its type at 0: 1 a file, 2 a directory, 3 a tree; its owner 4,
\ group 8, mode 12, size 16, made 20, changed 24, in seconds since 1970;
\ a tree's meta page 28); its bytes at the path, a NUL and the chunk's
\ number (4 bytes, high first), 1 KiB a chunk.  A directory's header is at
\ its path and a /, so what is in it follows it in the keys' order.  Names
\ are of bytes from 32 on.  A file open (kind 7) keeps its path in a page
\ of its own (at 8, its length at 16), its place at 12, append at 20.

:M XOUT  F80 lit ;  :M XOUTS F84 lit ;  :M XPLEN F88 lit ;  :M XF   F8C lit ;
:M XN    F90 lit ;  :M XD    F94 lit ;  :M XB    F98 lit ;  :M XSZ  F9C lit ;
:M TREE 100 lit ;  :M CREATE 200 lit ;  :M TRUNC 400 lit ;  :M APPEND 800 lit ;   \ open's flags

\ rtcsec ( -- s )  the seconds since 1970 (rtc0), under klk.
: rtcsec  klk @ lock rtc0 klk @ unlock ;

: bzero  ?dup if 0 lit do 0 lit over i + c! loop then drop ;   \ ( a n -- )

\ ucpy ( uaddr dst max -- n | -1 )  a NUL-ended string of the caller's, at
\ most max-1 bytes, copied (not its NUL): its length.
: ucpy
L2 x! L1 x! L0 x!
FFFFFFFF lit
L2 x@ 0 lit do
	dup FFFFFFFF lit = if
		L0 x@ i + 1 lit urange 0= if drop FFFFFFFE lit else
		L0 x@ i + c@ ?dup if L1 x@ i + c! else drop i then then
	then
loop
dup 0< if drop FFFFFFFF lit then ;

\ rcomp ( a n -- ok )  one name of a path onto XKEY: "" and "." nothing,
\ ".." back one, else / and the name (no byte below 32, 250 bytes in all).
: rcomp
dup 0= if 2drop 1 lit else
dup 1 lit = if over c@ 2E lit = else 0 lit then if 2drop 1 lit else
dup 2 lit = if over c@ 2E lit = 2 lit pick 1 lit + c@ 2E lit = and else 0 lit then if
	2drop
	XKLEN x@ begin dup if XKEY xa over 1 lit - + c@ 2F lit <> else 0 lit then while 1 lit - repeat
	dup if 1 lit - then XKLEN x!  1 lit
else
	1 lit over 0 lit do 2 lit pick i + c@ 20 lit u< if drop 0 lit then loop
	XKLEN x@ 2 lit pick + 1 lit + FA lit u> if drop 0 lit then
	if
		dup L3 x!  drop
		2F lit XKEY xa XKLEN x@ + c!  XKLEN x@ 1 lit + XKLEN x!
		XKEY xa XKLEN x@ + L3 x@ bcpy  XKLEN x@ L3 x@ + XKLEN x!  1 lit
	else 2drop 0 lit then
then then then ;

\ rnorm ( -- ok )  the path at XSKEY (Q1 bytes), made absolute and plain,
\ into XKEY.
: rnorm
0 lit XKLEN x!
Q1 x@ if XSKEY xa c@ 2F lit = else 0 lit then 0= if
	cproc C0 lit + @ ?dup if dup @ XKLEN x!  4 lit + XKEY xa XKLEN x@ bcpy then
then
1 lit Q2 x!  0 lit Q0 x!
begin Q0 x@ Q1 x@ u< Q2 x@ and while
	Q0 x@
	begin Q0 x@ Q1 x@ u< if XSKEY xa Q0 x@ + c@ 2F lit <> else 0 lit then while Q0 x@ 1 lit + Q0 x! repeat
	XSKEY xa over + Q0 x@ rot - rcomp Q2 x@ and Q2 x!
	Q0 x@ 1 lit + Q0 x!
repeat
Q2 x@ ;

\ rpath ( uaddr -- ok )  a path of the caller's, made absolute and plain,
\ into XKEY (the root: XKLEN 0).
: rpath  XSKEY xa 100 lit ucpy dup 0< if drop 0 lit else Q1 x! rnorm then ;

: dkey   2F lit XKEY xa XKLEN x@ + c!  XKLEN x@ 1 lit + XKLEN x! ;   \ the path as a directory's key
: pkey!  XPLEN x@ XKLEN x! ;                                        \ back to the path (XPLEN long)

\ hget ( -- type )  the header at XKEY (to XVAL): its type, 0 if none.
: hget  XVAL xa 20 lit tget 20 lit = if XVAL xa c@ else 0 lit then tunpin ;

\ ptype ( -- type )  what is at the path: 1 a file, 2 a directory, 3 a tree,
\ 0 nothing (its header in XVAL).
: ptype  XKLEN x@ if hget else 0 lit then ?dup 0= if dkey hget XKLEN x@ 1 lit - XKLEN x! then ;

\ hnew ( type -- )  a new header of that type in XVAL (made and changed now).
: hnew
XVAL xa 20 lit mzero  dup XVAL xa c!
2 lit = if 1ED lit else 1A4 lit then XVAL xa C lit + !
cuid XVAL xa 4 lit + !  cgid XVAL xa 8 lit + !
rtcsec dup XVAL xa 14 lit + !  XVAL xa 18 lit + !  20 lit XVLEN x! ;

\ perm ( need -- ok )  the caller may, by the header in XVAL: need 4 read,
\ 2 write, 1 search (a directory) or run, as the mode gives them to its
\ owner, its group, or others.  Root may do anything.
: perm
cuid 0= if drop 1 lit else
	cuid XVAL xa 4 lit + @ = if XVAL xa C lit + @ 6 lit rshift else
	cgid XVAL xa 8 lit + @ = if XVAL xa C lit + @ 3 lit rshift else XVAL xa C lit + @ then then
	over and =
then ;
: need  3 lit and dup 0= if drop 4 lit else 1 lit = if 2 lit else 6 lit then then ;   \ ( flags -- need )  open's

\ pdir ( need -- 0 | error )  the path's directory is there and the caller
\ may do that in it: 0; -2 no directory, -13 not allowed.
: pdir
XKLEN x@ Q3 x!
XKLEN x@ begin dup if XKEY xa over 1 lit - + c@ 2F lit <> else 0 lit then while 1 lit - repeat
XKLEN x!  hget 2 lit = if perm if 0 lit else FFFFFFF3 lit then else drop FFFFFFFE lit then  Q3 x@ XKLEN x! ;

\ chk! ( c -- )  XKEY: the path (XPLEN long), a NUL, chunk c.
: chk!
XKEY xa XPLEN x@ +  0 lit over c!
over 18 lit rshift over 1 lit + c!  over 10 lit rshift FF lit and over 2 lit + c!
over 8 lit rshift FF lit and over 3 lit + c!  swap FF lit and swap 4 lit + c!
XPLEN x@ 5 lit + XKLEN x! ;

\ fchunks ( -- )  the file's chunks taken out (its header in XVAL).
: fchunks  XKLEN x@ XPLEN x!  XVAL xa 10 lit + @ 3FF lit + A lit rshift ?dup if 0 lit do i chk! tdel drop tunpin loop then  pkey! ;

\ ftrunc  the file emptied: its chunks out, its size 0.
: ftrunc  fchunks  0 lit XVAL xa 10 lit + !  rtcsec XVAL xa 18 lit + !  20 lit XVLEN x!  tput drop tunpin ;

\ ffd ( -- fd | error )  the transaction committed and a descriptor on the
\ file at XKEY, open as open's flags say.
: ffd
1 lit spga ?dup 0= if tabort FFFFFFF4 lit else
	XKEY xa over XKLEN x@ bcpy  XKLEN x@ swap
	tcommit if 1 lit spgf drop FFFFFFE4 lit else
		klk @ lock
		7 lit 2C lit sysarg 3 lit and 1 lit + fnew ?dup 0= if klk @ unlock 1 lit spgf drop FFFFFFF4 lit else
			tuck 8 lit + !  tuck 10 lit + !  2C lit sysarg APPEND and over 14 lit + !
			dup cproc fdput dup 0< if swap fclose else nip then
			klk @ unlock
		then
	then
then ;

\ ploadf ( -- entry | error )  spawn's name a program in the store: a file
\ the caller may run (its mode's x for the caller, and an x of the mode's
\ even for root), 1 MiB at most, read into pages of its
\ own after a table entry made for it (its name the path's last part, 64
\ KiB of memory to start with, its pages counted at 1C; pslot0 frees
\ them).  -2 none such, -13 not to be run, -8 empty or too big, -12 no
\ memory, -16 busy.
: lfa variable ;  : lfn variable ;
: ploadf
fst @ 0= if FFFFFFFE lit else
fst @ 1 lit tbegin 0= if FFFFFFF0 lit else
28 lit sysarg rpath 0= if tabort FFFFFFFE lit else
ptype 1 lit = 0= if tabort FFFFFFFE lit else
1 lit perm XVAL xa C lit + @ 49 lit and 0= 0= and 0= if tabort FFFFFFF3 lit else
XVAL xa 10 lit + @ dup 0= over 100000 lit u> or if drop tabort FFFFFFF8 lit else
	dup FFF lit + C lit rshift 1 lit + dup spga ?dup 0= if 2drop tabort FFFFFFF4 lit else
		dup lfa !  over C lit lshift mzero
		lfa @ 1C lit + !  dup lfa @ 14 lit + !  XN x!
		lfa @ 1000 lit + 80000000 lit - lfa @ 10 lit + !  10000 lit lfa @ 18 lit + !
		XKLEN x@ begin dup if XKEY xa over 1 lit - + c@ 2F lit <> else 0 lit then while 1 lit - repeat
		XKLEN x@ over - dup F lit u> if drop F lit then lfn !
		XKEY xa + lfa @ lfn @ bcpy
		XKLEN x@ XPLEN x!  0 lit XD x!
		begin XD x@ XN x@ u< while
			XD x@ A lit rshift chk!
			XVAL xa 400 lit tget tunpin dup 0< if drop 0 lit then
			XN x@ XD x@ - dup 400 lit u> if drop 400 lit then
			2dup u> if nip else drop then
			XVAL xa lfa @ 1000 lit + XD x@ + rot bcpy
			XD x@ 400 lit + XD x!
		repeat
		tcommit drop  lfa @
	then
then then then then then then ;

\ kslash? ( s -- flag )  a / in the caller's string s (its end checked).
: kslash?  begin dup c@ dup 2F lit <> and while 1 lit + repeat c@ 0= 0= ;

\ 2 spawn(name, args, fds): a child running that program, with this one's
\ tickets: an image's program by its name (or /bin/ and it), else, a name
\ with a / in it, a program file of the store's (ploadf); its arguments
\ args (0: its name alone), its descriptors as fds says (0: this one's 0,
\ 1 and 2).  -2 no such program, -14 bad arguments, -9 a bad descriptor,
\ and ploadf's errors.
: sown variable ;
: sfree  sown @ if dup 1C lit + @ spgf else drop then ;      \ ( entry -- )
: sspawn
28 lit sysarg ustr 0= if FFFFFFF2 lit sret else
2C lit sysarg dup if uargl dup sal ! 0= else drop 0 lit then if FFFFFFF2 lit sret else
28 lit sysarg binp pfind ?dup if 0 lit sown ! else
	28 lit sysarg kslash? if ploadf 1 lit sown ! else FFFFFFFE lit then
then
dup kerr? if sret else
klk @ lock
sfds? 0= if klk @ unlock sfree FFFFFFF7 lit sret else
	dup cproc 20 lit + @ cproc pid pspawne
	dup 0< if klk @ unlock swap sfree sret else
		dup 1 lit - prn dup pfdset dup pargs dup pusr pcwd
		sown @ if 2dup 1 lit - prn 2C lit + ! then nip
		klk @ unlock sret
	then
then then then then ;

\ dirl? ( s -- flag )  the directory listed is s (5 bytes: /bin/, /lib/);
\ dname ( a -- )  an image entry's name (16 bytes at most) a line of the
\ listing.
: dirl?  XPLEN x@ 5 lit = if 1 lit 5 lit 0 lit do over i + c@ XKEY xa i + c@ <> if drop 0 lit then loop nip else drop 0 lit then ;

\ dlist ( -- fd | error )  the directory at XKEY listed (each name a line,
\ a directory's with a / after), the transaction ended, and a descriptor
\ to read the listing from (4 KiB of it at most).
: dout  XOUT x@ over + XOUTS x@ FF0 lit + u< if XOUT x@ swap dup XOUT x@ + XOUT x! bcpy else 2drop then ;   \ ( a n -- )
: dch   XOUT x@ XOUTS x@ FF0 lit + u< if XOUT x@ c!  XOUT x@ 1 lit + XOUT x! else drop then ;            \ ( c -- )
: dname  0 lit begin 2dup + c@ over 10 lit u< and while 1 lit + repeat dout 0A lit dch ;
\ tnames ( d out -- )  the image's names of one kind (d 0 its programs, -1
\ its data files), a line each: of a listing (out 0: dname) or of a text
\ (out 1: tl).
: tnkd variable ;  : tnout variable ;
: tnames
tnout ! tnkd !
progtab ?dup if dup @ ?dup if 0 lit do
	dup 4 lit + i 1C lit * + dup 18 lit + @ 0= tnkd @ = if tnout @ if tl else dname then else drop then
loop then drop then ;
: dlist
1 lit spga ?dup 0= if tabort FFFFFFF4 lit else
	dup XOUT x!  XOUTS x!
	dkey  XKLEN x@ XPLEN x!
	begin
		XSKEY xa tnext tunpin
		dup 0< if drop 1 lit else
		dup XPLEN x@ u> if XSKEY xa XPLEN x@ XKEY xa XPLEN x@ bcmp 0= else 0 lit then 0= if drop 1 lit else
			XPLEN x@ begin 2dup u> if XSKEY xa over + c@ dup 0= 0= swap 2F lit <> and else 0 lit then while 1 lit + repeat
			2dup = if
				XSKEY xa XPLEN x@ + over XPLEN x@ - dout  0A lit dch  drop
			else
				XSKEY xa over + c@ 2F lit = over 1 lit + 3 lit pick = and if
					XSKEY xa XPLEN x@ + over 1 lit + XPLEN x@ - dout  0A lit dch
				then
				XSKEY xa over + c@ 2F lit = if 30 lit else 1 lit then over XSKEY xa + c!
				nip 1 lit +
			then
			dup XKLEN x!  XSKEY xa XKEY xa rot bcpy  0 lit
		then then
	until
	XPLEN x@ 1 lit = if "dev/" 4 lit dout 0A lit dch "proc/" 5 lit dout 0A lit dch then   \ the root's: /dev and /proc too
	"/bin/" dirl? if 0 lit 0 lit tnames then   \ /bin's: the image's programs too
	"/lib/" dirl? if FFFFFFFF lit 0 lit tnames then   \ /lib's: its data files
	XOUT x@ XOUTS x@ - XOUTS x@
	tcommit drop
	klk @ lock 4 lit 1 lit fnew ?dup 0= if klk @ unlock 1 lit spgf drop FFFFFFF4 lit else
		tuck 8 lit + !  tuck 10 lit + !  0 lit over C lit + !
		dup cproc fdput dup 0< if swap fclose else nip then
		klk @ unlock
	then
then ;

\ nostore ( -- fd | error )  open with no store: the root, /bin and /lib
\ still listed (bin/, dev/, lib/, proc/; the image's programs; its data
\ files), to read only (-21 to write); -2 any other path.
: nostore
klk @ lock
kvpath if kpb @ "/" streq if 1 lit else "/bin" vdir? if 2 lit else "/lib" vdir? if 3 lit else 0 lit then then then else 0 lit then
?dup 0= if FFFFFFFE lit else
2C lit sysarg 3 lit and if drop FFFFFFEB lit else
ptext ?dup 0= if drop FFFFFFF4 lit else
	swap dup 1 lit = if drop "bin/" tl "dev/" tl "lib/" tl "proc/" tl else
		2 lit = if 0 lit 1 lit tnames else FFFFFFFF lit 1 lit tnames then
	then
	tbend dup cproc fdput dup 0< if swap fclose else nip then
then then then
klk @ unlock ;

\ sofile  open(path, flags) of the file system: flags 0 read, 1 write, 2
\ both; CREATE makes a file not there (its directory must be), TRUNC
\ empties it, APPEND writes at its end.  A directory opened to read gives
\ its listing.  -2 none there (or no store), -13 not allowed (by the
\ file's mode, or its directory's to make it), -21 a directory to write,
\ -22 a tree (open it with TREE), -14 a bad path, -16 busy, -28 no room.
: sofile
fst @ 0= if nostore sret else
2C lit sysarg 3 lit and 3 lit = if FFFFFFEA lit sret else
fst @ 2C lit sysarg 600 lit and if 2 lit else 1 lit then tbegin 0= if FFFFFFF0 lit sret else
28 lit sysarg rpath 0= if tabort FFFFFFF2 lit sret else
	ptype
	dup 2 lit = if drop 2C lit sysarg 3 lit and if tabort FFFFFFEB lit else 4 lit perm if dlist else tabort FFFFFFF3 lit then then else
	dup 3 lit = if drop tabort FFFFFFEA lit else
	dup 1 lit = if drop
		2C lit sysarg need perm 0= if tabort FFFFFFF3 lit else
			2C lit sysarg TRUNC and 0= 0= 2C lit sysarg 3 lit and 0= 0= and if ftrunc then
			ffd
		then
	else drop
		2C lit sysarg CREATE and 0= 0= 2C lit sysarg 3 lit and 0= 0= and 0= if tabort FFFFFFFE lit else
		3 lit pdir ?dup if tabort else
			1 lit hnew tput 0= if tabort FFFFFFE4 lit else tunpin ffd then
		then then
	then then then
	sret
then then then then ;

\ kfile? ( -- f | 0 )  the call's descriptor (a0), if it is a file's or a
\ working directory to write: one descriptor more on it while the call
\ works without klk (kfdone lets it go).
: kfile?
klk @ lock
28 lit sysarg ufd dup if
	dup @ 7 lit = over @ 5 lit = 2 lit pick 18 lit + @ 3 lit = and or if dup 4 lit + dup @ 1 lit + swap ! else drop 0 lit then
then
klk @ unlock ;
: kfdone  klk @ lock fclose klk @ unlock ;          \ ( f -- )

\ fpath ( f -- )  the transaction's key the file's path.
: fpath  dup 8 lit + @ XKEY xa 2 lit pick 10 lit + @ bcpy  10 lit + @ dup XKLEN x! XPLEN x! ;

\ fread ( f -- n )  read(fd, buf, n) of a file: from its place, to its end.
: fread
dup 1C lit + @ 1 lit and 0= if kfdone FFFFFFF7 lit else
2C lit sysarg 30 lit sysarg uwrange 0= if kfdone FFFFFFF2 lit else
fst @ 1 lit tbegin 0= if kfdone FFFFFFF0 lit else
	dup XF x!  dup fpath
	hget 1 lit = if XVAL xa 10 lit + @ else 0 lit then
	over C lit + @ 2dup u< if 2drop 0 lit else - 30 lit sysarg 2dup u> if nip else drop then then
	XN x!  0 lit XD x!
	begin XD x@ XN x@ u< while
		XF x@ C lit + @ XD x@ +  dup A lit rshift chk!  3FF lit and
		400 lit over - XN x@ XD x@ - 2dup u> if nip else drop then
		XVAL xa 400 lit tget tunpin dup 0< if drop 0 lit then
		dup 400 lit u< if XVAL xa over + 400 lit 2 lit pick - bzero then drop
		swap XVAL xa + 2C lit sysarg XD x@ + 2 lit pick bcpy
		XD x@ + XD x!
	repeat
	XN x@  tcommit drop
	over C lit + dup @ 2 lit pick + swap !
	swap kfdone
then then then ;

\ fw1 ( f done -- f done' ok )  one transaction of a file's write: up to
\ 16 KiB more, at its place (its end, appending), its size and its time
\ changed.
: fw1
fst @ 2 lit tbegin 0= if 0 lit else
	over fpath
	hget 1 lit = 0= if tabort 0 lit else
		XVAL xa 10 lit + @ XSZ x!
		over 14 lit + @ if XSZ x@ 2 lit pick C lit + ! then
		dup XB x!  30 lit sysarg over - 4000 lit 2dup u> if nip else drop then XN x!  0 lit XD x!
		begin XD x@ XN x@ u< while
			over C lit + @ XD x@ +  dup A lit rshift chk!  3FF lit and
			400 lit over - XN x@ XD x@ - 2dup u> if nip else drop then
			XVAL xa 400 lit tget tunpin dup 0< if drop 0 lit then
			dup 400 lit u< if XVAL xa over + 400 lit 2 lit pick - bzero then
			2 lit pick 2 lit pick + max XVLEN x!
			2C lit sysarg XB x@ + XD x@ +  rot XVAL xa +  2 lit pick bcpy
			tput 0= if 1 lit XERR x! then tunpin
			XD x@ + XD x!
		repeat
		pkey! hget drop
		over C lit + @ XN x@ + XSZ x@ max XVAL xa 10 lit + !
		rtcsec XVAL xa 18 lit + !  20 lit XVLEN x!  tput drop tunpin
		XN x@ tcommit if drop 0 lit else
			2 lit pick C lit + dup @ 2 lit pick + swap !  +  1 lit
		then
	then
then ;

\ fwrite ( f -- n )  write(fd, buf, n) of a file: all of it, each 16 KiB a
\ transaction; -28 if none of it could be written.
: fwrite
dup 1C lit + @ 2 lit and 0= if kfdone FFFFFFF7 lit else
2C lit sysarg 30 lit sysarg urange 0= if kfdone FFFFFFF2 lit else
	0 lit begin dup 30 lit sysarg u< if fw1 else 0 lit then while repeat
	dup 0= 30 lit sysarg 0= 0= and if drop FFFFFFE4 lit then
	swap kfdone
then then ;

\ xvdir ( -- flag )  the path at XKEY is one of /dev's and /proc's
\ directories (vdir).
: xvdir
XKLEN x@ 3E lit u< 0= if 0 lit else
	klk @ lock  XKEY xa kpb @ XKLEN x@ bcpy  0 lit kpb @ XKLEN x@ + c!  vdir 0= 0=  klk @ unlock
then ;

\ fcwd ( f -- n )  a working directory written (/proc/<pid>/cwd, its own
\ user's or root): the path written (a newline after it no matter), which
\ must be a directory the caller may search, or one of /dev's and /proc's.
: fcwd
30 lit sysarg 1 lit - FE lit u< 0= if kfdone FFFFFFEA lit else
2C lit sysarg 30 lit sysarg urange 0= if kfdone FFFFFFF2 lit else
fst @ 0= if kfdone FFFFFFED lit else
fst @ 1 lit tbegin 0= if kfdone FFFFFFF0 lit else
	2C lit sysarg XSKEY xa 30 lit sysarg bcpy  30 lit sysarg
	dup if XSKEY xa over + 1 lit - c@ A lit = if 1 lit - then then Q1 x!
	rnorm if xvdir if 0 lit else ptype 2 lit = if 1 lit perm if 0 lit else FFFFFFF3 lit then else FFFFFFEC lit then then else FFFFFFEC lit then
	?dup if tcommit drop else
		1 lit spga ?dup if
			XKLEN x@ over !  XKEY xa over 4 lit + XKLEN x@ bcpy
			tcommit drop
			klk @ lock
			over 14 lit + @ 1 lit - prn dup @ 1 lit = cuid 0= 2 lit pick C4 lit + @ cuid = or and if
				C0 lit + dup @ ?dup if 1 lit pgfree then !  30 lit sysarg
			else drop 1 lit pgfree FFFFFFFD lit then
			klk @ unlock
		else tcommit drop FFFFFFF4 lit then
	then
	swap kfdone
then then then then ;

\ fsize ( f -- f size )  the file's size now.
: fsize  fst @ 1 lit tbegin if dup fpath hget 1 lit = if XVAL xa 10 lit + @ else 0 lit then tcommit drop else 0 lit then ;

\ mseek ( f -- place | -22 )  seek on a text in memory (kinds 4 and 11:
\ a listing, a /proc key, the image or one of its programs), its size at
\ 10.  Under klk.
: mseek
30 lit sysarg dup 0= if drop 2C lit sysarg else
	dup 1 lit = if drop dup C lit + @ 2C lit sysarg + else
	2 lit = if dup 10 lit + @ 2C lit sysarg + else FFFFFFEA lit then then then
dup FFFFFFEA lit = if nip else tuck swap C lit + ! then ;
\ mfile? ( -- f | 0 )  the call's descriptor, if a text in memory.  Under klk.
: mfile?  28 lit sysarg ufd dup if dup @ dup 4 lit = swap B lit = or 0= if drop 0 lit then then ;

\ 18 seek(fd, offset, whence): a file's place set: whence 0 from its
\ start, 1 from its place, 2 from its end.  The place; -29 not a file
\ (nor a text in memory).
: sseek
klk @ lock mfile? ?dup if mseek klk @ unlock sret else klk @ unlock
kfile? ?dup 0= if FFFFFFE3 lit sret else
dup @ 7 lit = 0= if kfdone FFFFFFE3 lit sret else
30 lit sysarg dup 0= if drop 2C lit sysarg else
	dup 1 lit = if drop dup C lit + @ 2C lit sysarg + else
	2 lit = if fsize 2C lit sysarg + else FFFFFFEA lit then then then
dup FFFFFFEA lit = if swap kfdone sret else over C lit + !  dup C lit + @ swap kfdone sret then
then then then ;

\ 35 remove(path): a file, a tree (its pages are not given back yet) or an
\ empty directory taken out (its directory must allow it).  0; -2 none
\ there, -13 not allowed, -39 a directory not empty, -16 the root (or
\ busy), -14 a bad path, -19 no store.
: sremove
fst @ 0= if FFFFFFED lit sret else
fst @ 2 lit tbegin 0= if FFFFFFF0 lit sret else
28 lit sysarg rpath 0= if tabort FFFFFFF2 lit sret else
XKLEN x@ 0= if tabort FFFFFFF0 lit sret else
3 lit pdir ?dup if tabort sret else
	ptype
	dup 0= if drop tabort FFFFFFFE lit else
	dup 1 lit = if drop fchunks tdel drop tunpin tcommit else
	3 lit = if tdel drop tunpin tcommit else
		dkey  XKLEN x@ XPLEN x!
		XSKEY xa tnext tunpin
		dup 0< if drop 1 lit else
			XPLEN x@ u> if XSKEY xa XPLEN x@ XKEY xa XPLEN x@ bcmp else 1 lit then
		then
		if tdel drop tunpin tcommit else tabort FFFFFFD9 lit then
	then then then
	sret
then then then then then ;

\ 36 mkdir(path): a directory made (its own must be there).  0; -17 there
\ already, -2 no directory to make it in, -14 a bad path, -28 no room.
: smkdir
fst @ 0= if FFFFFFED lit sret else
fst @ 2 lit tbegin 0= if FFFFFFF0 lit sret else
28 lit sysarg rpath 0= if tabort FFFFFFF2 lit sret else
	ptype if tabort FFFFFFEF lit else
	3 lit pdir ?dup if tabort else
		dkey 2 lit hnew tput 0= if tabort FFFFFFE4 lit else tunpin tcommit then
	then then
	sret
then then then ;

\ hmod ( which -- r )  37 chmod(path, mode): the mode set (its owner, or
\ root); 38 chown(path, user, group): its owner and group set (root).
\ 0; -2 none there, -1 not allowed, -14 a bad path.
: hmod
fst @ 0= if drop FFFFFFFE lit else
fst @ 2 lit tbegin 0= if drop FFFFFFF0 lit else
28 lit sysarg rpath 0= if drop tabort FFFFFFF2 lit else
ptype ?dup 0= if drop tabort FFFFFFFE lit else
	swap if
		cuid if drop tabort FFFFFFFF lit else
			2C lit sysarg XVAL xa 4 lit + !  30 lit sysarg XVAL xa 8 lit + !  0 lit
		then
	else
		cuid 0= cuid XVAL xa 4 lit + @ = or 0= if drop tabort FFFFFFFF lit else
			2C lit sysarg 1FF lit and XVAL xa C lit + !  0 lit
		then
	then
	?dup 0= if
		2 lit = if dkey then
		rtcsec XVAL xa 18 lit + !  20 lit XVLEN x!
		tput if tunpin tcommit else tabort FFFFFFE4 lit then
	then
then then then then ;
: schmod  0 lit hmod sret ;
: schown  1 lit hmod sret ;

\ fsinit  the root directory, if the store has none yet.  At boot.
: fsinit  fst @ 2 lit tbegin if 0 lit XKLEN x! dkey hget 0= if 2 lit hnew tput drop then tunpin tcommit drop then ;

\ ── Trees, and the store's calls (docs/OS.md, section 6) ──
\
\ open(path, TREE) gives a descriptor on a tree of the store (TREE |
\ CREATE makes it if it is not there).  The file system's tree holds, at
\ the tree's path, a header of 32 bytes: its type at 0 (3: a tree), the
\ tree's meta page at 28 (the rest of a file's header to come with files).
\ A transaction (begin) is a number for its process: its slot in stx, plus
\ 1.  A slot: the transaction, its process, its state (0 free, 1 in a
\ call, 2 open, 3 its process gone: to be undone, by kdefer), the tree's
\ open file (one descriptor more on it while the transaction lasts).  The
\ calls run without klk, and may sleep (for the disk, or a tree's writer).


: sxe  1 lit - 4 lit lshift stx @ + ;          \ ( h -- slot )

\ sxget ( h -- slot | 0 )  the caller's open transaction h, now in a call.
: sxget
klk @ lock
dup 1 lit - TXMAX u< if
	sxe dup 4 lit + @ cproc = over 8 lit + @ 2 lit = and if 1 lit over 8 lit + ! else drop 0 lit then
else drop 0 lit then
klk @ unlock ;
: sxdone  klk @ lock 2 lit swap 8 lit + ! klk @ unlock ;   \ ( slot -- )  open again
: sxfree  klk @ lock dup C lit + @ fclose  dup 10 lit mzero drop klk @ unlock ;   \ ( slot -- )

\ ukey ( addr n -- ok )  a key of the caller's into the transaction's: 1 to
\ 255 bytes (ukey0: or none).
: ukey0  dup FF lit u> if 2drop 0 lit else 2dup urange 0= if 2drop 0 lit else dup XKLEN x! XKEY xa swap bcpy 1 lit then then ;
: ukey   dup 0= if 2drop 0 lit else ukey0 then ;

\ sotree  open(path, TREE [| CREATE] | mode): a descriptor on the tree,
\ to read (mode 0) or also to write (1, 2), as its mode allows.  -19 no
\ store, -16 no transaction to be had, -14 a bad path, -2 none there, -13
\ not allowed, -20 something else there, -28 no room, -12 no memory.
: sotree
fst @ 0= if FFFFFFED lit sret else
fst @ 2C lit sysarg CREATE and if 2 lit else 1 lit then tbegin 0= if FFFFFFF0 lit sret else
28 lit sysarg rpath XKLEN x@ 0= 0= and 0= if tabort FFFFFFF2 lit sret else
	ptype
	dup 3 lit = if drop 2C lit sysarg need perm if XVAL xa 1C lit + @ tcommit drop else tabort FFFFFFF3 lit then else
	if tabort FFFFFFEC lit else
	2C lit sysarg CREATE and 0= if tabort FFFFFFFE lit else
	3 lit pdir ?dup if tabort else
		tcreate ?dup 0= if tabort FFFFFFE4 lit else
			3 lit hnew  dup XVAL xa 1C lit + !
			tput 0= if drop tabort FFFFFFE4 lit else tcommit if drop FFFFFFE4 lit then then
		then
	then then then then
	dup kerr? 0= if
		topen ?dup 0= if FFFFFFF4 lit else
			klk @ lock 6 lit 2C lit sysarg 3 lit and 1 lit + fnew ?dup 0= if klk @ unlock tclose FFFFFFF4 lit else
				tuck 8 lit + !
				dup cproc fdput dup 0< if swap fclose else nip then
				klk @ unlock
			then
		then
	then
	sret
then then then ;

\ binf? ( -- entry | 0 )  open's path is /bin/ and an image program's name,
\ or /lib/ and one of its data files'.
: binf?  klk @ lock kvpath if kpb @ "/bin/" kpfx ?dup if pfind else kpb @ "/lib/" kpfx ?dup if dfind else 0 lit then then else 0 lit then klk @ unlock ;

\ sobin ( entry -- )  open of an image program as /bin/<name> (or a data
\ file as /lib/<name>): to read only (its bytes, kind 11); -13 to write
\ (its name the image's).
: sobin
2C lit sysarg 3 lit and if drop FFFFFFF3 lit sret else
klk @ lock
B lit 1 lit fnew ?dup 0= if drop klk @ unlock FFFFFFF4 lit sret else
	over 10 lit + @ 80000000 lit + over 8 lit + !  swap 14 lit + @ over 10 lit + !  0 lit over C lit + !
	dup cproc fdput dup 0< if swap fclose else nip then
	klk @ unlock sret
then then ;

\ vpath? ( -- flag )  open's path is /dev or /proc, or under them (not the
\ store's).
: vpath?
klk @ lock
kvpath if kpb @ "/dev/" kpfx kpb @ "/proc/" kpfx or "/dev" vdir? or "/proc" vdir? or else 0 lit then
klk @ unlock ;
: sopen  2C lit sysarg TREE and if sotree else vpath? if sopen1 else binf? ?dup if sobin else sofile then then then ;

\ 23 begin(fd, flags): a transaction on the tree open as fd: flags 0 a
\ reader (the last commit's snapshot), 1 its writer (waiting for the one
\ before to finish; the tree open to write).  Its number; -9 not a tree
\ (or not open to write), -16 none to be had.
: sbegin
klk @ lock
28 lit sysarg ufd dup if dup @ 6 lit = 0= if drop 0 lit then then
dup if 2C lit sysarg 1 lit and if dup 1C lit + @ 2 lit and 0= if drop 0 lit then then then
?dup 0= if klk @ unlock FFFFFFF7 lit sret else
	0 lit TXMAX 0 lit do dup 0= if i 4 lit lshift stx @ + dup 8 lit + @ 0= if nip else drop then then loop
	?dup 0= if drop klk @ unlock FFFFFFF0 lit sret else
		1 lit over 8 lit + !  cproc over 4 lit + !  2dup C lit + !  over 4 lit + dup @ 1 lit + swap !
		klk @ unlock
		swap 8 lit + @ 2C lit sysarg 1 lit and if 2 lit else 1 lit then tbegin
		0 lit tx!
		?dup if over !  dup sxdone  stx @ - 4 lit rshift 1 lit + sret
		else sxfree FFFFFFF0 lit sret then
	then
then ;

\ 24 commit(h): 0; -28 it failed (and is undone); -9 not a transaction.
: scommit  28 lit sysarg sxget ?dup if dup @ tx! tcommit 0 lit tx! swap sxfree sret else FFFFFFF7 lit sret then ;

\ 25 abort(h): 0, or -9.
: sabort  28 lit sysarg sxget ?dup if dup @ tx! tabort 0 lit tx! sxfree 0 lit sret else FFFFFFF7 lit sret then ;

\ 26 get(h, key, klen, buf, n): the value's length (at most n bytes of it to
\ buf); -2 not there, -14 bad arguments.
: sget
28 lit sysarg sxget ?dup if
	dup @ tx!
	2C lit sysarg 30 lit sysarg ukey if
		38 lit sysarg ?dup if 34 lit sysarg swap uwrange else 1 lit then
		if 34 lit sysarg 38 lit sysarg tget dup 0< if drop FFFFFFFE lit then else FFFFFFF2 lit then
	else FFFFFFF2 lit then
	tunpin 0 lit tx!  swap sxdone sret
else FFFFFFF7 lit sret then ;

\ 27 put(h, key, klen, value, vlen): 0; -9 a reader's, -14 bad arguments,
\ -22 the value too long (1 KiB at most), -28 no room (the transaction
\ fails).
: sput
28 lit sysarg sxget ?dup if
	dup @ tx!
	XKIND x@ 2 lit = 0= if FFFFFFF7 lit else
	2C lit sysarg 30 lit sysarg ukey 0= if FFFFFFF2 lit else
	38 lit sysarg 400 lit u> if FFFFFFEA lit else
	34 lit sysarg 38 lit sysarg urange 0= if FFFFFFF2 lit else
		34 lit sysarg XVAL xa 38 lit sysarg bcpy  38 lit sysarg XVLEN x!
		tput if 0 lit else FFFFFFE4 lit then
	then then then then
	tunpin 0 lit tx!  swap sxdone sret
else FFFFFFF7 lit sret then ;

\ 28 del(h, key, klen): 0; -2 not there; -9 a reader's; -28 no room.
: sdel
28 lit sysarg sxget ?dup if
	dup @ tx!
	XKIND x@ 2 lit = 0= if FFFFFFF7 lit else
	2C lit sysarg 30 lit sysarg ukey 0= if FFFFFFF2 lit else
		tdel if 0 lit else XERR x@ if FFFFFFE4 lit else FFFFFFFE lit then then
	then then
	tunpin 0 lit tx!  swap sxdone sret
else FFFFFFF7 lit sret then ;

\ 29 next(h, key, klen, buf): the first key after key (klen 0: the first
\ of all) to buf (room for 255 bytes): its length; -2 none after.
: snext
28 lit sysarg sxget ?dup if
	dup @ tx!
	2C lit sysarg 30 lit sysarg ukey0 34 lit sysarg FF lit uwrange and if
		34 lit sysarg tnext dup 0< if drop FFFFFFFE lit then
	else FFFFFFF2 lit then
	tunpin 0 lit tx!  swap sxdone sret
else FFFFFFF7 lit sret then ;

\ kdefer  what a process left: its transactions undone, the trees whose
\ last descriptor closed closed (one another call is opening or closing
\ waits for the next turn).  A hart's work, between threads: nothing it
\ does may wait.
: kdefer
kdfl @ if
	0 lit kdfl !
	TXMAX 0 lit do
		i 4 lit lshift stx @ + dup 8 lit + @ 3 lit = if 1 lit over 8 lit + !  dup @ tx! tabort 0 lit tx!  sxfree else drop then
	loop
	begin
		klk @ lock kdqn @ dup if 1 lit - dup kdqn !  2 lit lshift kdq @ + @ then klk @ unlock
		dup if
			dup tclose? if drop 0 lit else
				klk @ lock kdqn @ 2 lit lshift kdq @ + !  kdqn @ 1 lit + kdqn !  1 lit kdfl !  klk @ unlock 1 lit
			then
		else drop 1 lit then
	until
then ;

\ ── The devices' interrupts ──

\ kplic ( irq -- )  the PLIC sending irq to hart 0, machine mode (context
\ 0), and the hart taking external interrupts.
: meie
B7120000 ,   \ lui t0,0x1
93820280 ,   \ addi t0,t0,-2048
73A04230 ,   \ csrrs zero,mie,t0
;
: kplic
1 lit over 2 lit lshift C000000 lit + !
C002000 lit over 5 lit rshift 2 lit lshift + dup @ 1 lit 3 lit pick 1F lit and lshift or swap !
0 lit C200000 lit !
meie ;

\ kext  an external interrupt: claimed, the disk's, the network's or
\ randomness's seen to, completed.
: kext
C200004 lit @
dup if dup birq @ = if kblkirq else dup nirq @ = if knetirq else dup rngirq @ = if krngirq then then then then
C200004 lit ! ;

\ read and write: files (and working directories written) without klk.
: sread   kfile? ?dup if dup @ 7 lit = if fread else kfdone FFFFFFF7 lit then sret else sread1 then ;
: swrite  kfile? ?dup if dup @ 7 lit = if fwrite else fcwd then sret else swrite1 then ;

\ ksys  a system call (ecall from user mode): the number in a7.
: ksys
44 lit sysarg
dup 1 lit = if drop sexit else
dup 2 lit = if drop sspawn else
dup 3 lit = if drop swait else
dup 4 lit = if drop sthread else
dup 5 lit = if drop stexit else
dup 6 lit = if drop sjoin else
dup 7 lit = if drop syield else
dup 8 lit = if drop ssleep else
dup 9 lit = if drop slock else
dup A lit = if drop sunlock else
dup B lit = if drop sawait else
dup C lit = if drop swake else
dup D lit = if drop smap else
dup E lit = if drop sunmap else
dup F lit = if drop sopen else
dup 10 lit = if drop sread else
dup 11 lit = if drop swrite else
dup 12 lit = if drop sseek else
dup 13 lit = if drop sclose else
dup 14 lit = if drop spipe else
dup 15 lit = if drop spty else
dup 16 lit = if drop spoll else
dup 17 lit = if drop sbegin else
dup 18 lit = if drop scommit else
dup 19 lit = if drop sabort else
dup 1A lit = if drop sget else
dup 1B lit = if drop sput else
dup 1C lit = if drop sdel else
dup 1D lit = if drop snext else
dup 1E lit = if drop ssocket else
dup 1F lit = if drop snet else
dup 20 lit = if drop saccept else
dup 21 lit = if drop ssendto else
dup 22 lit = if drop srecvf else
dup 23 lit = if drop sremove else
dup 24 lit = if drop smkdir else
dup 25 lit = if drop schmod else
dup 26 lit = if drop schown else
27 lit = if stty else FFFFFFDA lit sret
then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then then ;

\ ukill  an exception in user mode: the process ends (-1), the system goes on.
: ukill
"kernel: process killed: trap " puts mcause@ u.x
" at " puts mepc@ u.x " (" puts mtval@ u.x ")" puts 0A lit putc
klk @ lock cproc FFFFFFFF lit pexit klk @ unlock tstop ;

\ kipi  a software interrupt: cleared, and counted (what it asks is in the
\ hart's job word, or the thread's process ending).
: kipi  msipclr mhartid@ hipi harr dup @ 1 lit + swap ! ;

\ hipiok  a software interrupt's part: the hart's stale mark cleared (its
\ PMP reloaded if a thread runs, which is stopped if its process is
\ ending; from the kernel, no thread runs and the next trun reloads it).
: hipiok
mpp@ 0= if cproc 28 lit + @ if 0 lit mhartid@ hstale harr ! tstop else hfresh then
else 0 lit mhartid@ hstale harr ! then ;

\ ktrap  what the entry calls, with every register saved.  A call that
\ ends (perhaps after sleeping in it) while its process is ending stops
\ the thread rather than go back to it.  Interrupts are
\ taken from either mode: a timer's ends a thread's slice (counted to it),
\ a software interrupt stops a thread whose process is ending.  An
\ ── A machine program's devices (docs/OS.md, step 11) ──
\
\ A machine program (the image's :m: the compiler, bin/fam, unchanged) runs
\ as on bare metal: it polls the UART (its line status at 10000005, its
\ data at 10000000) and stops QEMU through the test finisher (100000).  In
\ user mode those accesses fault; kemu does each one instead, the faulting
\ load or store decoded at mepc, its address mtval:
\   line status read: data ready (and the transmitter empty) once input is
\     buffered, or its end reached; the buffer refilled first (read(0)).
\   data read: the next byte of the input, or EOT at its end.
\   data written: the byte buffered, the buffer written (write(1)) full.
\   the finisher written: the output written, then exit, 0 for 5555 (pass),
\     else the code in its upper half (13333: 1).
\ The buffers: the last 64 KiB of its memory (32 KiB in, 32 KiB out), past
\ what bin/fam uses.  A read or write that waits leaves the instruction to
\ fault again when woken (as a call is run again), the program's a0-a2
\ kept meanwhile.  The state, in the process: input taken 128 and held 132,
\ its end seen 136, output held 140, a0-a2 kept 144 (148, 152, 156), the
\ faulting pc 160, the value 164, whether to go on 168.

: kpr     cproc + ;                                          \ ( off -- a )  a field of the process
: kemub    cproc dup 10 lit + @ swap 14 lit + @ C lit lshift + 10000 lit - ;   \ ( -- in )  the output's 32 KiB after it
: kstash  90 lit kpr @ 0= if 28 lit sysarg 94 lit kpr !  2C lit sysarg 98 lit kpr !  30 lit sysarg 9C lit kpr !  1 lit 90 lit kpr ! then ;
: kunst   90 lit kpr @ if 94 lit kpr @ area@ 28 lit + !  98 lit kpr @ area@ 2C lit + !  9C lit kpr @ area@ 30 lit + !  0 lit 90 lit kpr ! then ;
: kavail?  80 lit kpr @ 84 lit kpr @ u< 88 lit kpr @ or ;
\ kfill, kflush ( -- ok )  the input buffer refilled, the output written:
\ 0 if the call waits.
: kfill
kstash  0 lit area@ 28 lit + !  kemub area@ 2C lit + !  8000 lit area@ 30 lit + !
sread
area@ E0 lit + @ if 0 lit else
	area@ 28 lit + @ dup 0 lit > if 84 lit kpr !  0 lit 80 lit kpr ! else drop 1 lit 88 lit kpr ! then
	kunst 1 lit
then ;
: kflush
8C lit kpr @ 0= if 1 lit else
	kstash  1 lit area@ 28 lit + !  kemub 8000 lit + area@ 2C lit + !  8C lit kpr @ area@ 30 lit + !
	swrite
	area@ E0 lit + @ if 0 lit else 0 lit 8C lit kpr !  kunst 1 lit then
then ;
: kemu
mepc@ A0 lit kpr !  kunst  1 lit A8 lit kpr !  0 lit A4 lit kpr !
mepc@ @ dup 7F lit and 3 lit = if
	mtval@ dup 10000005 lit = if drop
		kavail? 0= if kfill A8 lit kpr ! then  61 lit A4 lit kpr !
	else 10000000 lit = if
		80 lit kpr @ 84 lit kpr @ u< if
			80 lit kpr @ kemub + c@ A4 lit kpr !  80 lit kpr dup @ 1 lit + swap !
		else 4 lit A4 lit kpr ! then
	then then
	A8 lit kpr @ if 7 lit rshift 1F lit and ?dup if 2 lit lshift area@ + A4 lit kpr @ swap ! then else drop then
else dup 7F lit and 23 lit = if
	14 lit rshift 1F lit and ?dup if 2 lit lshift area@ + @ else 0 lit then
	mtval@ dup 10000000 lit = if drop
		8C lit kpr @ 8000 lit = if kflush A8 lit kpr ! then
		A8 lit kpr @ if FF lit and kemub 8000 lit + 8C lit kpr @ + c!  8C lit kpr dup @ 1 lit + swap ! else drop then
	else 100000 lit = if
		kflush if
			dup 5555 lit = if drop 0 lit else 10 lit rshift then area@ 28 lit + !  sexit  0 lit A8 lit kpr !
		else drop 0 lit A8 lit kpr ! then
	else drop then then
else drop then then
A8 lit kpr @ if A0 lit kpr @ 4 lit + mepc!  0 lit area@ E0 lit + ! then ;

\ exception from user mode is the thread's (a system call, or its end; a
\ machine program's device access, kemu), from the kernel a bug.
: ktrap
mcause@
dup 80000007 lit = if drop ktick mpp@ 0= if
	area@ C4 lit + dup @ 1 lit + swap !  cproc 50 lit + dup @ 1 lit + swap !
	mhartid@ 0= if cpoll npoll then
	tstop
then else
dup 80000003 lit = if drop kipi hipiok else
dup 8000000B lit = if drop kext else
mpp@ if drop kfault else
dup 8 lit = if drop ksys mpp@ 0= cproc 28 lit + @ and if tstop then else
dup 5 lit = swap 7 lit = or 54 lit kpr @ and if kemu else ukill then then
then then then then ;

\ [skip ... skip]  compile the code between where it is but jump over it.
:I [skip  here ,j0 ;
:I skip]  jpat! ;

: trapvec variable ;         \ the entry, for the harts started later

\ trapinit  the trap entry: mscratch holds the area (a hart's, 512 bytes,
\ or the running thread's control block) where the entry saves x1-x31 (x5
\ by way of mscratch itself) before calling ktrap, and from where it
\ restores them for mret.  A trap from user mode runs ktrap on the
\ thread's own kernel stacks (empty: a call begins there); when ktrap stops the thread (152
\ set), the entry goes on where trun left off rather than back to it.  mtvec points at the
\ entry, 16 bytes past the auipc (auipc, addi, csrw, and [skip's jump).
: trapinit
kvars
200 lit alloc                \ hart 0's trap area, 512 bytes as a thread's block (the store keeps its context at 352)
83220100 ,   \ lw t0,0(sp)
13014100 ,   \ addi sp,sp,4
73900234 ,   \ csrrw zero,mscratch,t0
97020000 ,   \ auipc t0,0x0
93820201 ,   \ addi t0,t0,16
73905230 ,   \ csrrw zero,mtvec,t0
[skip
F3920234 ,   \ csrrw t0,mscratch,t0      ( t0 = the area, mscratch = t0 )
23A21200 ,   \ sw ra,4(t0)
23A42200 ,   \ sw sp,8(t0)
23A63200 ,   \ sw gp,12(t0)
23A84200 ,   \ sw tp,16(t0)
23AC6200 ,   \ sw t1,24(t0)
23AE7200 ,   \ sw t2,28(t0)
23A08202 ,   \ sw s0,32(t0)
23A29202 ,   \ sw s1,36(t0)
23A4A202 ,   \ sw a0,40(t0)
23A6B202 ,   \ sw a1,44(t0)
23A8C202 ,   \ sw a2,48(t0)
23AAD202 ,   \ sw a3,52(t0)
23ACE202 ,   \ sw a4,56(t0)
23AEF202 ,   \ sw a5,60(t0)
23A00205 ,   \ sw a6,64(t0)
23A21205 ,   \ sw a7,68(t0)
23A42205 ,   \ sw s2,72(t0)
23A63205 ,   \ sw s3,76(t0)
23A84205 ,   \ sw s4,80(t0)
23AA5205 ,   \ sw s5,84(t0)
23AC6205 ,   \ sw s6,88(t0)
23AE7205 ,   \ sw s7,92(t0)
23A08207 ,   \ sw s8,96(t0)
23A29207 ,   \ sw s9,100(t0)
23A4A207 ,   \ sw s10,104(t0)
23A6B207 ,   \ sw s11,108(t0)
23A8C207 ,   \ sw t3,112(t0)
23AAD207 ,   \ sw t4,116(t0)
23ACE207 ,   \ sw t5,120(t0)
23AEF207 ,   \ sw t6,124(t0)
73230034 ,   \ csrrs t1,mscratch,zero    ( the interrupted t0 )
23AA6200 ,   \ sw t1,20(t0)
73900234 ,   \ csrrw zero,mscratch,t0    ( mscratch = the area again )
73230030 ,   \ csrrs t1,mstatus,zero     ( from user mode (MPP 0): )
1353B300 ,   \ srli t1,t1,0xb
13733300 ,   \ andi t1,t1,3
631C0300 ,   \ bne t1,zero,kernel
03A10215 ,   \ lw sp,0x150(t0)           ( the thread's kernel stacks, empty )
03AC4215 ,   \ lw s8,0x154(t0)
03AD8208 ,   \ lw s10,136(t0)            ( the kernel's variables, and heap )
83AD8215 ,   \ lw s11,0x158(t0)
83A10209 ,   \ lw gp,144(t0)
ktrap                                     \ kernel:
F3220034 ,   \ csrrs t0,mscratch,zero
03A38209 ,   \ lw t1,152(t0)             ( the thread stops: back to trun )
63040302 ,   \ beq t1,zero,back
23AC0208 ,   \ sw zero,152(t0)
03A10208 ,   \ lw sp,128(t0)
03AC4208 ,   \ lw s8,132(t0)
03AD8208 ,   \ lw s10,136(t0)
83ADC208 ,   \ lw s11,140(t0)
83A10209 ,   \ lw gp,144(t0)
13000000 ,   \ nop                       ( interrupts stay off: trun's after it )
03A34209 ,   \ lw t1,148(t0)
67000300 ,   \ jalr zero,0(t1)
F3220034 ,   \ csrrs t0,mscratch,zero    back: ( to where the trap came from )
83A04200 ,   \ lw ra,4(t0)
03A18200 ,   \ lw sp,8(t0)
83A1C200 ,   \ lw gp,12(t0)
03A20201 ,   \ lw tp,16(t0)
03A38201 ,   \ lw t1,24(t0)
83A3C201 ,   \ lw t2,28(t0)
03A40202 ,   \ lw s0,32(t0)
83A44202 ,   \ lw s1,36(t0)
03A58202 ,   \ lw a0,40(t0)
83A5C202 ,   \ lw a1,44(t0)
03A60203 ,   \ lw a2,48(t0)
83A64203 ,   \ lw a3,52(t0)
03A78203 ,   \ lw a4,56(t0)
83A7C203 ,   \ lw a5,60(t0)
03A80204 ,   \ lw a6,64(t0)
83A84204 ,   \ lw a7,68(t0)
03A98204 ,   \ lw s2,72(t0)
83A9C204 ,   \ lw s3,76(t0)
03AA0205 ,   \ lw s4,80(t0)
83AA4205 ,   \ lw s5,84(t0)
03AB8205 ,   \ lw s6,88(t0)
83ABC205 ,   \ lw s7,92(t0)
03AC0206 ,   \ lw s8,96(t0)
83AC4206 ,   \ lw s9,100(t0)
03AD8206 ,   \ lw s10,104(t0)
83ADC206 ,   \ lw s11,108(t0)
03AE0207 ,   \ lw t3,112(t0)
83AE4207 ,   \ lw t4,116(t0)
03AF8207 ,   \ lw t5,120(t0)
83AFC207 ,   \ lw t6,124(t0)
83A24201 ,   \ lw t0,20(t0)
73002030 ,   \ mret
skip]
mtvec@ trapvec ! ;

\ hstep  one turn of a hart's loop, interrupts on only while it idles: a
\ test job asked of it, or (once the kernel is ready) what processes left
\ undone (kdefer) and a thread, or sleep until an interrupt.
: hstep
mhartid@ hjob harr @ ?dup if
	hrun fence 0 lit mhartid@ hjob harr !
else
	kready @ if kdefer klk @ lock tpick klk @ unlock else 0 lit then
	?dup if
		trun
		mhartid@ hcur harr @  0 lit mhartid@ hcur harr !  tafter
	else
		mhartid@ 0= kready @ and if cpoll npoll then
		kei wfi kdi
	then
then ;

: hloop  begin hstep 0 lit until ;                          \ for good
: hrunfor  mtime@ + begin hstep dup mtime@ - 0< until drop ;  \ ( ticks -- ) for a while

\ ── Every hart: starting them ──

\ hmain  where a started hart lives: its timer, then its loop.
: hmain
swon tmrinit
area@ mhartid@ harea harr !
fence 1 lit mhartid@ hup harr !
hloop ;

\ hentry  compiles the code a started hart begins at (its address into
\ hentrya): its stacks, its trap area and entry from the record in a0, then
\ hmain.
: hentry
97020000 ,   \ auipc t0,0x0
93824201 ,   \ addi t0,t0,20              ( the code below )
1301C1FF ,   \ addi sp,sp,-4
23205100 ,   \ sw t0,0(sp)
[skip
03214500 ,   \ lw sp,4(a0)
032C8500 ,   \ lw s8,8(a0)
032DC500 ,   \ lw s10,12(a0)
832D0501 ,   \ lw s11,16(a0)
83214501 ,   \ lw gp,20(a0)
83228501 ,   \ lw t0,24(a0)
73900234 ,   \ csrrw zero,mscratch,t0
8322C501 ,   \ lw t0,28(a0)
73905230 ,   \ csrrw zero,mtvec,t0
hmain
skip]
hentrya ! ;

\ hpresent ( -- n )  harts marked present in the mailboxes.
: hpresent  0 lit MAXH 1 lit do i mbox @ 1 lit = if 1 lit + then loop ;

\ hupn ( -- n )  harts started and running.
: hupn  0 lit hmax @ 1 lit u> if hmax @ 1 lit do i hup harr @ if 1 lit + then loop then ;

\ hlate  the harts started that have not said so, and their mailboxes.
: hlate
"kernel: not started:" puts
hmax @ 1 lit do
	i hup harr @ 0= if i mbox @ 1 lit u> if
		20 lit putc i u. "=" puts i mbox @ u.x
	then then
loop
0A lit putc ;

\ fdtharts ( -- n | 0 )  the harts the machine has, from the device tree
\ QEMU puts at the end of RAM (2 MiB aligned: 87E00000 with 128 MiB, which
\ nothing has used by the time hstart reads it): its nodes named cpu@...;
\ 0 if there is none there.  fbe@ ( a -- u )  a big-endian word.
: fbe@  dup c@ 18 lit lshift over 1 lit + c@ 10 lit lshift or over 2 lit + c@ 8 lit lshift or swap 3 lit + c@ or ;
: fdtharts
87E00000 lit dup fbe@ D00DFEED lit <> if drop 0 lit else
	dup 8 lit + fbe@ +  0 lit swap
	begin dup fbe@ dup 9 lit <> while
		dup 1 lit = if
			drop 4 lit +
			dup c@ 63 lit = over 1 lit + c@ 70 lit = and over 2 lit + c@ 75 lit = and over 3 lit + c@ 40 lit = and if swap 1 lit + swap then
			begin dup c@ while 1 lit + repeat 4 lit + FFFFFFFC lit and
		else dup 3 lit = if drop dup 4 lit + fbe@ 3 lit + FFFFFFFC lit and C lit + +
		else drop 4 lit + then then
	repeat
	2drop
then ;

\ hstart  every hart waiting started.  The harts start at once, but
\ reaching their mailboxes may take a moment (under QEMU, with more harts
\ than the host has cores, a hart's thread waits its turn): hart 0 waits
\ for as many as the device tree has (fdtharts), however long they take
\ (60 s at most, against a hang); with no device tree, until 100 ms pass
\ with no new one.  A hart it starts has 60 s to say so.  Each started hart gets 36 KiB of the heap: its record
\ and trap area, 16 KiB of data stack, 4 KiB each of loop frames, return ids
\ and heap.  Then the locks' size, from the highest hart id.
: hstart
hstarted @ 0= if
	1 lit hstarted !
	hentry
	1 lit nharts !  1 lit hmax !
	1 lit mhartid@ hup harr !
	fdtharts ?dup if
		1 lit - mtime@
		begin hpresent 2 lit pick u< mtime@ 2 lit pick - 23C34600 lit u< and while repeat
		2drop
	else
		hpresent mtime@
		begin mtime@ over - F4240 lit u< while
			hpresent 2 lit pick <> if 2drop hpresent mtime@ then
		repeat
		2drop
	then
	MAXH 1 lit do
		i mbox @ 1 lit = if
			9000 lit alloc FFF lit + FFFFF000 lit and   \ ( blk )
			hentrya @ over !
			dup 5000 lit + over 4 lit + !              \ sp
			dup 6000 lit + over 8 lit + !              \ s8
			s10@ over C lit + !                        \ s10, shared
			dup 7000 lit + over 10 lit + !             \ s11
			dup 7000 lit + over 14 lit + !             \ gp
			dup 40 lit + over 18 lit + !               \ the trap area
			trapvec @ over 1C lit + !                  \ the trap entry
			fence
			i mbox !
			fence
			i ipi
			nharts @ 1 lit + nharts !
			i 1 lit + hmax !
		then
	loop
	mtime@
	begin hupn nharts @ 1 lit - u< while
		mtime@ over - 23C34600 lit u> if hlate "a hart did not start" panic then
	repeat
	drop
	1 lit 0 lit
	begin over hmax @ u< while swap 1 lit lshift swap 1 lit + repeat
	lkl ! lkn !
	lknew klk !
then ;

\ hjobs ( job -- )  asked of every started hart.
: hjobs
hmax @ 1 lit u> if
	hmax @ 1 lit do
		i hup harr @ if dup i hjob harr ! fence i ipi then
	loop
then
drop ;

\ hjwait  until every started hart has done its job.
: hjwait
begin
	0 lit
	hmax @ 1 lit u> if hmax @ 1 lit do i hjob harr @ or loop then
while repeat
fence ;

\ kboot  the kernel made ready, on hart 0 at the start: its traps, every
\ hart, the pages (from past its heap, 64 KiB of which is kept for what it
\ takes before them, up to its stacks), the tables, the store if there is
\ a disk, its timer; then threads may run (kready).  What the image (src/boot.fam) and the tests of the
\ whole kernel (scripts/oscheck.sh) begin with.
: kboot
trapinit
area@ mhartid@ harea harr !
hstart
gp@ 10000 lit + FFF lit + FFFFF000 lit and
87F00000 lit pginit
ptinit kcinit 40 lit alloc kpb !  40 lit alloc kvb !
mtime@ 1 lit or rndseed !     \ the lottery's draws: not from 0, which xorshift never leaves
fence 1 lit kready !
"kernel: " puts nharts @ u. nharts @ 1 lit = if " hart, " else " harts, " then puts
pgfree# dup u. " pages free (" puts 8 lit rshift u. " MiB)" puts
0A lit putc
blkfind if                    \ a disk: the store, found or made, and its interrupt
	0 lit stmount  fsinit
	bk @ 10001000 lit - C lit rshift 1 lit + dup birq ! kplic
	"kernel: the store: " puts npg @ 8 lit rshift u. " MiB, " puts hwm @ u. " pages in use, a cache of " puts NSLOT 8 lit rshift u. " MiB" puts 0A lit putc
then
nfind ?dup if                 \ a network device: started, and its interrupt
	nk !  ninit cinit
	nk @ 10001000 lit - C lit rshift 1 lit + dup nirq ! kplic
	"kernel: the network: " puts nmac @ .mac ", 10.0.2.15" puts 0A lit putc
	narpwait ngwok @ if "kernel: the gateway: " puts ngw @ .mac 0A lit putc then
then
rngfind ?dup if               \ randomness: /dev/random, and its interrupt
	rnginit
	rngk @ 10001000 lit - C lit rshift 1 lit + dup rngirq ! kplic
	"kernel: randomness: virtio-rng" puts 0A lit putc
then
swon tmrinit                  \ hart 0 too takes software interrupts (stale PMP, a process ending)
kdi                           \ and in machine mode only where hstep idles
;

Test {
	pg_one {
		\ a range of 64 pages: three taken in a row, given back in another
		\ order, and the table whole again
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit           \ ( base )
		pgfree# 40 lit asrt_eq
		1 lit pgalloc over asrt_eq
		2 lit pgalloc over 1000 lit + asrt_eq
		3 lit pgalloc over 3000 lit + asrt_eq
		pgfree# 3A lit asrt_eq
		pgn @ 1 lit asrt_eq
		dup 1000 lit + 2 lit pgfree          \ a hole in the middle
		pgn @ 2 lit asrt_eq
		dup 1 lit pgfree                     \ joins it
		pgn @ 2 lit asrt_eq
		dup 3000 lit + 3 lit pgfree          \ joins both sides
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_full {
		\ running out, and coming back
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit
		41 lit pgalloc 0 lit asrt_eq
		40 lit pgalloc over asrt_eq
		pgn @ 0 lit asrt_eq
		pgfree# 0 lit asrt_eq
		1 lit pgalloc 0 lit asrt_eq
		dup 40 lit pgfree
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_holes {
		\ every page taken one by one; every other given back (32 ranges),
		\ then the rest (one again)
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup dup 40000 lit + pginit
		40 lit 0 lit do 1 lit pgalloc drop loop
		pgn @ 0 lit asrt_eq
		20 lit 0 lit do dup i D lit lshift + 1 lit pgfree loop
		pgn @ 20 lit asrt_eq
		20 lit 0 lit do dup i D lit lshift + 1000 lit + 1 lit pgfree loop
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
		drop
	}
	pg_rand {
		\ 1000 random takes and gives back over 16 slots, each block's
		\ pages tagged with its address and checked when it is given
		\ back (so no two blocks ever overlapped); at the end, whole
		41000 lit alloc FFF lit + FFFFF000 lit and
		dup 40000 lit + pginit
		80 lit alloc                         \ ( S: 16 slots, address and pages )
		20 lit 0 lit do 0 lit over i 2 lit lshift + ! loop
		1234567 lit rndseed !
		3E8 lit 0 lit do
			rnd F lit and 3 lit lshift over +        \ ( S slot )
			dup @ if
				dup @ over 4 lit + @ pgchk assert
				dup @ over 4 lit + @ pgfree
				0 lit over !
			else
				rnd 7 lit and 1 lit +                \ ( S slot pages )
				dup pgalloc                          \ ( S slot pages addr )
				dup if
					2dup swap pgtag
					2 lit pick !
					over 4 lit + !
				else
					2drop
				then
			then
			drop
		loop
		10 lit 0 lit do
			dup i 3 lit lshift + dup @ if dup @ swap 4 lit + @ pgfree else drop then
		loop
		drop
		pgn @ 1 lit asrt_eq
		pgfree# 40 lit asrt_eq
	}
	tm_busy {
		\ a long computation interrupted by the timer again and again comes
		\ out as it does uninterrupted: the entry saves and restores
		\ everything it should
		1234567 lit rndseed !
		100000 lit 0 lit do rnd drop loop
		rndseed @                            \ ( undisturbed )
		trapinit tmrinit
		1234567 lit rndseed !
		100000 lit 0 lit do rnd drop loop
		tmroff
		rndseed @ asrt_eq
		ticks@ 2 lit u< 0= assert            \ and it was interrupted
	}
	timer {
		\ 20 ticks, each a period at least after the last: none early, and
		\ they keep coming
		trapinit tmrinit
		mtime@
		begin ticks@ 14 lit u< while wfi repeat
		tmroff
		mtime@ swap -                        \ elapsed
		period @ 13 lit * u< 0= assert       \ at least 19 periods
	}
	harts {
		\ every hart there is started; 1000 counts each under the lock come
		\ out whole; numbers sent to each hart through its queue arrive
		\ every one, in order
		trapinit hstart
		hupn nharts @ 1 lit - asrt_eq
		0 lit lkc !  3E8 lit lkk !
		1 lit hjobs lkstrs hjwait
		lkc @ nharts @ 3E8 lit * asrt_eq
		hmax @ 1 lit u> if
			hmax @ 1 lit do
				i hup harr @ if qnew i hq harr !  0 lit i hres harr ! then
			loop
		then
		2 lit hjobs
		lkk @ 1 lit + 1 lit do
			hmax @ 1 lit u> if
				hmax @ 1 lit do
					i hup harr @ if
						begin j i hq harr @ qpush until
					then
				loop
			then
		loop
		hjwait
		0 lit hmax @ 1 lit u> if hmax @ 1 lit do i hres harr @ or loop then
		0 lit asrt_eq
		"harts: " puts nharts @ u. 0A lit putc
	}
}
